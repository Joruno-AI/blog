    "@heroui-pro/react": "1.0.0-beta.8",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@number-flow/react": "^0.6.2",
    "@opennextjs/cloudflare": "^1.20.4",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-code-block-lowlight": "^3.30.5",
