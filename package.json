{
  "name": "personal-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm diagrams:build && next build",
    "start": "next start",
    "test": "tsx --test tests/**/*.test.ts",
    "test:data-parity": "node scripts/verify-astro-online-parity.mjs",
    "test:cside-parity": "node scripts/verify-cside-route-parity.mjs",
    "test:agent-stress": "node scripts/stress-agent-routes.mjs",
    "test:smoke": "node scripts/smoke-runtime.mjs",
    "diagrams:build": "node scripts/generate-archify-artifacts.mjs && node scripts/generate-zread-archify-artifacts.mjs",
    "diagrams:check": "node scripts/generate-archify-artifacts.mjs --check && node scripts/generate-zread-archify-artifacts.mjs --check",
    "assets:sync:astro": "node scripts/sync-astro-static-assets.mjs",
    "data:generate:agent-selected": "node scripts/generate-agent-selected-summaries.mjs",
    "data:generate:agent-tree-snapshot": "node scripts/generate-agent-repository-tree-snapshot.mjs",
    "data:check:zread-cache": "node scripts/sync-zread-selected-cache.mjs --check",
    "data:check:zread-cache:strict": "node scripts/sync-zread-selected-cache.mjs --check --strict",
    "data:generate:public-content": "tsx scripts/generate-public-content-snapshot.ts --local && tsx scripts/generate-public-endpoint-assets.ts",
    "data:generate:public-content:remote": "tsx scripts/generate-public-content-snapshot.ts --remote && tsx scripts/generate-public-endpoint-assets.ts",
    "data:check:public-content": "tsx scripts/generate-public-content-snapshot.ts --local --check && tsx scripts/generate-public-endpoint-assets.ts --check",
    "data:generate:public-endpoints": "tsx scripts/generate-public-endpoint-assets.ts",
    "heroui:install:ci": "node scripts/install-heroui-pro.mjs",
    "heroui:verify": "node scripts/install-heroui-pro.mjs --check",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:verify": "node scripts/verify-d1-migration.mjs --local",
    "db:verify:remote": "node scripts/verify-d1-migration.mjs --remote",
    "security:verify:open-next": "node scripts/assert-safe-next-env.mjs --generated",
    "cloudflare:build": "node scripts/build-cloudflare.mjs",
    "cloudflare:preview": "node scripts/assert-safe-next-env.mjs --generated && opennextjs-cloudflare preview",
    "cloudflare:deploy": "node scripts/deploy-cloudflare.mjs",
    "cf-typegen": "mkdir -p .wrangler/types && wrangler types --include-runtime false --env-interface CloudflareBindings .wrangler/types/bindings.d.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
