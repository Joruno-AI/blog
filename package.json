    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "react": "^19.0.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-callouts": "2.2.0",
    "rehype-expressive-code": "0.44.0",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "10.0.1",
    "rehype-wrap-all": "1.1.0",
    "remark-breaks": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-directive-sugar": "2.0.1",
    "remark-gfm": "^4.0.1",
    "remark-imgattr": "1.1.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-smartypants": "3.0.2",
    "server-only": "0.0.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.7",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "unified": "11.0.5",
    "unist-util-visit": "^5.1.0",
    "viewerjs": "^1.11.7",
    "zod": "^4.5.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.24",
    "hpsetup": "4.7.1",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.127.1"
  },
  "pnpm": {
    "overrides": {
      "tar": "7.5.22",
      "solid-js>seroval": "1.5.3",
      "next>postcss": "8.5.18"
    }
  }
}
