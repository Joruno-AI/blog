---
import '~/styles/main.css'
import '~/styles/prose.css'
import '~/styles/markdown.css'
import '~/styles/page.css'
import '~/styles/mobile.css'
import '~/styles/music-polish.css'

import Head from '~/components/base/Head.astro'
import Background from '~/components/backgrounds/Background.astro'
import Link from '~/components/base/Link.astro'
import NavBar from '~/components/nav/NavBar.astro'
import BackLink from '~/components/widgets/BackLink.astro'
import Footer from '~/components/base/Footer.astro'
import ToTopButton from '~/components/widgets/ToTopButton.astro'
import Backdrop from '~/components/base/Backdrop.astro'
import SearchSwitch from '~/components/widgets/SearchSwitch.astro'
import GlobalMusicPlayer from '~/components/music/GlobalMusicPlayer.astro'
import KeyboardShortcuts from '~/components/widgets/KeyboardShortcuts.astro'

import { SITE, UI, FEATURES } from '~/config'
import { withBasePath } from '~/utils/path'

import type { BgType } from '~/types'

interface Props {
  title?: string
  description?: string
  ogImage?: string | boolean
  bgType?: BgType | false
  pubDate?: string
  lastModDate?: string
  tags?: string[]
  category?: string
  stableNavigation?: boolean
  disableReveal?: boolean
  hideFooter?: boolean
}

const {
  title,
  description,
  ogImage,
  bgType,
  pubDate,
  lastModDate,
  tags,
  category,
  stableNavigation = false,
  disableReveal = false,
  hideFooter = false,
} = Astro.props

let style: Record<string, string> = {}

const { slideEnterAnim } = FEATURES
const enableSlideEnterAnim = Array.isArray(slideEnterAnim) && slideEnterAnim[0]
if (enableSlideEnterAnim)
  style['--enter-step'] = `${slideEnterAnim[1].enterStep}ms`
if (enableSlideEnterAnim && slideEnterAnim[1].duration)
  style['--enter-duration'] = `${slideEnterAnim[1].duration}ms`
if (enableSlideEnterAnim && slideEnterAnim[1].distance)
  style['--enter-distance'] = `${slideEnterAnim[1].distance}px`

const {
  externalLink: { newTab, cursorType },
} = UI
const hasCustomCursor =
  newTab && cursorType.length > 0 && cursorType !== 'pointer'
if (hasCustomCursor) style['--external-link-cursor'] = cursorType

const pathname = Astro.url.pathname
const pageKind =
  pathname === withBasePath('/')
    ? 'home'
    : pathname === withBasePath('/blog') || pathname === withBasePath('/blog/')
      ? 'blog'
      : pathname.startsWith(withBasePath('/blog/'))
        ? 'article'
        : pathname.startsWith(withBasePath('/docs'))
          ? 'docs'
          : pathname.startsWith(withBasePath('/agent'))
            ? 'agent'
            : pathname.startsWith(withBasePath('/music'))
              ? 'music'
              : 'default'
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Head
      {title}
      {description}
      {ogImage}
      {pubDate}
      {lastModDate}
      {tags}
      {category}
    />
  </head>

  <body
    class="relative flex flex-col min-h-screen
      font-sans text-gray-700 dark:text-gray-200"
    style={Object.keys(style).length !== 0 ? style : undefined}
    data-page-kind={pageKind}
    data-stable-navigation={stableNavigation ? '' : undefined}
    data-no-sliding={disableReveal || !enableSlideEnterAnim ? '' : undefined}
  >
    <!-- Every standard route shares Light Rays in both themes. Music stays
         independent because it owns an album-driven implementation. -->
    {pageKind !== 'music' && <Background type={bgType} />}

    <!-- Skip Link -->
    <Link
      href="#main"
      class="sr-only focus:(not-sr-only fixed start-1 top-1.5 op-20)"
    >
      Skip to content
    </Link>

    <!-- Nav Bar -->
    <NavBar />

    <!-- Main -->
    <main id="main" class="px-7 py-10">
      <!-- Content -->
      <slot />
      <!-- Share -->
      {
        !hideFooter && Astro.url.pathname !== withBasePath('/') && (
          <footer class="slide-enter animate-delay-1000! prose mx-auto mt-8 print:hidden">
            <slot name="share" />
            <br />
            <BackLink />
          </footer>
        )
      }
      <!-- Comments -->
      <slot name="giscus" />
    </main>

    <!-- Footer -->
    {!hideFooter && <Footer />}
    <ToTopButton />

    <!-- Panel Backdrop (on mobile) -->
    <Backdrop />
    <SearchSwitch />

    <!-- Global Music Player -->
    <GlobalMusicPlayer />

    <!-- Keyboard Shortcuts -->
    <KeyboardShortcuts />

    <script>
      import { bindSlideReveal } from '~/scripts/reveal'

      bindSlideReveal()
    </script>

    <!-- Immersive reading is scoped to the current article. Astro keeps the
         <html> element across SPA navigations, so clear its state whenever the
         page changes instead of carrying it into the next article. -->
    <script>
      function resetImmersiveState() {
        document.documentElement.removeAttribute('data-immersive')
      }

      resetImmersiveState()
      document.addEventListener('astro:before-swap', resetImmersiveState)
    </script>
  </body>
</html>
