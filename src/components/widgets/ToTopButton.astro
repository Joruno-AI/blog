---

---

<button
  id="to-top-button"
  class="floating-tool-button"
  type="button"
  aria-label="回到页面顶部"
  title="回到页面顶部"
>
  <span class="i-ri-arrow-up-line" aria-hidden="true"></span>
</button>

<style>
  #to-top-button {
    right: 1.25rem;
    bottom: 6rem;
    width: 2rem;
    height: 2rem;
    border: 0;
    background: color-mix(in srgb, var(--c-bg) 30%, transparent);
    box-shadow:
      0 5px 16px rgb(0 0 0 / 0.08),
      inset 0 1px 0 rgb(255 255 255 / 0.1);
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.35rem) scale(0.96);
    visibility: hidden;
  }

  #to-top-button > span {
    font-size: 0.95rem;
  }

  @media (hover: hover) and (pointer: fine) {
    #to-top-button:hover {
      background: color-mix(in srgb, var(--c-bg) 44%, transparent);
      box-shadow:
        0 7px 20px rgb(0 0 0 / 0.11),
        inset 0 1px 0 rgb(255 255 255 / 0.12);
      color: var(--c-text);
      transform: translateY(-1px);
    }
  }

  #to-top-button[data-visible] {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    visibility: visible;
  }
</style>

<script>
  let toTopController: AbortController | null = null
  let scrollFrame = 0

  function initToTopButton() {
    const toTopButton = document.getElementById('to-top-button')
    if (!toTopButton) return
    toTopController?.abort()
    toTopController = new AbortController()
    const { signal } = toTopController

    const updateVisibility = () => {
      const scrollY = window.scrollY || document.documentElement.scrollTop
      toTopButton.toggleAttribute('data-visible', scrollY > 300)
    }

    const handleScroll = () => {
      if (scrollFrame) return
      scrollFrame = window.requestAnimationFrame(() => {
        scrollFrame = 0
        updateVisibility()
      })
    }

    toTopButton.addEventListener(
      'click',
      () => {
        const reduceMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches
        window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' })
      },
      { signal }
    )
    window.addEventListener('scroll', handleScroll, { passive: true, signal })
    updateVisibility()
  }

  document.addEventListener('astro:page-load', initToTopButton)
  document.addEventListener('astro:before-swap', () => {
    toTopController?.abort()
    if (scrollFrame) window.cancelAnimationFrame(scrollFrame)
    scrollFrame = 0
  })
</script>
