---

---

<button
  id="theme-switch"
  class="op-60 hover:op-100 op-transition"
  title="Toggle theme"
  role="switch"
  aria-label="Dark mode"
  aria-checked="false"
>
  <div u-i-ri-sun-line u-dark:i-ri-moon-line></div>
</button>

<script>
  import { withClientBasePath } from '~/utils/misc'

  // related to #45
  const chooseFill = (): FillMode => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const uach = (navigator as any).userAgentData

    if (uach?.brands?.length) {
      const brands: { brand: string; version: string }[] = uach.brands
      const isChromiumBrand = brands.some((b) => /Chrom(e|ium)/i.test(b.brand))
      if (isChromiumBrand) return 'both'
      return 'none'
    }

    return 'none'
  }
  const fill = chooseFill()

  const changeGiscusTheme = (isDark: boolean) => {
    const newTheme = isDark
      ? withClientBasePath('giscus/dark.css')
      : withClientBasePath('giscus/light.css')

    const giscusScript = document.getElementById('giscus-script')
    if (giscusScript) {
      giscusScript.setAttribute('data-theme', newTheme)
      const iframe = document.querySelector('iframe.giscus-frame')
      if (
        iframe &&
        iframe instanceof HTMLIFrameElement &&
        iframe.contentWindow
      ) {
        iframe.contentWindow.postMessage(
          { giscus: { setConfig: { theme: newTheme } } },
          'https://giscus.app'
        )
      }
    }
  }

  const updateAria = (isDark: boolean, buttonElement: HTMLElement | null) => {
    buttonElement?.setAttribute('aria-checked', isDark ? 'true' : 'false')
  }

  const setColorScheme = (isDark: boolean) => {
    const colorScheme = document.querySelector("meta[name='color-scheme']")
    colorScheme?.setAttribute('content', isDark ? 'dark light' : 'light dark')
  }

  const setThemeColor = () => {
    const themeColor = document.querySelector("meta[name='theme-color']")
    const bgColor = getComputedStyle(document.body).getPropertyValue('--c-bg')
    themeColor?.setAttribute('content', bgColor)
  }

  const saveTheme = (isDark: boolean) => {
    window.localStorage.setItem('theme', isDark ? 'dark' : 'light')
  }

  const getThemeSwitchButton = () => {
    return document.getElementById('theme-switch')
  }

  const syncTheme = (
    isDark: boolean,
    buttonElement = getThemeSwitchButton()
  ) => {
    document.documentElement.classList.toggle('dark', isDark)
    changeGiscusTheme(isDark)
    updateAria(isDark, buttonElement)
    setColorScheme(isDark)
    setThemeColor()
    saveTheme(isDark)
  }

  const handleToggle = (event: MouseEvent) => {
    const currentTarget = event.currentTarget
    if (!(currentTarget instanceof HTMLElement)) return

    const nextIsDark = !document.documentElement.classList.contains('dark')
    const toggle = () => {
      syncTheme(nextIsDark, currentTarget)
    }

    const isAppearanceTransition =
      // @ts-expect-error (View Transitions API)
      document.startViewTransition &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (!isAppearanceTransition) {
      toggle()
      return
    }

    const buttonRect = currentTarget.getBoundingClientRect()
    const hasPointerCoordinates =
      event.detail > 0 && (event.clientX !== 0 || event.clientY !== 0)
    const x = hasPointerCoordinates
      ? event.clientX
      : buttonRect.left + buttonRect.width / 2
    const y = hasPointerCoordinates
      ? event.clientY
      : buttonRect.top + buttonRect.height / 2
    const originX = `${(x / innerWidth) * 100}%`
    const originY = `${(y / innerHeight) * 100}%`

    const transition = document.startViewTransition(() => toggle())

    transition.ready.then(() => {
      const clipPath = [
        `circle(0% at ${originX} ${originY})`,
        `circle(150% at ${originX} ${originY})`,
      ]

      document.documentElement.animate(
        { clipPath },
        {
          duration: 400,
          easing: 'ease-out',
          fill,
          pseudoElement: '::view-transition-new(root)',
        }
      )
    })
  }

  const bindThemeSwitch = () => {
    const toggleThemeButton = getThemeSwitchButton()
    const isDark = document.documentElement.classList.contains('dark')
    updateAria(isDark, toggleThemeButton)
    if (toggleThemeButton) toggleThemeButton.onclick = handleToggle
  }

  type ThemeRuntimeWindow = Window & {
    __themePageLoadHandler?: () => void
    __themeSystemMedia?: MediaQueryList
    __themeSystemHandler?: (event: MediaQueryListEvent) => void
  }

  const runtimeWindow = window as ThemeRuntimeWindow
  if (runtimeWindow.__themePageLoadHandler) {
    document.removeEventListener(
      'astro:page-load',
      runtimeWindow.__themePageLoadHandler
    )
  }
  runtimeWindow.__themePageLoadHandler = bindThemeSwitch
  document.addEventListener('astro:page-load', bindThemeSwitch)

  if (runtimeWindow.__themeSystemMedia && runtimeWindow.__themeSystemHandler) {
    runtimeWindow.__themeSystemMedia.removeEventListener(
      'change',
      runtimeWindow.__themeSystemHandler
    )
  }
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)')
  const handleSystemTheme = ({ matches }: MediaQueryListEvent) => {
    syncTheme(matches)
  }
  runtimeWindow.__themeSystemMedia = systemTheme
  runtimeWindow.__themeSystemHandler = handleSystemTheme
  systemTheme.addEventListener('change', handleSystemTheme)

  // Bind immediately as well as after Astro navigations. This replaces stale
  // click handlers when this module is hot-reloaded during local development.
  bindThemeSwitch()
</script>
