<style>
  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    overflow: visible;
  }

  @media (max-width: 767.9px) {
    .logo-container {
      margin-top: 0.125rem;
    }
  }

  .logo-svg {
    display: block;
    width: 7.25rem;
    height: 2.15rem;
    overflow: visible;
  }

  .logo-ink {
    color: var(--c-text);
    fill: currentColor;
  }

  .logo-base {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo-ink {
      fill-opacity: 0;
      animation: fill-signature-word 9s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    }

    .logo-ink path {
      fill: currentColor;
      stroke: currentColor;
      stroke-width: 14;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw-signature-word 9s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @keyframes draw-signature-word {
      0%,
      3% {
        stroke-dashoffset: 1;
      }
      28%,
      88% {
        stroke-dashoffset: 0;
      }
      98%,
      100% {
        stroke-dashoffset: 1;
      }
    }

    @keyframes fill-signature-word {
      0%,
      7% {
        fill-opacity: 0;
      }
      30%,
      84% {
        fill-opacity: 1;
      }
      94%,
      100% {
        fill-opacity: 0;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-ink path {
      fill: currentColor;
    }
  }
</style>
