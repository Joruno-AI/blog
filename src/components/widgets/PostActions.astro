---
/**
 * Post actions: copy the raw Markdown, or open the article in an AI chat
 * with a prefilled prompt. Rendered near the title on blog posts.
 */
interface Props {
  markdown: string
  postUrl: string
  title: string
}

const { markdown, postUrl, title } = Astro.props
---

<div
  class="post-actions"
  data-post-actions
  data-markdown={markdown}
  data-url={postUrl}
  data-title={title}
>
  <button type="button" class="post-action" data-copy-md>
    <span class="i-ri-file-copy-line" aria-hidden="true"></span>
    <span>复制 Markdown</span>
    <span
      class="copy-tooltip"
      data-copy-tooltip
      role="status"
      aria-live="polite"></span>
  </button>

  <div class="post-action-menu" data-open-menu>
    <button
      type="button"
      class="post-action"
      aria-haspopup="true"
      aria-expanded="false"
      data-open-trigger
    >
      <span class="i-ri-robot-2-line" aria-hidden="true"></span>
      <span>用 AI 打开</span>
      <span class="i-ri-arrow-down-s-line post-action-caret" aria-hidden="true"
      ></span>
    </button>

    <div class="post-action-dropdown" data-open-dropdown hidden>
      <a
        class="post-action-item"
        data-ai="chatgpt"
        href="https://chatgpt.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="i-ri-openai-fill" aria-hidden="true"></span>
        <span>ChatGPT</span>
        <span class="i-ri-external-link-line post-action-ext" aria-hidden="true"
        ></span>
      </a>
      <a
        class="post-action-item"
        data-ai="claude"
        href="https://claude.ai/new"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="i-ri-claude-fill" aria-hidden="true"></span>
        <span>Claude</span>
        <span class="i-ri-external-link-line post-action-ext" aria-hidden="true"
        ></span>
      </a>
    </div>
  </div>

  <button
    type="button"
    class="post-action post-action-immersive"
    data-immersive-toggle
    aria-pressed="false"
    title="切换沉浸阅读（更宽的正文）"
  >
    <span class="i-ri-fullscreen-line" aria-hidden="true"></span>
    <span data-immersive-label>沉浸阅读</span>
  </button>
</div>

<style>
  .post-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .post-action {
    --post-action-hover-color: var(--c-text);

    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--c-border-soft);
    border-radius: 4px;
    background: transparent;
    color: var(--c-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.14s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .post-action:hover,
  .post-action:focus-visible {
    background: transparent;
    color: var(--post-action-hover-color);
    border-color: var(--post-action-hover-color);
  }

  .post-action[data-copy-md] {
    --post-action-hover-color: rgb(251 113 133);

    position: relative;
  }

  .post-action[data-open-trigger] {
    --post-action-hover-color: rgb(250 204 21);
  }

  .post-action[data-immersive-toggle] {
    --post-action-hover-color: rgb(163 230 53);
  }

  .post-action-menu[data-open] .post-action {
    color: var(--post-action-hover-color);
    border-color: var(--post-action-hover-color);
  }

  .post-action:active {
    transform: scale(0.97);
  }

  .copy-tooltip {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    z-index: 30;
    padding: 0.25rem 0.55rem;
    border-radius: 0.35rem;
    background: var(--c-text);
    color: var(--c-bg);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 0.25rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s ease;
  }

  .copy-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    border: 0.3rem solid transparent;
    border-top-color: var(--c-text);
    transform: translateX(-50%);
  }

  .copy-tooltip[data-visible] {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .post-action-caret {
    font-size: 0.9em;
    opacity: 0.6;
    transition: transform 0.2s ease;
  }

  .post-action-menu[data-open] .post-action-caret {
    transform: rotate(180deg);
  }

  .post-action-menu {
    display: inline-flex;
    position: relative;
  }

  .post-action-dropdown {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    z-index: 20;
    min-width: 11rem;
    padding: 0.35rem;
    border: 1px solid var(--c-border-soft);
    border-radius: 0.65rem;
    background: var(--c-bg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .post-action-dropdown[hidden] {
    display: none;
  }

  .post-action-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
    /* Override the global `.prose a` border-bottom that would otherwise
       show as an underline on these dropdown links. */
    border: none !important;
    text-decoration: none;
    border-radius: 0.4rem;
    color: var(--c-text-muted);
    font-size: 0.85rem;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .post-action-item:hover,
  .post-action-item:focus-visible {
    background: var(--c-surface-hover);
    color: var(--c-text);
  }

  .post-action-ext {
    margin-left: auto;
    font-size: 0.9em;
    opacity: 0.5;
  }
</style>
<script>
  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text)
      return
    } catch {
      const textarea = document.createElement('textarea')
      textarea.value = text
      textarea.setAttribute('readonly', '')
      textarea.style.position = 'fixed'
      textarea.style.opacity = '0'
      document.body.append(textarea)
      textarea.select()
      const legacyDocument = document as unknown as {
        execCommand: (commandId: string) => boolean
      }
      const copied = legacyDocument.execCommand('copy')
      textarea.remove()
      if (!copied) throw new Error('Clipboard access denied')
    }
  }

  function initPostActions() {
    const root = document.querySelector<HTMLElement>('[data-post-actions]')
    if (!root || root.dataset.ready === 'true') return
    root.dataset.ready = 'true'

    // --- Copy Markdown ---
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy-md]')
    const copyTooltip = root.querySelector<HTMLElement>('[data-copy-tooltip]')
    if (copyBtn && copyTooltip) {
      let feedbackTimer: number | undefined
      copyBtn.addEventListener('click', async () => {
        window.clearTimeout(feedbackTimer)
        try {
          await copyText(root.dataset.markdown ?? '')
          copyTooltip.textContent = 'Copied'
        } catch {
          copyTooltip.textContent = 'Copy failed'
        }
        copyTooltip.toggleAttribute('data-visible', true)
        feedbackTimer = window.setTimeout(() => {
          copyTooltip.removeAttribute('data-visible')
          copyTooltip.textContent = ''
        }, 1600)
      })
    }

    // --- AI chat deep links ---
    const aiLinks = root.querySelectorAll<HTMLAnchorElement>('[data-ai]')
    const updateAiLinks = () => {
      const title = root.dataset.title ?? ''
      const url = root.dataset.url ?? window.location.href
      const prompt = `请阅读这篇文章并帮我总结要点：《${title}》\n${url}`
      const q = encodeURIComponent(prompt)
      aiLinks.forEach((link) => {
        const provider = link.dataset.ai
        if (provider === 'chatgpt') {
          link.href = `https://chatgpt.com/?q=${q}`
        } else if (provider === 'claude') {
          link.href = `https://claude.ai/new?q=${q}`
        }
      })
    }
    updateAiLinks()

    // --- Dropdown toggle ---
    const menu = root.querySelector<HTMLElement>('[data-open-menu]')
    const trigger = root.querySelector<HTMLButtonElement>('[data-open-trigger]')
    const dropdown = root.querySelector<HTMLElement>('[data-open-dropdown]')
    if (menu && trigger && dropdown) {
      const close = () => {
        menu.removeAttribute('data-open')
        dropdown.hidden = true
        trigger.setAttribute('aria-expanded', 'false')
      }
      const open = () => {
        menu.setAttribute('data-open', '')
        dropdown.hidden = false
        trigger.setAttribute('aria-expanded', 'true')
      }
      trigger.addEventListener('click', (e) => {
        e.stopPropagation()
        updateAiLinks()
        dropdown.hidden ? open() : close()
      })
      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target as Node)) close()
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close()
      })
      // Close after choosing a provider
      dropdown.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => close())
      })
    }

    // --- Immersive reading toggle ---
    const immersiveBtn = root.querySelector<HTMLButtonElement>(
      '[data-immersive-toggle]'
    )
    const immersiveLabel = root.querySelector<HTMLElement>(
      '[data-immersive-label]'
    )
    if (immersiveBtn) {
      const apply = (on: boolean) => {
        document.documentElement.toggleAttribute('data-immersive', on)
        immersiveBtn.setAttribute('aria-pressed', String(on))
        if (immersiveLabel)
          immersiveLabel.textContent = on ? '默认宽度' : '沉浸阅读'
      }
      apply(false)
      let isAnimating = false
      const panelSelector =
        'blog-catalog .category-sidebar, #desktop-aside, .reader-course-panel, .reader-toc-panel'
      const surfaceSelector =
        'geektime-reader .reader-main, #main > header.prose, #main > article.prose'

      const visibleElements = (selector: string) =>
        Array.from(document.querySelectorAll<HTMLElement>(selector)).filter(
          (element) => getComputedStyle(element).display !== 'none'
        )

      const cancelLayoutAnimations = () => {
        for (const element of document.querySelectorAll<HTMLElement>(
          `${panelSelector}, ${surfaceSelector}`
        )) {
          element.getAnimations().forEach((animation) => animation.cancel())
        }
      }

      const animateReadingSurface = (surface: HTMLElement, before: DOMRect) => {
        const after = surface.getBoundingClientRect()
        if (after.width === 0 || before.width === 0) return

        const offsetX = before.left - after.left
        const scaleX = before.width / after.width
        const geometryChanged =
          Math.abs(offsetX) > 0.5 || Math.abs(1 - scaleX) > 0.005

        surface.animate(
          geometryChanged
            ? [
                {
                  opacity: 0.86,
                  transform: `translate3d(${offsetX}px, 0, 0) scaleX(${scaleX})`,
                  transformOrigin: 'top left',
                },
                {
                  opacity: 1,
                  transform: 'translate3d(0, 0, 0) scaleX(1)',
                  transformOrigin: 'top left',
                },
              ]
            : [{ opacity: 0.86 }, { opacity: 1 }],
          {
            duration: 220,
            easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
          }
        )
      }

      const setImmersive = async (on: boolean, allowMotion: boolean) => {
        if (isAnimating) return
        const reduceMotion =
          !allowMotion ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        cancelLayoutAnimations()
        const panels = visibleElements(panelSelector)
        const surfaces = visibleElements(surfaceSelector)
        const surfaceRects = new Map(
          surfaces.map((surface) => [surface, surface.getBoundingClientRect()])
        )

        isAnimating = true
        immersiveBtn.disabled = true
        try {
          if (on && !reduceMotion) {
            const exits = panels.map((panel) => {
              const direction =
                panel.getBoundingClientRect().left < window.innerWidth / 2
                  ? -6
                  : 6
              return panel.animate(
                [
                  { opacity: 1, transform: 'translate3d(0, 0, 0)' },
                  {
                    opacity: 0,
                    transform: `translate3d(${direction}px, 0, 0)`,
                  },
                ],
                {
                  duration: 80,
                  easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
                  fill: 'forwards',
                }
              )
            })
            await Promise.all(
              exits.map((animation) =>
                animation.finished.catch(() => undefined)
              )
            )
          }

          apply(on)
          // A filled exit animation must be removed after the layout switches.
          // Otherwise its opacity: 0 can survive the next toggle and hide the
          // course directory or the article anchors.
          panels.forEach((panel) =>
            panel.getAnimations().forEach((animation) => animation.cancel())
          )

          if (!reduceMotion) {
            surfaceRects.forEach((before, surface) =>
              animateReadingSurface(surface, before)
            )

            if (!on) {
              visibleElements(panelSelector).forEach((panel) => {
                const direction =
                  panel.getBoundingClientRect().left < window.innerWidth / 2
                    ? -6
                    : 6
                panel.animate(
                  [
                    {
                      opacity: 0,
                      transform: `translate3d(${direction}px, 0, 0)`,
                    },
                    { opacity: 1, transform: 'translate3d(0, 0, 0)' },
                  ],
                  {
                    duration: 180,
                    easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
                  }
                )
              })
            }
          }
        } finally {
          isAnimating = false
          immersiveBtn.disabled = false
        }
      }

      immersiveBtn.addEventListener('click', (event) => {
        const on = !document.documentElement.hasAttribute('data-immersive')
        void setImmersive(on, event.detail > 0)
      })
    }
  }

  document.addEventListener('astro:page-load', initPostActions)
</script>
