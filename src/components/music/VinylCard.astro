---
interface Song {
  id: string
  name: string
  url: string
}

interface Album {
  id: string
  name: string
  description: string
  artist: string
  cover: string
  color: string
  songs: Song[]
}

interface Props {
  album: Album
  index: number
}

const { album, index: _index } = Astro.props
---

<div
  class="vinyl-card"
  data-album-id={album.id}
  data-name={album.name}
  data-artist={album.artist}
  data-album={JSON.stringify(album)}
>
  <div class="vinyl-card-inner">
    <!-- 唱片视觉 -->
    <div
      class="vinyl-disc"
      style={`--cover-url: url(${album.cover}); --vinyl-color: ${album.color}; --vinyl-angle: 0rad;`}
    >
      <div class="cover-center" style={`background-image: url(${album.cover})`}>
      </div>
    </div>

    <!-- 唱片信息 -->
    <div class="vinyl-info">
      <h3 class="vinyl-name">{album.name}</h3>
      <p class="vinyl-artist">{album.artist}</p>
      <p class="vinyl-songs-count">{album.songs.length} 首歌曲</p>
    </div>
  </div>

  <!-- 播放状态指示器 -->
  <div class="play-indicator">
    <span class="i-ri-play-circle-fill"></span>
  </div>
</div>

<style>
  .vinyl-card {
    position: relative;
    padding: 0.875rem;
    border-radius: 12px;
    background: rgba(128, 128, 128, 0.06);
    border: 1px solid rgba(128, 128, 128, 0.12);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    user-select: none;
  }

  .vinyl-card:hover {
    background: rgba(128, 128, 128, 0.12);
    border-color: rgba(128, 128, 128, 0.22);
    transform: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .vinyl-card:active {
    transform: scale(0.98);
  }

  .vinyl-card.active {
    background: var(--music-accent-soft, rgba(82, 106, 115, 0.1));
    border-color: var(--music-accent-line, rgba(82, 106, 115, 0.28));
    box-shadow: 0 0 0 2px var(--music-accent-soft, rgba(82, 106, 115, 0.1));
  }

  .vinyl-card-inner {
    display: flex;
    gap: 0.875rem;
    align-items: center;
  }

  .vinyl-disc {
    --vinyl-hover-angle: 0deg;
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      var(--vinyl-color, #1a1a1a) 0%,
      #1a1a1a 100%
    );
    box-shadow:
      inset 0 0 15px rgba(0, 0, 0, 0.5),
      0 2px 8px rgba(0, 0, 0, 0.2);
    flex-shrink: 0;
    transition:
      transform 0.25s ease,
      box-shadow 0.3s ease;
    transform: rotate(
      calc((var(--vinyl-angle, 0rad) * -1) + var(--vinyl-hover-angle, 0deg))
    );
    will-change: transform;
  }

  .vinyl-card:not(.active):hover .vinyl-disc {
    --vinyl-hover-angle: 15deg;
  }

  .vinyl-card.active .vinyl-disc {
    transition: box-shadow 0.3s ease;
  }

  .cover-center {
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.3);
  }

  .cover-center::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(0, 0, 0, 0.2);
    pointer-events: none;
  }

  .vinyl-info {
    flex: 1;
    min-width: 0;
  }

  .vinyl-name {
    font-size: 0.9375rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0 0 0.25rem;
  }

  .vinyl-artist {
    font-size: 0.8125rem;
    opacity: 0.72;
    margin: 0 0 0.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .vinyl-songs-count {
    font-size: 0.75rem;
    opacity: 0.58;
    margin: 0;
  }

  .play-indicator {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity 0.2s ease;
    font-size: 1.5rem;
    color: var(--music-accent, #526a73);
  }

  .vinyl-card:hover .play-indicator {
    opacity: 1;
  }

  .vinyl-card.active .play-indicator {
    opacity: 1;
  }
</style>

<script>
  interface MiniSong {
    name: string
  }

  interface CardMusicState {
  isPlaying: boolean
  isInitialized: boolean
  currentAlbumId?: string | null
  currentPlaybackRate?: number
  currentVinylRotation?: number
  currentSongs?: MiniSong[]
  currentSongIndex?: number
}

  type MusicWindow = Window & {
    MusicPlayerState?: CardMusicState
    __vinylCardSyncBound?: boolean
  }

  function getMusicState() {
    const musicWindow = window as MusicWindow

    if (!musicWindow.MusicPlayerState) {
      musicWindow.MusicPlayerState = {
        isPlaying: false,
        isInitialized: false,
        currentPlaybackRate: 1,
        currentVinylRotation: 0,
      }
    }

    if (musicWindow.MusicPlayerState.currentPlaybackRate == null) {
      musicWindow.MusicPlayerState.currentPlaybackRate = 1
    }

    if (musicWindow.MusicPlayerState.currentVinylRotation == null) {
      musicWindow.MusicPlayerState.currentVinylRotation = 0
    }

    return musicWindow.MusicPlayerState
  }

  function updateActiveVinylCardRotation() {
    const state = getMusicState()
    const rotation = `${state.currentVinylRotation ?? 0}rad`

    document
      .querySelectorAll<HTMLElement>('.vinyl-card.active')
      .forEach((card) => {
        card.style.setProperty('--vinyl-angle', rotation)
      })
  }

  function syncVinylCards() {
    const state = getMusicState()
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('.vinyl-card')
    )
    const fallbackActiveAlbumId =
      document.querySelector<HTMLElement>('.vinyl-card.active')?.dataset
        .albumId ?? null
    const currentAlbumId = state.currentAlbumId ?? fallbackActiveAlbumId
    const currentVinylRotation = `${state.currentVinylRotation ?? 0}rad`

    if (!state.currentAlbumId && currentAlbumId) {
      state.currentAlbumId = currentAlbumId
    }

    cards.forEach((card) => {
      const isCurrent = card.dataset.albumId === currentAlbumId
      card.classList.toggle('active', isCurrent)
      card.classList.toggle('playing', isCurrent && state.isPlaying)
      if (isCurrent) {
        card.style.setProperty('--vinyl-angle', currentVinylRotation)
      } else {
        card.style.removeProperty('--vinyl-angle')
      }
    })
  }

  document.addEventListener('astro:page-load', () => {
    const vinylCards = Array.from(
      document.querySelectorAll<HTMLElement>('.vinyl-card')
    )
    if (!vinylCards.length) return

    const state = getMusicState()
    const musicWindow = window as MusicWindow

    vinylCards.forEach((card) => {
      if (card.dataset.vinylBound === 'true') return
      card.dataset.vinylBound = 'true'

      card.addEventListener('click', () => {
        const albumData = card.getAttribute('data-album')
        if (albumData) {
          const album = JSON.parse(albumData)
          state.currentAlbumId = album.id
          state.isPlaying = false
          syncVinylCards()

          window.dispatchEvent(
            new CustomEvent('album-selected', {
              detail: album,
            })
          )

          setTimeout(() => {
            window.dispatchEvent(
              new CustomEvent('auto-play-album', {
                detail: { album },
              })
            )
          }, 100)
        }
      })
    })

    if (!musicWindow.__vinylCardSyncBound) {
      window.addEventListener('album-selected', ((e: CustomEvent) => {
        const album = e.detail
        if (album?.id) {
          state.currentAlbumId = album.id
          state.isPlaying = false
          syncVinylCards()
        }
      }) as EventListener)

      window.addEventListener('playback-state', ((e: CustomEvent) => {
        const { isPlaying } = e.detail
        state.isPlaying = isPlaying
        syncVinylCards()
      }) as EventListener)

      window.addEventListener('vinyl-rotation', ((e: CustomEvent) => {
        const rotation = Number(
          e.detail?.rotation ?? e.detail ?? state.currentVinylRotation ?? 0
        )
        if (Number.isFinite(rotation)) {
          state.currentVinylRotation = rotation
          updateActiveVinylCardRotation()
        }
      }) as EventListener)

      musicWindow.__vinylCardSyncBound = true
    }

    syncVinylCards()
  })
</script>
