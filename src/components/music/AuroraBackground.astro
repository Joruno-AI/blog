---
// 动态氛围背景: 参考 reactbits Aurora 的流动光斑效果
// 原生 canvas 实现,颜色跟随当前专辑主题色(--album-color)与站点亮暗主题
// 仅在 music 页面激活,离开页面自动暂停
---

<canvas class="music-aurora" id="music-aurora" aria-hidden="true"></canvas>

<style>
  .music-aurora {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: blur(64px) saturate(1.15);
    opacity: 0.55;
    transform: translateZ(0);
    pointer-events: none;
  }
  :global(.dark) .music-aurora {
    opacity: 0.8;
  }
</style>

<script>
  function initAurora() {
    const canvas = document.getElementById(
      'music-aurora'
    ) as HTMLCanvasElement | null
    if (!canvas || canvas.dataset.bound === 'true') return
    canvas.dataset.bound = 'true'

    const ctx = canvas.getContext('2d')
    if (!ctx) return
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

    // 低分辨率绘制,靠 CSS blur 放大成氛围光
    const SCALE = 6
    let w = 0
    let h = 0
    let rafId = 0
    let albumColor = '#2d568d'

    function resize() {
      if (!canvas) return
      w = Math.max(1, Math.round(window.innerWidth / SCALE))
      h = Math.max(1, Math.round(window.innerHeight / SCALE))
      canvas.width = w
      canvas.height = h
    }

    function hexToRgb(hex: string): [number, number, number] {
      const m = /^#?([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i.exec(hex.trim())
      return m
        ? [parseInt(m[1], 16), parseInt(m[2], 16), parseInt(m[3], 16)]
        : [45, 86, 141]
    }

    function mix(
      a: [number, number, number],
      b: [number, number, number],
      t: number
    ): [number, number, number] {
      return [
        Math.round(a[0] + (b[0] - a[0]) * t),
        Math.round(a[1] + (b[1] - a[1]) * t),
        Math.round(a[2] + (b[2] - a[2]) * t),
      ]
    }

    const GOLD: [number, number, number] = [246, 195, 60]
    const WHITE: [number, number, number] = [255, 255, 255]

    // 4 个流动光斑: 位置比例 / 半径比例 / 漂移频率与幅度
    const BLOBS = [
      { x: 0.82, y: 0.08, r: 0.55, fx: 0.11, fy: 0.09, ax: 0.06, ay: 0.05, kind: 'gold' },
      { x: 0.2, y: 0.42, r: 0.48, fx: 0.07, fy: 0.13, ax: 0.08, ay: 0.07, kind: 'album' },
      { x: 0.58, y: 0.78, r: 0.42, fx: 0.09, fy: 0.06, ax: 0.07, ay: 0.06, kind: 'tint' },
      { x: 0.95, y: 0.62, r: 0.38, fx: 0.13, fy: 0.08, ax: 0.05, ay: 0.06, kind: 'gold' },
    ]

    function readAlbumColor() {
      const wrapper = document.getElementById('music-page-wrapper')
      if (!wrapper) return
      const v = getComputedStyle(wrapper).getPropertyValue('--album-color')
      if (v) albumColor = v.trim()
    }

    function draw(time: number) {
      const isDark = document.documentElement.classList.contains('dark')
      const base = hexToRgb(albumColor)
      const t = time / 1000
      ctx!.clearRect(0, 0, w, h)
      ctx!.globalCompositeOperation = isDark ? 'lighter' : 'source-over'

      for (const b of BLOBS) {
        let rgb: [number, number, number]
        if (b.kind === 'gold') rgb = mix(GOLD, base, 0.3)
        else if (b.kind === 'tint') rgb = mix(base, WHITE, 0.35)
        else rgb = base
        if (!isDark) rgb = mix(rgb, WHITE, 0.45)
        const alpha = isDark ? 0.5 : 0.4

        const cx = (b.x + Math.sin(t * b.fx * Math.PI * 2) * b.ax) * w
        const cy = (b.y + Math.cos(t * b.fy * Math.PI * 2) * b.ay) * h
        const r = b.r * Math.max(w, h)
        const g = ctx!.createRadialGradient(cx, cy, 0, cx, cy, r)
        g.addColorStop(0, `rgba(${rgb[0]},${rgb[1]},${rgb[2]},${alpha})`)
        g.addColorStop(1, `rgba(${rgb[0]},${rgb[1]},${rgb[2]},0)`)
        ctx!.fillStyle = g
        ctx!.fillRect(0, 0, w, h)
      }
    }

    function isMusicPage() {
      return /^\/music\/?$/.test(window.location.pathname)
    }

    function loop(time: number) {
      rafId = requestAnimationFrame(loop)
      if (!isMusicPage() || document.hidden) return
      draw(time)
    }

    window.addEventListener('resize', resize)
    window.addEventListener('album-selected', (() => {
      // 等 wrapper 的 --album-color 更新后再读
      window.setTimeout(readAlbumColor, 50)
    }) as EventListener)

    resize()
    readAlbumColor()
    if (reduceMotion.matches) {
      draw(0) // 静态一帧
    } else {
      rafId = requestAnimationFrame(loop)
    }
    window.addEventListener('beforeunload', () => cancelAnimationFrame(rafId))
  }

  document.addEventListener('astro:page-load', initAurora)
  initAurora()
</script>
