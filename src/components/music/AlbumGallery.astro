---
// 专辑长廊: 平面封面长带,支持拖拽/滚轮无缝循环
// 数据来自 /music/data.json (构建期生成)
// 派发: gallery-album-open { album } — 打开曲目面板
// 监听: album-selected — 高亮正在播放的专辑
---

<section class="album-gallery" id="album-gallery" aria-label="专辑长廊">
  <div class="corridor-viewport" id="corridor-viewport">
    <div class="corridor-plane">
      <div class="corridor-band" id="corridor-band"></div>
    </div>
  </div>
</section>

<style>
  .album-gallery {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .corridor-viewport {
    position: absolute;
    inset: 0;
    z-index: 2;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .corridor-viewport.dragging {
    cursor: grabbing;
  }
  .corridor-plane {
    position: absolute;
    top: 65%;
    left: 50%;
    transform: translateY(-50%);
  }
  .corridor-band {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.9rem, 1.45vw, 1.6rem);
    will-change: transform;
  }

  .corridor-band :global(.corridor-cell) {
    position: relative;
    flex: none;
    width: clamp(9.5rem, 14.5vw, 16rem);
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .corridor-band :global(.cell-cover) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: color-mix(in srgb, var(--music-text) 9%, transparent);
    border-radius: 2px;
    box-shadow: 0 1.2rem 2.6rem rgb(0 0 0 / 55%);
    -webkit-box-reflect: below 2px
      linear-gradient(transparent 58%, rgb(0 0 0 / 26%));
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }
  .corridor-band :global(.corridor-cell:hover .cell-cover) {
    transform: translateY(-0.5rem) scale(1.03);
    box-shadow: 0 1.8rem 3.2rem rgb(0 0 0 / 65%);
  }
  .corridor-band :global(.corridor-cell.is-active .cell-cover) {
    outline: none;
    transform: translateY(-0.35rem) scale(1.015);
    box-shadow: 0 1.7rem 3.1rem rgb(0 0 0 / 62%);
  }
  .corridor-band :global(.corridor-cell.is-active .cell-name) {
    color: var(--music-text-strong, #fffaf2);
    font-weight: 650;
  }
  .corridor-band :global(.corridor-cell:focus-visible) {
    outline: none;
  }
  .corridor-band :global(.corridor-cell:focus-visible .cell-name) {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  .corridor-band :global(.cell-name) {
    display: block;
    max-width: 100%;
    overflow: hidden;
    margin-top: 0.45rem;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.72));
    font-size: clamp(0.6rem, 0.85vw, 0.74rem);
    letter-spacing: 0.08em;
    white-space: nowrap;
    text-align: left;
    text-overflow: ellipsis;
  }

  @media (max-width: 1180px) {
    .corridor-plane {
      top: 60%;
    }
  }

  @media (max-width: 880px) {
    .corridor-plane {
      top: 58%;
    }
  }

  /* 播放后舞台底部出现控制条，唱片长廊同步下移，为歌词留出稳定呼吸区。 */
  @media (min-width: 961px) {
    :global(#music-page-wrapper.has-album) .corridor-plane {
      top: 69%;
    }
  }

  @media (min-width: 768px) and (max-width: 960px) {
    :global(#music-page-wrapper.has-album) .corridor-plane {
      top: 74%;
    }
  }

  @media (max-width: 767px) {
    .corridor-plane {
      top: 68%;
      transform: translateY(-50%);
    }
    .corridor-band :global(.corridor-cell) {
      width: clamp(8rem, 44vw, 10.75rem);
    }
    :global(#music-page-wrapper.has-album) .corridor-plane {
      top: 74%;
    }
  }

  @media (max-width: 767px) and (max-height: 700px) {
    .corridor-plane {
      top: 82%;
    }
    :global(#music-page-wrapper.has-album) .corridor-plane {
      top: 75%;
    }
    .corridor-band :global(.corridor-cell) {
      width: clamp(7rem, 38vw, 9rem);
    }
  }

  @media (min-width: 768px) and (max-height: 520px) {
    .corridor-band :global(.corridor-cell) {
      width: clamp(7.5rem, 12vw, 9rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .corridor-band :global(.cell-cover) {
      transition: none;
    }
  }
</style>

<script>
  interface GallerySong {
    id: string
    name: string
    duration: string
    url: string | null
    hasLyrics: boolean
  }
  interface GalleryAlbum {
    id: string
    name: string
    artist: string
    description: string | null
    cover: string | null
    color: string
    releaseDate: string | null
    songs: GallerySong[]
  }

  let albumsCache: GalleryAlbum[] | null = null
  let albumsPromise: Promise<GalleryAlbum[]> | null = null

  function galleryCover(cover: string | null): string {
    if (!cover) return ''
    return cover.replace(/\/\d+x\d+bb\.(jpe?g|png|webp)$/i, '/360x360bb.$1')
  }

  function fetchAlbums(): Promise<GalleryAlbum[]> {
    if (albumsCache) return Promise.resolve(albumsCache)
    if (!albumsPromise) {
      albumsPromise = fetch('/music/data.json')
        .then((r) => r.json())
        .then((d) => {
          albumsCache = d.albums as GalleryAlbum[]
          return albumsCache
        })
        .catch((e) => {
          albumsPromise = null
          throw e
        })
    }
    return albumsPromise
  }

  function isMusicPage() {
    return /^\/music\/?$/.test(window.location.pathname)
  }

  function applyAtmosphere(album: GalleryAlbum) {
    const wrapper = document.getElementById('music-page-wrapper')
    if (!wrapper) return
    const albumColor = album.color || '#1a1a2e'
    wrapper.style.setProperty('--album-color', albumColor)
    document.documentElement.style.setProperty(
      '--music-album-color',
      albumColor
    )
    if (album.cover)
      wrapper.style.setProperty('--album-cover', `url("${album.cover}")`)
  }

  function openAlbum(
    album: GalleryAlbum,
    sourceEl?: HTMLElement,
    autoPlay = false
  ) {
    applyAtmosphere(album)
    const sourceRect = sourceEl?.getBoundingClientRect()
    window.dispatchEvent(
      new CustomEvent('gallery-album-open', {
        detail: { album, sourceRect, autoPlay },
      })
    )
  }

  function initGallery() {
    const root = document.getElementById('album-gallery')
    const viewport = document.getElementById('corridor-viewport')
    const bandEl = document.getElementById('corridor-band')
    if (!root || !viewport || !bandEl) return
    if (root.dataset.bound === 'true') return
    root.dataset.bound = 'true'
    const band = bandEl

    let albums: GalleryAlbum[] = []
    let cycleWidth = 0
    let offset = 0
    let velocity = 0
    let dragging = false
    let lastX = 0
    let dragTravel = 0
    let pressedCell: HTMLElement | null = null
    let lastInteract = 0
    let rafId = 0
    let lastFrame = 0
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

    function buildCells() {
      const frag = document.createDocumentFragment()
      // 三份轨道让视口始终停留在中间副本，左右都有完整缓冲。
      for (let copy = 0; copy < 3; copy++) {
        albums.forEach((album) => {
          const cell = document.createElement('button')
          cell.type = 'button'
          cell.className = 'corridor-cell'
          cell.dataset.albumId = album.id
          cell.dataset.copy = String(copy)
          if (copy !== 1) cell.setAttribute('aria-hidden', 'true')
          if (copy !== 1) cell.tabIndex = -1
          cell.innerHTML = `
            <img class="cell-cover" src="${galleryCover(album.cover)}" alt="${album.name}" loading="lazy" decoding="async" draggable="false" />
            <span class="cell-name">${album.name} · ${album.artist}</span>`
          cell.addEventListener('click', (event) => {
            // Pointer activation is handled on pointerup because the viewport
            // owns pointer capture while dragging. Keep click for keyboard use.
            if (event.detail !== 0 || dragTravel > 6) return
            const cover = cell.querySelector<HTMLElement>('.cell-cover')
            openAlbum(album, cover ?? cell, true)
          })
          frag.appendChild(cell)
        })
      }
      band.replaceChildren(frag)
      measure()
    }

    function measure() {
      const firstCopy = band.querySelector<HTMLElement>(
        '.corridor-cell[data-copy="0"]'
      )
      const middleCopy = band.querySelector<HTMLElement>(
        '.corridor-cell[data-copy="1"]'
      )
      cycleWidth =
        firstCopy && middleCopy
          ? middleCopy.offsetLeft - firstCopy.offsetLeft
          : band.scrollWidth / 3
      if (cycleWidth) offset = ((offset % cycleWidth) + cycleWidth) % cycleWidth
    }

    function tick(time: number) {
      rafId = 0
      if (document.hidden || !isMusicPage()) return
      if (!cycleWidth) return
      const frameInterval = window.innerWidth <= 767 ? 1000 / 24 : 1000 / 30
      if (lastFrame && time - lastFrame < frameInterval) {
        rafId = requestAnimationFrame(tick)
        return
      }
      const elapsed = lastFrame ? time - lastFrame : frameInterval
      const frameScale = Math.min(2.5, elapsed / (1000 / 60))
      lastFrame = time
      if (!dragging) {
        offset += velocity * frameScale
        velocity *= Math.pow(0.94, frameScale)
        if (Math.abs(velocity) < 0.02) velocity = 0
        // 闲置 3 秒后缓慢自动漂移
        if (
          !reduceMotion.matches &&
          velocity === 0 &&
          performance.now() - lastInteract > 3000
        ) {
          offset += 0.3 * frameScale
        }
      }
      offset = ((offset % cycleWidth) + cycleWidth) % cycleWidth
      band.style.transform = `translate3d(${-(cycleWidth + offset)}px, 0, 0)`
      rafId = requestAnimationFrame(tick)
    }

    function startMotion() {
      if (rafId || document.hidden || !isMusicPage()) return
      rafId = requestAnimationFrame(tick)
    }

    function stopMotion() {
      if (!rafId) return
      cancelAnimationFrame(rafId)
      rafId = 0
      lastFrame = 0
    }

    function syncMotion() {
      if (document.hidden || !isMusicPage()) stopMotion()
      else {
        measure()
        startMotion()
      }
    }

    viewport.addEventListener('pointerdown', (e) => {
      dragging = true
      dragTravel = 0
      pressedCell = (e.target as Element | null)?.closest(
        '.corridor-cell'
      ) as HTMLElement | null
      lastX = e.clientX
      velocity = 0
      lastInteract = performance.now()
      viewport.classList.add('dragging')
      viewport.setPointerCapture(e.pointerId)
    })
    viewport.addEventListener('pointermove', (e) => {
      if (!dragging) return
      const dx = e.clientX - lastX
      lastX = e.clientX
      dragTravel += Math.abs(dx)
      offset -= dx
      velocity = -dx
      lastInteract = performance.now()
    })
    const endDrag = (e: PointerEvent, activate: boolean) => {
      const cell = pressedCell
      const shouldOpen = activate && dragTravel <= 6 && Boolean(cell)
      dragging = false
      pressedCell = null
      viewport.classList.remove('dragging')
      if (viewport.hasPointerCapture(e.pointerId)) {
        viewport.releasePointerCapture(e.pointerId)
      }
      if (shouldOpen && cell) {
        const album = albums.find((item) => item.id === cell.dataset.albumId)
        if (album) {
          const cover = cell.querySelector<HTMLElement>('.cell-cover')
          openAlbum(album, cover ?? cell, true)
        }
      }
    }
    viewport.addEventListener('pointerup', (e) => endDrag(e, true))
    viewport.addEventListener('pointercancel', (e) => endDrag(e, false))
    viewport.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault()
        const delta =
          Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY
        velocity += delta * 0.08
        lastInteract = performance.now()
      },
      { passive: false }
    )
    window.addEventListener('resize', measure)
    document.addEventListener('visibilitychange', syncMotion)
    document.addEventListener('astro:page-load', syncMotion)

    window.addEventListener('album-selected', ((e: CustomEvent) => {
      const id = e.detail?.id
      band.querySelectorAll('.corridor-cell').forEach((cell) => {
        cell.classList.toggle(
          'is-active',
          (cell as HTMLElement).dataset.albumId === id
        )
      })
    }) as EventListener)

    fetchAlbums()
      .then((data) => {
        albums = data
        buildCells()
        startMotion()
      })
      .catch((e) => console.error('[gallery] failed to load albums:', e))
  }

  function activateWhenOnMusicPage() {
    if (isMusicPage()) initGallery()
  }
  document.addEventListener('astro:page-load', activateWhenOnMusicPage)
  activateWhenOnMusicPage()
</script>
