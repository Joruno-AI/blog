</style>

<script>
  interface StageSong {
    id: string
    name: string
    duration: string
    url: string | null
    hasLyrics: boolean
    quality?: {
      incomplete: boolean
      lyricsMismatch: boolean
      actualSeconds: number
      expectedSeconds: number
      studioStatus: string
      fingerprintSimilarity: number | null
      lyricsAlignmentStatus: string
    } | null
  }
  interface StageAlbum {
    id: string
    name: string
    artist: string
    description: string | null
    cover: string | null
    color: string
    releaseDate: string | null
    songs: StageSong[]
  }
  interface LyricLine {
    t: number
    text: string
  }

  function parseLrc(lrc: string): LyricLine[] {
    const out: LyricLine[] = []
    for (const raw of lrc.split('\n')) {
      const tags = [...raw.matchAll(/\[(\d+):(\d+(?:\.\d+)?)\]/g)]
      if (!tags.length) continue
      const text = raw.replace(/\[[^\]]*\]/g, '').trim()
      if (!text) continue
      for (const m of tags) {
        out.push({ t: Number(m[1]) * 60 + Number(m[2]), text })
      }
    }
    return out.sort((a, b) => a.t - b.t)
  }

  function initNowPlaying() {
    const stage = document.getElementById('now-playing-stage')
    if (!stage || stage.dataset.bound === 'true') return
    stage.dataset.bound = 'true'

    const vinyl = document.getElementById('stage-vinyl')
    const stageLeft = stage.querySelector<HTMLElement>('.stage-left')
    // 唱臂点击 = 播放/暂停(有已选专辑时)
    document.getElementById('tonearm')?.addEventListener('click', () => {
      if (playingAlbum) window.dispatchEvent(new CustomEvent('toggle-play'))
    })
    const vinylLabel = document.getElementById('vinyl-label')
    const panel = document.getElementById('track-panel')
    const panelBody = document.getElementById('track-panel-body')
    const panelCover = document.getElementById(
      'panel-cover'
    ) as HTMLImageElement | null
    const panelTitle = document.getElementById('panel-title')
    const panelSub = document.getElementById('panel-sub')
    const panelPlayAll = document.getElementById(
      'panel-play-all'
    ) as HTMLButtonElement | null
    const panelTracks = document.getElementById('panel-tracks')
    const lyricsEmpty = document.getElementById('lyrics-empty')
    const lyricsScroll = document.getElementById('lyrics-scroll')
    const listeningIntro = document.getElementById('listening-intro')
    const recordContext = document.getElementById('record-context')
    const recordContextTitle = document.getElementById('record-context-title')
    const recordContextMeta = document.getElementById('record-context-meta')
    const recordContextDescription = document.getElementById(
      'record-context-description'
    )

    let panelAlbum: StageAlbum | null = null
    let playingAlbum: StageAlbum | null = null
    let lyricsMap: Record<string, string> = {}
    let currentLines: LyricLine[] = []
    let currentLineIndex = -1
    let currentSongId: string | null = null
    let selectedLyricIndex = -1
    let lyricSelectionTimer = 0
    const mobileLyricSeekQuery = window.matchMedia('(max-width: 767px)')

    const musicWrapper = document.getElementById('music-page-wrapper')
    let fitFrame = 0
    let fitSettleTimer = 0

    function updateIntroGalleryFlow(hasAlbum: boolean) {
      if (!musicWrapper || !stage || !listeningIntro) return
      const corridorPlane = document.querySelector<HTMLElement>(
        '#album-gallery .corridor-plane'
      )
      if (!corridorPlane) return

      if (hasAlbum) {
        corridorPlane.style.removeProperty('top')
        musicWrapper.style.removeProperty('--music-intro-stage-height')
        return
      }

      const stageRect = stage.getBoundingClientRect()
      const introRect = listeningIntro.getBoundingClientRect()
      const firstCell = corridorPlane.querySelector<HTMLElement>(
        '.corridor-cell[data-copy="1"]'
      )
      if (!firstCell || introRect.height <= 0) return
      const cellRect = firstCell.getBoundingClientRect()
      if (cellRect.height <= 0) return

      const width = stage.clientWidth || window.innerWidth
      const gap = width <= 767 ? 28 : width <= 960 ? 40 : 48
      const introBottom = introRect.bottom - stageRect.top
      const targetCardTop = introBottom + gap
      const currentCardTop = cellRect.top - stageRect.top
      const currentCorridorTop =
        Number.parseFloat(getComputedStyle(corridorPlane).top) || 0
      const corridorTop = Math.ceil(
        currentCorridorTop + targetCardTop - currentCardTop
      )
      const reflectionRoom = Math.min(120, cellRect.height * 0.55)
      const requiredHeight = Math.ceil(
        targetCardTop + cellRect.height + reflectionRoom + 48
      )

      const nextTop = `${corridorTop}px`
      const nextHeight = `${requiredHeight}px`
      if (corridorPlane.style.top !== nextTop) corridorPlane.style.top = nextTop
      if (
        musicWrapper.style.getPropertyValue('--music-intro-stage-height') !==
        nextHeight
      ) {
        musicWrapper.style.setProperty('--music-intro-stage-height', nextHeight)
      }
    }

    function updatePlayerVerticalFit() {
      if (!musicWrapper || !stage || !stageLeft) return
      musicWrapper.style.removeProperty('--stage-player-max-size')
      if (!musicWrapper.classList.contains('has-album')) return

      const firstCell = document.querySelector<HTMLElement>(
        '#album-gallery .corridor-cell[data-copy="1"]'
      )
      if (!firstCell) return

      const stageRect = stage.getBoundingClientRect()
      const playerRect = stageLeft.getBoundingClientRect()
      const cellRect = firstCell.getBoundingClientRect()
      const availableHeight = Math.floor(
        Math.min(cellRect.top - 12, stageRect.bottom - 12) - playerRect.top
      )
      musicWrapper.style.setProperty(
        '--stage-player-max-size',
        `${Math.max(64, availableHeight)}px`
      )
    }

    function updateRecordDescriptionFit() {
      if (!musicWrapper || !stage || !recordContextDescription) return
      musicWrapper.classList.remove(
        'stage-hide-description',
        'stage-description-clipped'
      )
      musicWrapper.style.removeProperty('--record-description-max-height')

      if (
        !musicWrapper.classList.contains('has-album') ||
        musicWrapper.classList.contains('stage-hide-intro')
      )
        return

      const firstCell = document.querySelector<HTMLElement>(
        '#album-gallery .corridor-cell[data-copy="1"]'
      )
      if (!firstCell) return

      const stageRect = stage.getBoundingClientRect()
      const cellRect = firstCell.getBoundingClientRect()
      const descriptionRect = recordContextDescription.getBoundingClientRect()
      const metaBottom = recordContextMeta?.getBoundingClientRect().bottom ?? 0
      const lineHeight =
        Number.parseFloat(
          getComputedStyle(recordContextDescription).lineHeight
        ) || 24
      const bottomLimit = Math.min(cellRect.top - 20, stageRect.bottom - 16)
      const availableHeight = Math.floor(bottomLimit - descriptionRect.top)
      const minimumHeight = Math.ceil(lineHeight * 2.2)

      if (bottomLimit <= metaBottom + 12) {
        musicWrapper.classList.add('stage-hide-intro')
        return
      }

      if (availableHeight < minimumHeight) {
        musicWrapper.classList.add('stage-hide-description')
        return
      }

      musicWrapper.style.setProperty(
        '--record-description-max-height',
        `${availableHeight}px`
      )
      musicWrapper.classList.toggle(
        'stage-description-clipped',
        recordContextDescription.scrollHeight > availableHeight + 1
      )
    }

    function updateStageFit() {
      if (!musicWrapper || !stage || !stageLeft) return
      musicWrapper.classList.remove(
        'stage-compact-intro',
        'stage-hide-intro',
        'stage-hide-vinyl',
        'stage-hide-lyrics',
        'stage-hide-description',
        'stage-description-clipped'
      )
      musicWrapper.style.removeProperty('--record-description-max-height')
      musicWrapper.style.removeProperty('--stage-player-max-size')

      const width = stage.clientWidth || window.innerWidth
      const hasAlbum = musicWrapper.classList.contains('has-album')
      if (width <= 767) {
        musicWrapper.classList.toggle('stage-hide-intro', hasAlbum)
        updateIntroGalleryFlow(hasAlbum)
        updatePlayerVerticalFit()
        return
      }

      // 尚未选择专辑时只存在导语和长廊，不用未显示的歌词/唱片参与宽度压缩。
      if (!hasAlbum) {
        musicWrapper.style.removeProperty('--stage-intro-fit')
        updateIntroGalleryFlow(false)
        return
      }

      updateIntroGalleryFlow(true)
      updatePlayerVerticalFit()

      const stageRect = stage.getBoundingClientRect()
      const playerRect = stageLeft.getBoundingClientRect()
      const introInset = Math.max(48, Math.min(104, width * 0.06))
      const sectionGap = Math.max(28, width * 0.025)
      const availableIntroWidth = Math.floor(
        playerRect.left - stageRect.left - introInset - sectionGap
      )
      const minimumIntroWidth = 240
      const preferredIntroWidth = Math.min(544, width * 0.38)
      const hideIntro = availableIntroWidth < minimumIntroWidth
      const compactIntro =
        !hideIntro && availableIntroWidth < preferredIntroWidth

      musicWrapper.style.setProperty(
        '--stage-intro-fit',
        `${Math.max(minimumIntroWidth, Math.min(544, availableIntroWidth))}px`
      )
      musicWrapper.classList.toggle('stage-compact-intro', compactIntro)
      musicWrapper.classList.toggle('stage-hide-intro', hideIntro)
      updateRecordDescriptionFit()
    }
    function scheduleStageFit() {
      cancelAnimationFrame(fitFrame)
      window.clearTimeout(fitSettleTimer)
      fitFrame = requestAnimationFrame(() => {
        updateStageFit()
        // Viewport media queries can resize the gallery one frame after the
        // resize event. Measure again on the next frame so dragging never
        // exposes a stale lyric height between breakpoints.
        fitFrame = requestAnimationFrame(updateStageFit)
      })
      fitSettleTimer = window.setTimeout(() => {
        cancelAnimationFrame(fitFrame)
        fitFrame = requestAnimationFrame(updateStageFit)
      }, 620)
    }

    const fitObserver = new ResizeObserver(scheduleStageFit)
    fitObserver.observe(stage)
    if (listeningIntro) fitObserver.observe(listeningIntro)
    const corridorPlane = document.querySelector<HTMLElement>(
      '#album-gallery .corridor-plane'
    )
    if (corridorPlane) fitObserver.observe(corridorPlane)
    window.addEventListener('resize', scheduleStageFit)
    scheduleStageFit()

    function renderRecordContext(album: StageAlbum) {
      if (recordContextTitle) recordContextTitle.textContent = album.name
      if (recordContextMeta) {
        const year = album.releaseDate?.slice(0, 4)
        const trackCount = album.songs.length
          ? `${album.songs.length} 首曲目`
          : null
        recordContextMeta.textContent = [album.artist, year, trackCount]
          .filter(Boolean)
          .join(' · ')
      }
      if (recordContextDescription) {
        recordContextDescription.textContent = album.description?.trim() ?? ''
      }
      recordContext?.classList.add('has-album')
      recordContext?.setAttribute('aria-hidden', 'false')
      listeningIntro?.classList.add('is-hidden')
      listeningIntro?.setAttribute('aria-hidden', 'true')
    }

    function setPanelAvailable(available: boolean) {
      panel?.classList.toggle('is-available', available)
      if (!available) setPanelOpen(false)
    }

    function setPanelOpen(open: boolean) {
      if (open && !panel?.classList.contains('is-available')) return
      panel?.classList.toggle('is-open', open)
      panelBody?.setAttribute('aria-hidden', String(!open))
      if (panelBody) panelBody.inert = !open
      document
        .getElementById('track-panel-handle')
        ?.setAttribute('aria-expanded', String(open))
    }

    let lyricsRequestId = 0

    function formatLyricTime(seconds: number) {
      const safeSeconds = Math.max(0, Math.floor(seconds))
      return `${String(Math.floor(safeSeconds / 60)).padStart(2, '0')}:${String(safeSeconds % 60).padStart(2, '0')}`
    }

    function clearLyricSeekSelection() {
      window.clearTimeout(lyricSelectionTimer)
      lyricSelectionTimer = 0
      selectedLyricIndex = -1
      lyricsScroll
        ?.querySelectorAll<HTMLElement>('.lyric-line-shell')
        .forEach((shell) => shell.classList.remove('is-seek-selected'))
    }

    function selectLyricForSeek(index: number) {
      clearLyricSeekSelection()
      selectedLyricIndex = index
      lyricsScroll
        ?.querySelectorAll<HTMLElement>('.lyric-line-shell')
        [index]?.classList.add('is-seek-selected')
      lyricSelectionTimer = window.setTimeout(clearLyricSeekSelection, 5000)
    }

    mobileLyricSeekQuery.addEventListener('change', clearLyricSeekSelection)

    async function loadLyricsMap(album: StageAlbum) {
      const requestId = ++lyricsRequestId
      lyricsMap = {}
      if (!album.songs.some((s) => s.hasLyrics)) return
      try {
        const res = await fetch(`/music/lyrics/${album.id}.json`)
        if (res.ok && requestId === lyricsRequestId) {
          lyricsMap = await res.json()
          if (playingAlbum?.id === album.id && currentSongId) {
            renderLyrics(currentSongId)
          }
        }
      } catch (e) {
        console.warn('[lyrics] load failed:', e)
      }
    }

    function renderLyrics(songId: string) {
      clearLyricSeekSelection()
      currentSongId = songId
      currentLineIndex = -1
      const lrc = lyricsMap[songId]
      currentLines = lrc ? parseLrc(lrc) : []
      if (!lyricsScroll || !lyricsEmpty) return
      if (!currentLines.length) {
        lyricsScroll.replaceChildren()
        const song = playingAlbum?.songs.find((item) => item.id === songId)
        lyricsEmpty.textContent = song?.quality?.lyricsMismatch
          ? '当前音源版本与歌词时间轴不一致'
          : song?.quality?.lyricsAlignmentStatus === 'lyrics-incomplete'
            ? '歌词内容不完整，暂不展示'
            : song?.quality?.lyricsAlignmentStatus === 'timing-review'
              ? '歌词时间轴待校准，暂不展示'
              : song?.quality?.lyricsAlignmentStatus === 'lyrics-mismatch'
                ? '歌词与当前录音室音源不匹配'
                : playingAlbum
                  ? '这首作品暂未收录歌词'
                  : ''
        lyricsEmpty.style.display = playingAlbum ? '' : 'none'
        return
      }
      lyricsEmpty.style.display = 'none'
      const frag = document.createDocumentFragment()
      const countdown = document.createElement('div')
      countdown.className = 'lyric-countdown'
      countdown.setAttribute('aria-hidden', 'true')
      for (let i = 0; i < 3; i++) {
        const dot = document.createElement('span')
        dot.className = 'countdown-dot'
        countdown.appendChild(dot)
      }
      frag.appendChild(countdown)
      currentLines.forEach((line, i) => {
        const shell = document.createElement('div')
        shell.className = 'lyric-line-shell'
        const el = document.createElement('button')
        el.type = 'button'
        el.className = 'lyric-line'
        el.textContent = line.text
        el.setAttribute(
          'aria-label',
          `${line.text}，${formatLyricTime(line.t)}`
        )
        el.addEventListener('click', () => {
          if (mobileLyricSeekQuery.matches) {
            selectLyricForSeek(i)
            return
          }
          window.dispatchEvent(
            new CustomEvent('seek-to-time', { detail: currentLines[i].t })
          )
        })

        const time = document.createElement('span')
        time.className = 'lyric-seek-time'
        time.textContent = formatLyricTime(line.t)
        time.setAttribute('aria-hidden', 'true')

        const confirm = document.createElement('button')
        confirm.type = 'button'
        confirm.className = 'lyric-seek-confirm'
        confirm.setAttribute(
          'aria-label',
          `从 ${formatLyricTime(line.t)} 播放《${line.text}》`
        )
        confirm.innerHTML =
          '<span class="i-ri-play-fill" aria-hidden="true"></span>'
        confirm.addEventListener('click', () => {
          window.dispatchEvent(
            new CustomEvent('seek-to-time', { detail: currentLines[i].t })
          )
          clearLyricSeekSelection()
        })

        shell.append(el, time, confirm)
        frag.appendChild(shell)
      })
      lyricsScroll.replaceChildren(frag)
      lyricsScroll.scrollTop = 0
    }

    function updateLyricCountdown(time: number) {
      if (!lyricsScroll || !currentLines.length) return
      const countdown =
        lyricsScroll.querySelector<HTMLElement>('.lyric-countdown')
      if (!countdown) return
      const remaining = currentLines[0].t - time
      const visible = remaining > 0.25 && remaining <= 3.4
      countdown.classList.toggle('is-visible', visible)
      const activeDots = visible
        ? Math.max(0, Math.min(3, 4 - Math.ceil(remaining)))
        : 0
      countdown.querySelectorAll('.countdown-dot').forEach((dot, index) => {
        dot.classList.toggle('is-active', index < activeDots)
      })
    }

    function syncLyrics(time: number) {
      if (!currentLines.length || !lyricsScroll) return
      updateLyricCountdown(time)
      let idx = -1
      for (let i = 0; i < currentLines.length; i++) {
        if (currentLines[i].t <= time + 0.25) idx = i
        else break
      }
      if (idx === currentLineIndex) return
      currentLineIndex = idx
      const nodes = lyricsScroll.querySelectorAll<HTMLElement>('.lyric-line')
      for (let i = 0; i < nodes.length; i++) {
        nodes[i].classList.toggle('is-current', i === idx)
      }
      if (idx >= 0) {
        const el = nodes[idx]
        if (selectedLyricIndex >= 0 && mobileLyricSeekQuery.matches) return
        const scrollTarget = el.closest<HTMLElement>('.lyric-line-shell') ?? el
        const centeredTop =
          scrollTarget.offsetTop -
          (lyricsScroll.clientHeight - scrollTarget.offsetHeight) / 2
        const maxScrollTop = Math.max(
          0,
          lyricsScroll.scrollHeight - lyricsScroll.clientHeight
        )
        lyricsScroll.scrollTo({
          // Keep regular lines centred, then progressively clamp the final
          // lines so the lyric content finishes at the bottom without a gap.
          top: Math.min(Math.max(0, centeredTop), maxScrollTop),
          behavior: 'smooth',
        })
      }
    }

    function renderPanel(album: StageAlbum) {
      panelAlbum = album
      if (panelCover) {
        panelCover.src = album.cover || '/joruno.png'
        panelCover.alt = `${album.name} 专辑封面`
      }
      if (panelTitle) panelTitle.textContent = album.name
      if (panelSub) {
        const year = album.releaseDate?.slice(0, 4)
        panelSub.textContent = [album.artist, year && `${year}年`]
          .filter(Boolean)
          .join(' · ')
      }
      const playable = album.songs.some((s) => s.url)
      if (panelPlayAll) {
        panelPlayAll.disabled = !playable
        panelPlayAll.innerHTML = playable
          ? '<span class="i-ri-play-fill"></span> 播放专辑'
          : '音频待补充'
      }
      if (panelTracks) {
        const frag = document.createDocumentFragment()
        album.songs.forEach((song, i) => {
          const li = document.createElement('li')
          const row = document.createElement('button')
          row.type = 'button'
          row.className = 'track-row'
          row.dataset.songId = song.id
          if (!song.url) row.classList.add('is-disabled')
          const qualityTag =
            song.quality?.studioStatus === 'wrong-version'
              ? '非录音室版本'
              : song.quality?.studioStatus === 'correct-master-wrong-length'
                ? '音源长度异常'
                : song.quality?.studioStatus === 'probable-version-match'
                  ? '版本待复核'
                  : song.quality?.studioStatus === 'fingerprint-failed'
                    ? '版本校验失败'
                    : song.quality?.incomplete
                      ? '音源不完整'
                      : song.quality?.lyricsMismatch
                        ? '歌词待校准'
                        : song.quality?.lyricsAlignmentStatus ===
                            'lyrics-incomplete'
                          ? '歌词不完整'
                          : song.quality?.lyricsAlignmentStatus ===
                              'timing-review'
                            ? '时间轴待校准'
                            : song.quality?.lyricsAlignmentStatus ===
                                'lyrics-mismatch'
                              ? '歌词待校准'
                              : !song.url
                                ? '待补音频'
                                : ''
          row.innerHTML = `
            <span class="track-no">${String(i + 1).padStart(2, '0')}</span>
            <span class="track-name">${song.name}</span>
            ${qualityTag ? `<span class="track-tag">${qualityTag}</span>` : ''}
            <span class="track-dur">${song.duration}</span>`
          if (song.url) {
            row.addEventListener('click', () => playTrack(album, i))
          }
          li.appendChild(row)
          frag.appendChild(li)
        })
        panelTracks.replaceChildren(frag)
        panelTracks.scrollTop = 0
      }
    }

    let vinylFlightId = 0
    let activeVinylGhost: HTMLElement | null = null
    let activeVinylAnimation: Animation | null = null

    function waitForStageLayout() {
      return new Promise<void>((resolve) => {
        requestAnimationFrame(() => requestAnimationFrame(() => resolve()))
      })
    }

    // 黑胶飞行: 先等响应式舞台完成布局，再从封面飞向真实唱机位。
    async function flyVinylFrom(sourceRect: DOMRect, cover: string | null) {
      if (!vinyl) return Promise.resolve()
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches
      if (reduceMotion) return Promise.resolve()

      const flightId = ++vinylFlightId
      activeVinylAnimation?.cancel()
      activeVinylGhost?.remove()
      activeVinylAnimation = null
      activeVinylGhost = null
      vinyl.style.opacity = '0'

      await waitForStageLayout()
      if (flightId !== vinylFlightId) return

      const target = vinyl.getBoundingClientRect()
      const size = Math.min(sourceRect.width, sourceRect.height)
      if (size <= 0 || target.width <= 0 || target.height <= 0) {
        vinyl.style.opacity = ''
        return
      }
      const ghost = document.createElement('div')
      activeVinylGhost = ghost
      ghost.className = 'vinyl-ghost'
      ghost.style.cssText = `
        position: fixed; z-index: 200; pointer-events: none;
        left: ${sourceRect.left + sourceRect.width / 2 - size / 2}px;
        top: ${sourceRect.top + sourceRect.height / 2 - size / 2}px;
        width: ${size}px; height: ${size}px; border-radius: 50%;
        background:
          radial-gradient(circle at 50% 50%, transparent 0 17%, rgb(0 0 0 / 35%) 18% 19%, transparent 20%),
          repeating-radial-gradient(circle, rgba(255,255,255,0.05) 0 1px, transparent 1px 4px),
          radial-gradient(circle, #202124 0 26%, #0d0e10 27% 100%);
        box-shadow: 0 1rem 2.4rem rgb(0 0 0 / 55%);`
      const label = document.createElement('div')
      label.style.cssText = `
        position: absolute; inset: 31%; border-radius: 50%;
        background: ${cover ? `url("${cover}") center/cover` : 'var(--album-color, #333)'};
        box-shadow: inset 0 0 0 2px rgb(0 0 0 / 35%);`
      ghost.appendChild(label)
      document.body.appendChild(ghost)

      const dx =
        target.left +
        target.width / 2 -
        (sourceRect.left + sourceRect.width / 2)
      const dy =
        target.top +
        target.height / 2 -
        (sourceRect.top + sourceRect.height / 2)
      const scale = target.width / size
      const distance = Math.hypot(dx, dy)
      const arcLift = Math.min(86, Math.max(28, distance * 0.14))
      const duration = Math.min(1120, Math.max(860, 760 + distance * 0.42))

      const anim = ghost.animate(
        [
          { transform: 'translate(0, 0) rotate(0deg) scale(1)', opacity: 1 },
          {
            transform: `translate(${dx * 0.52}px, ${dy * 0.52 - arcLift}px) rotate(190deg) scale(${(1 + scale) / 2})`,
            opacity: 1,
            offset: 0.52,
          },
          {
            transform: `translate(${dx}px, ${dy}px) rotate(360deg) scale(${scale})`,
            opacity: 1,
          },
        ],
        { duration, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' }
      )
      activeVinylAnimation = anim
      try {
        await anim.finished
      } catch (err) {
        // 动画被中断(如快速连点)属正常,吞掉即可
        void err
      }

      ghost.remove()
      if (flightId !== vinylFlightId) return
      activeVinylGhost = null
      activeVinylAnimation = null
      vinyl.style.opacity = ''
      vinyl.animate(
        [
          { transform: 'scale(0.96)', opacity: 0.72 },
          { transform: 'scale(1)', opacity: 1 },
        ],
        { duration: 280, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
      )
    }

    // 音符飘出: 播放时定时从黑胶顶部生成音符
    const NOTE_GLYPHS = ['♪', '♫', '♩', '♬']
    let noteTimer = 0
    function startNotes() {
      if (noteTimer) return
      const notesBox = document.getElementById('vinyl-notes')
      if (!notesBox) return
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches
      if (reduceMotion) return
      const spawn = () => {
        const note = document.createElement('span')
        note.className = 'note'
        note.textContent =
          NOTE_GLYPHS[Math.floor(Math.random() * NOTE_GLYPHS.length)]
        const dur = 2.2 + Math.random() * 1.6
        note.style.setProperty('--note-dur', `${dur}s`)
        note.style.setProperty(
          '--note-dx',
          `${(Math.random() * 2 - 0.6) * 3.4}rem`
        )
        note.style.setProperty(
          '--note-rot',
          `${(Math.random() * 2 - 1) * 32}deg`
        )
        note.style.setProperty(
          '--note-scale',
          String(0.8 + Math.random() * 0.7)
        )
        note.style.setProperty(
          '--note-alpha',
          String(0.55 + Math.random() * 0.35)
        )
        note.style.fontSize = `${0.85 + Math.random() * 0.5}rem`
        notesBox.appendChild(note)
        window.setTimeout(() => note.remove(), dur * 1000 + 100)
      }
      spawn()
      noteTimer = window.setInterval(spawn, 700)
    }
    function stopNotes() {
      if (noteTimer) {
        clearInterval(noteTimer)
        noteTimer = 0
      }
    }

    function selectAlbum(album: StageAlbum) {
      playingAlbum = album
      document.getElementById('music-page-wrapper')?.classList.add('has-album')
      scheduleStageFit()
      renderRecordContext(album)
      window.dispatchEvent(new CustomEvent('album-selected', { detail: album }))
      if (vinylLabel && album.cover) {
        vinylLabel.style.setProperty('--vinyl-cover', `url("${album.cover}")`)
      }
      void loadLyricsMap(album)
    }

    function playTrack(album: StageAlbum, index: number) {
      if (playingAlbum?.id !== album.id) {
        selectAlbum(album)
      }
      window.dispatchEvent(
        new CustomEvent('song-selected', { detail: { index } })
      )
      renderLyrics(album.songs[index].id)
    }

    window.addEventListener('gallery-album-open', ((e: CustomEvent) => {
      const { album, sourceRect, autoPlay } = e.detail as {
        album: StageAlbum
        sourceRect?: DOMRect
        autoPlay?: boolean
      }
      renderRecordContext(album)
      // 无可播音频: 只展示曲目,不打断当前播放、不换盘
      const playable = album.songs.some((s) => s.url)
      if (!playable) {
        setPanelAvailable(false)
        return
      }
      renderPanel(album)
      setPanelAvailable(true)
      setPanelOpen(false)
      let fly: Promise<void> = Promise.resolve()
      if (autoPlay) {
        // Start from the original click call stack. Waiting for the vinyl
        // flight here loses the browser's user-gesture allowance for audio.
        const first = album.songs.findIndex((s) => s.url)
        if (first >= 0) {
          playTrack(album, first)
          if (sourceRect) fly = flyVinylFrom(sourceRect, album.cover)
        }
      } else if (sourceRect) {
        // 仅换盘不播: 飞行后更新盘面
        fly = flyVinylFrom(sourceRect, album.cover)
        fly.then(() => {
          if (vinylLabel && album.cover)
            vinylLabel.style.setProperty(
              '--vinyl-cover',
              `url("${album.cover}")`
            )
        })
      }
    }) as EventListener)

    panelPlayAll?.addEventListener('click', async () => {
      if (!panelAlbum) return
      const first = panelAlbum.songs.findIndex((s) => s.url)
      if (first >= 0) playTrack(panelAlbum, first)
    })

    document
      .getElementById('track-panel-handle')
      ?.addEventListener('click', () =>
        setPanelOpen(!panel?.classList.contains('is-open'))
      )
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setPanelOpen(false)
    })

    // 倍速与黑胶转速同步: 基准 3.6s/转
    window.addEventListener('set-playback-rate', ((e: CustomEvent) => {
      const rate = Number(e.detail) || 1
      vinyl?.style.setProperty('--spin-duration', `${3.6 / rate}s`)
    }) as EventListener)

    window.addEventListener('playback-state', ((e: CustomEvent) => {
      const { isPlaying, songIndex } = e.detail
      vinyl?.classList.toggle('is-playing', Boolean(isPlaying))
      if (isPlaying) startNotes()
      else stopNotes()
      const song = playingAlbum?.songs[songIndex]
      if (song && song.id !== currentSongId) renderLyrics(song.id)
      panelTracks?.querySelectorAll('.track-row').forEach((row) => {
        row.classList.toggle(
          'is-current',
          Boolean(
            song &&
            (row as HTMLElement).dataset.songId === song.id &&
            panelAlbum?.id === playingAlbum?.id
          )
        )
      })
    }) as EventListener)

    window.addEventListener('playback-progress', ((e: CustomEvent) => {
      const { currentTime, songIndex } = e.detail
      const song = playingAlbum?.songs[songIndex]
      if (song && song.id !== currentSongId) renderLyrics(song.id)
      syncLyrics(Number(currentTime) || 0)
    }) as EventListener)

    // 初始化时同步全局倍速(跨页返回场景)
    const initialRate =
      (window as { MusicPlayerState?: { currentPlaybackRate?: number } })
        .MusicPlayerState?.currentPlaybackRate ?? 1
    vinyl?.style.setProperty('--spin-duration', `${3.6 / initialRate}s`)
  }

  document.addEventListener('astro:page-load', initNowPlaying)
  initNowPlaying()
</script>
