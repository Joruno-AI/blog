---
// 正在播放舞台: 黑胶指示 + 同步歌词 + 专辑曲目面板
// 监听: gallery-album-open / album-selected / playback-state / playback-progress
// 派发: album-selected / auto-play-album / song-selected / seek-to-time
---

<div class="now-playing-stage" id="now-playing-stage">
  <div class="stage-left">
    <div class="stage-vinyl" id="stage-vinyl" aria-hidden="true">
      <div class="vinyl-disc">
        <div class="vinyl-label" id="vinyl-label"></div>
        <div class="vinyl-hole"></div>
      </div>
    </div>
    <div class="lyrics-panel" id="lyrics-panel" aria-label="歌词">
      <p class="lyrics-empty" id="lyrics-empty">选一张唱片 让歌词在这里流动</p>
      <div class="lyrics-scroll" id="lyrics-scroll"></div>
    </div>
  </div>

  <aside
    class="track-panel"
    id="track-panel"
    aria-label="专辑曲目"
    aria-hidden="true"
  >
    <button
      class="track-panel-close"
      id="track-panel-close"
      type="button"
      aria-label="关闭曲目面板"
    >
      <span class="i-ri-close-line"></span>
    </button>
    <header class="track-panel-head">
      <img class="panel-cover" id="panel-cover" src="" alt="" />
      <div class="panel-meta">
        <h2 class="panel-title" id="panel-title">专辑</h2>
        <p class="panel-sub" id="panel-sub"></p>
        <button class="panel-play-all" id="panel-play-all" type="button">
          <span class="i-ri-play-fill"></span> 播放专辑
        </button>
      </div>
    </header>
    <ol class="panel-tracks" id="panel-tracks"></ol>
  </aside>
</div>

<style>
  .now-playing-stage {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }
  .stage-left {
    position: absolute;
    top: clamp(6rem, 15vh, 8.5rem);
    left: clamp(1rem, 4vw, 4rem);
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2.4rem);
    pointer-events: auto;
  }
  /* 无边界渐晕垫底,保证歌词在长廊滑过时仍可读 */
  .stage-left::before {
    content: '';
    position: absolute;
    inset: -22% -14%;
    z-index: -1;
    background: radial-gradient(
      ellipse at 42% 50%,
      var(--music-scrim, rgb(6 7 9 / 82%)),
      color-mix(in srgb, var(--music-scrim, rgb(6 7 9 / 82%)) 58%, transparent)
        52%,
      transparent 74%
    );
    pointer-events: none;
  }

  .stage-vinyl {
    flex: none;
    width: clamp(9.5rem, 16vw, 14rem);
    aspect-ratio: 1;
    filter: drop-shadow(0 1.4rem 2.6rem rgb(0 0 0 / 55%));
  }
  .vinyl-disc {
    position: relative;
    width: 100%;
    height: 100%;
    background:
      repeating-radial-gradient(
        circle,
        rgba(255, 255, 255, 0.045) 0 1px,
        transparent 1px 4px
      ),
      radial-gradient(circle, #202124 0 26%, #0d0e10 27% 100%);
    border-radius: 50%;
    animation: vinyl-spin 3.6s linear infinite;
    animation-play-state: paused;
  }
  .stage-vinyl.is-playing .vinyl-disc {
    animation-play-state: running;
  }
  .vinyl-label {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 38%;
    aspect-ratio: 1;
    background: var(--album-color, #333) center/cover no-repeat;
    background-image: var(--vinyl-cover, none);
    border-radius: 50%;
    box-shadow: inset 0 0 0 2px rgb(0 0 0 / 35%);
    transform: translate(-50%, -50%);
  }
  .vinyl-hole {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4.5%;
    aspect-ratio: 1;
    background: #060607;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  @keyframes vinyl-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .lyrics-panel {
    position: relative;
    width: clamp(13rem, 22vw, 20rem);
    max-height: clamp(11rem, 26vh, 16rem);
    overflow: hidden;
  }
  .lyrics-empty {
    margin: 0.4rem 0;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.35));
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-shadow: var(--music-decor-shadow, 0 1px 10px rgb(0 0 0 / 70%));
  }
  .lyrics-scroll {
    max-height: clamp(11rem, 26vh, 16rem);
    overflow-y: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 16%,
      #000 84%,
      transparent
    );
  }
  .lyrics-scroll::-webkit-scrollbar {
    display: none;
  }
  .lyrics-scroll :global(.lyric-line) {
    display: block;
    width: 100%;
    padding: 0.3rem 0;
    background: none;
    border: 0;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.38));
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    line-height: 1.55;
    text-align: left;
    text-shadow: var(--music-decor-shadow, 0 1px 12px rgb(0 0 0 / 80%));
    cursor: pointer;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }
  .lyrics-scroll :global(.lyric-line:hover) {
    color: var(--music-text-soft, rgba(247, 242, 234, 0.68));
  }
  .lyrics-scroll :global(.lyric-line.is-current) {
    color: var(--music-accent-text, #f6d23c);
    font-weight: 600;
    transform: scale(1.04);
    transform-origin: left center;
  }

  .track-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(26rem, calc(100vw - 1.5rem));
    padding: clamp(4.5rem, 10vh, 6rem) clamp(1.2rem, 2.5vw, 2.5rem)
      clamp(5rem, 12vh, 7rem) 3.5rem;
    background: linear-gradient(
      to left,
      color-mix(
          in srgb,
          var(--album-color, #101216) 24%,
          var(--music-scrim-strong, rgb(7 8 10 / 97%))
        )
        72%,
      color-mix(
          in srgb,
          var(--album-color, #101216) 12%,
          var(--music-scrim, rgb(7 8 10 / 78%))
        )
        88%,
      transparent
    );
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(2rem);
    transition:
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 200ms ease,
      visibility 260ms;
  }
  .track-panel.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
  }
  .track-panel-close {
    position: absolute;
    top: clamp(4.6rem, 10vh, 6.2rem);
    right: clamp(1.2rem, 2.5vw, 2.5rem);
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    background: none;
    border: 0;
    border-radius: 50%;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.55));
    cursor: pointer;
    transition: color 160ms ease;
  }
  .track-panel-close:hover {
    color: var(--music-text-strong, #f7f2ea);
  }
  .track-panel-head {
    display: flex;
    gap: 0.9rem;
    margin-bottom: 0.8rem;
  }
  .panel-cover {
    width: 5.4rem;
    height: 5.4rem;
    object-fit: cover;
    border-radius: 0.4rem;
    box-shadow: 0 0.8rem 1.8rem rgb(0 0 0 / 45%);
  }
  .panel-meta {
    min-width: 0;
  }
  .panel-title {
    overflow: hidden;
    margin: 0 1.6rem 0.2rem 0;
    color: var(--music-text, #f7f2ea);
    font-size: 1.05rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .panel-sub {
    margin: 0 0 0.55rem;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.55));
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }
  .panel-play-all {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.34rem 0.85rem;
    background: var(--music-accent-fill, #f6d23c);
    border: 0;
    border-radius: 999px;
    color: var(--music-accent-contrast, #191507);
    font-weight: 700;
    font-size: 0.74rem;
    cursor: pointer;
  }
  .panel-play-all:disabled {
    background: var(--music-control-soft, rgba(255, 255, 255, 0.14));
    color: var(--music-text-muted, rgba(247, 242, 234, 0.4));
    cursor: not-allowed;
  }
  .panel-tracks {
    flex: none;
    max-height: 52vh;
    overflow-y: auto;
    margin: 0;
    padding: 0;
    list-style: none;
    scrollbar-width: none;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 6%,
      #000 94%,
      transparent
    );
  }
  .panel-tracks::-webkit-scrollbar {
    display: none;
  }
  .panel-tracks :global(.track-row) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.5rem 0.45rem;
    background: none;
    border: 0;
    border-radius: 0.45rem;
    color: var(--music-text-soft, rgba(247, 242, 234, 0.85));
    font-size: 0.8rem;
    text-align: left;
    cursor: pointer;
  }
  .panel-tracks :global(.track-row:hover) {
    background: color-mix(in srgb, var(--music-text, #fff) 8%, transparent);
  }
  .panel-tracks :global(.track-row.is-current) {
    background: color-mix(
      in srgb,
      var(--music-accent-fill, #f6d23c) 16%,
      transparent
    );
    color: var(--music-accent-text, #f6d23c);
  }
  .panel-tracks :global(.track-row.is-disabled) {
    color: var(--music-text-muted, rgba(247, 242, 234, 0.32));
    cursor: default;
  }
  .panel-tracks :global(.track-row.is-disabled:hover) {
    background: none;
  }
  .panel-tracks :global(.track-no) {
    flex: none;
    width: 1.4rem;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.45));
    font-size: 0.68rem;
    font-style: italic;
  }
  .panel-tracks :global(.track-name) {
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .panel-tracks :global(.track-tag) {
    flex: none;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.35));
    font-size: 0.62rem;
  }
  .panel-tracks :global(.track-dur) {
    flex: none;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.45));
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 767px) {
    .stage-left {
      top: 4.6rem;
      left: 0.9rem;
      right: 0.9rem;
      gap: 0.8rem;
    }
    .stage-vinyl {
      width: clamp(6.2rem, 30vw, 8rem);
    }
    .lyrics-panel {
      width: auto;
      flex: 1;
      max-height: 6.5rem;
    }
    .lyrics-scroll {
      max-height: 6.5rem;
    }
    .lyrics-scroll :global(.lyric-line) {
      font-size: 0.68rem;
    }
    .track-panel {
      top: auto;
      right: 0;
      bottom: 0;
      left: 0;
      width: auto;
      justify-content: flex-end;
      padding: 3rem 1rem calc(5rem + env(safe-area-inset-bottom)) 1rem;
      background: linear-gradient(
        to top,
        color-mix(
            in srgb,
            var(--album-color, #101216) 24%,
            var(--music-scrim-strong, rgb(7 8 10 / 96%))
          )
          70%,
        transparent
      );
      transform: translateY(2rem);
    }
    .track-panel.is-open {
      transform: translateY(0);
    }
    .track-panel-close {
      top: auto;
      right: 1rem;
      bottom: calc(5rem + env(safe-area-inset-bottom));
    }
    .panel-tracks {
      max-height: 38vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vinyl-disc {
      animation: none;
    }
    .track-panel {
      transition: none;
    }
  }
</style>

<script>
  interface StageSong {
    id: string
    name: string
    duration: string
    url: string | null
    hasLyrics: boolean
  }
  interface StageAlbum {
    id: string
    name: string
    artist: string
    description: string | null
    cover: string | null
    color: string
    releaseDate: string | null
    songs: StageSong[]
  }
  interface LyricLine {
    t: number
    text: string
  }

  function parseLrc(lrc: string): LyricLine[] {
    const out: LyricLine[] = []
    for (const raw of lrc.split('\n')) {
      const tags = [...raw.matchAll(/\[(\d+):(\d+(?:\.\d+)?)\]/g)]
      if (!tags.length) continue
      const text = raw.replace(/\[[^\]]*\]/g, '').trim()
      if (!text) continue
      for (const m of tags) {
        out.push({ t: Number(m[1]) * 60 + Number(m[2]), text })
      }
    }
    return out.sort((a, b) => a.t - b.t)
  }

  function initNowPlaying() {
    const stage = document.getElementById('now-playing-stage')
    if (!stage || stage.dataset.bound === 'true') return
    stage.dataset.bound = 'true'

    const vinyl = document.getElementById('stage-vinyl')
    const vinylLabel = document.getElementById('vinyl-label')
    const panel = document.getElementById('track-panel')
    const panelCover = document.getElementById(
      'panel-cover'
    ) as HTMLImageElement | null
    const panelTitle = document.getElementById('panel-title')
    const panelSub = document.getElementById('panel-sub')
    const panelPlayAll = document.getElementById(
      'panel-play-all'
    ) as HTMLButtonElement | null
    const panelTracks = document.getElementById('panel-tracks')
    const lyricsEmpty = document.getElementById('lyrics-empty')
    const lyricsScroll = document.getElementById('lyrics-scroll')

    let panelAlbum: StageAlbum | null = null
    let playingAlbum: StageAlbum | null = null
    let lyricsMap: Record<string, string> = {}
    let currentLines: LyricLine[] = []
    let currentLineIndex = -1
    let currentSongId: string | null = null

    function setPanelOpen(open: boolean) {
      panel?.classList.toggle('is-open', open)
      panel?.setAttribute('aria-hidden', String(!open))
      // 面板打开时让个人最爱/提示文案让位,避免遮挡(与 dock 曲目抽屉共用)
      const queueOpen = document
        .getElementById('playlist-drawer')
        ?.classList.contains('active')
      document
        .getElementById('music-page-wrapper')
        ?.classList.toggle('panel-open', open || Boolean(queueOpen))
    }

    async function loadLyricsMap(album: StageAlbum) {
      lyricsMap = {}
      if (!album.songs.some((s) => s.hasLyrics)) return
      try {
        const res = await fetch(`/music/lyrics/${album.id}.json`)
        if (res.ok) lyricsMap = await res.json()
      } catch (e) {
        console.warn('[lyrics] load failed:', e)
      }
    }

    function renderLyrics(songId: string) {
      currentSongId = songId
      currentLineIndex = -1
      const lrc = lyricsMap[songId]
      currentLines = lrc ? parseLrc(lrc) : []
      if (!lyricsScroll || !lyricsEmpty) return
      if (!currentLines.length) {
        lyricsScroll.replaceChildren()
        lyricsEmpty.textContent = playingAlbum
          ? '这首歌还没有歌词'
          : '选一张唱片 让歌词在这里流动'
        lyricsEmpty.style.display = ''
        return
      }
      lyricsEmpty.style.display = 'none'
      const frag = document.createDocumentFragment()
      currentLines.forEach((line, i) => {
        const el = document.createElement('button')
        el.type = 'button'
        el.className = 'lyric-line'
        el.textContent = line.text
        el.addEventListener('click', () =>
          window.dispatchEvent(
            new CustomEvent('seek-to-time', { detail: currentLines[i].t })
          )
        )
        frag.appendChild(el)
      })
      lyricsScroll.replaceChildren(frag)
      lyricsScroll.scrollTop = 0
    }

    function syncLyrics(time: number) {
      if (!currentLines.length || !lyricsScroll) return
      let idx = -1
      for (let i = 0; i < currentLines.length; i++) {
        if (currentLines[i].t <= time + 0.25) idx = i
        else break
      }
      if (idx === currentLineIndex) return
      currentLineIndex = idx
      const nodes = lyricsScroll.children
      for (let i = 0; i < nodes.length; i++) {
        nodes[i].classList.toggle('is-current', i === idx)
      }
      if (idx >= 0) {
        const el = nodes[idx] as HTMLElement
        lyricsScroll.scrollTo({
          top: el.offsetTop - lyricsScroll.clientHeight / 2 + el.clientHeight,
          behavior: 'smooth',
        })
      }
    }

    function renderPanel(album: StageAlbum) {
      panelAlbum = album
      if (panelCover) {
        panelCover.src = album.cover ?? ''
        panelCover.alt = album.name
      }
      if (panelTitle) panelTitle.textContent = album.name
      if (panelSub) {
        const year = album.releaseDate?.slice(0, 4)
        panelSub.textContent = [album.artist, year && `${year}年`]
          .filter(Boolean)
          .join(' · ')
      }
      const playable = album.songs.some((s) => s.url)
      if (panelPlayAll) {
        panelPlayAll.disabled = !playable
        panelPlayAll.innerHTML = playable
          ? '<span class="i-ri-play-fill"></span> 播放专辑'
          : '音频待补充'
      }
      if (panelTracks) {
        const frag = document.createDocumentFragment()
        album.songs.forEach((song, i) => {
          const li = document.createElement('li')
          const row = document.createElement('button')
          row.type = 'button'
          row.className = 'track-row'
          row.dataset.songId = song.id
          if (!song.url) row.classList.add('is-disabled')
          row.innerHTML = `
            <span class="track-no">${String(i + 1).padStart(2, '0')}</span>
            <span class="track-name">${song.name}</span>
            ${song.url ? '' : '<span class="track-tag">待补音频</span>'}
            <span class="track-dur">${song.duration}</span>`
          if (song.url) {
            row.addEventListener('click', () => playTrack(album, i))
          }
          li.appendChild(row)
          frag.appendChild(li)
        })
        panelTracks.replaceChildren(frag)
        panelTracks.scrollTop = 0
      }
    }

    async function selectAlbum(album: StageAlbum) {
      playingAlbum = album
      window.dispatchEvent(
        new CustomEvent('album-selected', { detail: album })
      )
      if (vinylLabel && album.cover) {
        vinylLabel.style.setProperty('--vinyl-cover', `url("${album.cover}")`)
      }
      await loadLyricsMap(album)
    }

    async function playTrack(album: StageAlbum, index: number) {
      if (playingAlbum?.id !== album.id) {
        await selectAlbum(album)
      }
      window.dispatchEvent(
        new CustomEvent('song-selected', { detail: { index } })
      )
      renderLyrics(album.songs[index].id)
    }

    window.addEventListener('gallery-album-open', ((e: CustomEvent) => {
      renderPanel(e.detail as StageAlbum)
      setPanelOpen(true)
    }) as EventListener)

    panelPlayAll?.addEventListener('click', async () => {
      if (!panelAlbum) return
      const first = panelAlbum.songs.findIndex((s) => s.url)
      if (first >= 0) await playTrack(panelAlbum, first)
    })

    document
      .getElementById('track-panel-close')
      ?.addEventListener('click', () => setPanelOpen(false))
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setPanelOpen(false)
    })

    window.addEventListener('playback-state', ((e: CustomEvent) => {
      const { isPlaying, songIndex } = e.detail
      vinyl?.classList.toggle('is-playing', Boolean(isPlaying))
      const song = playingAlbum?.songs[songIndex]
      if (song && song.id !== currentSongId) renderLyrics(song.id)
      panelTracks?.querySelectorAll('.track-row').forEach((row) => {
        row.classList.toggle(
          'is-current',
          Boolean(
            song &&
              (row as HTMLElement).dataset.songId === song.id &&
              panelAlbum?.id === playingAlbum?.id
          )
        )
      })
    }) as EventListener)

    window.addEventListener('playback-progress', ((e: CustomEvent) => {
      const { currentTime, songIndex } = e.detail
      const song = playingAlbum?.songs[songIndex]
      if (song && song.id !== currentSongId) renderLyrics(song.id)
      syncLyrics(Number(currentTime) || 0)
    }) as EventListener)
  }

  document.addEventListener('astro:page-load', initNowPlaying)
  initNowPlaying()
</script>
