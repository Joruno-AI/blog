---
// 正在播放舞台: 黑胶指示 + 同步歌词 + 右侧曲目侧边栏
// 监听: gallery-album-open / album-selected / playback-state / playback-progress
// 派发: album-selected / auto-play-album / song-selected / seek-to-time
---

<div class="now-playing-stage" id="now-playing-stage">
  <section
    class="listening-intro"
    id="listening-intro"
    aria-labelledby="listening-intro-title"
  >
    <h1 id="listening-intro-title">
      <span class="intro-title-lead">一张唱片</span>
      <span class="intro-title-tail">一个时代</span>
    </h1>
    <p class="listening-intro-copy">
      这里按专辑而不是单曲整理音乐。挑一张封面，从第一首顺着曲序听下去，感受创作者如何铺陈情绪、风格与故事。
    </p>
    <p class="listening-intro-hint">拖动浏览唱片，点击封面从头播放</p>
  </section>

  <section class="record-context" id="record-context" aria-hidden="true">
    <h1 class="record-context-title" id="record-context-title">
      正在播放的唱片
    </h1>
    <p class="record-context-meta" id="record-context-meta"></p>
    <p class="record-context-description" id="record-context-description"></p>
  </section>

  <div class="stage-left">
    <div class="stage-vinyl" id="stage-vinyl" aria-hidden="true">
      <div class="vinyl-disc">
        <div class="vinyl-label" id="vinyl-label"></div>
        <div class="vinyl-hole"></div>
      </div>
      <div class="tonearm" id="tonearm">
        <div class="tonearm-pivot"></div>
        <div class="tonearm-rod"></div>
        <div class="tonearm-head"></div>
      </div>
      <div class="vinyl-notes" id="vinyl-notes"></div>
    </div>
    <div class="lyrics-panel" id="lyrics-panel" aria-label="歌词">
      <p class="lyrics-empty" id="lyrics-empty" hidden></p>
      <div class="lyrics-scroll" id="lyrics-scroll"></div>
    </div>
  </div>

  <aside class="track-panel" id="track-panel" aria-label="专辑曲目">
    <button
      class="track-panel-handle"
      id="track-panel-handle"
      type="button"
      aria-label="展开或收起曲目"
      aria-expanded="false"
    >
      <span class="handle-chevron i-ri-arrow-left-s-line"></span>
      <span class="handle-label">曲目</span>
    </button>
    <div class="track-panel-body" id="track-panel-body" aria-hidden="true">
      <header class="track-panel-head">
        <img
          class="panel-cover"
          id="panel-cover"
          src="/joruno.png"
          alt="专辑封面"
        />
        <div class="panel-meta">
          <h2 class="panel-title" id="panel-title">专辑</h2>
          <p class="panel-sub" id="panel-sub"></p>
          <button class="panel-play-all" id="panel-play-all" type="button">
            <span class="i-ri-play-fill"></span> 播放专辑
          </button>
        </div>
      </header>
      <ol class="panel-tracks" id="panel-tracks"></ol>
    </div>
  </aside>
</div>

<style>
  .now-playing-stage {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }
  .listening-intro {
    position: absolute;
    top: clamp(5.5rem, 13vh, 8.25rem);
    left: clamp(1.5rem, 6vw, 6.5rem);
    z-index: 3;
    width: min(31rem, 36vw);
    color: var(--music-text-strong);
    pointer-events: none;
    transition:
      opacity 360ms ease,
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .listening-intro::before {
    content: '';
    display: block;
    width: 3rem;
    height: 1px;
    margin-bottom: 1rem;
    background: var(--music-accent-fill);
  }
  .listening-intro.is-hidden {
    opacity: 0;
    transform: translateY(-0.75rem);
  }
  .listening-intro h1 {
    display: flex;
    max-width: none;
    align-items: baseline;
    gap: 0.28em;
    margin: 0;
    font-size: clamp(2.2rem, 3.8vw, 3.55rem);
    font-weight: 720;
    letter-spacing: -0.065em;
    line-height: 0.96;
    white-space: nowrap;
  }
  .intro-title-lead,
  .intro-title-tail {
    display: block;
  }
  .intro-title-tail {
    color: var(--music-text-soft);
    font-weight: 520;
    letter-spacing: -0.05em;
  }
  .listening-intro-copy {
    max-width: 28rem;
    margin: 1.5rem 0 0;
    color: var(--music-text-soft);
    font-size: clamp(0.86rem, 1vw, 1rem);
    letter-spacing: 0.02em;
    line-height: 1.8;
    text-wrap: pretty;
  }
  .listening-intro-hint {
    margin: 1.1rem 0 0;
    color: var(--music-accent-text);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
  }
  .record-context {
    position: absolute;
    top: clamp(6.5rem, 13vh, 8.25rem);
    left: clamp(3rem, 6vw, 6.5rem);
    z-index: 3;
    width: min(34rem, 38vw);
    color: var(--music-text-strong);
    text-align: left;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.75rem);
    transition:
      opacity 360ms ease,
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .record-context::before {
    content: '';
    display: block;
    width: 3rem;
    height: 1px;
    margin: 0 0 1rem;
    background: var(--music-accent-fill);
  }
  .record-context.has-album {
    opacity: 0.78;
    transform: translateY(0);
  }
  .record-context-title {
    max-width: 10ch;
    margin: 0 0 0.65rem;
    font-size: clamp(2.5rem, 4.6vw, 4.9rem);
    font-weight: 720;
    letter-spacing: -0.04em;
    line-height: 0.94;
    text-wrap: balance;
  }
  .record-context-meta {
    margin: 0;
    color: var(--music-text-soft);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
  }
  .record-context-description {
    display: -webkit-box;
    max-width: 32rem;
    overflow: hidden;
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    color: var(--music-text-soft);
    border-top: 1px solid var(--music-border-soft);
    font-size: clamp(0.82rem, 0.9vw, 0.94rem);
    letter-spacing: 0.025em;
    line-height: 1.75;
    text-align: left;
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
  }
  .record-context-description:empty {
    display: none;
  }
  :global(#music-page-wrapper.stage-compact-intro) .listening-intro,
  :global(#music-page-wrapper.stage-compact-intro) .record-context {
    width: clamp(10.5rem, var(--stage-intro-fit, 22rem), 28rem);
  }
  :global(#music-page-wrapper.stage-compact-intro) .record-context-title,
  :global(#music-page-wrapper.stage-compact-intro) .record-context-title {
    max-width: 9ch;
    font-size: clamp(2rem, 3.6vw, 3.6rem);
    line-height: 0.96;
  }
  :global(#music-page-wrapper.stage-compact-intro) .listening-intro h1 {
    max-width: none;
    gap: 0.2em;
    font-size: clamp(1.15rem, 2.8vw, 2rem);
  }
  :global(#music-page-wrapper.stage-compact-intro) .record-context-description {
    margin-top: 0.9rem;
    padding-top: 0.75rem;
    font-size: clamp(0.72rem, 0.82vw, 0.86rem);
    line-height: 1.62;
    -webkit-line-clamp: 4;
  }
  :global(#music-page-wrapper.stage-compact-intro) .listening-intro-copy {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 1rem;
    font-size: clamp(0.72rem, 0.82vw, 0.86rem);
    line-height: 1.62;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }
  :global(#music-page-wrapper.stage-compact-intro) .listening-intro-hint {
    margin-top: 0.75rem;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }
  .stage-left {
    position: absolute;
    top: clamp(6.25rem, 12vh, 7.75rem);
    right: clamp(2.75rem, 5vw, 5.5rem);
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    gap: clamp(1.4rem, 2.5vw, 2.8rem);
    pointer-events: auto;
    transform-origin: right center;
    transition:
      right 520ms cubic-bezier(0.22, 1, 0.36, 1),
      left 520ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms ease;
  }
  .stage-vinyl {
    flex: none;
    width: clamp(12rem, 19vw, 17.5rem);
    aspect-ratio: 1;
    filter: drop-shadow(0 1.4rem 2.6rem rgb(0 0 0 / 55%));
  }
  .vinyl-disc {
    position: relative;
    width: 100%;
    height: 100%;
    background:
      repeating-radial-gradient(
        circle,
        rgba(255, 255, 255, 0.045) 0 1px,
        transparent 1px 4px
      ),
      radial-gradient(circle, #202124 0 26%, #0d0e10 27% 100%);
    border-radius: 50%;
    animation: vinyl-spin var(--spin-duration, 3.6s) linear infinite;
    animation-play-state: paused;
  }
  .stage-vinyl.is-playing .vinyl-disc {
    animation-play-state: running;
  }
  /* 唱臂: 支点在右上角,播放落针/暂停抬针,点击切换播放 */
  .tonearm {
    position: absolute;
    top: -4%;
    right: -7%;
    width: 46%;
    height: 60%;
    transform-origin: 78% 12%;
    transform: rotate(-24deg);
    transition:
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 180ms ease;
    filter: drop-shadow(0 0.5rem 0.9rem rgb(0 0 0 / 45%));
    cursor: pointer;
  }
  .tonearm:hover {
    filter: drop-shadow(0 0.5rem 0.9rem rgb(0 0 0 / 45%)) brightness(1.35);
  }
  .stage-vinyl.is-playing .tonearm {
    transform: rotate(6deg);
  }
  .tonearm-pivot {
    position: absolute;
    top: 4%;
    right: 12%;
    width: 22%;
    aspect-ratio: 1;
    background: radial-gradient(circle at 38% 34%, #4a4d52, #1b1d20 68%);
    border-radius: 50%;
    box-shadow: inset 0 1px 2px rgb(255 255 255 / 18%);
  }
  .tonearm-rod {
    position: absolute;
    top: 12%;
    right: 20%;
    width: 3.5%;
    height: 74%;
    background: linear-gradient(90deg, #52555a, #2c2e32);
    border-radius: 999px;
    transform: rotate(14deg);
    transform-origin: top center;
  }
  .tonearm-head {
    position: absolute;
    bottom: 2%;
    left: 47%;
    width: 12%;
    height: 15%;
    background: linear-gradient(135deg, #5d6167, #24262a);
    border-radius: 0.15rem;
    transform: rotate(24deg);
  }
  .vinyl-label {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 50%;
    aspect-ratio: 1;
    background: var(--album-color, #333) center/cover no-repeat;
    background-image: var(--vinyl-cover, none);
    border-radius: 50%;
    box-shadow: inset 0 0 0 2px rgb(0 0 0 / 35%);
    transform: translate(-50%, -50%);
  }
  .vinyl-hole {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4.5%;
    aspect-ratio: 1;
    background: #060607;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  @keyframes vinyl-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 播放时飘出的音符 */
  .vinyl-notes {
    position: absolute;
    inset: -30%;
    overflow: visible;
    pointer-events: none;
  }
  .vinyl-notes :global(.note) {
    position: absolute;
    bottom: 46%;
    left: 50%;
    color: var(--music-accent-text, #f6d23c);
    opacity: 0;
    animation: note-float var(--note-dur, 2.6s) ease-out forwards;
    will-change: transform, opacity;
  }
  @keyframes note-float {
    0% {
      opacity: 0;
      transform: translate(-50%, 0) rotate(0deg) scale(0.6);
    }
    12% {
      opacity: var(--note-alpha, 0.85);
    }
    100% {
      opacity: 0;
      transform: translate(calc(-50% + var(--note-dx, 2rem)), -7.5rem)
        rotate(var(--note-rot, 18deg)) scale(var(--note-scale, 1));
    }
  }

  .lyrics-panel {
    --lyrics-height: clamp(14rem, 32vh, 20rem);
    --lyrics-line-box: 2.05rem;
    position: relative;
    z-index: 1;
    width: clamp(16rem, 23vw, 22rem);
    height: var(--lyrics-height);
    max-height: var(--lyrics-height);
    overflow: hidden;
  }
  .lyrics-empty {
    margin: 0;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.35));
    font-size: 0.78rem;
    font-weight: 520;
    letter-spacing: 0.04em;
    line-height: 1.6;
    text-shadow:
      0 1px 1px rgb(0 0 0 / 85%),
      0 0 1.2rem rgb(0 0 0 / 72%);
  }
  .lyrics-scroll {
    box-sizing: border-box;
    height: 100%;
    max-height: none;
    overflow-x: hidden;
    overflow-y: auto;
    /* Leave a half viewport of breathing room so the first and last line can
       occupy the same centered position as every line in between. */
    padding-block: calc((var(--lyrics-height) - var(--lyrics-line-box)) / 2);
    scrollbar-width: none;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 16%,
      #000 84%,
      transparent
    );
  }
  .lyrics-scroll::-webkit-scrollbar {
    display: none;
  }
  .lyrics-scroll :global(.lyric-line) {
    display: block;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    padding: 0.38rem 0;
    background: none;
    border: 0;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.38));
    font-size: clamp(0.94rem, 1.08vw, 1.1rem);
    letter-spacing: 0.025em;
    line-height: 1.62;
    overflow-wrap: anywhere;
    text-align: left;
    text-shadow:
      0 1px 1px rgb(0 0 0 / 86%),
      0 0 1.2rem rgb(0 0 0 / 76%);
    cursor: pointer;
    white-space: normal;
    word-break: break-word;
    transition:
      color 180ms ease,
      font-size 220ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 180ms ease;
  }
  .lyrics-scroll :global(.lyric-line:hover) {
    color: var(--music-text-soft, rgba(247, 242, 234, 0.68));
  }
  .lyrics-scroll :global(.lyric-line.is-current) {
    color: var(--music-accent-text, #f6d23c);
    font-size: clamp(1.2rem, 1.45vw, 1.45rem);
    font-weight: 720;
    letter-spacing: 0;
    line-height: 1.5;
    transform: none;
  }

  /* 右侧曲目侧边栏: 平时收在屏幕右缘只露把手,展开时滑入 */
  .track-panel {
    position: absolute;
    top: clamp(4.2rem, 9vh, 5.5rem);
    right: 0;
    bottom: clamp(4.6rem, 11vh, 6.5rem);
    z-index: 20;
    display: flex;
    align-items: center;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateX(var(--panel-width, 24rem));
    transition:
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 180ms ease,
      visibility 180ms ease;
  }
  .track-panel.is-available {
    visibility: visible;
    opacity: 1;
  }
  .track-panel.is-open {
    transform: translateX(0);
  }
  .track-panel-body {
    display: flex;
    flex-direction: column;
    width: var(--panel-width, 24rem);
    max-height: 100%;
    padding: 1.2rem 1.4rem 1.2rem 1.6rem;
    background: color-mix(
      in srgb,
      var(--album-color, #101216) 18%,
      var(--music-panel-strong, rgb(7 8 10 / 97%))
    );
    border-inline-start: 0;
    box-shadow: -1.2rem 0 2.4rem rgb(0 0 0 / 12%);
    pointer-events: auto;
  }
  .track-panel-handle {
    position: absolute;
    top: 50%;
    left: 1px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 0.7rem 0.3rem;
    background: color-mix(
      in srgb,
      var(--album-color, #101216) 18%,
      var(--music-panel-strong, rgb(7 8 10 / 97%))
    );
    border: 1px solid var(--music-border, rgb(255 255 255 / 12%));
    border-right: 0;
    border-radius: 0.6rem 0 0 0.6rem;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.55));
    cursor: pointer;
    pointer-events: auto;
    transform: translate(-100%, -50%);
    transition: color 160ms ease;
  }
  .track-panel-handle:hover {
    color: var(--music-text-strong, #f7f2ea);
  }
  .handle-label {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    writing-mode: vertical-rl;
  }
  .handle-chevron {
    font-size: 0.9rem;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .track-panel.is-open .handle-chevron {
    transform: rotate(180deg);
  }
  .track-panel-head {
    display: flex;
    gap: 0.9rem;
    margin-bottom: 0.8rem;
  }
  .panel-cover {
    width: 5.4rem;
    height: 5.4rem;
    object-fit: cover;
    border-radius: 0.4rem;
    box-shadow: 0 0.8rem 1.8rem rgb(0 0 0 / 45%);
  }
  .panel-meta {
    min-width: 0;
  }
  .panel-title {
    overflow: hidden;
    margin: 0 1.6rem 0.2rem 0;
    color: var(--music-text, #f7f2ea);
    font-size: 1.05rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .panel-sub {
    margin: 0 0 0.55rem;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.55));
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }
  .panel-play-all {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.34rem 0.85rem;
    background: var(--music-accent-fill, #f6d23c);
    border: 0;
    border-radius: 999px;
    color: var(--music-accent-contrast, #191507);
    font-weight: 700;
    font-size: 0.74rem;
    cursor: pointer;
  }
  .panel-play-all:disabled {
    background: var(--music-control-soft, rgba(255, 255, 255, 0.14));
    color: var(--music-text-muted, rgba(247, 242, 234, 0.4));
    cursor: not-allowed;
  }
  .panel-tracks {
    flex: none;
    max-height: 52vh;
    overflow-y: auto;
    margin: 0;
    padding: 0;
    list-style: none;
    scrollbar-width: none;
  }
  .panel-tracks::-webkit-scrollbar {
    display: none;
  }
  .panel-tracks :global(.track-row) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.5rem 0.45rem;
    background: none;
    border: 0;
    border-radius: 0.45rem;
    color: var(--music-text-soft, rgba(247, 242, 234, 0.85));
    font-size: 0.8rem;
    text-align: left;
    cursor: pointer;
  }
  .panel-tracks :global(.track-row:hover) {
    background: color-mix(in srgb, var(--music-text, #fff) 8%, transparent);
  }
  .panel-tracks :global(.track-row.is-current) {
    background: color-mix(
      in srgb,
      var(--music-accent-fill, #f6d23c) 16%,
      transparent
    );
    color: var(--music-accent-text, #f6d23c);
  }
  .panel-tracks :global(.track-row.is-disabled) {
    color: var(--music-text-muted, rgba(247, 242, 234, 0.32));
    cursor: default;
  }
  .panel-tracks :global(.track-row.is-disabled:hover) {
    background: none;
  }
  .panel-tracks :global(.track-no) {
    flex: none;
    width: 1.4rem;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.45));
    font-size: 0.68rem;
    font-style: italic;
  }
  .panel-tracks :global(.track-name) {
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .panel-tracks :global(.track-tag) {
    flex: none;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.35));
    font-size: 0.62rem;
  }
  .panel-tracks :global(.track-dur) {
    flex: none;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.45));
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-height: 760px) and (min-width: 961px) {
    .record-context-description {
      margin-top: 1rem;
      padding-top: 0.75rem;
      -webkit-line-clamp: 4;
    }
  }

  @media (max-width: 767px) {
    .stage-left {
      top: clamp(4.2rem, 11vh, 6rem);
      left: 0.9rem;
      right: auto;
      flex-direction: row-reverse;
      gap: 0.8rem;
    }
    .lyrics-panel {
      --lyrics-height: clamp(8.5rem, 25vh, 12rem);
      --lyrics-line-box: 2.75rem;
      width: clamp(14rem, 62vw, 22rem);
      flex: 1;
      height: var(--lyrics-height);
      max-height: var(--lyrics-height);
    }
    .lyrics-scroll {
      max-height: none;
    }
    .lyrics-scroll :global(.lyric-line) {
      min-height: 2.75rem;
      font-size: 0.88rem;
    }
    .lyrics-scroll :global(.lyric-line.is-current) {
      font-size: 1.16rem;
      line-height: 1.45;
      transform: none;
    }
    .track-panel {
      --panel-width: min(19rem, calc(100vw - 3rem));
      top: 4.2rem;
      right: 0;
      bottom: 7.4rem;
    }
    .track-panel-handle {
      width: 2.75rem;
      min-height: 4.4rem;
      justify-content: center;
    }
    .track-panel-body {
      padding: 0.9rem 1rem 0.9rem 1.1rem;
    }
    .panel-tracks {
      max-height: 46vh;
    }
  }

  /* 三段布局先极限压缩简介，再按真实占用宽度逐级退场。 */
  :global(#music-page-wrapper.stage-hide-intro) .listening-intro,
  :global(#music-page-wrapper.stage-hide-intro) .record-context {
    display: none;
  }
  :global(#music-page-wrapper.stage-hide-intro) .stage-left {
    left: clamp(0.9rem, 5vw, 4rem);
    right: auto;
    flex-direction: row-reverse;
    transform-origin: left center;
  }
  :global(#music-page-wrapper.stage-hide-vinyl) .stage-vinyl {
    display: none;
  }
  :global(#music-page-wrapper.stage-hide-lyrics) .lyrics-panel {
    display: none;
  }
  :global(#music-page-wrapper.stage-hide-lyrics) .stage-left {
    display: none;
  }
  @media (pointer: coarse) {
    .panel-play-all,
    .panel-tracks :global(.track-row) {
      min-height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vinyl-disc {
      animation: none;
    }
    .track-panel {
      transition: none;
    }
  }
</style>

<script>
  interface StageSong {
    id: string
    name: string
    duration: string
    url: string | null
    hasLyrics: boolean
    quality?: {
      incomplete: boolean
      lyricsMismatch: boolean
      actualSeconds: number
      expectedSeconds: number
      studioStatus: string
      fingerprintSimilarity: number | null
      lyricsAlignmentStatus: string
    } | null
  }
  interface StageAlbum {
    id: string
    name: string
    artist: string
    description: string | null
    cover: string | null
    color: string
    releaseDate: string | null
    songs: StageSong[]
  }
  interface LyricLine {
    t: number
    text: string
  }

  function parseLrc(lrc: string): LyricLine[] {
    const out: LyricLine[] = []
    for (const raw of lrc.split('\n')) {
      const tags = [...raw.matchAll(/\[(\d+):(\d+(?:\.\d+)?)\]/g)]
      if (!tags.length) continue
      const text = raw.replace(/\[[^\]]*\]/g, '').trim()
      if (!text) continue
      for (const m of tags) {
        out.push({ t: Number(m[1]) * 60 + Number(m[2]), text })
      }
    }
    return out.sort((a, b) => a.t - b.t)
  }

  function initNowPlaying() {
    const stage = document.getElementById('now-playing-stage')
    if (!stage || stage.dataset.bound === 'true') return
    stage.dataset.bound = 'true'

    const vinyl = document.getElementById('stage-vinyl')
    const stageLeft = stage.querySelector<HTMLElement>('.stage-left')
    // 唱臂点击 = 播放/暂停(有已选专辑时)
    document.getElementById('tonearm')?.addEventListener('click', () => {
      if (playingAlbum) window.dispatchEvent(new CustomEvent('toggle-play'))
    })
    const vinylLabel = document.getElementById('vinyl-label')
    const panel = document.getElementById('track-panel')
    const panelBody = document.getElementById('track-panel-body')
    const panelCover = document.getElementById(
      'panel-cover'
    ) as HTMLImageElement | null
    const panelTitle = document.getElementById('panel-title')
    const panelSub = document.getElementById('panel-sub')
    const panelPlayAll = document.getElementById(
      'panel-play-all'
    ) as HTMLButtonElement | null
    const panelTracks = document.getElementById('panel-tracks')
    const lyricsEmpty = document.getElementById('lyrics-empty')
    const lyricsScroll = document.getElementById('lyrics-scroll')
    const listeningIntro = document.getElementById('listening-intro')
    const recordContext = document.getElementById('record-context')
    const recordContextTitle = document.getElementById('record-context-title')
    const recordContextMeta = document.getElementById('record-context-meta')
    const recordContextDescription = document.getElementById(
      'record-context-description'
    )

    let panelAlbum: StageAlbum | null = null
    let playingAlbum: StageAlbum | null = null
    let lyricsMap: Record<string, string> = {}
    let currentLines: LyricLine[] = []
    let currentLineIndex = -1
    let currentSongId: string | null = null

    const musicWrapper = document.getElementById('music-page-wrapper')
    let fitFrame = 0
    function updateStageFit() {
      if (!musicWrapper || !stageLeft) return
      musicWrapper.classList.remove(
        'stage-compact-intro',
        'stage-hide-intro',
        'stage-hide-vinyl',
        'stage-hide-lyrics'
      )

      const width = stage!.clientWidth || window.innerWidth
      const introWidth = Math.max(
        listeningIntro?.offsetWidth ?? 0,
        recordContext?.offsetWidth ?? 0
      )
      const lyricsWidth =
        document.getElementById('lyrics-panel')?.offsetWidth ?? 0
      const vinylWidth = vinyl?.offsetWidth ?? 0
      const gap = Number.parseFloat(getComputedStyle(stageLeft).gap) || 24
      const outerSpace = width * 0.11
      const sectionGap = Math.max(32, width * 0.04)
      const allSectionsWidth =
        introWidth + lyricsWidth + vinylWidth + gap + outerSpace + sectionGap

      const availableIntroWidth =
        width - (lyricsWidth + vinylWidth + gap + outerSpace + sectionGap)
      const minimumIntroWidth = 168
      const compactIntro =
        allSectionsWidth > width && availableIntroWidth >= minimumIntroWidth
      const hideIntro =
        allSectionsWidth > width && availableIntroWidth < minimumIntroWidth
      const playerSectionsWidth =
        lyricsWidth + vinylWidth + gap + Math.max(32, width * 0.1)
      const hideVinyl = hideIntro && playerSectionsWidth > width
      const lyricsOnlyWidth = lyricsWidth + Math.max(32, width * 0.08)
      const hideLyrics = hideVinyl && lyricsOnlyWidth > width

      musicWrapper.style.setProperty(
        '--stage-intro-fit',
        `${Math.max(minimumIntroWidth, Math.floor(availableIntroWidth))}px`
      )
      musicWrapper.classList.toggle('stage-compact-intro', compactIntro)
      musicWrapper.classList.toggle('stage-hide-intro', hideIntro)
      musicWrapper.classList.toggle('stage-hide-vinyl', hideVinyl)
      musicWrapper.classList.toggle('stage-hide-lyrics', hideLyrics)
    }
    function scheduleStageFit() {
      cancelAnimationFrame(fitFrame)
      fitFrame = requestAnimationFrame(updateStageFit)
    }

    const fitObserver = new ResizeObserver(scheduleStageFit)
    fitObserver.observe(stage)
    window.addEventListener('resize', scheduleStageFit)
    scheduleStageFit()

    function renderRecordContext(album: StageAlbum) {
      if (recordContextTitle) recordContextTitle.textContent = album.name
      if (recordContextMeta) {
        const year = album.releaseDate?.slice(0, 4)
        const trackCount = album.songs.length
          ? `${album.songs.length} 首曲目`
          : null
        recordContextMeta.textContent = [album.artist, year, trackCount]
          .filter(Boolean)
          .join(' · ')
      }
      if (recordContextDescription) {
        recordContextDescription.textContent = album.description?.trim() ?? ''
      }
      recordContext?.classList.add('has-album')
      recordContext?.setAttribute('aria-hidden', 'false')
      listeningIntro?.classList.add('is-hidden')
      listeningIntro?.setAttribute('aria-hidden', 'true')
    }

    function setPanelAvailable(available: boolean) {
      panel?.classList.toggle('is-available', available)
      if (!available) setPanelOpen(false)
    }

    function setPanelOpen(open: boolean) {
      if (open && !panel?.classList.contains('is-available')) return
      panel?.classList.toggle('is-open', open)
      panelBody?.setAttribute('aria-hidden', String(!open))
      if (panelBody) panelBody.inert = !open
      document
        .getElementById('track-panel-handle')
        ?.setAttribute('aria-expanded', String(open))
    }

    let lyricsRequestId = 0

    async function loadLyricsMap(album: StageAlbum) {
      const requestId = ++lyricsRequestId
      lyricsMap = {}
      if (!album.songs.some((s) => s.hasLyrics)) return
      try {
        const res = await fetch(`/music/lyrics/${album.id}.json`)
        if (res.ok && requestId === lyricsRequestId) {
          lyricsMap = await res.json()
          if (playingAlbum?.id === album.id && currentSongId) {
            renderLyrics(currentSongId)
          }
        }
      } catch (e) {
        console.warn('[lyrics] load failed:', e)
      }
    }

    function renderLyrics(songId: string) {
      currentSongId = songId
      currentLineIndex = -1
      const lrc = lyricsMap[songId]
      currentLines = lrc ? parseLrc(lrc) : []
      if (!lyricsScroll || !lyricsEmpty) return
      if (!currentLines.length) {
        lyricsScroll.replaceChildren()
        const song = playingAlbum?.songs.find((item) => item.id === songId)
        lyricsEmpty.textContent = song?.quality?.lyricsMismatch
          ? '当前音源版本与歌词时间轴不一致'
          : song?.quality?.lyricsAlignmentStatus === 'lyrics-incomplete'
            ? '歌词内容不完整，暂不展示'
            : song?.quality?.lyricsAlignmentStatus === 'timing-review'
              ? '歌词时间轴待校准，暂不展示'
              : song?.quality?.lyricsAlignmentStatus === 'lyrics-mismatch'
                ? '歌词与当前录音室音源不匹配'
                : playingAlbum
                  ? '这首作品暂未收录歌词'
                  : ''
        lyricsEmpty.style.display = playingAlbum ? '' : 'none'
        return
      }
      lyricsEmpty.style.display = 'none'
      const frag = document.createDocumentFragment()
      currentLines.forEach((line, i) => {
        const el = document.createElement('button')
        el.type = 'button'
        el.className = 'lyric-line'
        el.textContent = line.text
        el.addEventListener('click', () =>
          window.dispatchEvent(
            new CustomEvent('seek-to-time', { detail: currentLines[i].t })
          )
        )
        frag.appendChild(el)
      })
      lyricsScroll.replaceChildren(frag)
      lyricsScroll.scrollTop = 0
    }

    function syncLyrics(time: number) {
      if (!currentLines.length || !lyricsScroll) return
      let idx = -1
      for (let i = 0; i < currentLines.length; i++) {
        if (currentLines[i].t <= time + 0.25) idx = i
        else break
      }
      if (idx === currentLineIndex) return
      currentLineIndex = idx
      const nodes = lyricsScroll.children
      for (let i = 0; i < nodes.length; i++) {
        nodes[i].classList.toggle('is-current', i === idx)
      }
      if (idx >= 0) {
        const el = nodes[idx] as HTMLElement
        lyricsScroll.scrollTo({
          // Center the line itself. The scroll padding above makes this work
          // for the first and last line too, instead of clamping them into
          // the masked edges.
          top: el.offsetTop - (lyricsScroll.clientHeight - el.offsetHeight) / 2,
          behavior: 'smooth',
        })
      }
    }

    function renderPanel(album: StageAlbum) {
      panelAlbum = album
      if (panelCover) {
        panelCover.src = album.cover || '/joruno.png'
        panelCover.alt = `${album.name} 专辑封面`
      }
      if (panelTitle) panelTitle.textContent = album.name
      if (panelSub) {
        const year = album.releaseDate?.slice(0, 4)
        panelSub.textContent = [album.artist, year && `${year}年`]
          .filter(Boolean)
          .join(' · ')
      }
      const playable = album.songs.some((s) => s.url)
      if (panelPlayAll) {
        panelPlayAll.disabled = !playable
        panelPlayAll.innerHTML = playable
          ? '<span class="i-ri-play-fill"></span> 播放专辑'
          : '音频待补充'
      }
      if (panelTracks) {
        const frag = document.createDocumentFragment()
        album.songs.forEach((song, i) => {
          const li = document.createElement('li')
          const row = document.createElement('button')
          row.type = 'button'
          row.className = 'track-row'
          row.dataset.songId = song.id
          if (!song.url) row.classList.add('is-disabled')
          const qualityTag =
            song.quality?.studioStatus === 'wrong-version'
              ? '非录音室版本'
              : song.quality?.studioStatus === 'correct-master-wrong-length'
                ? '音源长度异常'
                : song.quality?.studioStatus === 'probable-version-match'
                  ? '版本待复核'
                  : song.quality?.studioStatus === 'fingerprint-failed'
                    ? '版本校验失败'
                    : song.quality?.incomplete
                      ? '音源不完整'
                      : song.quality?.lyricsMismatch
                        ? '歌词待校准'
                        : song.quality?.lyricsAlignmentStatus ===
                            'lyrics-incomplete'
                          ? '歌词不完整'
                          : song.quality?.lyricsAlignmentStatus ===
                              'timing-review'
                            ? '时间轴待校准'
                            : song.quality?.lyricsAlignmentStatus ===
                                'lyrics-mismatch'
                              ? '歌词待校准'
                              : !song.url
                                ? '待补音频'
                                : ''
          row.innerHTML = `
            <span class="track-no">${String(i + 1).padStart(2, '0')}</span>
            <span class="track-name">${song.name}</span>
            ${qualityTag ? `<span class="track-tag">${qualityTag}</span>` : ''}
            <span class="track-dur">${song.duration}</span>`
          if (song.url) {
            row.addEventListener('click', () => playTrack(album, i))
          }
          li.appendChild(row)
          frag.appendChild(li)
        })
        panelTracks.replaceChildren(frag)
        panelTracks.scrollTop = 0
      }
    }

    // 黑胶飞行: 从来源封面位置克隆一张小黑胶,FLIP 动画飞到唱机位
    function flyVinylFrom(sourceRect: DOMRect, cover: string | null) {
      if (!vinyl) return Promise.resolve()
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches
      if (reduceMotion) return Promise.resolve()
      const target = vinyl.getBoundingClientRect()
      const size = Math.min(sourceRect.width, sourceRect.height)
      const ghost = document.createElement('div')
      ghost.className = 'vinyl-ghost'
      ghost.style.cssText = `
        position: fixed; z-index: 200; pointer-events: none;
        left: ${sourceRect.left + sourceRect.width / 2 - size / 2}px;
        top: ${sourceRect.top + sourceRect.height / 2 - size / 2}px;
        width: ${size}px; height: ${size}px; border-radius: 50%;
        background:
          radial-gradient(circle at 50% 50%, transparent 0 17%, rgb(0 0 0 / 35%) 18% 19%, transparent 20%),
          repeating-radial-gradient(circle, rgba(255,255,255,0.05) 0 1px, transparent 1px 4px),
          radial-gradient(circle, #202124 0 26%, #0d0e10 27% 100%);
        box-shadow: 0 1rem 2.4rem rgb(0 0 0 / 55%);`
      const label = document.createElement('div')
      label.style.cssText = `
        position: absolute; inset: 31%; border-radius: 50%;
        background: ${cover ? `url("${cover}") center/cover` : 'var(--album-color, #333)'};
        box-shadow: inset 0 0 0 2px rgb(0 0 0 / 35%);`
      ghost.appendChild(label)
      document.body.appendChild(ghost)

      const dx =
        target.left +
        target.width / 2 -
        (sourceRect.left + sourceRect.width / 2)
      const dy =
        target.top +
        target.height / 2 -
        (sourceRect.top + sourceRect.height / 2)
      const scale = target.width / size

      // 唱机位黑胶先隐去,等飞行结束接棒
      vinyl.style.opacity = '0'
      const anim = ghost.animate(
        [
          { transform: 'translate(0, 0) rotate(0deg) scale(1)', opacity: 1 },
          {
            transform: `translate(${dx * 0.5}px, ${dy * 0.5 - 60}px) rotate(200deg) scale(${(1 + scale) / 2})`,
            opacity: 1,
            offset: 0.55,
          },
          {
            transform: `translate(${dx}px, ${dy}px) rotate(380deg) scale(${scale})`,
            opacity: 1,
          },
        ],
        { duration: 1380, easing: 'cubic-bezier(0.2, 0.72, 0.2, 1)' }
      )
      return anim.finished
        .catch((err) => {
          // 动画被中断(如快速连点)属正常,吞掉即可
          void err
        })
        .then(() => {
          ghost.remove()
          if (vinyl) {
            vinyl.style.opacity = ''
            vinyl.animate(
              [
                { transform: 'scale(1.06)' },
                { transform: 'scale(0.98)', offset: 0.6 },
                { transform: 'scale(1)' },
              ],
              { duration: 520, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
            )
          }
        })
    }

    // 音符飘出: 播放时定时从黑胶顶部生成音符
    const NOTE_GLYPHS = ['♪', '♫', '♩', '♬']
    let noteTimer = 0
    function startNotes() {
      if (noteTimer) return
      const notesBox = document.getElementById('vinyl-notes')
      if (!notesBox) return
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches
      if (reduceMotion) return
      const spawn = () => {
        const note = document.createElement('span')
        note.className = 'note'
        note.textContent =
          NOTE_GLYPHS[Math.floor(Math.random() * NOTE_GLYPHS.length)]
        const dur = 2.2 + Math.random() * 1.6
        note.style.setProperty('--note-dur', `${dur}s`)
        note.style.setProperty(
          '--note-dx',
          `${(Math.random() * 2 - 0.6) * 3.4}rem`
        )
        note.style.setProperty(
          '--note-rot',
          `${(Math.random() * 2 - 1) * 32}deg`
        )
        note.style.setProperty(
          '--note-scale',
          String(0.8 + Math.random() * 0.7)
        )
        note.style.setProperty(
          '--note-alpha',
          String(0.55 + Math.random() * 0.35)
        )
        note.style.fontSize = `${0.85 + Math.random() * 0.5}rem`
        notesBox.appendChild(note)
        window.setTimeout(() => note.remove(), dur * 1000 + 100)
      }
      spawn()
      noteTimer = window.setInterval(spawn, 700)
    }
    function stopNotes() {
      if (noteTimer) {
        clearInterval(noteTimer)
        noteTimer = 0
      }
    }

    function selectAlbum(album: StageAlbum) {
      playingAlbum = album
      document.getElementById('music-page-wrapper')?.classList.add('has-album')
      renderRecordContext(album)
      window.dispatchEvent(new CustomEvent('album-selected', { detail: album }))
      if (vinylLabel && album.cover) {
        vinylLabel.style.setProperty('--vinyl-cover', `url("${album.cover}")`)
      }
      void loadLyricsMap(album)
    }

    function playTrack(album: StageAlbum, index: number) {
      if (playingAlbum?.id !== album.id) {
        selectAlbum(album)
      }
      window.dispatchEvent(
        new CustomEvent('song-selected', { detail: { index } })
      )
      renderLyrics(album.songs[index].id)
    }

    window.addEventListener('gallery-album-open', ((e: CustomEvent) => {
      const { album, sourceRect, autoPlay } = e.detail as {
        album: StageAlbum
        sourceRect?: DOMRect
        autoPlay?: boolean
      }
      renderRecordContext(album)
      // 无可播音频: 只展示曲目,不打断当前播放、不换盘
      const playable = album.songs.some((s) => s.url)
      if (!playable) {
        setPanelAvailable(false)
        return
      }
      renderPanel(album)
      setPanelAvailable(true)
      setPanelOpen(false)
      const fly = sourceRect
        ? flyVinylFrom(sourceRect, album.cover)
        : Promise.resolve()
      if (autoPlay) {
        // Start from the original click call stack. Waiting for the vinyl
        // flight here loses the browser's user-gesture allowance for audio.
        const first = album.songs.findIndex((s) => s.url)
        if (first >= 0) playTrack(album, first)
      } else if (sourceRect) {
        // 仅换盘不播: 飞行后更新盘面
        fly.then(() => {
          if (vinylLabel && album.cover)
            vinylLabel.style.setProperty(
              '--vinyl-cover',
              `url("${album.cover}")`
            )
        })
      }
    }) as EventListener)

    panelPlayAll?.addEventListener('click', async () => {
      if (!panelAlbum) return
      const first = panelAlbum.songs.findIndex((s) => s.url)
      if (first >= 0) playTrack(panelAlbum, first)
    })

    document
      .getElementById('track-panel-handle')
      ?.addEventListener('click', () =>
        setPanelOpen(!panel?.classList.contains('is-open'))
      )
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setPanelOpen(false)
    })

    // 倍速与黑胶转速同步: 基准 3.6s/转
    window.addEventListener('set-playback-rate', ((e: CustomEvent) => {
      const rate = Number(e.detail) || 1
      vinyl?.style.setProperty('--spin-duration', `${3.6 / rate}s`)
    }) as EventListener)

    window.addEventListener('playback-state', ((e: CustomEvent) => {
      const { isPlaying, songIndex } = e.detail
      vinyl?.classList.toggle('is-playing', Boolean(isPlaying))
      if (isPlaying) startNotes()
      else stopNotes()
      const song = playingAlbum?.songs[songIndex]
      if (song && song.id !== currentSongId) renderLyrics(song.id)
      panelTracks?.querySelectorAll('.track-row').forEach((row) => {
        row.classList.toggle(
          'is-current',
          Boolean(
            song &&
            (row as HTMLElement).dataset.songId === song.id &&
            panelAlbum?.id === playingAlbum?.id
          )
        )
      })
    }) as EventListener)

    window.addEventListener('playback-progress', ((e: CustomEvent) => {
      const { currentTime, songIndex } = e.detail
      const song = playingAlbum?.songs[songIndex]
      if (song && song.id !== currentSongId) renderLyrics(song.id)
      syncLyrics(Number(currentTime) || 0)
    }) as EventListener)

    // 初始化时同步全局倍速(跨页返回场景)
    const initialRate =
      (window as { MusicPlayerState?: { currentPlaybackRate?: number } })
        .MusicPlayerState?.currentPlaybackRate ?? 1
    vinyl?.style.setProperty('--spin-duration', `${3.6 / initialRate}s`)
  }

  document.addEventListener('astro:page-load', initNowPlaying)
  initNowPlaying()
</script>
