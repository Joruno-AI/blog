---
import AlbumGallery from '~/components/music/AlbumGallery.astro'
import NowPlayingStage from '~/components/music/NowPlayingStage.astro'
import PlayerEngine from '~/components/music/PlayerEngine.astro'
import SongList from '~/components/music/SongList.astro'
---

<div id="global-music-player" transition:persist="music-player">
  <div
    class="music-page-wrapper hidden"
    id="music-page-wrapper"
    style="--album-color: #1a1a2e;"
  >
    <div class="music-ambient" aria-hidden="true">
      <div class="music-ambient-cover"></div>
      <div class="music-ambient-light"></div>
      <div class="music-ambient-noise"></div>
    </div>

    <div class="music-player-container">
      <div class="listening-stage">
        <AlbumGallery />
        <NowPlayingStage />
      </div>

      <section class="playback-hub" id="playback-hub" aria-label="音乐播放控制">
        <aside class="playback-queue" id="playlist-drawer" aria-hidden="true">
          <SongList />
        </aside>

        <div class="now-playing-dock" id="mobile-mini-player">
          <div class="mini-track">
            <span class="mini-track-eyebrow" id="mini-track-eyebrow"
              >等待落针</span
            >
            <span class="mini-track-title" id="mini-track-title"
              >请选择一张唱片</span
            >
            <span class="mini-track-time" id="mini-track-time">0:00 / 0:00</span
            >
          </div>

          <div
            class="mini-progress"
            id="mini-progress"
            role="progressbar"
            aria-label="播放进度"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          >
            <div class="mini-progress-fill" id="mini-progress-fill"></div>
          </div>

          <div class="mini-controls">
            <button
              id="mini-prev"
              class="mini-ctrl-btn"
              type="button"
              aria-label="上一首"
              disabled
            >
              <span class="i-ri-skip-back-fill"></span>
            </button>
            <button
              id="mini-play"
              class="mini-ctrl-btn mini-play-btn"
              type="button"
              aria-label="播放或暂停"
              disabled
            >
              <span class="i-ri-play-fill" id="mini-play-icon"></span>
            </button>
            <button
              id="mini-next"
              class="mini-ctrl-btn"
              type="button"
              aria-label="下一首"
              disabled
            >
              <span class="i-ri-skip-forward-fill"></span>
            </button>
          </div>

          <div class="dock-speed-options" role="group" aria-label="播放速度">
            <button class="dock-speed-btn" type="button" data-rate="0.5"
              >.5×</button
            >
            <button class="dock-speed-btn active" type="button" data-rate="1"
              >1×</button
            >
            <button class="dock-speed-btn" type="button" data-rate="1.5"
              >1.5×</button
            >
            <button class="dock-speed-btn" type="button" data-rate="2"
              >2×</button
            >
          </div>

          <button
            class="queue-toggle"
            id="playlist-trigger"
            type="button"
            aria-label="展开曲目"
            aria-expanded="false"
            aria-controls="playlist-drawer"
          >
            <span class="i-ri-play-list-2-line"></span>
            <span class="queue-toggle-label">曲目</span>
            <i id="playlist-trigger-count">0</i>
            <span class="queue-chevron i-ri-arrow-up-s-line"></span>
          </button>

          <button
            class="dock-collapse-toggle"
            id="player-collapse-trigger"
            type="button"
            aria-label="收起播放条"
          >
            <span class="i-ri-arrow-down-s-line"></span>
          </button>
        </div>

        <div class="compact-player-dock" aria-hidden="true">
          <span class="compact-track-title" id="compact-track-title"
            >请选择一张唱片</span
          >
          <button
            class="compact-play-btn"
            id="compact-play"
            type="button"
            aria-label="播放或暂停"
            disabled
          >
            <span class="i-ri-play-fill" id="compact-play-icon"></span>
          </button>
          <button
            class="compact-expand-btn"
            id="player-expand-trigger"
            type="button"
            aria-label="展开播放条"
          >
            <span class="i-ri-arrow-up-s-line"></span>
          </button>
        </div>
      </section>
    </div>
  </div>
</div>

<PlayerEngine />

<style>
  #global-music-player {
    position: fixed;
    z-index: 100;
    inset: 0;
    pointer-events: none;
  }
  .music-page-wrapper {
    position: fixed;
    inset: 0;
    overflow: hidden;
    color: var(--music-text, #f7f2ea);
    background: var(--music-room-surface, #0c0d0f);
    pointer-events: auto;
    transition:
      opacity 220ms ease,
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .music-page-wrapper.hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(1.25rem);
  }
  .music-player-container,
  .listening-stage {
    position: relative;
    width: 100%;
  }
  .music-player-container {
    display: grid;
    height: 100dvh;
    min-height: 100dvh;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: clip;
  }
  .listening-stage {
    z-index: 2;
    position: relative;
    min-height: 0;
  }

  .playback-hub {
    position: relative;
    z-index: 90;
    width: 100%;
    padding: 0.45rem clamp(0.75rem, 4vw, 4.5rem)
      max(0.55rem, env(safe-area-inset-bottom));
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--music-room-surface, #101318) 94%, transparent),
      color-mix(in srgb, var(--music-room-surface, #101318) 76%, transparent)
    );
    border-top: 0;
    box-shadow: none;
    backdrop-filter: blur(18px) saturate(1.05);
    -webkit-backdrop-filter: blur(18px) saturate(1.05);
    transition:
      background-color 680ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 420ms ease;
  }
  .playback-queue {
    position: absolute;
    right: max(0.75rem, calc((100vw - 70rem) / 2));
    bottom: calc(100% + 0.5rem);
    left: max(0.75rem, calc((100vw - 70rem) / 2));
    height: min(57vh, 34rem);
    overflow: hidden;
    color: var(--music-text, #f7f2ea);
    background: color-mix(
      in srgb,
      var(--album-color, #28303a) 16%,
      var(--music-panel-strong, rgb(10 11 13 / 95%))
    );
    border: 1px solid var(--music-border, rgba(255, 255, 255, 0.12));
    border-radius: 1rem 1rem 0 0;
    box-shadow: var(--music-float-shadow, 0 -1.5rem 5rem rgb(5 6 8 / 32%));
    backdrop-filter: blur(24px) saturate(1.08);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate3d(0, 0.8rem, 0) scale(0.992);
    transform-origin: bottom center;
    transition:
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 170ms ease,
      visibility 260ms ease;
    will-change: transform, opacity;
  }
  .playback-queue.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate3d(0, 0, 0) scale(1);
  }
  .now-playing-dock {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns:
      minmax(9rem, 15rem) minmax(14rem, 1fr) auto auto auto
      auto;
    min-height: 3.85rem;
    width: min(68rem, 100%);
    align-items: center;
    gap: 0.75rem;
    margin-inline: auto;
    padding: 0.58rem 0.65rem 0.58rem 1rem;
    color: var(--music-text, #f7f2ea);
    background: var(--music-control-soft, rgba(255, 255, 255, 0.055));
    border: 0;
    border-radius: 1rem;
    box-shadow:
      inset 0 1px 0 var(--music-highlight, rgba(255, 255, 255, 0.08)),
      var(--music-dock-shadow, 0 0.8rem 2.5rem rgba(3, 5, 8, 0.16));
    backdrop-filter: blur(18px) saturate(1.08);
    -webkit-backdrop-filter: blur(18px) saturate(1.08);
    transition:
      transform 220ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 160ms ease,
      background-color 280ms ease,
      border-color 280ms ease,
      visibility 220ms ease;
    will-change: transform, opacity;
  }
  .mini-track {
    display: grid;
    min-width: 0;
    grid-template-columns: 1fr auto;
    gap: 0.08rem 0.55rem;
  }
  .mini-track-eyebrow {
    grid-column: 1/-1;
    color: var(
      --music-accent-text,
      color-mix(in srgb, var(--album-tint, #d6b57b) 76%, white)
    );
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .mini-track-title {
    overflow: hidden;
    font-size: 0.72rem;
    font-weight: 650;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mini-track-time {
    color: var(--music-text-muted, rgba(247, 242, 234, 0.42));
    font-size: 0.56rem;
    font-variant-numeric: tabular-nums;
  }
  .mini-progress {
    position: relative;
    height: 3px;
    overflow: hidden;
    background: var(--music-progress-track, rgba(255, 255, 255, 0.13));
    border-radius: 999px;
    cursor: pointer;
  }
  .mini-progress-fill {
    position: absolute;
    width: 0;
    background: var(
      --music-accent-fill,
      color-mix(in srgb, var(--album-tint, #d6b57b) 78%, white)
    );
    border-radius: inherit;
    inset: 0 auto 0 0;
  }
  .mini-controls,
  .dock-speed-options {
    display: flex;
    align-items: center;
  }
  .mini-controls {
    gap: 0.12rem;
  }
  .mini-ctrl-btn {
    display: grid;
    width: 2.15rem;
    height: 2.15rem;
    padding: 0;
    color: var(--music-text-soft, rgba(247, 242, 234, 0.67));
    background: transparent;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    place-items: center;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      transform 150ms ease;
  }
  .mini-ctrl-btn:disabled {
    opacity: 0.28;
    cursor: default;
  }
  .mini-play-btn {
    color: var(--music-primary-button-text, #111214);
    background: var(--music-primary-button, #f3eee5);
  }
  .mini-play-btn:disabled {
    color: var(--music-primary-button-text, #111214);
    background: var(--music-primary-button-disabled, rgba(243, 238, 229, 0.5));
  }
  .dock-speed-options {
    gap: 0.1rem;
    padding: 0.15rem;
    background: var(--music-control-soft, rgba(255, 255, 255, 0.055));
    border: 0;
    border-radius: 0.65rem;
  }
  .dock-speed-btn {
    min-width: 1.85rem;
    height: 1.75rem;
    padding: 0 0.28rem;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.43));
    background: transparent;
    border: 0;
    border-radius: 0.48rem;
    font-size: 0.58rem;
    cursor: pointer;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      transform 150ms ease;
  }
  .dock-speed-btn.active {
    color: var(--music-primary-button-text, #111214);
    background: var(--music-primary-button, #eee8de);
  }
  .queue-toggle {
    display: flex;
    min-height: 2.4rem;
    align-items: center;
    gap: 0.42rem;
    padding: 0.38rem 0.48rem 0.38rem 0.62rem;
    color: var(--music-text-soft, rgba(247, 242, 234, 0.76));
    background: var(--music-control-soft, rgba(255, 255, 255, 0.055));
    border: 0;
    border-radius: 0.72rem;
    cursor: pointer;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      border-color 150ms ease,
      transform 150ms ease;
  }
  .dock-collapse-toggle,
  .compact-expand-btn,
  .compact-play-btn {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    color: var(--music-text-soft, rgba(247, 242, 234, 0.76));
    background: var(--music-control-soft, rgba(255, 255, 255, 0.055));
    border: 0;
    border-radius: 0.72rem;
    cursor: pointer;
    place-items: center;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      border-color 150ms ease,
      transform 150ms ease;
  }
  .compact-player-dock {
    position: absolute;
    bottom: 0;
    left: 50%;
    z-index: 3;
    display: grid;
    width: min(22rem, calc(100vw - 1.2rem));
    min-height: 3.35rem;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.48rem 0.42rem 0.85rem;
    color: var(--music-text, #f7f2ea);
    background: var(--music-control-soft, rgba(255, 255, 255, 0.06));
    border: 0;
    border-radius: 1rem;
    box-shadow: inset 0 1px 0 var(--music-highlight, rgba(255, 255, 255, 0.08));
    backdrop-filter: blur(18px) saturate(1.08);
    -webkit-backdrop-filter: blur(18px) saturate(1.08);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate3d(-50%, 0.5rem, 0) scale(0.965);
    transition:
      transform 220ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 150ms ease,
      background-color 280ms ease,
      border-color 280ms ease,
      visibility 220ms ease;
    will-change: transform, opacity;
  }
  .compact-track-title {
    overflow: hidden;
    font-size: 0.72rem;
    font-weight: 650;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .compact-play-btn {
    color: var(--music-primary-button-text, #111214);
    background: var(--music-primary-button, #f3eee5);
    border-color: transparent;
    border-radius: 999px;
  }
  .compact-play-btn:disabled {
    opacity: 0.42;
  }
  .playback-hub.is-collapsed .now-playing-dock {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate3d(0, 0.5rem, 0) scale(0.985);
  }
  .playback-hub.is-collapsed .compact-player-dock {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate3d(-50%, 0, 0) scale(1);
  }
  .queue-toggle-label {
    font-size: 0.66rem;
    font-weight: 650;
  }
  .queue-toggle i {
    display: grid;
    min-width: 1.25rem;
    height: 1.25rem;
    color: var(--music-text-muted, rgba(247, 242, 234, 0.56));
    background: var(--music-control-soft, rgba(255, 255, 255, 0.07));
    border-radius: 999px;
    font-size: 0.54rem;
    font-style: normal;
    place-items: center;
  }
  .queue-chevron {
    font-size: 0.86rem;
    transition: transform 210ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .queue-toggle[aria-expanded='true'] .queue-chevron {
    transform: rotate(180deg);
  }
  .queue-toggle[aria-expanded='true'] {
    color: var(--music-text-strong, #fffaf2);
    background: var(--music-control-hover, rgba(255, 255, 255, 0.1));
    border-color: rgba(255, 255, 255, 0.17);
  }
  @media (hover: hover) and (pointer: fine) {
    .mini-ctrl-btn:not(:disabled):hover,
    .dock-speed-btn:hover,
    .queue-toggle:hover,
    .dock-collapse-toggle:hover,
    .compact-expand-btn:hover {
      color: var(--music-text-strong, #fffaf2);
      background-color: var(--music-control-hover, rgba(255, 255, 255, 0.1));
    }
    .mini-play-btn:not(:disabled):hover {
      color: var(--music-primary-button-text, #111214);
      background: var(--music-primary-button-hover, #fffaf2);
      transform: scale(1.035);
    }
  }
  .mini-ctrl-btn:not(:disabled):active,
  .dock-speed-btn:active,
  .queue-toggle:active,
  .dock-collapse-toggle:active,
  .compact-expand-btn:active,
  .compact-play-btn:active {
    transform: scale(0.97);
  }

  @media (max-width: 1024px) {
    .gramophone-hint {
      display: none;
    }
    .now-playing-dock {
      grid-template-columns:
        minmax(8rem, 1fr) minmax(6rem, 0.9fr)
        auto auto auto auto;
      gap: 0.5rem;
    }
  }
  @media (max-width: 960px) {
    .playback-queue {
      right: 0.55rem;
      bottom: calc(100% + 0.45rem);
      left: 0.55rem;
      height: min(62dvh, 32rem);
      max-height: calc(100dvh - 8.5rem);
      border-radius: 1rem;
    }
    .now-playing-dock {
      grid-template-areas:
        'track controls queue collapse'
        'progress progress progress progress';
      grid-template-columns: minmax(0, 1fr) auto auto auto;
      gap: 0.42rem 0.55rem;
      min-height: 4.75rem;
      padding: 0.48rem 0.52rem 0.55rem 0.72rem;
      border-radius: 0.95rem;
    }
    .mini-track {
      grid-area: track;
    }
    .mini-progress {
      grid-area: progress;
    }
    .mini-controls {
      grid-area: controls;
    }
    .dock-speed-options {
      display: none;
    }
    .queue-toggle {
      grid-area: queue;
    }
    .dock-collapse-toggle {
      grid-area: collapse;
    }
    .mini-track-time,
    .mini-track-eyebrow {
      display: none;
    }
    .mini-track {
      display: block;
    }
  }
  @media (max-width: 480px) {
    .queue-toggle-label {
      display: none;
    }
    .queue-toggle {
      gap: 0.28rem;
      padding-inline: 0.48rem;
    }
    .mini-ctrl-btn:not(.mini-play-btn) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .music-page-wrapper,
    .playback-queue,
    .now-playing-dock,
    .compact-player-dock,
    .queue-chevron,
    .mini-ctrl-btn,
    .dock-speed-btn,
    .queue-toggle,
    .dock-collapse-toggle,
    .compact-expand-btn,
    .compact-play-btn {
      transition-duration: 1ms !important;
    }
  }
</style>

<script>
  interface MiniSong {
    name: string
  }
  interface MusicPlayerState {
    isPlaying: boolean
    isInitialized: boolean
    currentSongs?: MiniSong[]
    currentSongIndex?: number
    currentAlbumId?: string | null
    currentPlaybackRate?: number
    currentVinylRotation?: number
    shellEventsBound?: boolean
    playerCollapsed?: boolean
  }
  declare global {
    interface Window {
      MusicPlayerState: MusicPlayerState
    }
  }

  if (!window.MusicPlayerState) {
    window.MusicPlayerState = {
      isPlaying: false,
      isInitialized: false,
      currentPlaybackRate: 1,
      currentVinylRotation: 0,
    }
  }

  function isMusicPage() {
    return /^\/music\/?$/.test(window.location.pathname)
  }
  function updatePlayerVisibility() {
    document
      .getElementById('music-page-wrapper')
      ?.classList.toggle('hidden', !isMusicPage())
  }
  function formatTime(seconds: number) {
    if (!Number.isFinite(seconds) || seconds < 0) return '0:00'
    return `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`
  }
  function setControlsEnabled(enabled: boolean) {
    document
      .querySelectorAll<HTMLButtonElement>(
        '#mini-prev, #mini-play, #mini-next, #compact-play'
      )
      .forEach((button) => {
        button.disabled = !enabled
      })
  }
  function updateMiniTrack() {
    const state = window.MusicPlayerState
    const song = state.currentSongs?.[state.currentSongIndex ?? 0]
    const title = document.getElementById('mini-track-title')
    const compactTitle = document.getElementById('compact-track-title')
    const eyebrow = document.getElementById('mini-track-eyebrow')
    if (title) title.textContent = song?.name ?? '请选择一张唱片'
    if (compactTitle) compactTitle.textContent = song?.name ?? '请选择一张唱片'
    if (eyebrow)
      eyebrow.textContent = song
        ? state.isPlaying
          ? '正在播放'
          : '已就绪'
        : '等待落针'
    setControlsEnabled(Boolean(song))
  }
  function updatePlayIcon(isPlaying: boolean) {
    const icon = document.getElementById('mini-play-icon')
    const compactIcon = document.getElementById('compact-play-icon')
    if (icon) icon.className = isPlaying ? 'i-ri-pause-fill' : 'i-ri-play-fill'
    if (compactIcon)
      compactIcon.className = isPlaying ? 'i-ri-pause-fill' : 'i-ri-play-fill'
  }
  function setPlaylistOpen(open: boolean) {
    const playerContainer = document.querySelector<HTMLElement>(
      '.music-player-container'
    )
    if (playerContainer) playerContainer.scrollTop = 0
    const drawer = document.getElementById('playlist-drawer')
    const trigger = document.getElementById('playlist-trigger')
    drawer?.classList.toggle('active', open)
    drawer?.setAttribute('aria-hidden', String(!open))
    trigger?.setAttribute('aria-expanded', String(open))
    trigger?.setAttribute('aria-label', open ? '收起曲目' : '展开曲目')
  }
  function setPlayerCollapsed(collapsed: boolean) {
    const hub = document.getElementById('playback-hub')
    const fullDock = document.getElementById('mobile-mini-player')
    const compactDock = hub?.querySelector<HTMLElement>('.compact-player-dock')
    window.MusicPlayerState.playerCollapsed = collapsed
    hub?.classList.toggle('is-collapsed', collapsed)
    fullDock?.setAttribute('aria-hidden', String(collapsed))
    compactDock?.setAttribute('aria-hidden', String(!collapsed))
    if (collapsed) setPlaylistOpen(false)
  }
  function syncSpeed(rate: number) {
    window.MusicPlayerState.currentPlaybackRate = rate
    document
      .querySelectorAll<HTMLButtonElement>('.dock-speed-btn')
      .forEach((button) => {
        button.classList.toggle('active', Number(button.dataset.rate) === rate)
      })
  }
  function bindGlobalMusicEvents() {
    if (window.MusicPlayerState.shellEventsBound) return
    window.MusicPlayerState.shellEventsBound = true
    window.addEventListener('album-selected', ((event: CustomEvent) => {
      const album = event.detail
      if (!album || !Array.isArray(album.songs)) return
      window.MusicPlayerState.currentAlbumId = album.id ?? null
      window.MusicPlayerState.currentSongs = album.songs.map(
        (song: { name: string }) => ({ name: song.name })
      )
      window.MusicPlayerState.currentSongIndex = 0
      window.MusicPlayerState.isPlaying = false
      const count = document.getElementById('playlist-trigger-count')
      if (count) count.textContent = String(album.songs.length)
      const fill = document.getElementById('mini-progress-fill')
      const progress = document.getElementById('mini-progress')
      const time = document.getElementById('mini-track-time')
      if (fill) fill.style.width = '0%'
      progress?.setAttribute('aria-valuenow', '0')
      if (time) time.textContent = '0:00 / 0:00'
      updateMiniTrack()
      updatePlayIcon(false)
    }) as EventListener)
    window.addEventListener('playback-state', ((event: CustomEvent) => {
      const { isPlaying, songIndex } = event.detail
      window.MusicPlayerState.isPlaying = Boolean(isPlaying)
      if (typeof songIndex === 'number')
        window.MusicPlayerState.currentSongIndex = songIndex
      updateMiniTrack()
      updatePlayIcon(Boolean(isPlaying))
    }) as EventListener)
    window.addEventListener('playback-progress', ((event: CustomEvent) => {
      const { currentTime, duration, songIndex } = event.detail
      if (typeof songIndex === 'number')
        window.MusicPlayerState.currentSongIndex = songIndex
      const percent =
        duration > 0 ? Math.min(100, (currentTime / duration) * 100) : 0
      const fill = document.getElementById('mini-progress-fill')
      const progress = document.getElementById('mini-progress')
      const time = document.getElementById('mini-track-time')
      if (fill) fill.style.width = `${percent}%`
      progress?.setAttribute('aria-valuenow', String(Math.round(percent)))
      if (time)
        time.textContent = `${formatTime(currentTime)} / ${formatTime(duration)}`
      updateMiniTrack()
    }) as EventListener)
    window.addEventListener('set-playback-rate', ((event: CustomEvent) =>
      syncSpeed(Number(event.detail) || 1)) as EventListener)
  }
  function initialiseMusicShell() {
    bindGlobalMusicEvents()
    updatePlayerVisibility()
    const root = document.getElementById('music-page-wrapper')
    if (!root || root.dataset.shellBound === 'true') return
    root.dataset.shellBound = 'true'
    document
      .getElementById('playlist-trigger')
      ?.addEventListener('click', () =>
        setPlaylistOpen(
          !document
            .getElementById('playlist-drawer')
            ?.classList.contains('active')
        )
      )
    document
      .getElementById('mini-play')
      ?.addEventListener('click', () =>
        window.dispatchEvent(new CustomEvent('toggle-play'))
      )
    document
      .getElementById('compact-play')
      ?.addEventListener('click', () =>
        window.dispatchEvent(new CustomEvent('toggle-play'))
      )
    document
      .getElementById('mini-prev')
      ?.addEventListener('click', () =>
        window.dispatchEvent(new CustomEvent('prev-song'))
      )
    document
      .getElementById('mini-next')
      ?.addEventListener('click', () =>
        window.dispatchEvent(new CustomEvent('next-song'))
      )
    document
      .getElementById('mini-progress')
      ?.addEventListener('click', (event) => {
        const bar = event.currentTarget as HTMLElement
        const rect = bar.getBoundingClientRect()
        window.dispatchEvent(
          new CustomEvent('seek-to', {
            detail: Math.max(
              0,
              Math.min(1, (event.clientX - rect.left) / rect.width)
            ),
          })
        )
      })
    document
      .getElementById('player-collapse-trigger')
      ?.addEventListener('click', () => setPlayerCollapsed(true))
    document
      .getElementById('player-expand-trigger')
      ?.addEventListener('click', () => setPlayerCollapsed(false))
    document
      .querySelectorAll<HTMLButtonElement>('.dock-speed-btn')
      .forEach((button) => {
        button.addEventListener('click', () => {
          const rate = Number(button.dataset.rate)
          if (!Number.isFinite(rate)) return
          syncSpeed(rate)
          window.dispatchEvent(
            new CustomEvent('set-playback-rate', { detail: rate })
          )
        })
      })
    document.addEventListener('click', (event) => {
      const target = event.target as Node
      const hub = document.getElementById('playback-hub')
      if (hub && !hub.contains(target)) setPlaylistOpen(false)
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isMusicPage()) setPlaylistOpen(false)
    })
    syncSpeed(window.MusicPlayerState.currentPlaybackRate ?? 1)
    setPlayerCollapsed(Boolean(window.MusicPlayerState.playerCollapsed))
    updateMiniTrack()
    updatePlayIcon(window.MusicPlayerState.isPlaying)
  }
  document.addEventListener('astro:page-load', initialiseMusicShell)
  initialiseMusicShell()
</script>
