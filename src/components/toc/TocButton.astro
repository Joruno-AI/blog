---

<button
  id="toc-open-button"
  class="floating-tool-button"
  type="button"
  aria-label="展开文章目录"
  title="展开文章目录"
>
  <span class="i-lucide-panel-right-open" aria-hidden="true"></span>
</button>

<style>
  #toc-open-button {
    top: 50%;
    right: -0.9375rem;
    bottom: auto;
    width: 1.875rem;
    height: 1.875rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
    visibility: hidden;
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease,
      opacity 160ms ease;
  }

  #toc-open-button > span {
    font-size: 1rem;
  }

  @media (max-width: 1127px) {
    #toc-open-button {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(-50%);
      visibility: visible;
    }
  }

  @media (max-width: 1127px) and (hover: hover) and (pointer: fine) {
    #toc-open-button:hover,
    #toc-open-button:focus-visible {
      transform: translate(-0.9375rem, -50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #toc-open-button {
      transition-duration: 1ms;
    }
  }
</style>

<script>
  import { toggleFadeEffect } from '~/utils/misc'

  document.addEventListener('astro:page-load', () => {
    /* Open toc panel when user click on button */
    const handleBtnClickToOpen = () => {
      toggleFadeEffect('backdrop', true, 'hidden')
      toggleFadeEffect('toc-panel', true, 'hidden!')
    }

    const tocOpenButton = document.getElementById('toc-open-button')
    tocOpenButton?.addEventListener('click', handleBtnClickToOpen)
  })
</script>
