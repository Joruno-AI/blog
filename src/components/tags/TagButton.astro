---
interface Props {
  stacked?: boolean
}

const { stacked = false } = Astro.props
---

<button
  id="tag-open-button"
  style={{ bottom: stacked ? '14rem' : '2rem' }}
  class="floating-tool-button"
  type="button"
  aria-label="展开标签筛选"
  title="展开标签筛选"
>
  <span class="i-ri-price-tag-3-line" aria-hidden="true"></span>
</button>

<style>
  #tag-open-button {
    right: 1.25rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.35rem) scale(0.96);
    visibility: hidden;
  }

  @media (max-width: 1127px) {
    #tag-open-button {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0) scale(1);
      visibility: visible;
    }
  }
</style>

<script>
  import { toggleFadeEffect } from '~/utils/misc'

  document.addEventListener('astro:page-load', () => {
    /* Open tag panel when user click on button */
    const handleBtnClickToOpen = () => {
      console.debug('[tag] open panel')
      toggleFadeEffect('backdrop', true, 'hidden')
      toggleFadeEffect('tag-panel', true, 'hidden!')
    }

    const tagOpenButton = document.getElementById('tag-open-button')
    tagOpenButton?.addEventListener('click', handleBtnClickToOpen)
  })
</script>
