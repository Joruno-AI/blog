---
import LogoButton from '~/components/widgets/LogoButton.astro'
import Divider from '~/components/base/Divider.astro'
import SearchButton from '~/components/widgets/SearchButton.astro'
import ThemeSwitch from '~/components/widgets/ThemeSwitch.astro'
import RssLink from '~/components/widgets/RssLink.astro'
import NavItem from '~/components/nav/NavItem.astro'
import NavSwitch from '~/components/nav/NavSwitch.astro'

import { UI } from '~/config'

const { navBarLayout, internalNavs, socialLinks } = UI
const { left, right, mergeOnMobile } = navBarLayout

for (const item of new Set(left)) {
  if (new Set(right).has(item)) {
    throw new Error(
      `Duplicate '${item}' found in both 'UI.navBarLayout.left' and 'UI.navBarLayout.right'.`
    )
  }
}
---

<header
  class={`nav-header fixed top-0 left-0 right-0 z-50 flex items-center p-[1rem_2rem_1rem] ${mergeOnMobile ? 'lt-md:px-7' : 'lt-md:px-6'}`}
>
  <div class="logo-wrapper mr-6 lt-md:mr-3">
    <LogoButton />
  </div>
  <nav
    class={`main-nav flex items-center gap-4.8 w-full lt-md:justify-end
    ${left.length !== 0 ? (right.length !== 0 ? 'justify-between' : '') : 'justify-end'}`}
    aria-label="Main menu"
  >
    {
      left.length !== 0 && (
        <div
          class={`grid grid-flow-col items-center gap-4.8 print:op-0 ${mergeOnMobile ? '' : 'lt-md:(gap-3)'}`}
        >
          {left.map((key) =>
            key === 'hr' ? (
              <Divider class={mergeOnMobile ? 'lt-md:hidden' : undefined} />
            ) : key === 'searchButton' ? (
              <SearchButton />
            ) : key === 'themeButton' ? (
              <ThemeSwitch />
            ) : key === 'rssLink' ? (
              <RssLink class={mergeOnMobile ? 'lt-md:hidden' : undefined} />
            ) : key === 'internalNavs' ? (
              internalNavs.map((item) => (
                <NavItem type="internal" {item} {mergeOnMobile} />
              ))
            ) : (
              socialLinks.map((item) => (
                <NavItem type="social" {item} {mergeOnMobile} />
              ))
            )
          )}
        </div>
      )
    }
    {
      right.length !== 0 && (
        <div
          class={`grid grid-flow-col items-center gap-4.8 print:op-0
              ${!right.includes('themeButton') && !right.includes('searchButton') && 'lt-md:hidden'}
              ${mergeOnMobile ? '' : 'lt-md:(gap-3)'}`}
        >
          {right.map((key) =>
            key === 'hr' ? (
              <Divider class={mergeOnMobile ? 'lt-md:hidden' : undefined} />
            ) : key === 'searchButton' ? (
              <SearchButton />
            ) : key === 'themeButton' ? (
              <ThemeSwitch />
            ) : key === 'rssLink' ? (
              <RssLink class={mergeOnMobile ? 'lt-md:hidden' : undefined} />
            ) : key === 'internalNavs' ? (
              internalNavs.map((item) => (
                <NavItem type="internal" {item} {mergeOnMobile} />
              ))
            ) : (
              socialLinks.map((item) => (
                <NavItem type="social" {item} {mergeOnMobile} />
              ))
            )
          )}
        </div>
      )
    }
    {
      mergeOnMobile && (
        <NavSwitch>
          <Fragment slot="text">
            {internalNavs.length !== 0 &&
              internalNavs.map((item) => (
                <NavItem
                  type="internal"
                  {item}
                  {mergeOnMobile}
                  mobileItemType="text"
                />
              ))}
            {socialLinks.length !== 0 &&
              socialLinks.map((item) => (
                <NavItem
                  type="social"
                  {item}
                  {mergeOnMobile}
                  mobileItemType="text"
                />
              ))}
          </Fragment>
          <Fragment slot="icon">
            {internalNavs.length !== 0 &&
              internalNavs.map((item) => (
                <NavItem
                  type="internal"
                  {item}
                  {mergeOnMobile}
                  mobileItemType="icon"
                />
              ))}
            {socialLinks.length !== 0 &&
              socialLinks.map((item) => (
                <NavItem
                  type="social"
                  {item}
                  {mergeOnMobile}
                  mobileItemType="icon"
                />
              ))}
            <RssLink class="op-50!" />
          </Fragment>
        </NavSwitch>
      )
    }
  </nav>
</header>

<style>
  .logo-wrapper {
    transition: all 0.5s ease-in-out;
    width: auto;
    opacity: 1;
    overflow: hidden;
  }

  /* Even hover/current highlight around each nav icon.
     Padding is uniform on all sides; the grid gap is tightened and the
     row is pulled out with negative margin so icons keep their original
     visual positions while gaining a rounded-square hit area. */
  .main-nav :global(.grid-flow-col) {
    gap: 0.25rem;
    margin-inline: -0.5rem;
  }

  .main-nav :global(.grid-flow-col > a),
  .main-nav :global(.grid-flow-col > button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 0.5rem;
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
  }

  .main-nav :global(.grid-flow-col > a:hover),
  .main-nav :global(.grid-flow-col > a:focus-visible),
  .main-nav :global(.grid-flow-col > button:hover),
  .main-nav :global(.grid-flow-col > button:focus-visible),
  .main-nav :global(.grid-flow-col > a[aria-current='page']) {
    background: var(--c-surface-hover);
  }

  .main-nav :global(a[data-music-nav]) {
    position: relative;
    overflow: visible;
  }

  .main-nav :global(a[data-music-nav] > div) {
    transform-origin: center;
  }

  .main-nav :global(a[data-music-nav][data-playing='true'] > div) {
    animation: navbar-record-spin 3s linear infinite;
  }

  .main-nav :global(a[data-music-nav][data-playing='true'])::before,
  .main-nav :global(a[data-music-nav][data-playing='true'])::after {
    position: absolute;
    z-index: 2;
    left: 52%;
    top: 40%;
    color: var(--c-text-muted);
    font-size: 0.72rem;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
    text-shadow: 0 1px 8px color-mix(in srgb, var(--c-bg) 75%, transparent);
  }

  .main-nav :global(a[data-music-nav][data-playing='true'])::before {
    content: '♪';
    animation: navbar-music-note 2.4s ease-out infinite;
  }

  .main-nav :global(a[data-music-nav][data-playing='true'])::after {
    content: '♫';
    animation: navbar-music-note 2.4s 1.2s ease-out infinite;
  }

  @keyframes navbar-record-spin {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes navbar-music-note {
    0% {
      opacity: 0;
      transform: translate(-15%, 0) scale(0.72) rotate(-8deg);
    }
    18% {
      opacity: 0.75;
    }
    75% {
      opacity: 0.42;
    }
    100% {
      opacity: 0;
      transform: translate(0.85rem, -1.45rem) scale(1.08) rotate(9deg);
    }
  }

  @media (max-width: 767px) {
    :global(.nav-header:has(#nav-panel.visible)) {
      z-index: 200;
    }

    .logo-wrapper {
      width: 4.25rem;
      flex: 0 0 4.25rem;
      margin-right: 0.5rem !important;
    }

    .logo-wrapper :global(.logo-svg) {
      width: 4.25rem;
    }

    /* The desktop hit-area rule above sets display:inline-flex with higher
       specificity than Uno's responsive utility. Reinstate the intended
       mobile hiding so the icon row collapses into the menu button. */
    .main-nav :global(.grid-flow-col > [class~='lt-md:hidden']) {
      display: none !important;
    }

    .main-nav :global(.grid-flow-col) {
      margin-inline: 0;
    }

    .main-nav {
      gap: 0.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .main-nav :global(a[data-music-nav][data-playing='true'] > div) {
      animation: none;
    }

    .main-nav :global(a[data-music-nav][data-playing='true'])::before,
    .main-nav :global(a[data-music-nav][data-playing='true'])::after {
      display: none;
    }
  }
</style>

<script>
  type PlaybackStateEvent = CustomEvent<{ isPlaying?: boolean }>

  function syncNavbarMusicState(isPlaying?: boolean) {
    const musicState = (
      window as typeof window & {
        MusicPlayerState?: { isPlaying?: boolean }
      }
    ).MusicPlayerState
    const playing = isPlaying ?? Boolean(musicState?.isPlaying)

    document
      .querySelectorAll<HTMLElement>('[data-music-nav]')
      .forEach((link) => {
        link.dataset.playing = String(playing)
        link.setAttribute(
          'aria-label',
          playing
            ? '音乐播放中，打开播放器'
            : link.getAttribute('title') || '打开音乐'
        )
      })
  }

  window.addEventListener('playback-state', ((event: PlaybackStateEvent) => {
    syncNavbarMusicState(Boolean(event.detail?.isPlaying))
  }) as EventListener)

  document.addEventListener('astro:page-load', () => {
    syncNavbarMusicState()
  })
</script>
