---

---

<button
  type="button"
  id="nav-open-button"
  class="hidden lt-md:flex items-center justify-center op-60 hover:op-100 op-transition touch-target"
  title="打开导航菜单"
  aria-label="打开导航菜单"
  aria-expanded="false"
  aria-controls="nav-panel"
>
  <div u-i-ri-menu-line class="nav-toggle-icon"></div>
</button>

<div
  id="nav-panel"
  class="hidden! fixed top-16
    overflow-y-auto flex flex-col gap-4
    max-h-[calc(100vh-5rem)] py-2 px-2 rounded-xl touch-scroll
    text-[var(--c-text)]"
  style="left: 50%; view-transition-name: none;"
  role="navigation"
  aria-label="导航菜单"
>
  <ul class="mobile-nav-text-list mt-2">
    <slot name="text" />
  </ul>
  <div class="mobile-nav-icon-grid">
    <slot name="icon" />
  </div>
</div>

<style>
  #nav-open-button {
    display: none;
  }

  #nav-panel {
    position: fixed;
    top: 4.25rem;
    z-index: 9999;
    width: min(calc(100vw - 1rem), 30rem);
    max-height: calc(100vh - 5rem);
    overflow-y: auto;
    flex-direction: column;
    gap: 1rem;
    padding: 0.5rem;
    border-radius: 0.75rem;
  }

  #nav-panel[class~='hidden!'] {
    display: none !important;
  }

  #nav-panel:not([class~='hidden!']) {
    display: flex !important;
  }

  #nav-open-button {
    box-sizing: border-box;
    width: 2.2rem;
    height: 2.2rem;
    min-width: 0;
    min-height: 0;
    flex: 0 0 2.2rem;
    padding: 0.5rem;
    border-radius: 0.5rem;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      opacity 160ms ease,
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  #nav-open-button[aria-expanded='true'] {
    background: var(--c-surface-active);
    color: var(--c-text);
    opacity: 1;
  }

  .nav-toggle-icon {
    font-size: 1.2rem;
    transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  #nav-open-button[aria-expanded='true'] .nav-toggle-icon {
    transform: scale(0.9);
  }

  .mobile-nav-text-list:empty {
    display: none;
  }

  .mobile-nav-icon-grid {
    --mobile-nav-item-size: clamp(1.75rem, 8vw, 2rem);
    --mobile-nav-gap: clamp(0.16rem, 0.8vw, 0.25rem);

    display: flex;
    flex-wrap: wrap;
    gap: var(--mobile-nav-gap);
    justify-content: center;
    padding: 0.25rem 0;
  }

  .mobile-nav-icon-grid :global(a) {
    display: inline-flex;
    width: var(--mobile-nav-item-size);
    height: var(--mobile-nav-item-size);
    min-width: 0 !important;
    min-height: 0 !important;
    padding: 0 !important;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.45rem;
    color: var(--c-text-muted);
    opacity: 1 !important;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .mobile-nav-icon-grid :global(a[aria-current='page']) {
    border-color: var(--c-border-soft);
    background: var(--c-surface-active);
    color: var(--c-text);
  }

  @media (hover: hover) and (pointer: fine) {
    .mobile-nav-icon-grid :global(a:hover),
    .mobile-nav-icon-grid :global(a:focus-visible) {
      border-color: var(--c-border-soft);
      background: var(--c-surface-hover);
      color: var(--c-text);
    }
  }

  .mobile-nav-icon-grid :global(a:active) {
    transform: scale(0.96);
  }

  .mobile-nav-icon-grid :global(a > div) {
    font-size: clamp(1rem, 4.8vw, 1.15rem);
  }

  @media (max-width: 767px) {
    #nav-open-button {
      display: inline-flex !important;
    }
  }

  @media (max-width: 360px) {
    .mobile-nav-icon-grid {
      --mobile-nav-item-size: 1.75rem;
    }
  }
</style>

<script>
  let navPanelController: AbortController | null = null
  let navPanelCloseTimer = 0

  function mountNavPanel() {
    navPanelController?.abort()
    window.clearTimeout(navPanelCloseTimer)
    navPanelController = new AbortController()
    const { signal } = navPanelController
    const navPanel = document.getElementById('nav-panel')
    const navOpenButton = document.getElementById('nav-open-button')

    /* 页面加载时重置面板状态 */
    navPanel?.classList.remove('visible')
    navPanel?.classList.add('hidden!')
    navOpenButton?.setAttribute('aria-expanded', 'false')

    /* 打开导航面板 */
    const openNavPanel = (allowMotion = true) => {
      if (!navPanel) return
      window.clearTimeout(navPanelCloseTimer)
      navPanel.classList.remove('hidden!')
      navPanel.toggleAttribute('data-no-motion', !allowMotion)
      requestAnimationFrame(() => {
        navPanel.classList.add('visible')
      })
      navOpenButton?.setAttribute('aria-expanded', 'true')
      navOpenButton?.setAttribute('aria-label', '收起导航菜单')
      navOpenButton?.setAttribute('title', '收起导航菜单')
    }

    /* 关闭导航面板 */
    const closeNavPanel = (restoreFocus = true, allowMotion = true) => {
      if (!navPanel || navPanel.classList.contains('hidden!')) return
      window.clearTimeout(navPanelCloseTimer)
      navPanel.toggleAttribute('data-no-motion', !allowMotion)
      navPanel.classList.remove('visible')
      navOpenButton?.setAttribute('aria-expanded', 'false')
      navOpenButton?.setAttribute('aria-label', '打开导航菜单')
      navOpenButton?.setAttribute('title', '打开导航菜单')
      const finish = () => {
        navPanel.classList.add('hidden!')
        navPanel.removeAttribute('data-no-motion')
      }
      if (allowMotion) navPanelCloseTimer = window.setTimeout(finish, 240)
      else finish()
      if (restoreFocus) navOpenButton?.focus()
    }

    /* 事件绑定 */
    navOpenButton?.addEventListener(
      'click',
      (event) => {
        const isOpen = navOpenButton.getAttribute('aria-expanded') === 'true'
        if (isOpen) closeNavPanel(false, event.detail > 0)
        else openNavPanel(event.detail > 0)
      },
      { signal }
    )
    document.addEventListener(
      'click',
      (event) => {
        const target = event.target
        if (
          target instanceof Node &&
          !navPanel?.contains(target) &&
          !navOpenButton?.contains(target)
        ) {
          closeNavPanel(false)
        }
      },
      { signal }
    )
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape') closeNavPanel(true, false)
      },
      { signal }
    )
  }

  document.addEventListener('astro:page-load', mountNavPanel)
  document.addEventListener('astro:before-swap', () => {
    navPanelController?.abort()
    window.clearTimeout(navPanelCloseTimer)
  })
</script>
