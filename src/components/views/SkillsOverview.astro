---
import { getCollection } from 'astro:content'

import Link from '~/components/base/Link.astro'
import SkillCategoryIcon from '~/components/views/SkillCategoryIcon.astro'
import SkillMiniCard from '~/components/views/SkillMiniCard.astro'
import SkillSelect from '~/components/views/SkillSelect.astro'
import skillsMeta from '~/content/skills/meta.json'
import scenesData from '~/data/skill-scenes.json'
import '~/styles/skills.css'
import { withBasePath } from '~/utils/path'
import {
  CATEGORY_ICONS,
  CATEGORY_LABELS,
  SKILL_CATEGORIES,
  formatCount,
  githubAvatar,
} from '~/utils/skills'
import { loadFullIndex } from '~/utils/skills-data'

const selected = (await getCollection('skills')).map((entry) => entry.data)
const fullIndex = loadFullIndex()
const enrichMap = Object.fromEntries(
  selected.map((skill) => [
    skill.id,
    { descZh: skill.descZh, installs: skill.installs },
  ])
)

const totalStars = fullIndex.reduce((sum, skill) => sum + skill.s, 0)
const safeCount = fullIndex.filter((skill) => skill.g === 'safe').length
const avgQuality =
  Math.round(
    (fullIndex.reduce((sum, skill) => sum + skill.q, 0) / fullIndex.length) * 10
  ) / 10
const premiumCount = fullIndex.filter((skill) => skill.q >= 80).length

const stats = [
  {
    label: '全量项目',
    value: fullIndex.length,
    fmt: fullIndex.length.toLocaleString('zh-CN'),
    note: '完整索引',
  },
  {
    label: '累计 Stars',
    value: totalStars,
    fmt: formatCount(totalStars),
    note: '社区热度',
  },
  {
    label: '安全评级通过',
    value: safeCount,
    fmt: `${Math.round((safeCount / fullIndex.length) * 100)}%`,
    note: `${safeCount.toLocaleString('zh-CN')} 项`,
  },
  {
    label: '平均质量分',
    value: avgQuality,
    fmt: String(avgQuality),
    note: `${premiumCount} 个 S 级`,
  },
]

const categorySections = SKILL_CATEGORIES.map((category) => {
  const items = fullIndex
    .filter((skill) => skill.c === category)
    .sort((a, b) => b.s - a.s)
  return {
    key: category,
    label: CATEGORY_LABELS[category],
    count: items.length,
    items: items.slice(0, 3),
  }
})
const pulseFocalCategory = categorySections.reduce((highest, category) =>
  category.count > highest.count ? category : highest
).key

const categorySelectOptions = [
  { value: 'all', label: '全部分类', icon: 'i-ri-apps-2-line' },
  ...SKILL_CATEGORIES.map((category) => ({
    value: category,
    label: CATEGORY_LABELS[category],
    icon: CATEGORY_ICONS[category] || undefined,
  })),
]

const ranked = [...fullIndex].sort((a, b) => b.s - a.s)
const featured = ranked[0]
const curated = [...fullIndex]
  .filter((skill) => skill.g === 'safe')
  .sort((a, b) => b.q - a.q || b.s - a.s)
  .slice(0, 6)
interface BoardRow {
  id: string
  n: string
  a: string
  s: number
  q: number
  c: string
  g: string
  u: string
}
const toBoardRow = (skill: (typeof fullIndex)[number]): BoardRow => ({
  id: skill.f,
  n: skill.n,
  a: skill.a,
  s: skill.s,
  q: skill.q,
  c: skill.c,
  g: skill.g,
  u: withBasePath(`/agent/${skill.f}/`),
})
const boardData: Record<
  string,
  Record<'s' | 'q', BoardRow[]>
> = Object.fromEntries(
  ['all', ...SKILL_CATEGORIES].map((category) => {
    const items =
      category === 'all'
        ? fullIndex
        : fullIndex.filter((skill) => skill.c === category)
    return [
      category,
      {
        s: [...items]
          .sort((a, b) => b.s - a.s)
          .slice(0, 7)
          .map(toBoardRow),
        q: [...items]
          .sort((a, b) => b.q - a.q || b.s - a.s)
          .slice(0, 7)
          .map(toBoardRow),
      },
    ]
  })
)

const sceneChips = scenesData.scenes.slice(0, 16)
const updatedAt = new Intl.DateTimeFormat('zh-CN', {
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
}).format(new Date(skillsMeta.generatedAt))
const allPath = withBasePath('/agent/all/')
const suggestIndexUrl = withBasePath('/agent/suggest-index.json')
const searchSeed = ranked.slice(0, 180).map((skill) => ({
  f: skill.f,
  n: skill.n,
  a: skill.a,
  c: skill.c,
  s: skill.s,
}))
---

<section class="skills-hero slide-enter" style="--enter-stage: 0">
  <div class="skills-hero-main">
    <p class="skills-eyebrow">
      Agent 能力索引
      <small>更新于 {updatedAt}</small>
    </p>
    <h1>找到真正值得装进<br />Agent 的能力</h1>
    <p class="skills-hero-copy">
      从 {fullIndex.length.toLocaleString('zh-CN')} 个开源 Skill、MCP Server 与 Agent
      工具中搜索、筛选、比较，并直接在博客内阅读源码与文档。
    </p>

    <div class="skills-search-shell" data-agent-search>
      <form class="skills-hero-search" action={allPath} method="get">
        <span class="i-ri-search-line" aria-hidden="true"></span>
        <input
          type="search"
          name="q"
          autocomplete="off"
          placeholder="搜索项目、作者或用途，例如 openclaw"
          aria-label="搜索 Agent 能力"
          aria-autocomplete="list"
          aria-controls="agent-search-suggestions"
          aria-expanded="false"
          role="combobox"
          data-agent-search-input
        />
        <button
          type="button"
          class="skills-search-clear"
          data-agent-search-clear
          aria-label="清空 Agent 搜索"
          hidden
        >
          <span class="i-ri-close-line" aria-hidden="true"></span>
        </button>
        <kbd>/</kbd>
        <button type="submit">开始搜索</button>
      </form>
      <div
        class="skills-search-suggestions"
        id="agent-search-suggestions"
        role="listbox"
        aria-label="搜索联想"
        data-agent-suggestions
        hidden
      >
      </div>
    </div>

    <div class="skills-quick-search" role="group" aria-label="热门搜索">
      <span>常用入口</span>
      {
        [
          ['Claude Code', 'claude code'],
          ['浏览器自动化', 'browser automation'],
          ['代码审查', 'code review'],
          ['MCP 数据库', 'database'],
        ].map(([label, query]) => (
          <Link href={`${allPath}?q=${encodeURIComponent(query)}`}>
            {label}
          </Link>
        ))
      }
    </div>
  </div>

  <aside class="skills-hero-pulse" aria-label="Skills 索引状态">
    <div class="skills-pulse-head">
      <div>
        <strong>索引状态</strong>
      </div>
      <span class="skills-live"><i></i>已同步</span>
    </div>
    <div class="skills-pulse-score">
      <span>覆盖项目</span>
      <strong>{fullIndex.length.toLocaleString('zh-CN')}</strong>
      <small>本地索引，无需跳转搜索</small>
    </div>
    <div class="skills-pulse-bars">
      {
        categorySections.map((category) => (
          <Link
            href={`${allPath}?cat=${category.key}`}
            data-focal={
              category.key === pulseFocalCategory ? 'true' : undefined
            }
          >
            <span>{category.label}</span>
            <i aria-hidden="true">
              <b
                style={`width:${(category.count / fullIndex.length) * 100}%`}
              />
            </i>
            <strong>{formatCount(category.count)}</strong>
          </Link>
        ))
      }
    </div>
  </aside>
</section>

<section class="skills-stats slide-enter" style="--enter-stage: 1">
  {
    stats.map((stat) => (
      <div class="skills-stat">
        <div>
          <span class="skills-stat-value">{stat.fmt}</span>
          <span class="skills-stat-label">{stat.label}</span>
        </div>
        <small>{stat.note}</small>
      </div>
    ))
  }
</section>

<section class="skills-discovery slide-enter" style="--enter-stage: 2">
  <Link
    class="skills-feature-lead"
    href={withBasePath(`/agent/${featured.f}/`)}
  >
    <div class="skills-feature-noise" aria-hidden="true"></div>
    <div class="skills-feature-topline">
      <span>编辑推荐 · 社区热度第一</span>
      <span class="i-ri-arrow-right-up-line" aria-hidden="true"></span>
    </div>
    <div class="skills-feature-identity">
      <img
        src={githubAvatar(featured.a, 112)}
        alt={featured.a}
        loading="lazy"
        decoding="async"
      />
      <div>
        <span>{featured.a}</span>
        <h2>{featured.n}</h2>
      </div>
    </div>
    <p>{featured.d}</p>
    <div class="skills-feature-metrics">
      <span><i class="i-ri-star-line"></i>{formatCount(featured.s)} Stars</span>
      <span><i class="i-ri-medal-line"></i>{featured.q} 质量分</span>
      <span>
        <i class="i-ri-shield-check-line"></i>
        安全状态：{featured.g === 'safe' ? '通过' : '谨慎'}
      </span>
    </div>
  </Link>

  <div class="skills-board">
    <div class="skills-board-head">
      <div>
        <h2>实时榜单</h2>
      </div>
      <div class="skills-board-controls">
        <SkillSelect
          class="skills-board-select"
          options={categorySelectOptions}
          ariaLabel="榜单分类"
          dataAttribute="data-board-cat"
        />
        <div class="skills-sort" role="group" aria-label="榜单排序">
          <button class="is-active" data-board-sort="s">Stars</button>
          <button data-board-sort="q">质量</button>
        </div>
      </div>
    </div>
    <ol class="skills-board-list" data-board>
      {
        boardData.all.s.map((item, index) => (
          <li>
            <span class="skills-board-rank">
              {String(index + 1).padStart(2, '0')}
            </span>
            <Link href={item.u}>
              <strong>{item.n}</strong>
              <small>{item.a}</small>
            </Link>
            <i
              class:list={{ 'is-safe': item.g === 'safe' }}
              title={item.g === 'safe' ? '安全评级通过' : '需谨慎评估'}
            />
            <span class="skills-board-value">{formatCount(item.s)}</span>
          </li>
        ))
      }
    </ol>
    <Link class="skills-board-more" href={allPath}>
      浏览完整目录
      <span class="i-ri-arrow-right-line" aria-hidden="true"></span>
    </Link>
  </div>
</section>

<section class="skills-section slide-enter" style="--enter-stage: 3">
  <div class="skills-section-head">
    <div>
      <h2>按工具类型开始</h2>
    </div>
    <p>先选生态，再看其中真正活跃的项目</p>
  </div>
  <div class="skills-category-grid">
    {
      categorySections.map((category) => (
        <article class="skills-category-card">
          <div class="skills-category-title">
            <SkillCategoryIcon category={category.key} size="lg" />
            <div>
              <h3>{category.label}</h3>
              <p>{category.count.toLocaleString('zh-CN')} 个项目</p>
            </div>
            <Link
              href={`${allPath}?cat=${category.key}`}
              aria-label={`查看全部 ${category.label}`}
            >
              <span class="i-ri-arrow-right-line" aria-hidden="true" />
            </Link>
          </div>
          <ol>
            {category.items.map((skill, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <Link href={withBasePath(`/agent/${skill.f}/`)}>{skill.n}</Link>
                <small>{formatCount(skill.s)}</small>
              </li>
            ))}
          </ol>
        </article>
      ))
    }
  </div>
</section>

<section class="skills-section slide-enter" style="--enter-stage: 4">
  <div class="skills-section-head">
    <div>
      <h2>高质量精选</h2>
    </div>
    <Link class="skills-section-more" href={`${allPath}?sort=q&safe=1`}>
      查看全部
      <span class="i-ri-arrow-right-line" aria-hidden="true"></span>
    </Link>
  </div>
  <div class="skills-grid">
    {
      curated.map((skill) => (
        <SkillMiniCard
          item={skill}
          descZh={enrichMap[skill.f]?.descZh}
          installs={enrichMap[skill.f]?.installs}
          hasDetail={true}
        />
      ))
    }
  </div>
</section>

<section class="skills-scenes slide-enter" style="--enter-stage: 5">
  <div class="skills-section-head">
    <div>
      <h2>按场景找工具</h2>
    </div>
    <Link class="skills-section-more" href={withBasePath('/agent/scenes/')}>
      全部 {scenesData.scenes.length} 个场景
      <span class="i-ri-arrow-right-line" aria-hidden="true"></span>
    </Link>
  </div>
  <div class="skills-scene-chips">
    {
      sceneChips.map((scene, index) => (
        <Link
          class="skills-scene-link"
          href={withBasePath(`/agent/scenes/${scene.slug}/`)}
        >
          <span class="skills-scene-index">
            {String(index + 1).padStart(2, '0')}
          </span>
          <strong>{scene.title}</strong>
          <i class="i-ri-arrow-right-up-line" aria-hidden="true" />
          <small>{scene.desc}</small>
        </Link>
      ))
    }
  </div>
</section>

<script
  is:inline
  data-astro-rerun
  define:vars={{ boardData, searchSeed, suggestIndexUrl, allPath }}
>
  window.__SKILLS_BOARD__ = boardData
  window.__AGENT_SEARCH__ = { searchSeed, suggestIndexUrl, allPath }
</script>

<script>
  interface BoardItem {
    id: string
    n: string
    a: string
    s: number
    q: number
    c: string
    g: string
    u: string
  }

  interface SuggestionItem {
    f: string
    n: string
    a: string
    c: string
    s: number
  }

  type BoardGroups = Record<string, Record<'s' | 'q', BoardItem[]>>
  type SkillsBoardWindow = Window & {
    __SKILLS_BOARD__?: BoardGroups
    __AGENT_SEARCH__?: {
      searchSeed: SuggestionItem[]
      suggestIndexUrl: string
      allPath: string
    }
    __AGENT_SUGGESTIONS__?: SuggestionItem[]
    __AGENT_SUGGESTIONS_PROMISE__?: Promise<SuggestionItem[]>
  }

  const skillsBoardWindow = window as SkillsBoardWindow
  const compact = (value: number) => {
    if (value >= 1_000_000) return `${(value / 1_000_000).toFixed(1)}M`
    if (value >= 1_000) return `${(value / 1_000).toFixed(1)}k`
    return String(value)
  }
  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (character) =>
        ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        })[character] as string
    )

  const mountSkillsOverview = () => {
    const board = document.querySelector<HTMLOListElement>('[data-board]')
    if (!board || board.dataset.boardBound === 'true') return
    board.dataset.boardBound = 'true'

    const boardItems = skillsBoardWindow.__SKILLS_BOARD__
    if (!boardItems) return
    const category =
      document.querySelector<HTMLSelectElement>('[data-board-cat]')
    const sortButtons = [
      ...document.querySelectorAll<HTMLButtonElement>('[data-board-sort]'),
    ]
    const pageController = new AbortController()
    document.addEventListener(
      'astro:before-swap',
      () => pageController.abort(),
      { once: true }
    )

    let sortKey: 's' | 'q' = 's'
    const renderBoard = () => {
      const activeCategory = category?.value ?? 'all'
      const rows =
        boardItems[activeCategory]?.[sortKey] ?? boardItems.all[sortKey]

      board.innerHTML = rows
        .map(
          (item, index) => `<li>
            <span class="skills-board-rank">${String(index + 1).padStart(2, '0')}</span>
            <a href="${escapeHtml(item.u)}"><strong>${escapeHtml(item.n)}</strong><small>${escapeHtml(item.a)}</small></a>
            <i class="${item.g === 'safe' ? 'is-safe' : ''}" title="${item.g === 'safe' ? '安全评级通过' : '需谨慎评估'}"></i>
            <span class="skills-board-value">${sortKey === 'q' ? item.q : compact(item.s)}</span>
          </li>`
        )
        .join('')
    }

    category?.addEventListener('change', renderBoard)
    sortButtons.forEach((button) =>
      button.addEventListener('click', () => {
        sortKey = button.dataset.boardSort as typeof sortKey
        sortButtons.forEach((item) =>
          item.classList.toggle('is-active', item === button)
        )
        renderBoard()
      })
    )
    renderBoard()

    const searchRoot = document.querySelector<HTMLElement>(
      '[data-agent-search]'
    )
    const heroSearch = searchRoot?.querySelector<HTMLInputElement>(
      '[data-agent-search-input]'
    )
    const suggestions = searchRoot?.querySelector<HTMLElement>(
      '[data-agent-suggestions]'
    )
    const searchClear = searchRoot?.querySelector<HTMLButtonElement>(
      '[data-agent-search-clear]'
    )
    const searchForm = searchRoot?.querySelector<HTMLFormElement>('form')
    const searchConfig = skillsBoardWindow.__AGENT_SEARCH__
    const categoryLabels: Record<string, string> = {
      'claude-skill': 'Claude Skill',
      'codex-skill': 'Codex Skill',
      'mcp-server': 'MCP Server',
      'agent-tool': 'Agent Tool',
      'ai-skill': 'AI Skill',
      'llm-plugin': 'Prompt / LLM Plugin',
      'uncategorized': '其他工具',
    }
    let visibleSuggestions: SuggestionItem[] = []
    let activeSuggestion = -1

    const normalize = (value: string) => value.trim().toLowerCase()
    const rankSuggestions = (items: SuggestionItem[], query: string) => {
      const needle = normalize(query)
      if (!needle) return items.slice(0, 6)
      return items
        .map((item) => {
          const name = item.n.toLowerCase()
          const author = item.a.toLowerCase()
          const repo = item.f.toLowerCase()
          const score =
            name === needle
              ? 0
              : name.startsWith(needle)
                ? 1
                : author.startsWith(needle)
                  ? 2
                  : repo.includes(needle)
                    ? 3
                    : name.includes(needle)
                      ? 4
                      : author.includes(needle)
                        ? 5
                        : 99
          return { item, score }
        })
        .filter((entry) => entry.score < 99)
        .sort((a, b) => a.score - b.score || b.item.s - a.item.s)
        .slice(0, 7)
        .map((entry) => entry.item)
    }

    const setActiveSuggestion = (index: number) => {
      if (!suggestions || !heroSearch) return
      activeSuggestion = index
      const options = [
        ...suggestions.querySelectorAll<HTMLElement>('[role="option"]'),
      ]
      options.forEach((option, optionIndex) =>
        option.classList.toggle('is-active', optionIndex === index)
      )
      const active = options[index]
      if (active) {
        heroSearch.setAttribute('aria-activedescendant', active.id)
        active.scrollIntoView({ block: 'nearest' })
      } else {
        heroSearch.removeAttribute('aria-activedescendant')
      }
    }

    const renderSuggestions = (items: SuggestionItem[], query = '') => {
      if (!suggestions || !heroSearch || !searchConfig) return
      visibleSuggestions = rankSuggestions(items, query)
      activeSuggestion = -1
      suggestions.innerHTML = visibleSuggestions.length
        ? visibleSuggestions
            .map(
              (
                item,
                index
              ) => `<a id="agent-suggestion-${index}" role="option" href="${escapeHtml(`${searchConfig.allPath.replace(/all\/$/, '')}${item.f}/`)}" data-suggestion-index="${index}">
                <span class="skills-search-avatar" aria-hidden="true">${escapeHtml(item.n.charAt(0).toUpperCase())}</span>
                <span class="skills-search-result-copy"><strong>${escapeHtml(item.n)}</strong><small>${escapeHtml(item.a)} · ${escapeHtml(categoryLabels[item.c] || item.c)}</small></span>
                <span class="skills-search-result-stars"><i class="i-ri-star-line"></i>${compact(item.s)}</span>
              </a>`
            )
            .join('')
        : `<a class="skills-search-all" href="${escapeHtml(`${searchConfig.allPath}?q=${encodeURIComponent(query)}`)}"><span class="i-ri-search-line"></span>在全部目录中搜索“${escapeHtml(query)}”<span class="i-ri-arrow-right-line"></span></a>`
      suggestions.hidden = false
      heroSearch.setAttribute('aria-expanded', 'true')
    }

    const closeSuggestions = () => {
      if (!suggestions || !heroSearch) return
      suggestions.hidden = true
      heroSearch.setAttribute('aria-expanded', 'false')
      setActiveSuggestion(-1)
    }

    const syncSearchClear = () => {
      if (searchClear) searchClear.hidden = !heroSearch?.value
    }

    const loadSuggestionIndex = async () => {
      if (!searchConfig) return []
      if (skillsBoardWindow.__AGENT_SUGGESTIONS__)
        return skillsBoardWindow.__AGENT_SUGGESTIONS__
      if (!skillsBoardWindow.__AGENT_SUGGESTIONS_PROMISE__) {
        skillsBoardWindow.__AGENT_SUGGESTIONS_PROMISE__ = fetch(
          searchConfig.suggestIndexUrl
        )
          .then((response) => {
            if (!response.ok) throw new Error('suggestions unavailable')
            return response.json() as Promise<{ items: SuggestionItem[] }>
          })
          .then((payload) => {
            skillsBoardWindow.__AGENT_SUGGESTIONS__ = payload.items
            return payload.items
          })
          .catch(() => searchConfig.searchSeed)
      }
      return skillsBoardWindow.__AGENT_SUGGESTIONS_PROMISE__
    }

    let suggestionTimer = 0
    heroSearch?.addEventListener(
      'focus',
      () =>
        searchConfig &&
        renderSuggestions(searchConfig.searchSeed, heroSearch.value),
      { signal: pageController.signal }
    )
    heroSearch?.addEventListener(
      'input',
      () => {
        if (!searchConfig) return
        syncSearchClear()
        const query = heroSearch.value
        renderSuggestions(searchConfig.searchSeed, query)
        window.clearTimeout(suggestionTimer)
        if (query.trim().length >= 2) {
          suggestionTimer = window.setTimeout(async () => {
            const items = await loadSuggestionIndex()
            if (heroSearch.value === query) renderSuggestions(items, query)
          }, 120)
        }
      },
      { signal: pageController.signal }
    )
    searchClear?.addEventListener(
      'click',
      () => {
        if (!heroSearch || !searchConfig) return
        heroSearch.value = ''
        syncSearchClear()
        renderSuggestions(searchConfig.searchSeed)
        heroSearch.focus()
      },
      { signal: pageController.signal }
    )
    heroSearch?.addEventListener(
      'keydown',
      (event) => {
        if (!suggestions || suggestions.hidden) return
        if (event.key === 'ArrowDown') {
          event.preventDefault()
          setActiveSuggestion(
            Math.min(activeSuggestion + 1, visibleSuggestions.length - 1)
          )
        } else if (event.key === 'ArrowUp') {
          event.preventDefault()
          setActiveSuggestion(Math.max(activeSuggestion - 1, 0))
        } else if (event.key === 'Enter' && activeSuggestion >= 0) {
          event.preventDefault()
          const target = suggestions.querySelector<HTMLAnchorElement>(
            `[data-suggestion-index="${activeSuggestion}"]`
          )
          if (target) location.href = target.href
        } else if (event.key === 'Escape') {
          closeSuggestions()
        }
      },
      { signal: pageController.signal }
    )
    searchForm?.addEventListener('submit', () => closeSuggestions(), {
      signal: pageController.signal,
    })
    document.addEventListener(
      'keydown',
      (event) => {
        if (
          event.key === '/' &&
          !['INPUT', 'TEXTAREA'].includes(
            (event.target as HTMLElement)?.tagName ?? ''
          )
        ) {
          event.preventDefault()
          heroSearch?.focus()
        }
      },
      { signal: pageController.signal }
    )

    document.addEventListener(
      'click',
      (event) => {
        if (searchRoot && !searchRoot.contains(event.target as Node))
          closeSuggestions()
        const button = (event.target as HTMLElement).closest<HTMLElement>(
          '[data-copy]'
        )
        if (!button) return
        navigator.clipboard
          .writeText(button.dataset.copy ?? '')
          .then(() => {
            button.classList.add('is-copied')
            window.setTimeout(() => button.classList.remove('is-copied'), 1200)
          })
          .catch(() => {
            console.warn('[agent] 复制安装命令失败: 剪贴板不可用')
          })
      },
      { signal: pageController.signal }
    )
  }

  mountSkillsOverview()
  document.addEventListener('astro:page-load', mountSkillsOverview)
</script>
