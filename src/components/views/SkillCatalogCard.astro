---
import SkillAvatar from '~/components/views/SkillAvatar.astro'
import { withBasePath } from '~/utils/path'
import {
  CATEGORY_LABELS,
  INSTALLABLE_CATEGORIES,
  SECURITY_GRADES,
  formatCount,
  installCommand,
} from '~/utils/skills'

import type { FullIndexItem } from '~/utils/skills'

interface Props {
  item: FullIndexItem
  descZh?: string
  installs?: number | null
}

const { item, descZh, installs } = Astro.props
const qualityBand =
  item.q >= 80 ? 'S' : item.q >= 65 ? 'A' : item.q >= 50 ? 'B' : 'C'
const grade = SECURITY_GRADES[item.g] ?? SECURITY_GRADES.unknown
const detailPath = withBasePath(`/agent/${item.f}/`)
const installable = INSTALLABLE_CATEGORIES.has(item.c)
const category =
  CATEGORY_LABELS[item.c as keyof typeof CATEGORY_LABELS] ?? item.c
---

<article class="ska-card">
  <div class="ska-card-topline">
    <span class="ska-quality"><b>{qualityBand}</b><small>{item.q}</small></span>
    <span class:list={['ska-grade', `is-${item.g}`]}><i></i>{grade.label}</span>
  </div>
  <div class="ska-card-head">
    <SkillAvatar class="ska-card-avatar" author={item.a} size={80} />
    <div class="ska-card-titles">
      <a class="ska-card-name" href={detailPath}>{item.n}</a>
      <span class="ska-card-author">{item.a}</span>
    </div>
  </div>
  <p class="ska-card-desc">{descZh || item.d || '暂无描述'}</p>
  <div class="ska-card-meta">
    <span><span class="i-ri-star-line"></span>{formatCount(item.s)}</span>
    {
      installs ? (
        <span>
          <span class="i-ri-download-2-line" />
          {formatCount(installs)}
        </span>
      ) : null
    }
    <span class="ska-card-cat">{category}</span>
  </div>
  <div class="ska-card-foot">
    <button
      type="button"
      class="ska-card-compare"
      data-compare={item.f}
      aria-pressed="false"
    >
      <span class="i-ri-scales-3-line"></span>对比
    </button>
    {
      installable ? (
        <button
          type="button"
          class="ska-card-install"
          data-copy={installCommand(item.f)}
        >
          <span class="i-ri-terminal-box-line" />
          <span>复制安装命令</span>
        </button>
      ) : (
        <a class="ska-card-read" href={detailPath}>
          <span class="i-ri-book-open-line" />
          站内阅读
        </a>
      )
    }
    <a class="ska-card-more" href={detailPath} aria-label={`查看 ${item.n}`}>
      <span class="i-ri-arrow-right-line"></span>
    </a>
  </div>
</article>
