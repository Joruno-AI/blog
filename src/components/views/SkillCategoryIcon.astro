---
import { CATEGORY_ICONS, CATEGORY_LABELS } from '~/utils/skills'

import type { SkillCategory } from '~/utils/skills'

interface Props {
  category: SkillCategory
  size?: 'sm' | 'md' | 'lg'
  class?: string
}

const { category, size = 'md', class: className } = Astro.props
---

<span
  class:list={['skill-category-icon', `is-${size}`, className]}
  title={CATEGORY_LABELS[category]}
  aria-hidden="true"
>
  <span class={CATEGORY_ICONS[category]}></span>
</span>

<style>
  .skill-category-icon {
    display: inline-grid;
    flex: none;
    place-items: center;
    overflow: visible;
    border: 0;
    background: transparent;
    color: var(--c-text-soft);
  }

  .skill-category-icon > span {
    display: block;
    width: 72%;
    height: 72%;
  }

  .skill-category-icon.is-sm {
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 0.5rem;
  }

  .skill-category-icon.is-md {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.5rem;
  }

  .skill-category-icon.is-lg {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.75rem;
  }
</style>
