---
import { slug } from '~/utils/toc'

interface Props {
  anchors: string[]
}

const { anchors } = Astro.props
---

<project-anchor-nav class="project-anchor-nav">
  <div class="project-anchor-nav__head">
    <span class="i-ri-bookmark-3-line" aria-hidden="true"></span>
    <strong>项目分类</strong>
  </div>
  <nav aria-label="项目分类导航">
    {
      anchors.map((anchor, index) => (
        <a
          href={`#${slug(anchor)}`}
          data-project-anchor={slug(anchor)}
          aria-current={index === 0 ? 'location' : undefined}
        >
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{anchor}</strong>
        </a>
      ))
    }
  </nav>
</project-anchor-nav>

<script>
  class ProjectAnchorNav extends HTMLElement {
    private observer: IntersectionObserver | null = null
    private links: HTMLAnchorElement[] = []

    connectedCallback() {
      this.links = [...this.querySelectorAll<HTMLAnchorElement>('a')]
      this.addEventListener('click', this.handleClick)
      this.initObserver()
    }

    disconnectedCallback() {
      this.removeEventListener('click', this.handleClick)
      this.observer?.disconnect()
      this.observer = null
    }

    private setActive = (id: string) => {
      this.links.forEach((link) => {
        const active = link.dataset.projectAnchor === id
        if (active) link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      })
    }

    private initObserver = () => {
      this.observer?.disconnect()
      const headings = this.links
        .map((link) =>
          document.getElementById(link.dataset.projectAnchor || '')
        )
        .filter((heading): heading is HTMLElement => Boolean(heading))
      if (!headings.length || !('IntersectionObserver' in window)) return

      this.observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort(
              (left, right) =>
                Math.abs(left.boundingClientRect.top) -
                Math.abs(right.boundingClientRect.top)
            )
          const active = visible[0]?.target
          if (active instanceof HTMLElement) this.setActive(active.id)
        },
        { rootMargin: '-18% 0px -72% 0px', threshold: [0, 1] }
      )
      headings.forEach((heading) => this.observer?.observe(heading))
    }

    private handleClick = (event: Event) => {
      const target = event.target
      const link =
        target instanceof Element
          ? target.closest<HTMLAnchorElement>('[data-project-anchor]')
          : null
      if (!link) return
      const id = link.dataset.projectAnchor || ''
      const heading = document.getElementById(id)
      if (!heading) return
      event.preventDefault()
      this.setActive(id)
      heading.scrollIntoView({
        block: 'start',
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'auto'
          : 'smooth',
      })
      history.replaceState(history.state, '', `#${encodeURIComponent(id)}`)
    }
  }

  if (!customElements.get('project-anchor-nav'))
    customElements.define('project-anchor-nav', ProjectAnchorNav)
</script>

<style>
  .project-anchor-nav {
    position: sticky;
    top: calc(var(--navbar-height, 4rem) + 1.25rem);
    align-self: start;
    display: grid;
    gap: 0.9rem;
    max-height: calc(100vh - var(--navbar-height, 4rem) - 2.5rem);
    padding-top: 1.8rem;
    overflow: auto;
    scrollbar-width: none;
  }

  .project-anchor-nav::-webkit-scrollbar {
    display: none;
  }

  .project-anchor-nav__head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--c-text-muted);
    font-size: 0.7rem;
  }

  .project-anchor-nav__head > span {
    font-size: 0.82rem;
  }

  .project-anchor-nav nav {
    display: grid;
    border-left: 1px solid var(--c-border-soft);
  }

  .project-anchor-nav a {
    position: relative;
    display: grid;
    grid-template-columns: 1.45rem minmax(0, 1fr);
    gap: 0.25rem;
    align-items: baseline;
    padding: 0.48rem 0.6rem;
    color: var(--c-text-muted);
    font-size: 0.72rem;
    line-height: 1.35;
    text-decoration: none;
    transition:
      color 160ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-anchor-nav a::before {
    content: '';
    position: absolute;
    inset: 20% auto 20% -1px;
    width: 2px;
    border-radius: 99px;
    background: var(--c-text);
    opacity: 0;
    transform: scaleY(0.3);
    transition:
      opacity 160ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-anchor-nav a > span {
    color: var(--c-text-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
  }

  .project-anchor-nav a > strong {
    min-width: 0;
    font-weight: 520;
  }

  .project-anchor-nav a:hover,
  .project-anchor-nav a:focus-visible,
  .project-anchor-nav a[aria-current='location'] {
    color: var(--c-text);
    transform: translateX(0.18rem);
  }

  .project-anchor-nav a[aria-current='location'] {
    font-weight: 650;
  }

  .project-anchor-nav a[aria-current='location']::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .project-anchor-nav a:focus-visible {
    outline: 1px solid var(--c-border-strong);
    outline-offset: -1px;
    box-shadow: none;
  }

  @media (max-width: 820px) {
    .project-anchor-nav {
      top: var(--navbar-height, 4rem);
      z-index: 20;
      width: 100%;
      max-height: none;
      padding: 0.5rem 0;
      background: var(--c-bg);
      border-bottom: 1px solid var(--c-border-soft);
    }

    .project-anchor-nav__head {
      display: none;
    }

    .project-anchor-nav nav {
      display: flex;
      gap: 0.15rem;
      overflow-x: auto;
      border-left: 0;
      scrollbar-width: none;
    }

    .project-anchor-nav nav::-webkit-scrollbar {
      display: none;
    }

    .project-anchor-nav a {
      flex: none;
      display: inline-flex;
      gap: 0.38rem;
      padding: 0.55rem 0.7rem;
      white-space: nowrap;
    }

    .project-anchor-nav a::before {
      inset: auto 18% -0.5rem;
      width: auto;
      height: 2px;
      transform: scaleX(0.3);
    }

    .project-anchor-nav a[aria-current='location']::before {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-anchor-nav a,
    .project-anchor-nav a::before {
      transition: none;
    }
  }
</style>
