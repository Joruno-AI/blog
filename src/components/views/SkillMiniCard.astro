---
import Link from '~/components/base/Link.astro'
import SkillAvatar from '~/components/views/SkillAvatar.astro'
import { withBasePath } from '~/utils/path'
import {
  INSTALLABLE_CATEGORIES,
  SECURITY_GRADES,
  formatCount,
  installCommand,
} from '~/utils/skills'

import type { FullIndexItem } from '~/utils/skills'

interface Props {
  item: FullIndexItem
  descZh?: string
  installs?: number | null
  hasDetail?: boolean
  metaText?: string
}

const { item, descZh, installs, hasDetail = false, metaText } = Astro.props

const grade = SECURITY_GRADES[item.g] ?? SECURITY_GRADES.unknown
const detailPath = withBasePath(`/agent/${item.f}/`)
const primaryLink = detailPath
const installable = INSTALLABLE_CATEGORIES.has(item.c)
---

<article class="skm-card">
  <div class="skm-head">
    <SkillAvatar class="skm-avatar" author={item.a} size={64} />
    <div class="skm-titles">
      <Link class="skm-name" href={primaryLink}>
        {item.n}
      </Link>
      <span class="skm-author">{item.a}</span>
    </div>
    <span class="skm-grade">{grade.label}</span>
  </div>
  <p class="skm-desc">{descZh || item.d || '暂无描述'}</p>
  <div class="skm-meta">
    <span title={`${item.s} stars`}>
      <span class="i-ri-star-line" aria-hidden="true"></span>
      {formatCount(item.s)}
    </span>
    {
      installs ? (
        <span title={`安装量 ${installs}`}>
          <span class="i-ri-download-2-line" aria-hidden="true" />
          {formatCount(installs)}
        </span>
      ) : null
    }
    <span title={`质量分 ${item.q}`}>
      <span class="i-ri-medal-line" aria-hidden="true"></span>
      {item.q}
    </span>
    {metaText && <span class="skm-extra">{metaText}</span>}
  </div>
  <div class="skm-foot">
    {
      installable ? (
        <button
          type="button"
          class="skm-install"
          data-copy={installCommand(item.f)}
          title="复制安装命令"
        >
          <code>{installCommand(item.f)}</code>
          <span class="i-ri-file-copy-line" aria-hidden="true" />
        </button>
      ) : (
        <Link class="skm-repo" href={detailPath}>
          <span class="i-ri-book-open-line" aria-hidden="true" />
          站内阅读
        </Link>
      )
    }
    {
      hasDetail && (
        <Link class="skm-more" href={detailPath}>
          {'详情'}
          <span class="i-ri-arrow-right-line" aria-hidden="true" />
        </Link>
      )
    }
  </div>
</article>

<style is:global>
  .skm-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1rem 0.35rem;
    overflow: hidden;
    border: 0;
    border-top: 1px solid var(--skills-border, var(--c-border-strong));
    border-radius: 0;
    background: transparent;
    min-width: 0;
    transition:
      background 160ms ease,
      border-color 160ms ease;
  }

  .skm-card::before {
    content: none;
  }

  .skm-card:hover {
    background: var(--c-surface-soft);
  }

  .skm-head {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .skm-avatar {
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--c-border-soft);
    border-radius: var(--skills-radius-sm, 0.375rem);
    background: var(--c-surface-soft);
    flex: none;
  }

  .skm-titles {
    flex: auto;
    min-width: 0;
  }

  .skm-name {
    display: block !important;
    font-size: 0.85rem;
    font-weight: 650;
    color: var(--c-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 1 !important;
  }

  .skm-name:hover {
    text-decoration: underline;
  }

  .skm-author {
    display: block;
    font-size: 0.66rem;
    color: var(--c-text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .skm-grade {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-size: 0.63rem;
    color: var(--c-text-muted);
  }

  .skm-grade::before {
    content: none;
  }

  .skm-desc {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.65;
    color: var(--c-text-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 3.7rem;
    text-align: left;
    -webkit-line-clamp: 3;
  }

  .skm-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.67rem;
    color: var(--c-text-soft);
  }

  .skm-meta > span {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .skm-extra {
    margin-left: auto;
    color: var(--c-text-faint);
    font-size: 0.68rem;
  }

  .skm-foot {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: auto;
    padding-top: 0.7rem;
    border-top: 1px solid var(--skills-border, var(--c-border-soft));
  }

  .skm-install {
    flex: auto;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    min-height: 2rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--skills-border, var(--c-border-soft));
    border-radius: var(--skills-radius-sm, 0.375rem);
    background: var(--c-surface-soft);
    color: var(--c-text-soft);
    font-size: 0.64rem;
    cursor: copy;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .skm-install:hover {
    border-color: var(--c-border-strong);
    background: var(--c-surface-hover);
  }

  .skm-install.is-copied {
    border-color: #22c55e;
  }

  .skm-install code {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .skm-repo,
  .skm-more {
    display: inline-flex !important;
    align-items: center;
    gap: 0.28rem;
    min-height: 2rem;
    border: 1px solid var(--skills-border, var(--c-border-soft));
    border-radius: var(--skills-radius-sm, 0.375rem);
    padding: 0 0.55rem;
    font-size: 0.65rem;
    color: var(--c-text-muted);
    opacity: 1 !important;
  }

  .skm-repo:hover,
  .skm-more:hover {
    border-color: var(--c-border-strong);
    background: var(--c-surface-soft);
    color: var(--c-text);
  }

  .skm-more {
    margin-left: auto;
    flex: none;
  }

  .skm-repo:hover,
  .skm-more:hover {
    color: var(--c-text);
  }
</style>
