    padding: 1.1rem clamp(0.85rem, 2.4vw, 2.4rem) 2rem;
  }

  .agent-repo {
    --agent-line: color-mix(in srgb, var(--c-text) 17%, transparent);
    width: min(100%, 108rem);
    margin: 0 auto;
    color: var(--c-text);
  }

  .agent-repo [hidden] {
    display: none !important;
  }

  .agent-repo button,
  .agent-repo input {
    font: inherit;
  }

  .agent-repo-crumbs {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2rem;
    color: var(--c-text-faint);
    font-size: 0.72rem;
  }

  .agent-repo-crumbs a {
    display: inline-flex !important;
    align-items: center;
    gap: 0.3rem;
    color: var(--c-text-muted);
    opacity: 1 !important;
  }

  .agent-repo-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 0 0.9rem;
  }

  .agent-repo-identity {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    min-width: 0;
  }

  .agent-repo-avatar {
    width: 3.35rem;
    height: 3.35rem;
    flex: none;
    border: 1px solid var(--agent-line);
    border-radius: 0.7rem;
    background: var(--c-surface-soft);
  }

  .agent-repo-owner,
  .agent-repo-description {
    margin: 0;
  }

  .agent-repo-owner {
    color: var(--c-text-faint);
    font: 500 0.68rem/1.35 var(--font-mono);
    letter-spacing: 0.045em;
  }

  .agent-repo-identity h1 {
    margin: 0.1rem 0 0;
    font-size: clamp(1.45rem, 2.2vw, 2rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .agent-repo-description {
    max-width: 66ch;
    margin-top: 0.45rem;
    color: var(--c-text-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .agent-repo-actions {
    display: flex;
    gap: 0.45rem;
    flex: none;
  }

  .agent-repo-actions button,
  .agent-repo-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 2.2rem;
    padding: 0.42rem 0.65rem;
    border: 1px solid var(--agent-line);
    border-radius: 0.48rem;
    background: var(--c-bg);
    color: var(--c-text-muted);
    font-size: 0.72rem;
    opacity: 1;
  }

  .agent-repo-actions button:hover,
  .agent-repo-actions a:hover {
    background: var(--c-surface-soft);
    color: var(--c-text);
  }

  .agent-repo-actions .is-copied {
    color: #3c8b63;
  }

  .agent-repo-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    min-height: 2.4rem;
    color: var(--c-text-faint);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .agent-repo-meta > span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .agent-repo-grade::before {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--grade);
    content: '';
  }

  .agent-repo-tabs {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    min-height: 3.25rem;
    border-top: 1px solid var(--agent-line);
    border-bottom: 1px solid var(--agent-line);
  }

  .agent-repo-tabs button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    height: 3.2rem;
    padding: 0 0.8rem;
    border: 0;
    background: transparent;
    color: var(--c-text-faint);
    font-size: 0.76rem;
  }

  .agent-repo-tabs button::after {
    position: absolute;
    right: 0.7rem;
    bottom: -1px;
    left: 0.7rem;
    height: 2px;
    background: var(--c-text);
    transform: scaleX(0);
    content: '';
  }

  .agent-repo-tabs button:hover,
  .agent-repo-tabs button.is-active {
    color: var(--c-text);
  }

  .agent-repo-tabs button.is-active::after {
    transform: scaleX(1);
  }

  .agent-repo-source-state {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    color: var(--c-text-faint);
    font: 0.63rem/1 var(--font-mono);
  }

  .agent-repo-source-state i,
  .agent-drawer-live i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: #c08457;
  }

  .agent-repo-source-state.is-ready i,
  .agent-drawer-live i {
    background: #4f9b72;
  }

  .agent-repo-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 21rem);
    align-items: start;
    min-height: 68dvh;
    transition: grid-template-columns 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .agent-repo[data-drawer-open='false'] .agent-repo-workspace {
    grid-template-columns: minmax(0, 1fr) 2.75rem;
  }

  .agent-repo-main {
    min-width: 0;
    padding: 1.8rem clamp(0rem, 2.4vw, 2.4rem) 5rem 0;
  }

  .agent-repo-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.62rem 0.75rem;
    border: 1px solid var(--agent-line);
    border-radius: 0.5rem;
    background: var(--c-surface-soft);
    color: var(--c-text-muted);
    font-size: 0.72rem;
  }

  .agent-repo-status[data-kind='error'] {
    color: #bd5e5e;
  }

  .agent-repo-pulse {
    width: 0.44rem;
    height: 0.44rem;
    border-radius: 50%;
    background: var(--c-text-faint);
    animation: agent-pulse 1.2s ease-in-out infinite;
  }

  .agent-repo-intro,
  .agent-panel-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--agent-line);
  }

  .agent-repo-kicker,
  .agent-section-heading span,
  .agent-panel-heading > div > span {
    color: var(--c-text-faint);
    font: 500 0.62rem/1.3 var(--font-mono);
    letter-spacing: 0.1em;
  }

  .agent-repo-intro h2,
  .agent-panel-heading h2 {
    margin: 0.28rem 0 0;
    font-size: clamp(1.55rem, 3vw, 2.45rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .agent-repo-intro p,
  .agent-panel-heading p {
    max-width: 48rem;
    margin: 0.65rem 0 0;
    color: var(--c-text-muted);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .agent-repo-intro > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0;
    color: var(--c-text-faint);
    font-size: 0.7rem;
    white-space: nowrap;
    opacity: 1 !important;
  }

  .agent-architecture {
    margin: 1.6rem 0 2rem;
    padding: 1rem;
    border: 1px solid var(--agent-line);
    border-radius: 0.65rem;
    background-image: radial-gradient(var(--agent-line) 0.7px, transparent 0.7px);
    background-size: 12px 12px;
  }

  .agent-section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .agent-section-heading h3 {
    margin: 0.18rem 0 0;
    font-size: 1rem;
  }

  .agent-section-heading small {
    color: var(--c-text-faint);
    font-size: 0.62rem;
  }

  .agent-architecture-flow {
    display: grid;
    grid-template-columns: minmax(7rem, 0.34fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.8rem;
    min-height: 10rem;
    padding-top: 1rem;
  }

  .agent-architecture-root {
    display: grid;
    justify-items: center;
    gap: 0.22rem;
    padding: 0.85rem;
    border: 1px solid var(--agent-line);
    border-radius: 0.5rem;
    background: var(--c-bg);
    text-align: center;
  }

  .agent-architecture-root > span {
    font-size: 1.2rem;
  }

  .agent-architecture-root strong,
  .agent-architecture-nodes strong {
    font: 600 0.7rem/1.25 var(--font-mono);
  }

  .agent-architecture-root small {
    color: var(--c-text-faint);
    font-size: 0.58rem;
  }

  .agent-architecture-arrow {
    color: var(--c-text-faint);
  }

  .agent-architecture-nodes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .agent-architecture-nodes button,
  .agent-local-grid button {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    padding: 0.65rem;
    border: 1px solid var(--agent-line);
    border-radius: 0.45rem;
    background: var(--c-bg);
    color: var(--c-text-muted);
    text-align: left;
  }

  .agent-architecture-nodes button:hover,
  .agent-local-grid button:hover {
    background: var(--c-surface-soft);
    color: var(--c-text);
  }

  .agent-architecture-nodes strong {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .agent-wiki-content {
    width: min(100%, 57rem);
    max-width: 100% !important;
    margin: 2rem auto 0;
  }

  .agent-wiki-content h1:first-child {
    margin-top: 0;
  }

  .agent-wiki-content h1,
  .agent-wiki-content h2,
  .agent-wiki-content h3 {
    letter-spacing: -0.025em;
  }

  .agent-wiki-content p,
  .agent-wiki-content li {
    line-height: 1.8;
  }

  .agent-wiki-content table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }

  .agent-wiki-content pre {
    border: 1px solid var(--agent-line);
    border-radius: 0.5rem;
  }

  .agent-mermaid {
    width: 100%;
    margin: 1.5rem 0 2rem;
    overflow: hidden;
    border: 1px solid var(--agent-line);
    border-radius: 0.7rem;
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--c-text) 11%, transparent) 1px, transparent 0) 0 0 / 18px 18px,
      var(--c-bg);
  }

  .agent-mermaid-toolbar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.8rem;
    padding: 0.45rem 0.6rem 0.45rem 0.85rem;
    border-bottom: 1px solid var(--agent-line);
    background: color-mix(in srgb, var(--c-bg) 94%, transparent);
    backdrop-filter: blur(12px);
  }

  .agent-mermaid-toolbar > span,
  .agent-mermaid-toolbar > div {
    display: inline-flex;
    align-items: center;
  }

  .agent-mermaid-toolbar > span {
    gap: 0.4rem;
    color: var(--c-text-muted);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  .agent-mermaid-toolbar > div {
    gap: 0.2rem;
  }

  .agent-mermaid-toolbar button {
    display: inline-grid;
    min-width: 2rem;
    height: 1.9rem;
    place-items: center;
    padding: 0 0.45rem;
    border: 0;
    border-radius: 0.35rem;
    background: transparent;
    color: var(--c-text-muted);
    font-size: 0.68rem;
    cursor: pointer;
  }

  .agent-mermaid-toolbar button:hover {
    background: var(--c-surface-soft);
    color: var(--c-text);
  }

  .agent-mermaid-viewport {
    min-height: 18rem;
    max-height: min(68vh, 48rem);
    overflow: auto;
    overscroll-behavior: contain;
  }

  .agent-mermaid-canvas {
    display: grid;
    width: max-content;
    min-width: 100%;
    min-height: 18rem;
    place-items: center;
    padding: clamp(1.2rem, 3vw, 2.4rem);
    zoom: var(--diagram-scale, 1);
  }

  .agent-mermaid-canvas > svg {
    display: block;
    width: auto !important;
    min-width: min(46rem, 82vw);
    max-width: none !important;
    height: auto;
    min-height: 14rem;
  }

  .agent-mermaid-canvas > small {
    margin-left: 0.6rem;
    color: var(--c-text-faint);
    font-size: 0.7rem;
  }

  .agent-mermaid-error {
    width: min(100%, 54rem);
    color: var(--c-text-muted);
    font-size: 0.75rem;
  }

  .agent-mermaid-error summary {
    cursor: pointer;
  }

  .agent-mermaid-error pre {
    max-height: 24rem;
    overflow: auto;
    white-space: pre;
  }

  @media (max-width: 640px) {
    .agent-mermaid-toolbar > span {
      font-size: 0.62rem;
    }

    .agent-mermaid-viewport,
    .agent-mermaid-canvas {
      min-height: 14rem;
    }

    .agent-mermaid-canvas {
      padding: 1rem;
    }
  }

  .agent-source-details {
    margin: 1rem 0;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--agent-line);
    border-radius: 0.5rem;
    background: var(--c-surface-soft);
    color: var(--c-text-muted);
    font-size: 0.72rem;
  }

  .agent-wiki-skeleton,
  .agent-list-skeleton {
    display: grid;
    gap: 0.65rem;
  }

  .agent-wiki-skeleton {
    padding-top: 0.5rem;
  }

  .agent-wiki-skeleton span,
  .agent-list-skeleton span {
    height: 0.75rem;
    border-radius: 0.2rem;
    background: linear-gradient(90deg, var(--c-surface-soft), var(--c-surface-hover), var(--c-surface-soft));
    background-size: 220% 100%;
    animation: agent-shimmer 1.45s linear infinite;
  }

  .agent-wiki-skeleton span:first-child {
    width: 48%;
    height: 1.7rem;
  }

  .agent-wiki-skeleton span:nth-child(3) {
    width: 88%;
  }

  .agent-wiki-skeleton span:last-child {
    width: 67%;
  }

  .agent-local-note {
    padding: 0.65rem 0.8rem;
    border-left: 2px solid #c08457;
    background: var(--c-surface-soft);
    color: var(--c-text-muted);
    font-size: 0.75rem;
  }

  .agent-local-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .agent-local-grid button {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
  }

  .agent-local-grid small {
    grid-column: 2;
    color: var(--c-text-faint);
    font-size: 0.62rem;
  }

  .agent-local-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .agent-local-tags span {
    padding: 0.22rem 0.48rem;
    border: 1px solid var(--agent-line);
    border-radius: 0.35rem;
    color: var(--c-text-muted);
    font-size: 0.66rem;
  }

  .agent-doc-list {
    margin-top: 0.5rem;
  }

  .agent-doc-list > button {
    display: grid;
    grid-template-columns: 2.2rem 1.4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    min-height: 4.4rem;
    padding: 0.7rem 0.2rem;
    border: 0;
    border-bottom: 1px solid var(--agent-line);
    background: transparent;
    color: var(--c-text-muted);
    text-align: left;
  }

  .agent-doc-list > button:hover {
    background: var(--c-surface-soft);
    color: var(--c-text);
  }

  .agent-doc-index {
    color: var(--c-text-faint);
    font: 0.66rem/1 var(--font-mono);
  }

  .agent-doc-icon {
    font-size: 1rem;
  }

  .agent-doc-copy strong,
  .agent-doc-copy small {
    display: block;
  }

  .agent-doc-copy strong {
    color: var(--c-text);
    font: 550 0.79rem/1.45 var(--font-mono);
  }

  .agent-doc-copy small {
    margin-top: 0.15rem;
    color: var(--c-text-faint);
    font-size: 0.62rem;
  }

  .agent-doc-arrow {
    color: var(--c-text-faint);
  }

  .agent-files-shell {
    display: grid;
    grid-template-columns: minmax(13rem, 18rem) minmax(0, 1fr);
    min-height: 66dvh;
    border: 1px solid var(--agent-line);
    border-radius: 0.65rem;
    overflow: hidden;
  }

  .agent-file-browser {
    min-width: 0;
    border-right: 1px solid var(--agent-line);
    background: var(--c-bg);
  }

  .agent-file-browser-head,
  .agent-filebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    min-height: 3.3rem;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--agent-line);
  }

  .agent-file-browser-head strong {
    display: block;
    max-width: 12rem;
    margin-top: 0.18rem;
    overflow: hidden;
    font: 550 0.69rem/1.35 var(--font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .agent-file-browser-head button {
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    border: 1px solid var(--agent-line);
    border-radius: 0.4rem;
    background: var(--c-bg);
    color: var(--c-text-muted);
  }

  .agent-file-search {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.65rem;
    padding: 0.45rem 0.5rem;
    border: 1px solid var(--agent-line);
    border-radius: 0.42rem;
    color: var(--c-text-faint);
  }

  .agent-file-search:focus-within {
    border-color: var(--c-text-muted);
  }

  .agent-file-search input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--c-text);
    font-size: 0.7rem;
  }

  .agent-file-search kbd {
    padding: 0.04rem 0.28rem;
    border: 1px solid var(--agent-line);
    border-radius: 0.25rem;
    font: 0.58rem/1.3 var(--font-mono);
  }

  .agent-file-list {
    max-height: calc(100dvh - 17rem);
    padding: 0 0.4rem 1rem;
    overflow: auto;
    scrollbar-width: thin;
  }

  .agent-file-list > button {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.38rem;
    width: 100%;
    padding: 0.4rem 0.42rem;
    border: 0;
    border-radius: 0.35rem;
    background: transparent;
    color: var(--c-text-muted);
    text-align: left;
  }

  .agent-file-list > button:hover {
    background: var(--c-surface-soft);
    color: var(--c-text);
  }

  .agent-file-list strong {
    overflow: hidden;
    font: 500 0.66rem/1.35 var(--font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .agent-file-viewer {
    min-width: 0;
    background: color-mix(in srgb, var(--c-bg) 97%, var(--c-text) 3%);
  }

  .agent-filebar > div,
  .agent-filebar a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .agent-filebar strong {
    overflow: hidden;
    font: 550 0.7rem/1.3 var(--font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .agent-filebar a {
    flex: none;
    color: var(--c-text-faint);
    font-size: 0.65rem;
    opacity: 1 !important;
  }

  .agent-file-content {
    max-height: calc(100dvh - 13rem);
    overflow: auto;
  }

  .agent-file-empty {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    padding: 8rem 1rem;
    color: var(--c-text-faint);
    text-align: center;
  }

  .agent-file-empty > span {
    font-size: 1.8rem;
  }

  .agent-file-empty h3,
  .agent-file-empty p {
    margin: 0;
  }

  .agent-file-empty h3 {
    color: var(--c-text);
    font-size: 0.95rem;
  }

  .agent-file-empty p {
    font-size: 0.72rem;
  }

  .agent-code-view {
    margin: 0;
    padding: 0.85rem 0;
    overflow: visible;
    background: transparent;
    color: var(--c-text-soft);
    font: 0.68rem/1.65 var(--font-mono);
  }

  .agent-code-view > span {
    display: grid;
    grid-template-columns: 3.2rem minmax(max-content, 1fr);
    min-height: 1.15rem;
  }

  .agent-code-view i {
    padding-right: 0.8rem;
    color: var(--c-text-faint);
    font-style: normal;
    text-align: right;
    user-select: none;
  }

  .agent-code-view code {
    padding-right: 1rem;
    white-space: pre;
  }

  .agent-code-note,
  .agent-panel-empty {
    padding: 1rem;
    color: var(--c-text-faint);
    font-size: 0.7rem;
  }

  .agent-file-markdown {
    width: min(100% - 2rem, 52rem);
    max-width: 100% !important;
    margin: 1.2rem auto 3rem;
  }

  .agent-file-image {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    margin: 0;
    padding: 2rem;
  }

  .agent-file-image img {
    max-width: 100%;
    max-height: 70dvh;
  }

  .agent-file-image figcaption {
    color: var(--c-text-faint);
    font: 0.65rem/1.4 var(--font-mono);
  }

  .agent-repo-drawer {
    position: sticky;
    top: 4.8rem;
    min-width: 0;
    height: calc(100dvh - 5.7rem);
    overflow: hidden;
    border-left: 1px solid var(--agent-line);
    background: var(--c-bg);
  }

  .agent-drawer-toggle {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    left: 0.48rem;
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    border: 1px solid var(--agent-line);
    border-radius: 0.4rem;
    background: var(--c-bg);
    color: var(--c-text-muted);
  }

  .agent-drawer-body {
    width: min(21rem, 100%);
    height: 100%;
    padding: 0.8rem 0.8rem 2rem 3rem;
    overflow: auto;
    opacity: 1;
    scrollbar-width: thin;
    transition: opacity 120ms ease;
  }

  .agent-repo[data-drawer-open='false'] .agent-drawer-body {
    pointer-events: none;
    opacity: 0;
  }

  .agent-drawer-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
