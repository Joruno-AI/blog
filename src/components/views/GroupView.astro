---
import { getCollection } from 'astro:content'

import Warning from '~/components/base/Warning.astro'
import Categorizer from '~/components/base/Categorizer.astro'
import GroupItem from '~/components/views/GroupItem.astro'
import ProjectAnchorNav from '~/components/views/ProjectAnchorNav.astro'
import projectsData from '~/content/projects/data.json'
import { FEATURES } from '~/config'

import type { CollectionKey } from 'astro:content'
import type { GroupItemData } from '~/components/views/GroupItem.astro'

interface Props {
  collectionType: CollectionKey
  pageToc?: boolean
}

const { collectionType, pageToc = false } = Astro.props

const WARNING = `No content available for display.
  Please review and modify <code>GroupView.astro</code> as needed.`

let isEmpty = false
let data: Record<string, GroupItemData[]> = {}

/* Projects */
if (collectionType === 'projects') {
  const projects = await getCollection(collectionType)
  isEmpty = projects.length === 0
  if (isEmpty) return

  const projectOrder = new Map(
    projectsData.map(({ id }, index) => [id, index] as const)
  )
  data = [...projects]
    .sort(
      (a, b) =>
        (projectOrder.get(a.data.id) ?? projects.length) -
        (projectOrder.get(b.data.id) ?? projects.length)
    )
    .map((p) => p.data)
    .reduce((acc: Record<string, GroupItemData[]>, { category, ...rest }) => {
      ;(acc[category] ??= []).push(rest)
      return acc
    }, {})
}

/* Toc */
const { toc } = FEATURES
const tocEnabled = Array.isArray(toc) && toc[0] && pageToc
---

{
  isEmpty ? (
    <Warning html={WARNING} />
  ) : (
    <div
      class:list={[
        'project-directory-layout',
        { 'has-anchor-nav': tocEnabled },
      ]}
    >
      {tocEnabled && <ProjectAnchorNav anchors={Object.keys(data)} />}
      <div class="project-directory-groups">
        {Object.keys(data).map((key, idx) => (
          <div class="slide-enter" style={{ '--enter-stage': idx }}>
            <Categorizer text={key} needId={tocEnabled} wide={true} />
            <GroupItem items={data[key]} />
          </div>
        ))}
      </div>
    </div>
  )
}

<style>
  .project-directory-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }

  .project-directory-layout.has-anchor-nav {
    grid-template-columns: 8.75rem minmax(0, 1fr);
    gap: 1.5rem;
  }

  .project-directory-groups {
    min-width: 0;
  }

  :global(.project-directory-groups .toc-heading) {
    scroll-margin-top: calc(var(--navbar-height, 4rem) + 1rem);
  }

  @media (max-width: 820px) {
    .project-directory-layout.has-anchor-nav {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    :global(.project-directory-groups .toc-heading) {
      scroll-margin-top: calc(var(--navbar-height, 4rem) + 4rem);
    }
  }
</style>
