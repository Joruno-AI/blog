    }
  }
  .agent-file-markdown {
    padding: 1.5rem 2rem 4rem;
    max-width: 56rem;
  }
  .agent-file-image {
    min-height: 100%;
    margin: 0;
    padding: 2rem;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1rem;
  }
  .agent-file-image img {
    max-width: 100%;
    max-height: 70vh;
  }
  .agent-file-image figcaption {
    color: var(--agent-muted);
    font-size: 0.7rem;
  }
  .agent-highlighted-block {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }
  .agent-highlighted-block .shiki,
  .agent-code-fallback {
    width: max-content;
    min-width: 100%;
    margin: 0;
    padding: 0.55rem 0;
    border: 0;
    border-radius: 0;
    background: transparent !important;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.15rem;
  }
  .agent-highlighted-block {
    margin: 1.5rem 0;
    overflow: auto;
    border: 1px solid var(--agent-line);
    border-radius: 0.7rem;
    background: var(--agent-soft);
  }
  .agent-highlighted-block .shiki {
    padding-block: 0.55rem;
  }
  .agent-highlighted-block .shiki > code,
  .agent-code-fallback > code {
    display: block;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    font: inherit;
    line-height: 1.15rem !important;
    box-decoration-break: slice !important;
    -webkit-box-decoration-break: slice !important;
  }
  .agent-highlighted-block .shiki,
  .agent-highlighted-block .shiki span {
    color: var(--shiki-light);
  }
  .dark .agent-highlighted-block .shiki,
  .dark .agent-highlighted-block .shiki span {
    color: var(--shiki-dark);
  }
  .agent-highlighted-block .line {
    position: relative;
    display: block;
    width: 100%;
    min-height: 1.15rem;
    height: 1.15rem;
    margin: 0 !important;
    padding: 0 1.25rem 0 2.7rem;
    line-height: 1.15rem !important;
    white-space: pre;
  }
  .agent-highlighted-block .line::before {
    content: attr(data-line);
    position: absolute;
    left: 0;
    width: 2.4rem;
    padding-right: 0.45rem;
    color: var(--c-text-faint);
    text-align: right;
    font-variant-numeric: tabular-nums;
    user-select: none;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .agent-highlighted-block .line:hover {
    background: var(--agent-soft);
  }
  .agent-empty {
    padding: 1rem;
    color: var(--agent-muted);
    font-size: 0.75rem;
  }
  .agent-list-skeleton {
    padding: 0.65rem 0.5rem;
    display: grid;
    gap: 0.72rem;
  }
  .agent-list-skeleton span {
    width: 92%;
    height: 0.58rem;
    border-radius: 0.1rem;
    background: linear-gradient(
      90deg,
      var(--agent-soft),
      color-mix(in srgb, var(--c-text) 8%, var(--c-bg)),
      var(--agent-soft)
    );
    background-size: 220% 100%;
    animation: agent-shimmer 1.65s ease-in-out infinite;
  }
  .agent-list-skeleton span:nth-child(2) {
    width: 76%;
  }
  .agent-list-skeleton span:nth-child(3) {
    width: 86%;
  }
  .agent-list-skeleton span:nth-child(4) {
    width: 64%;
  }

  .agent-mermaid {
    margin: 2rem 0;
    border: 1px solid var(--diagram-rule);
    border-radius: var(--diagram-radius-frame);
    overflow: hidden;
    background: var(--diagram-paper);
  }
  .agent-mermaid-toolbar {
    min-height: 3.75rem;
    padding: 0.5rem 0.5rem 0.5rem 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--diagram-rule);
  }
  .agent-mermaid-toolbar > span {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--diagram-muted);
  }
  .agent-mermaid-toolbar > span b,
  .agent-mermaid-toolbar > span em {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-style: normal;
    letter-spacing: 0.12em;
  }
  .agent-mermaid-toolbar > span b {
    color: var(--diagram-ink);
    font-weight: 600;
  }
  .agent-mermaid-toolbar > span em {
    color: var(--diagram-soft);
    letter-spacing: 0.04em;
  }
  .agent-mermaid-toolbar > div {
    display: flex;
    gap: 0.25rem;
  }
  .agent-mermaid-toolbar button {
    min-width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.5rem;
    border: 1px solid var(--diagram-rule);
    border-radius: var(--diagram-radius-node);
    background: var(--diagram-paper);
    color: var(--diagram-muted);
    font-family: var(--diagram-font-mono);
    font-size: 0.6rem;
  }
  .agent-mermaid-toolbar button:hover {
    border-color: var(--diagram-rule-solid);
    background: var(--diagram-paper-2);
    color: var(--diagram-ink);
  }
  .agent-mermaid-viewport {
    min-height: 22rem;
    padding: 1.5rem;
    overflow: auto;
    display: grid;
    place-items: center;
    overscroll-behavior: contain;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--diagram-muted) 26%, transparent) 0.75px,
      transparent 0.85px
    );
    background-size: 17px 17px;
  }
  .agent-mermaid-canvas {
    width: var(--diagram-width, 100%);
    min-width: var(--diagram-width, 100%);
    display: grid;
    place-items: center;
    transition: width var(--diagram-motion-fast) ease;
  }
  .agent-mermaid-canvas > svg {
    max-width: none !important;
    width: 100%;
    min-width: 0;
    height: auto;
  }
  .agent-mermaid.is-fullscreen {
    position: fixed;
    z-index: 110;
    inset: 4.75rem 1rem 1rem;
    min-height: 0;
    margin: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    background: var(--diagram-paper);
  }
  .agent-mermaid.is-fullscreen .agent-mermaid-viewport {
    min-height: 0;
    height: 100%;
  }
  @media (max-width: 767px) {
    .agent-mermaid.is-fullscreen {
      inset: 4.25rem 0.5rem 0.5rem;
    }
  }
  .agent-mermaid :is(svg text, svg .nodeLabel, svg .label) {
    fill: var(--diagram-ink) !important;
    color: var(--diagram-ink) !important;
    font-family:
      'Comic Sans MS', 'Bradley Hand', 'Kaiti SC', var(--diagram-font-node) !important;
    font-size: 12px !important;
  }
  .agent-mermaid svg :is(.node rect, .node polygon, .node path, .actor) {
    fill: var(--diagram-paper) !important;
    stroke: var(--diagram-rule-solid) !important;
    stroke-width: 1.75px !important;
    filter: none !important;
  }
  .agent-mermaid svg .node rect {
    rx: var(--diagram-radius-node) !important;
    ry: var(--diagram-radius-node) !important;
  }
  .agent-mermaid svg g.node:first-of-type > :is(rect, polygon, path) {
    fill: var(--diagram-accent-tint) !important;
    stroke: var(--diagram-accent) !important;
  }
  .agent-mermaid svg .cluster rect {
    fill: var(--diagram-paper-2) !important;
    stroke: var(--diagram-rule) !important;
    rx: var(--diagram-radius-frame) !important;
    ry: var(--diagram-radius-frame) !important;
  }
  .agent-mermaid
    svg
    :is(.flowchart-link, .edgePath path, .messageLine0, .messageLine1) {
    stroke: color-mix(
      in srgb,
      var(--diagram-ink) 88%,
      var(--diagram-muted)
    ) !important;
    stroke-width: 2.15px !important;
    stroke-linecap: round !important;
    stroke-linejoin: round !important;
  }
  .agent-mermaid
    svg.agent-excalidraw-svg
    :is(.node rect, .node polygon, .node path, .actor, .cluster rect) {
    filter: var(--agent-hand-drawn-filter) !important;
    stroke-linecap: round !important;
    stroke-linejoin: round !important;
  }
  .agent-mermaid
    svg.agent-excalidraw-svg
    :is(.flowchart-link, .edgePath path, .messageLine0, .messageLine1) {
    filter: none !important;
    opacity: 1 !important;
  }
  .agent-mermaid svg marker path {
    fill: var(--diagram-ink) !important;
    stroke: var(--diagram-ink) !important;
  }
  .agent-mermaid svg .edgeLabel {
    color: var(--diagram-muted) !important;
    background: var(--diagram-paper) !important;
    font-family: var(--diagram-font-mono) !important;
    font-size: 8px !important;
  }
  .agent-mermaid svg .edgeLabel rect {
    fill: var(--diagram-paper) !important;
    opacity: 1 !important;
  }
  .agent-mermaid figcaption {
    padding: 0.55rem 0.75rem;
    border-top: 1px solid var(--diagram-rule);
    color: var(--diagram-soft);
    font-family: var(--diagram-font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-align: right;
  }

  /* Repository reader polish: surfaces are separated by tone, spacing and
     depth instead of persistent outlines. Motion borrows Sylva's soft lift
     and icon response while all colours continue to come from the blog theme. */
  .agent-material-icon,
  .agent-file-reference-icon,
  [data-file-icon] {
    width: 1.08rem;
    height: 1.08rem;
    flex: 0 0 auto;
    object-fit: contain;
    filter: saturate(0.9);
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 220ms ease;
  }
  .agent-knowledge-head {
    border-bottom: 0;
    box-shadow: 0 1rem 2.6rem -2.35rem var(--c-shadow-key);
  }
  .agent-wiki-main {
    border-right: 0;
  }
  .agent-nav-repo-card {
    border-top: 0;
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--c-text) 3.5%, var(--c-bg));
  }
  .agent-knowledge-actions > button,
  .agent-knowledge-actions > a {
    border: 0;
    background: color-mix(in srgb, var(--c-text) 4%, var(--c-bg));
    transition:
      color 180ms ease,
      background-color 180ms ease,
      box-shadow 220ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .agent-back {
    transition:
      color 180ms ease,
      background-color 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .agent-knowledge-actions > button:hover,
  .agent-knowledge-actions > a:hover,
  .agent-back:hover {
    border: 0;
    background: color-mix(in srgb, var(--c-text) 8%, var(--c-bg));
    color: var(--c-text);
    transform: translateY(-2px);
    box-shadow: 0 0.9rem 1.8rem -1.2rem var(--c-shadow-key);
  }
  .agent-knowledge-actions > button:hover > span:first-child,
  .agent-knowledge-actions > a:hover > span,
  .agent-back:hover > span {
    transform: scale(1.08) rotate(-3deg);
  }
  .agent-knowledge-actions > button > span:first-child,
  .agent-knowledge-actions > a > span,
  .agent-back > span {
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-file-icon] {
    width: 1.22rem;
    height: 1.22rem;
  }
  .agent-atlas-head a,
  .agent-atlas-head button,
  .agent-atlas-tabs button,
  .agent-file-browser-head button,
  .agent-file-viewer > header a,
  .agent-start-files button,
  .agent-atlas-docs button,
  .agent-file-list button,
  .agent-overview-topics a,
  .agent-page-links :is(a, button) {
    position: relative;
    isolation: isolate;
    cursor: pointer;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      box-shadow 220ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .agent-atlas-head a:hover,
  .agent-file-browser-head button:hover,
  .agent-file-viewer > header a:hover,
  .agent-overview-topics a:hover,
  .agent-page-links :is(a, button):hover {
    color: var(--c-text);
    transform: translateY(-1px);
  }
  .agent-atlas-head a:hover span,
  .agent-file-viewer > header a:hover span,
  .agent-page-links :is(a, button):hover :is(span, i) {
    transform: translate3d(2px, -2px, 0);
  }
  .agent-atlas-head a span,
  .agent-file-viewer > header a span,
  .agent-page-links :is(a, button) :is(span, i) {
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .agent-atlas-head [data-atlas-close] {
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 50%;
    background: transparent;
    box-shadow: none;
    color: var(--agent-muted);
  }
  .agent-atlas-head [data-atlas-close]:hover {
    background: color-mix(in srgb, var(--c-text) 8%, var(--c-bg));
    color: var(--c-text);
    transform: rotate(6deg) scale(1.04);
    box-shadow: 0 0.7rem 1.8rem -1rem var(--c-shadow-key);
  }
  .agent-atlas-head [data-atlas-close]:active {
    transform: rotate(0) scale(0.92);
  }
  .agent-atlas-head [data-atlas-close]:focus-visible,
  .agent-atlas-tabs button:focus-visible,
  .agent-file-list button:focus-visible {
    outline: 0;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c-text) 14%, transparent);
  }
  .agent-atlas-tabs {
    min-height: 3.35rem;
    padding: 0.45rem 1.15rem;
    align-items: center;
    gap: 0.25rem;
  }
  .agent-atlas-tabs button {
    height: 2.35rem;
    padding: 0 0.72rem;
    gap: 0.38rem;
    border-radius: 0.68rem;
  }
  .agent-atlas-tabs button::after {
    content: '';
    position: absolute;
    inset: auto 0.78rem 0.25rem;
    height: 2px;
    border-radius: 999px;
    background: var(--c-text);
    opacity: 0;
    transform: scaleX(0.45);
    transition:
      opacity 180ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .agent-atlas-tabs button:hover {
    background: color-mix(in srgb, var(--c-text) 5%, transparent);
    color: var(--c-text);
    transform: translateY(-1px);
  }
  .agent-atlas-tabs button:hover > span {
    transform: translateY(-1px) rotate(-4deg) scale(1.08);
  }
  .agent-atlas-tabs button > span {
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .agent-atlas-tabs button.is-active {
    background: color-mix(in srgb, var(--c-text) 7%, var(--c-bg));
    color: var(--c-text);
    box-shadow: inset 0 1px color-mix(in srgb, white 12%, transparent);
  }
  .agent-atlas-tabs button.is-active::after {
    opacity: 0.78;
    transform: scaleX(1);
  }
  .agent-overview-facts {
    gap: 0.45rem;
    border: 0;
  }
  .agent-overview-facts > div {
    min-height: 4.5rem;
    padding: 0.82rem 0.75rem;
    border: 0;
    border-radius: 0.72rem;
    background: color-mix(in srgb, var(--c-text) 4%, var(--c-bg));
    transition:
      background-color 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .agent-overview-facts > div:hover {
    background: color-mix(in srgb, var(--c-text) 7%, var(--c-bg));
    transform: translateY(-2px);
  }
  .agent-overview-facts strong {
    overflow: visible;
    text-overflow: clip;
    font-size: clamp(0.7rem, 0.75vw, 0.82rem);
  }
  .agent-start-files {
    gap: 0.45rem;
    border: 0;
  }
  .agent-start-files button {
    border: 0 !important;
    border-radius: 0.68rem;
    background: color-mix(in srgb, var(--c-text) 3%, var(--c-bg));
  }
  .agent-start-files button:hover,
  .agent-atlas-docs button:hover {
    background: color-mix(in srgb, var(--c-text) 7%, var(--c-bg));
    transform: translateY(-2px);
    box-shadow: 0 0.9rem 2rem -1.35rem var(--c-shadow-key);
  }
  .agent-start-files button:hover .agent-material-icon,
  .agent-atlas-docs button:hover .agent-material-icon,
  .agent-file-list button:hover .agent-material-icon {
    filter: saturate(1.08);
    transform: scale(1.1);
  }
  .agent-files-shell {
    grid-template-columns: clamp(17rem, 29%, 21rem) minmax(0, 1fr);
  }
  .agent-file-browser,
  .agent-file-viewer {
    border: 0;
    background: color-mix(in srgb, var(--c-text) 3%, var(--c-bg));
    box-shadow: 0 1.1rem 3rem -2.45rem var(--c-shadow-key);
  }
  .agent-file-viewer > header {
    background: color-mix(in srgb, var(--c-text) 4%, var(--c-bg));
  }
  .agent-file-content,
  .agent-file-content.is-code-viewer {
    background: var(--c-bg);
  }
  .agent-file-list button:hover {
    background: color-mix(in srgb, var(--c-text) 7%, transparent);
    transform: translateX(2px);
  }
  .agent-tree-entry.is-active > button {
    background: color-mix(in srgb, var(--c-text) 10%, var(--c-bg));
    box-shadow: inset 2px 0 var(--c-text);
  }
  .agent-file-list .agent-search-result {
    grid-template-columns: 1.15rem minmax(0, 1fr);
  }
  .agent-wiki-article a.agent-file-reference,
  .agent-file-markdown a.agent-file-reference {
    padding: 0.12rem 0.38rem;
    border: 0;
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--c-text) 6%, var(--c-bg));
    box-shadow: inset 0 -1px color-mix(in srgb, var(--c-text) 12%, transparent);
    transition:
      background-color 180ms ease,
      box-shadow 220ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .agent-file-reference:hover {
    border: 0;
    background: color-mix(in srgb, var(--c-text) 10%, var(--c-bg));
    box-shadow:
      inset 0 -1px color-mix(in srgb, var(--c-text) 18%, transparent),
      0 0.7rem 1.4rem -1rem var(--c-shadow-key);
    transform: translateY(-1px);
  }
  .agent-file-reference:hover .agent-file-reference-icon {
    filter: saturate(1.12);
    transform: scale(1.12) rotate(-3deg);
  }
  .agent-source-files {
    border: 0;
    border-radius: 0.72rem;
    background: color-mix(in srgb, var(--c-text) 4%, var(--c-bg));
    box-shadow: inset 0 1px color-mix(in srgb, white 7%, transparent);
  }

  /* Final repository-reader language: flat editorial separators, quiet
     surfaces and inline references. Depth is reserved for the modal scrim. */
  .agent-knowledge-head,
  .agent-knowledge-actions > button:hover,
  .agent-knowledge-actions > a:hover,
  .agent-back:hover,
  .agent-atlas-head [data-atlas-close]:hover,
  .agent-start-files button:hover,
  .agent-atlas-docs button:hover,
  .agent-file-browser,
  .agent-file-viewer {
    box-shadow: none;
  }

  .agent-knowledge-head {
    border-bottom: 1px solid var(--agent-line);
  }

  .agent-atlas {
    border-left: 1px solid var(--agent-line);
    box-shadow: none;
  }

  .agent-overview-facts {
    gap: 0;
    border-top: 1px solid var(--agent-line);
    border-bottom: 1px solid var(--agent-line);
  }

  .agent-overview-facts > div {
    border-radius: 0;
    background: transparent;
  }

  .agent-overview-facts > div:hover {
    background: var(--agent-soft);
    transform: none;
  }

  .agent-file-browser,
  .agent-file-viewer {
    border: 1px solid var(--agent-line);
    background: var(--c-bg);
  }

  .agent-wiki-article a.agent-file-reference,
  .agent-file-markdown a.agent-file-reference {
    gap: 0.18rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: inherit;
    font-size: 0.86em;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--c-text) 36%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .agent-file-reference-icon {
    display: none;
  }

  .agent-file-reference:hover {
    background: transparent;
    box-shadow: none;
    color: var(--c-text);
    text-decoration-color: currentColor;
    transform: none;
  }

  .agent-file-reference:hover .agent-file-reference-icon {
    filter: none;
    transform: none;
  }

  .agent-source-files {
    border-top: 1px solid var(--agent-line);
    border-bottom: 1px solid var(--agent-line);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  /* Keep navigation controls stationary; only the document/page lists scroll. */
  .agent-wiki-nav {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-bottom: 1rem;
  }

  .agent-wiki-nav-head,
  .agent-nav-search,
  .agent-nav-repo-card {
    flex: 0 0 auto;
  }

  .agent-wiki-pages {
    flex: 1 1 auto;
    min-height: 0;
    margin-top: 0.85rem;
    padding-right: 0.2rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    align-content: start;
    grid-auto-rows: max-content;
  }

  .agent-wiki-pages button {
    height: auto;
    min-height: 2.15rem;
    overflow: visible;
  }

  .agent-wiki-pages button[hidden],
  .agent-nav-search-empty[hidden] {
    display: none !important;
  }

  .agent-nav-search-empty {
    align-self: start;
    width: 100%;
    margin-top: 0.4rem;
  }

  .agent-nav-search [data-doc-search-clear] {
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 0.4rem;
    background: transparent;
    transform: none;
  }

  .agent-nav-search [data-doc-search-clear]:hover {
    background: color-mix(in srgb, var(--c-text) 8%, transparent);
    transform: none;
  }

  .agent-nav-search:has([data-doc-search-clear]:not([hidden])) kbd {
    display: none;
  }

  .agent-wiki-pages button.is-active,
  .agent-tree-entry.is-active > button {
    box-shadow: none;
  }

  .agent-wiki-pages button.is-active strong,
  .agent-tree-entry.is-active > button strong {
    font-weight: 680;
  }

  .agent-page-toc {
    overflow: hidden;
  }

  .agent-page-toc-inner {
    height: 100%;
    min-height: 0;
    grid-template-rows: minmax(0, 1fr);
  }

  .agent-page-toc nav {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
  }

  .agent-wiki-article a.agent-file-reference,
  .agent-file-markdown a.agent-file-reference {
    position: relative;
    isolation: isolate;
    gap: 0.3rem;
    color: var(--c-text-soft);
    text-decoration: none;
    transition:
      color 220ms ease,
      background-color 220ms ease,
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .agent-wiki-article a.agent-file-reference::after,
  .agent-file-markdown a.agent-file-reference::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -0.12em;
    left: 0;
    height: 1px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-text) 32%, transparent);
    transform: scaleX(1);
    transform-origin: left center;
    transition:
      transform 340ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 220ms ease,
      height 220ms ease;
  }

  .agent-file-reference-icon {
    display: inline-block;
    width: 0.92em;
    height: 0.92em;
    opacity: 0.78;
    filter: grayscale(0.32) saturate(0.82);
  }

  .agent-file-reference-label {
    min-width: 0;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .agent-wiki-article a.agent-external-link,
  .agent-file-markdown a.agent-external-link {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.12em;
    color: var(--c-text-soft);
    text-decoration: none;
    vertical-align: baseline;
    transition:
      color 200ms ease,
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .agent-wiki-article a.agent-external-link::after,
  .agent-file-markdown a.agent-external-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -0.12em;
    left: 0;
    height: 1px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-text) 34%, transparent);
    transform: scaleX(1);
    transform-origin: left center;
    transition:
      background-color 200ms ease,
      height 200ms ease,
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .agent-external-link-icon {
    display: inline-block;
    flex: none;
    font-size: 0.72em;
    opacity: 0.7;
    transition:
      color 200ms ease,
      opacity 200ms ease,
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .agent-wiki-article a.agent-external-link:hover,
  .agent-wiki-article a.agent-external-link:focus-visible,
  .agent-file-markdown a.agent-external-link:hover,
  .agent-file-markdown a.agent-external-link:focus-visible {
    color: var(--c-accent-strong);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .agent-wiki-article a.agent-external-link:hover::after,
  .agent-wiki-article a.agent-external-link:focus-visible::after,
  .agent-file-markdown a.agent-external-link:hover::after,
  .agent-file-markdown a.agent-external-link:focus-visible::after {
    height: 1.5px;
    background: var(--c-accent);
  }

  .agent-external-link:hover .agent-external-link-icon,
  .agent-external-link:focus-visible .agent-external-link-icon {
    opacity: 1;
    transform: translate(0.14em, -0.14em);
  }

  .agent-wiki-article code:not(pre code),
  .agent-file-markdown code:not(pre code) {
    transition:
      color 180ms ease,
      background-color 180ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .agent-wiki-article code:not(pre code):hover,
  .agent-file-markdown code:not(pre code):hover,
  .agent-wiki-article a:hover > code:not(pre code),
  .agent-wiki-article a:focus-visible > code:not(pre code),
  .agent-file-markdown a:hover > code:not(pre code),
  .agent-file-markdown a:focus-visible > code:not(pre code) {
    color: var(--c-accent-strong);
    background: var(--agent-accent-soft);
    transform: translateY(-1px);
  }

  .agent-wiki-article a.agent-file-reference:hover,
  .agent-wiki-article a.agent-file-reference:focus-visible,
  .agent-file-markdown a.agent-file-reference:hover,
  .agent-file-markdown a.agent-file-reference:focus-visible {
    color: var(--c-accent-strong);
    background: color-mix(in srgb, var(--c-accent) 8%, transparent);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .agent-wiki-article a.agent-file-reference:hover::after,
  .agent-wiki-article a.agent-file-reference:focus-visible::after,
  .agent-file-markdown a.agent-file-reference:hover::after,
  .agent-file-markdown a.agent-file-reference:focus-visible::after {
    height: 2px;
    background: var(--c-accent-strong);
    transform: scaleX(1);
    transform-origin: left center;
  }

  .agent-file-reference:hover .agent-file-reference-icon,
  .agent-file-reference:focus-visible .agent-file-reference-icon {
    opacity: 1;
    filter: grayscale(0) saturate(1.18) brightness(1.04);
    transform: translateY(-1px) scale(1.1) rotate(-3deg);
  }

  .agent-file-browser-head button {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--agent-line);
    border-radius: 0.55rem;
    background: transparent;
    color: var(--agent-muted);
    font-size: 1rem;
    box-shadow: none;
  }

  .agent-file-browser-head button:hover {
    border-color: var(--agent-line-strong);
    background: var(--agent-soft);
    color: var(--c-text);
    transform: none;
  }

  .agent-file-browser-head button:active {
    transform: scale(0.95);
  }

  /* Low-saturation editorial system: muted plum carries navigation and
     selection, clay red is reserved for relationships and small moments of
     emphasis. Neutral paper remains dominant for comfortable long reading. */
  .agent-knowledge {
    --agent-line: color-mix(
      in srgb,
      var(--c-text) 9%,
      color-mix(in srgb, var(--c-accent) 8%, transparent)
    );
    --agent-line-strong: color-mix(
      in srgb,
      var(--c-text) 16%,
      var(--c-accent) 7%
    );
    --agent-soft: color-mix(in srgb, var(--c-accent) 4.5%, var(--c-bg));
    --agent-accent-soft: color-mix(in srgb, var(--c-accent) 9%, var(--c-bg));
    --agent-alt-soft: color-mix(in srgb, var(--c-accent-alt) 7%, var(--c-bg));
    background: transparent;
  }

  .agent-knowledge-head {
    background: color-mix(in srgb, var(--c-surface-overlay) 88%, transparent);
    border-bottom-color: color-mix(
      in srgb,
      var(--c-accent) 13%,
      var(--agent-line)
    );
  }

  .agent-wiki-nav,
  .agent-page-toc {
    background: color-mix(in srgb, var(--c-accent) 2.6%, var(--c-bg));
  }

  .agent-wiki-nav-head > div > span,
  .agent-page-toc-inner > span,
  .agent-map-section header > div > span,
  .agent-diagram-eyebrow {
    color: var(--c-accent-strong);
  }

  .agent-nav-search:focus-within,
  .agent-file-search:focus-within {
    background: var(--c-bg);
    box-shadow: 0 0 0 2px var(--c-focus-ring);
  }

  .agent-wiki-pages button:hover {
    background: transparent;
    color: var(--c-text);
  }

  .agent-wiki-pages button.is-active {
    background: transparent;
    color: var(--c-text);
    box-shadow: none;
  }

  .agent-wiki-pages button.is-active span {
    color: var(--c-text);
  }

  .agent-knowledge-actions .agent-atlas-launch,
  .agent-atlas-intro button,
  .agent-wiki-error button,
  .agent-wiki-error a {
    border-color: var(--c-accent);
    background: var(--c-accent);
    color: var(--c-accent-contrast);
  }

  .agent-knowledge-actions .agent-atlas-launch:hover,
  .agent-atlas-intro button:hover {
    border-color: var(--c-accent-strong);
    background: var(--c-accent-strong);
    color: var(--c-accent-contrast);
  }

  .agent-atlas {
    background: var(--c-bg);
    border-left-color: color-mix(
      in srgb,
      var(--c-accent) 15%,
      var(--agent-line)
    );
  }

  .agent-atlas-head,
  .agent-atlas-tabs {
    background: color-mix(in srgb, var(--c-accent) 3.3%, var(--c-bg));
  }

  .agent-atlas-title > span,
  .agent-mermaid-toolbar > span > i {
    color: var(--c-accent);
  }

  .agent-atlas-tabs button:hover {
    background: var(--agent-accent-soft);
    color: var(--c-text);
  }

  .agent-atlas-tabs button.is-active {
    background: var(--agent-accent-soft);
    color: var(--c-accent-strong);
    box-shadow: none;
  }

  .agent-atlas-tabs button::after {
    background: var(--c-accent);
  }

  .agent-overview-facts > div:hover {
    background: var(--agent-accent-soft);
  }

  .agent-overview-facts > div:nth-child(-n + 3) strong {
    color: var(--c-accent-strong);
  }

  .agent-overview-facts > div:nth-child(n + 4):nth-child(-n + 6) strong {
    color: color-mix(in srgb, var(--c-accent-alt) 76%, var(--c-text));
  }

  .agent-tree-entry.is-active > button,
  .agent-file-list button.is-active {
    background: var(--agent-accent-soft);
    color: var(--c-accent-strong);
    box-shadow: none;
  }

  /* Deep repository paths must grow the tree canvas instead of recursively
     squeezing every child row until the selected filename disappears. */
  .agent-file-list > .agent-tree-entry,
  .agent-tree-entry,
  .agent-tree-group {
    width: max-content;
    min-width: 100%;
  }

  .agent-tree-entry > button {
    width: 100%;
    min-width: max-content;
    grid-template-columns: 0.9rem 1.35rem max-content;
    padding-right: 0.85rem;
  }

  .agent-tree-entry > button > strong {
    overflow: visible;
    text-overflow: clip;
  }

  .agent-file-list .agent-material-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .agent-tree-entry.is-active > button {
    background: color-mix(in srgb, var(--c-accent) 9%, var(--c-surface-soft));
  }

  .agent-tree-entry.is-active > button .agent-material-icon {
    filter: saturate(1.08);
    transform: scale(1.06);
  }

  .agent-file-browser-head,
  .agent-file-viewer > header {
    background: color-mix(in srgb, var(--c-accent) 3.5%, var(--c-bg));
  }

  .agent-mermaid {
    border-color: color-mix(in srgb, var(--c-accent) 16%, var(--diagram-rule));
  }

  .agent-mermaid-viewport {
    background-color: color-mix(in srgb, var(--c-accent) 1.8%, var(--c-bg));
  }

  /* Repository reader refinement. Side columns stay on the page canvas instead of
     becoming two grey panels; hierarchy is carried by rules and typography. */
  .agent-wiki-nav,
  .agent-page-toc {
    background: transparent;
  }

  /* The repository bar is context, not a second navbar. Keep it compact,
     aligned with the reader grid and let the page canvas show through. */
  .agent-knowledge {
    --agent-reader-head: 3.65rem;
  }

  .agent-knowledge-head {
    padding-inline: clamp(0.85rem, 2vw, 1.5rem);
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    border-bottom-color: var(--agent-line);
    backdrop-filter: blur(20px) saturate(120%);
  }

  .agent-knowledge-head-inner {
    width: min(100%, 82rem);
    height: 100%;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .agent-knowledge-brand {
    gap: 0.58rem;
  }

  .agent-back {
    width: 2.15rem;
    height: 2.15rem;
    margin-right: 0.12rem;
    border-radius: 50%;
  }

  .agent-knowledge-brand img {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.48rem;
  }

  .agent-knowledge-brand > div {
    gap: 0.3rem;
  }

  .agent-knowledge-brand p span,
  .agent-knowledge-brand p i {
    font-size: 0.78rem;
  }

  .agent-knowledge-brand h1 {
    font-size: 0.98rem;
    font-weight: 680;
    letter-spacing: -0.015em;
  }

  .agent-source-state {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .agent-knowledge-actions {
    gap: 0.18rem;
  }

  .agent-knowledge-actions > button,
  .agent-knowledge-actions > a,
  .agent-knowledge-actions .agent-atlas-launch {
    min-height: 2.15rem;
    padding-inline: 0.68rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--agent-muted);
    box-shadow: none;
    transform: none;
  }

  .agent-knowledge-actions > a {
    width: 2.15rem;
    padding: 0;
  }

  .agent-knowledge-actions > button:hover,
  .agent-knowledge-actions > a:hover,
  .agent-knowledge-actions .agent-atlas-launch:hover,
  .agent-back:hover {
    background: var(--agent-soft);
    color: var(--c-text);
    box-shadow: none;
    transform: none;
  }

  /* Better Auth-inspired stepped outline. The rail moves with the heading
     depth, while the active section strengthens only its local segment. */
  .agent-page-toc nav {
    --toc-rail-color: color-mix(in srgb, var(--c-text) 15%, transparent);
    position: relative;
    display: block;
    margin-top: 0;
    padding-block: 0.7rem;
    border-left: 0;
    scrollbar-width: none;
    scrollbar-gutter: auto;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 0.7rem,
      #000 calc(100% - 0.7rem),
      transparent
    );
  }

  .agent-page-toc nav::-webkit-scrollbar {
    display: none;
  }

  .agent-toc-list {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .agent-page-toc nav a {
    position: relative;
    z-index: 1;
    min-height: 2rem;
    padding: 0.38rem 0.35rem 0.38rem 1.25rem;
    border-radius: 0;
    color: var(--agent-muted);
    font-size: 0.76rem;
    line-height: 1.25rem;
    overflow-wrap: anywhere;
    transition: color 180ms ease;
  }

  .agent-page-toc nav a[data-level='3'] {
    padding-left: 2rem;
    font-size: 0.72rem;
  }

  .agent-page-toc nav a > span {
    display: block;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .agent-toc-track {
    position: absolute;
    z-index: 0;
    top: 0;
    left: 0;
    overflow: visible;
    pointer-events: none;
  }

  .agent-toc-track path {
    stroke-width: 1;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .agent-toc-track-base path {
    stroke: var(--toc-rail-color);
  }

  .agent-toc-track-active {
    --toc-track-bottom: 0px;
    clip-path: polygon(
      0 0,
      100% 0,
      100% var(--toc-track-bottom),
      0 var(--toc-track-bottom)
    );
    transition: clip-path 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .agent-toc-track-active path {
    stroke: var(--c-text);
    stroke-width: 1.35;
  }

  .agent-page-toc nav a:hover {
    background: transparent;
    color: var(--c-text);
    transform: none;
  }

  .agent-page-toc nav a:hover > span {
    transform: translateX(0.14rem);
  }

  .agent-page-toc nav a.is-active {
    color: var(--c-text);
    font-weight: 660;
  }

  .agent-page-toc nav a:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .agent-page-toc nav a:focus-visible > span {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  @media (prefers-reduced-motion: reduce) {
    .agent-toc-track-active,
    .agent-page-toc nav a > span {
      transition: none;
    }
  }

  .agent-atlas-scrim {
    z-index: 110;
  }

  .agent-atlas {
    z-index: 120;
    box-shadow: none;
    border-left: 1px solid var(--agent-line);
  }

  .agent-knowledge {
    --diagram-node-blue: #eaf2ff;
    --diagram-node-blue-border: #4f6fdb;
    --diagram-node-green: #e8f7ef;
    --diagram-node-green-border: #2b8a62;
    --diagram-node-amber: #fff3db;
    --diagram-node-amber-border: #c77b18;
    --diagram-node-violet: #f3ebff;
    --diagram-node-violet-border: #8056c7;
  }

  html.dark .agent-knowledge {
    --diagram-node-blue: #15203b;
    --diagram-node-blue-border: #86a2ff;
    --diagram-node-green: #102d24;
    --diagram-node-green-border: #65c99d;
    --diagram-node-amber: #332511;
    --diagram-node-amber-border: #e6aa54;
    --diagram-node-violet: #291b3d;
    --diagram-node-violet-border: #b394ed;
  }

  .agent-mermaid svg g.node[data-palette='0'] > :is(rect, polygon, path) {
    fill: var(--diagram-node-blue) !important;
    stroke: var(--diagram-node-blue-border) !important;
  }

  .agent-mermaid svg g.node[data-palette='1'] > :is(rect, polygon, path) {
    fill: var(--diagram-node-green) !important;
    stroke: var(--diagram-node-green-border) !important;
  }

  .agent-mermaid svg g.node[data-palette='2'] > :is(rect, polygon, path) {
    fill: var(--diagram-node-amber) !important;
    stroke: var(--diagram-node-amber-border) !important;
  }

  .agent-mermaid svg g.node[data-palette='3'] > :is(rect, polygon, path) {
    fill: var(--diagram-node-violet) !important;
    stroke: var(--diagram-node-violet-border) !important;
  }

  .agent-mermaid svg g.cluster[data-palette='0'] > rect {
    fill: color-mix(
      in srgb,
      var(--diagram-node-blue) 62%,
      var(--diagram-paper)
    ) !important;
  }

  .agent-mermaid svg g.cluster[data-palette='1'] > rect {
    fill: color-mix(
      in srgb,
      var(--diagram-node-green) 62%,
      var(--diagram-paper)
    ) !important;
  }

  .agent-mermaid svg g.cluster[data-palette='2'] > rect {
    fill: color-mix(
      in srgb,
      var(--diagram-node-amber) 62%,
      var(--diagram-paper)
    ) !important;
  }

  .agent-mermaid svg g.cluster[data-palette='3'] > rect {
    fill: color-mix(
      in srgb,
      var(--diagram-node-violet) 62%,
      var(--diagram-paper)
    ) !important;
  }

  .agent-mermaid svg g.edgePath[data-palette='0'] path {
    stroke: var(--diagram-node-blue-border) !important;
  }

  .agent-mermaid svg g.edgePath[data-palette='1'] path {
    stroke: var(--diagram-node-green-border) !important;
  }

  .agent-mermaid svg g.edgePath[data-palette='2'] path {
    stroke: var(--diagram-node-amber-border) !important;
  }

  .agent-mermaid svg g.edgePath[data-palette='3'] path {
    stroke: var(--diagram-node-violet-border) !important;
  }

  .agent-mermaid-scale {
    min-width: 4.4rem;
    height: 2.75rem;
    padding: 0 0.55rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    border: 1px solid var(--diagram-rule);
    border-radius: var(--diagram-radius-node);
    background: var(--diagram-paper);
    color: var(--diagram-muted);
    font-family: var(--diagram-font-mono);
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }

  .agent-mermaid-scale:focus-within {
    border-color: var(--diagram-node-blue-border);
    background: var(--diagram-paper-2);
    color: var(--diagram-ink);
    box-shadow: 0 0 0 2px
      color-mix(in srgb, var(--diagram-node-blue-border) 18%, transparent);
  }

  .agent-mermaid-scale input {
    width: 2.35rem;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: currentColor;
    font: inherit;
    text-align: right;
    appearance: textfield;
  }

  .agent-mermaid-scale input::-webkit-inner-spin-button,
  .agent-mermaid-scale input::-webkit-outer-spin-button {
    margin: 0;
    appearance: none;
  }

  .agent-mermaid.is-fullscreen {
    z-index: 130;
    inset: 0.75rem;
  }

  .agent-mermaid:fullscreen {
    width: 100vw;
    height: 100vh;
    min-height: 0;
    margin: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    border: 0;
    border-radius: 0;
    background: var(--diagram-paper);
  }

  .agent-mermaid:fullscreen .agent-mermaid-viewport {
    min-height: 0;
    height: 100%;
  }

  .agent-diagram-loading {
    position: relative;
    width: min(22rem, 80%);
    min-height: 10rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    color: var(--diagram-soft);
  }

  .agent-diagram-loading::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 22%;
    right: 22%;
    height: 1px;
