  .agent-file-list button > span.i-ri-folder-3-line {
    color: #d09a22;
  }
  .agent-file-list button > span.i-ri-markdown-line {
    color: #4285a8;
  }
  .agent-file-list button > span.i-ri-braces-line {
    color: #a56a32;
  }
  .agent-file-list button > span.i-ri-palette-line {
