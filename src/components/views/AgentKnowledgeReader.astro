---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Link from '~/components/base/Link.astro'
import { withBasePath } from '~/utils/path'
import {
  formatCount,
  githubAvatar,
  installCommand,
  INSTALLABLE_CATEGORIES,
} from '~/utils/skills'

import type { CollectionEntry } from 'astro:content'

type Skill = CollectionEntry<'skills'>['data']

interface Props {
  skill?: Skill
}

const { skill } = Astro.props
const repo = skill?.id ?? ''
const installable = skill ? INSTALLABLE_CATEGORIES.has(skill.category) : false
const command = skill
  ? installable
    ? installCommand(skill.id)
    : `git clone https://github.com/${skill.id}.git`
  : ''
const description = skill?.descZh || skill?.desc || ''
const agentBase = withBasePath('/agent/')
const bootstrapJson = JSON.stringify({
  repo,
  skill: skill
    ? {
        name: skill.name,
        author: skill.author,
        description,
        stars: skill.stars,
        language: skill.language,
        command,
      }
    : null,
}).replace(/</g, '\\u003c')
---

<BaseLayout
  title={skill ? `${skill.name} - Agent 知识库` : 'Agent 知识库'}
  description={description ||
    '基于仓库源码生成的站内知识库、架构地图与文件浏览器'}
  bgType={false}
  hideFooter={true}
  stableNavigation={true}
>
  <div
    class="agent-knowledge"
    data-agent-knowledge
    data-agent-base={agentBase}
    data-atlas-open="false"
  >
    <header class="agent-knowledge-head">
      <div class="agent-knowledge-head-inner">
        <div class="agent-knowledge-brand">
          <Link
            class="agent-back"
            href={withBasePath('/agent/')}
            aria-label="返回 Agent 目录"
          >
            <span class="i-ri-arrow-left-line" aria-hidden="true"></span>
          </Link>
          <img
            src={skill ? githubAvatar(skill.author, 96) : ''}
            alt=""
            data-repo-avatar
            hidden={!skill}
          />
          <div>
            <p>
              <span data-repo-owner>{skill?.author ?? 'GitHub'}</span><i>/</i>
            </p>
            <h1 data-repo-title>{skill?.name ?? '正在读取仓库…'}</h1>
          </div>
          <span
            class="agent-source-state"
            data-source-state
            role="status"
            aria-live="polite"
          >
            <i aria-hidden="true"></i><span>连接中</span>
          </span>
        </div>

        <div class="agent-knowledge-actions">
          <button
            type="button"
            class="agent-mobile-nav"
            data-mobile-nav
            aria-label="打开文档目录"
            aria-controls="agent-wiki-nav"
            aria-expanded="false"
          >
            <span class="i-ri-menu-2-line" aria-hidden="true"></span>
            目录
          </button>
          <button
            type="button"
            data-copy-command
            data-copy={command}
            hidden={!command}
          >
            <span class="i-ri-terminal-box-line" aria-hidden="true"></span>
            <span data-command-label>{installable ? '安装' : '克隆'}</span>
          </button>
          <button
            type="button"
            class="agent-atlas-launch"
            data-atlas-launch
            aria-controls="agent-atlas"
            aria-expanded="false"
            aria-haspopup="dialog"
          >
            <span class="i-ri-node-tree" aria-hidden="true"></span>
            仓库地图
          </button>
          <a
            href={repo ? `https://github.com/${repo}` : 'https://github.com'}
            data-github-link
            target="_blank"
            rel="noopener"
            aria-label="在 GitHub 查看"
          >
            <span class="i-uil-github-alt" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </header>

    <div class="agent-reader-shell">
      <aside
        id="agent-wiki-nav"
        class="agent-wiki-nav"
        data-wiki-nav
        aria-label="知识库目录"
      >
        <div class="agent-wiki-nav-head">
          <button type="button" data-mobile-nav-close aria-label="关闭文档目录">
            <span class="i-ri-close-line" aria-hidden="true"></span>
          </button>
        </div>
        <div class="agent-nav-search">
          <span class="i-ri-search-line" aria-hidden="true"></span>
          <input
            type="search"
            data-doc-search
            placeholder="搜索章节"
            autocomplete="off"
            aria-label="搜索仓库文档章节"
          />
          <button
            type="button"
            data-doc-search-clear
            aria-label="清空章节搜索"
            hidden
          >
            <span class="i-ri-close-line" aria-hidden="true"></span>
          </button>
          <kbd>/</kbd>
        </div>
        <nav class="agent-wiki-pages" data-wiki-pages aria-label="文档章节">
          <div class="agent-list-skeleton">
            <span></span><span></span><span></span><span></span>
          </div>
          <p class="agent-nav-search-empty" data-doc-search-empty hidden>
            没有匹配的章节
          </p>
        </nav>
        <div class="agent-nav-repo-card">
          <span>仓库</span>
          <strong data-repo-full-name>{repo || '读取中…'}</strong>
          <small data-repo-description
            >{description || '正在读取仓库信息'}</small
          >
          <div>
            <span
              ><i class="i-ri-star-line"></i><b data-repo-stars
                >{skill ? formatCount(skill.stars) : '—'}</b
              ></span
            >
            <span data-language>{skill?.language ?? '—'}</span>
          </div>
        </div>
      </aside>

      <section class="agent-wiki-main" aria-label="知识库正文">
        <div
          class="agent-reader-status"
          data-reader-status
          role="status"
          aria-live="polite"
        >
          <span class="agent-pulse"></span>
          正在生成源码知识库…
        </div>

        <article class="agent-wiki-article prose" data-wiki-content>
          <div class="agent-article-skeleton" aria-label="正在读取文档">
            <span></span><span></span><span></span><span></span><span
            ></span><span></span>
          </div>
        </article>
      </section>

      <aside class="agent-page-toc" aria-label="本页目录">
        <div class="agent-page-toc-inner">
          <nav data-page-toc aria-label="本页章节">
            <p>正文加载后显示标题</p>
          </nav>
        </div>
      </aside>
    </div>

    <button
      class="agent-atlas-scrim"
      data-atlas-close
      type="button"
      tabindex="-1"
      aria-hidden="true"
      aria-label="关闭仓库地图"></button>
    <div
      id="agent-atlas"
      class="agent-atlas"
      data-atlas
      role="dialog"
      aria-modal="true"
      aria-label="仓库地图"
      tabindex="-1"
      aria-hidden="true"
      inert
    >
      <div
        class="agent-atlas-resize"
        data-atlas-resize
        role="slider"
        aria-label="调整仓库地图宽度"
        aria-orientation="horizontal"
        aria-valuemin="680"
        aria-valuemax="1600"
        aria-valuenow="1120"
        tabindex="0"
      >
        <span aria-hidden="true"></span>
      </div>
      <header class="agent-atlas-head">
        <div class="agent-atlas-title">
          <span class="i-ri-git-repository-line"></span>
          <div>
            <strong data-atlas-repo>{repo || '仓库'}</strong>
            <small
              ><span data-default-branch>HEAD</span><i>·</i><span
                data-updated-at>读取中</span
              ></small
            >
          </div>
        </div>
        <div>
          <a
            href={repo ? `https://github.com/${repo}` : 'https://github.com'}
            data-atlas-github
            target="_blank"
            rel="noopener"
          >
            GitHub<span class="i-ri-arrow-right-up-line"></span>
          </a>
          <button type="button" data-atlas-close aria-label="关闭仓库地图"
            ><span class="i-ri-close-line"></span></button
          >
        </div>
      </header>

      <div class="agent-atlas-tabs" role="tablist" aria-label="仓库地图视图">
        <button
          id="agent-atlas-tab-overview"
          type="button"
          role="tab"
          class="is-active"
          data-atlas-tab="overview"
          aria-controls="agent-atlas-panel-overview"
          aria-selected="true"><span class="i-ri-node-tree"></span>概览</button
        >
        <button
          id="agent-atlas-tab-docs"
          type="button"
          role="tab"
          data-atlas-tab="docs"
          aria-controls="agent-atlas-panel-docs"
          aria-selected="false"
          tabindex="-1"><span class="i-ri-book-2-line"></span>文档</button
        >
        <button
          id="agent-atlas-tab-files"
          type="button"
          role="tab"
          data-atlas-tab="files"
          aria-controls="agent-atlas-panel-files"
          aria-selected="false"
          tabindex="-1"><span class="i-ri-file-code-line"></span>文件</button
        >
      </div>

      <div class="agent-atlas-body">
        <section
          id="agent-atlas-panel-overview"
          role="tabpanel"
          aria-labelledby="agent-atlas-tab-overview"
          data-atlas-panel="overview"
        >
          <div class="agent-atlas-intro">
            <div>
              <h2>先建立边界，再沿入口阅读关键流程</h2>
              <p data-atlas-summary>正在核对仓库结构与模块边界…</p>
            </div>
            <button type="button" data-first-document
              >开始阅读<span class="i-ri-arrow-right-line"></span></button
            >
          </div>

          <div class="agent-overview-facts" data-overview-facts>
            <div><span>星标</span><strong data-atlas-stars>—</strong></div>
            <div><span>派生</span><strong data-atlas-forks>—</strong></div>
            <div>
              <span>关注</span><strong data-atlas-watchers>—</strong>
            </div>
            <div>
              <span>主要语言</span><strong data-atlas-language>—</strong>
            </div>
            <div><span>许可证</span><strong data-atlas-license>—</strong></div>
            <div><span>默认分支</span><strong data-atlas-branch>—</strong></div>
            <div><span>最近更新</span><strong data-atlas-update>—</strong></div>
            <div><span>仓库状态</span><strong data-atlas-state>—</strong></div>
          </div>
          <div class="agent-overview-topics" data-atlas-topics></div>

          <section class="agent-map-section">
            <header>
              <div>
                <span class="agent-diagram-eyebrow">依赖关系</span>
                <h3>项目依赖总览</h3><p>
                  从 workspace 与 package.json 重建模块之间的真实依赖关系
                </p>
              </div><small data-tree-count>读取中</small>
            </header>
            <div class="agent-repo-map diagram-design" data-repo-map>
              <div class="agent-graph-hint">拖动画布 · 滚轮缩放</div>
              <button
                class="agent-graph-fullscreen"
                type="button"
                data-graph-action="fullscreen"
                aria-label="全屏查看依赖图"
                aria-pressed="false"
                ><span class="i-ri-fullscreen-line"></span></button
              >
              <div class="agent-graph-viewport" data-graph-viewport>
                <div class="agent-graph-canvas" data-graph-canvas>
                  <div class="agent-list-skeleton">
                    <span></span><span></span><span></span>
                  </div>
                </div>
              </div>
            </div>
            <div class="agent-module-detail" data-module-detail hidden></div>
          </section>

          <section class="agent-map-section">
            <header>
              <div>
                <span>阅读路径</span><h3>建议从这里开始读</h3>
              </div><small>按结构重要度排序</small>
            </header>
            <div class="agent-start-files" data-start-files>
              <div class="agent-list-skeleton"><span></span><span></span></div>
            </div>
          </section>
        </section>

        <section
          id="agent-atlas-panel-docs"
          role="tabpanel"
          aria-labelledby="agent-atlas-tab-docs"
          data-atlas-panel="docs"
          hidden
        >
          <div class="agent-atlas-section-head">
            <h2>代码库文档</h2>
            <p>
              这里展示仓库中的
              README、贡献指南与架构文档。选择后会切换到文件视图并直接回显内容。
            </p>
            <small data-repository-doc-count>正在整理文档…</small>
          </div>
          <div class="agent-atlas-docs" data-atlas-docs></div>
        </section>

        <section
          id="agent-atlas-panel-files"
          role="tabpanel"
          aria-labelledby="agent-atlas-tab-files"
          data-atlas-panel="files"
          hidden
        >
          <div class="agent-files-shell">
            <aside class="agent-file-browser">
              <div class="agent-file-browser-head">
                <div>
                  <strong>文件浏览器</strong><small data-file-count
                    >读取中</small
                  >
                </div>
                <button
                  type="button"
                  data-collapse-tree
                  aria-label="折叠全部目录"
                  title="折叠全部目录"
                  ><span class="i-ri-folder-reduce-line"></span></button
                >
              </div>
              <label class="agent-file-search">
                <span class="i-ri-search-line"></span>
                <input
                  type="search"
                  data-file-search
                  placeholder="搜索文件路径"
                />
                <kbd>/</kbd>
              </label>
              <div class="agent-file-list" data-file-list></div>
            </aside>
            <article class="agent-file-viewer">
              <header>
                <div>
                  <img data-file-icon alt="" aria-hidden="true" hidden /><strong
                    data-file-breadcrumb>选择一个文件</strong
                  >
                </div>
                <a
                  href={repo
                    ? `https://github.com/${repo}`
                    : 'https://github.com'}
                  data-file-github
                  target="_blank"
                  rel="noopener"
                  hidden
                  >查看源文件<span class="i-ri-arrow-right-up-line"></span></a
                >
              </header>
              <div class="agent-file-content" data-file-content>
                <div class="agent-file-empty">
                  <span class="i-ri-code-box-line"></span><h3>
                    选择文件开始阅读
                  </h3><p>源码、Markdown 和图片都会留在博客内打开。</p>
                </div>
              </div>
            </article>
          </div>
        </section>
      </div>
    </div>

    <button
      class="agent-mobile-scrim"
      data-mobile-nav-close
      type="button"
      tabindex="-1"
      aria-hidden="true"
      aria-label="关闭目录"></button>
  </div>

  <script
    is:inline
    type="application/json"
    data-agent-bootstrap
    set:html={bootstrapJson}
  />
</BaseLayout>

<script>
  import DOMPurify from 'dompurify'
  import { Marked } from 'marked'
  import astroIcon from 'material-icon-theme/icons/astro.svg?url'
  import audioIcon from 'material-icon-theme/icons/audio.svg?url'
  import cIcon from 'material-icon-theme/icons/c.svg?url'
  import cppIcon from 'material-icon-theme/icons/cpp.svg?url'
  import cssIcon from 'material-icon-theme/icons/css.svg?url'
  import csharpIcon from 'material-icon-theme/icons/csharp.svg?url'
  import databaseIcon from 'material-icon-theme/icons/database.svg?url'
  import dockerIcon from 'material-icon-theme/icons/docker.svg?url'
  import fileIcon from 'material-icon-theme/icons/file.svg?url'
  import folderApiIcon from 'material-icon-theme/icons/folder-api.svg?url'
  import folderApiOpenIcon from 'material-icon-theme/icons/folder-api-open.svg?url'
  import folderComponentsIcon from 'material-icon-theme/icons/folder-components.svg?url'
  import folderComponentsOpenIcon from 'material-icon-theme/icons/folder-components-open.svg?url'
  import folderConfigIcon from 'material-icon-theme/icons/folder-config.svg?url'
  import folderConfigOpenIcon from 'material-icon-theme/icons/folder-config-open.svg?url'
  import folderDocsIcon from 'material-icon-theme/icons/folder-docs.svg?url'
  import folderDocsOpenIcon from 'material-icon-theme/icons/folder-docs-open.svg?url'
  import folderGithubIcon from 'material-icon-theme/icons/folder-github.svg?url'
  import folderGithubOpenIcon from 'material-icon-theme/icons/folder-github-open.svg?url'
  import folderIcon from 'material-icon-theme/icons/folder.svg?url'
  import folderOpenIcon from 'material-icon-theme/icons/folder-open.svg?url'
  import folderScriptsIcon from 'material-icon-theme/icons/folder-scripts.svg?url'
  import folderScriptsOpenIcon from 'material-icon-theme/icons/folder-scripts-open.svg?url'
  import folderSrcIcon from 'material-icon-theme/icons/folder-src.svg?url'
  import folderSrcOpenIcon from 'material-icon-theme/icons/folder-src-open.svg?url'
  import folderTestIcon from 'material-icon-theme/icons/folder-test.svg?url'
  import folderTestOpenIcon from 'material-icon-theme/icons/folder-test-open.svg?url'
  import folderVscodeIcon from 'material-icon-theme/icons/folder-vscode.svg?url'
  import folderVscodeOpenIcon from 'material-icon-theme/icons/folder-vscode-open.svg?url'
  import goIcon from 'material-icon-theme/icons/go.svg?url'
  import graphqlIcon from 'material-icon-theme/icons/graphql.svg?url'
  import htmlIcon from 'material-icon-theme/icons/html.svg?url'
  import imageIcon from 'material-icon-theme/icons/image.svg?url'
  import javascriptIcon from 'material-icon-theme/icons/javascript.svg?url'
  import javaIcon from 'material-icon-theme/icons/java.svg?url'
  import jsonIcon from 'material-icon-theme/icons/json.svg?url'
  import kotlinIcon from 'material-icon-theme/icons/kotlin.svg?url'
  import lessIcon from 'material-icon-theme/icons/less.svg?url'
  import licenseIcon from 'material-icon-theme/icons/license.svg?url'
  import lockIcon from 'material-icon-theme/icons/lock.svg?url'
  import markdownIcon from 'material-icon-theme/icons/markdown.svg?url'
  import npmIcon from 'material-icon-theme/icons/npm.svg?url'
  import pdfIcon from 'material-icon-theme/icons/pdf.svg?url'
  import phpIcon from 'material-icon-theme/icons/php.svg?url'
  import powershellIcon from 'material-icon-theme/icons/powershell.svg?url'
  import pythonIcon from 'material-icon-theme/icons/python.svg?url'
  import reactIcon from 'material-icon-theme/icons/react.svg?url'
  import readmeIcon from 'material-icon-theme/icons/readme.svg?url'
  import rubyIcon from 'material-icon-theme/icons/ruby.svg?url'
  import rustIcon from 'material-icon-theme/icons/rust.svg?url'
  import sassIcon from 'material-icon-theme/icons/sass.svg?url'
  import svelteIcon from 'material-icon-theme/icons/svelte.svg?url'
  import svgIcon from 'material-icon-theme/icons/svg.svg?url'
  import swiftIcon from 'material-icon-theme/icons/swift.svg?url'
  import tomlIcon from 'material-icon-theme/icons/toml.svg?url'
  import typescriptDefIcon from 'material-icon-theme/icons/typescript-def.svg?url'
  import typescriptIcon from 'material-icon-theme/icons/typescript.svg?url'
  import videoIcon from 'material-icon-theme/icons/video.svg?url'
  import vueIcon from 'material-icon-theme/icons/vue.svg?url'
  import xmlIcon from 'material-icon-theme/icons/xml.svg?url'
  import yamlIcon from 'material-icon-theme/icons/yaml.svg?url'

  interface Bootstrap {
    repo: string
    skill: null | {
      name: string
      author: string
      description: string
      stars: number
      language: string | null
      command: string
    }
  }
  interface RepoMeta {
    fullName: string
    name: string
    owner: string
    description: string
    stars: number
    forks: number
    watchers: number
    language: string | null
    defaultBranch: string
    updatedAt: string
    license: string | null
    topics: string[]
    archived: boolean
    homepage: string | null
  }
  interface WikiItem {
    depth: number
    id: string
    title: string
    slug?: string
    group?: string
    section?: string
  }
  interface TreeItem {
    path: string
    type: 'blob' | 'tree'
    size: number | null
  }
  interface FileResponse {
    type: 'file'
    name: string
    path: string
    content: string | null
    downloadUrl: string | null
    text?: string
  }
  interface ManifestNode {
    id: string
    name: string
    path: string
    dependencies: string[]
    incoming: string[]
    workspace: boolean
  }
  interface RepositoryFileReference {
    path: string
    ref: string
    line: number
    column: number
  }

  const materialFileIcons: Record<string, string> = {
    astro: astroIcon,
    c: cIcon,
    cc: cppIcon,
    cpp: cppIcon,
    css: cssIcon,
    cs: csharpIcon,
    db: databaseIcon,
    dockerfile: dockerIcon,
    go: goIcon,
    gql: graphqlIcon,
    graphql: graphqlIcon,
    h: cIcon,
    hpp: cppIcon,
    htm: htmlIcon,
    html: htmlIcon,
    jpeg: imageIcon,
    jpg: imageIcon,
    js: javascriptIcon,
    java: javaIcon,
    cjs: javascriptIcon,
    mjs: javascriptIcon,
    json: jsonIcon,
    jsonc: jsonIcon,
    kt: kotlinIcon,
    kts: kotlinIcon,
    less: lessIcon,
    lock: lockIcon,
    md: markdownIcon,
    mdx: markdownIcon,
    png: imageIcon,
    ps1: powershellIcon,
    php: phpIcon,
    py: pythonIcon,
    rb: rubyIcon,
    rs: rustIcon,
    sass: sassIcon,
    scss: sassIcon,
    svelte: svelteIcon,
    svg: svgIcon,
    swift: swiftIcon,
    toml: tomlIcon,
    ts: typescriptIcon,
    tsx: reactIcon,
    jsx: reactIcon,
    dts: typescriptDefIcon,
    vue: vueIcon,
    webm: videoIcon,
    mp4: videoIcon,
    mp3: audioIcon,
    wav: audioIcon,
    xml: xmlIcon,
    yaml: yamlIcon,
    yml: yamlIcon,
    pdf: pdfIcon,
  }
  const materialFolderIcons: Record<string, { closed: string; open: string }> =
    {
      '.github': { closed: folderGithubIcon, open: folderGithubOpenIcon },
      '.vscode': { closed: folderVscodeIcon, open: folderVscodeOpenIcon },
      'api': { closed: folderApiIcon, open: folderApiOpenIcon },
      'components': {
        closed: folderComponentsIcon,
        open: folderComponentsOpenIcon,
      },
      'config': { closed: folderConfigIcon, open: folderConfigOpenIcon },
      'configs': { closed: folderConfigIcon, open: folderConfigOpenIcon },
      'docs': { closed: folderDocsIcon, open: folderDocsOpenIcon },
      'documentation': { closed: folderDocsIcon, open: folderDocsOpenIcon },
      'scripts': { closed: folderScriptsIcon, open: folderScriptsOpenIcon },
      'src': { closed: folderSrcIcon, open: folderSrcOpenIcon },
      'test': { closed: folderTestIcon, open: folderTestOpenIcon },
      'tests': { closed: folderTestIcon, open: folderTestOpenIcon },
    }

  function materialIconFor(
    path: string,
    type: 'blob' | 'tree' = 'blob',
    expanded = false
  ) {
    const name = path.split('/').pop()?.toLowerCase() || ''
    if (type === 'tree') {
      const pair = materialFolderIcons[name]
      return pair
        ? expanded
          ? pair.open
          : pair.closed
        : expanded
          ? folderOpenIcon
          : folderIcon
    }
    if (/^readme(?:\.|$)/i.test(name)) return readmeIcon
    if (/^(license|licence)(?:\.|$)/i.test(name)) return licenseIcon
    if (/^(package|package-lock|npm-shrinkwrap)\.json$/i.test(name))
      return npmIcon
    if (/^(dockerfile|containerfile)(?:\.|$)/i.test(name)) return dockerIcon
    const extension = name.endsWith('.d.ts')
      ? 'dts'
      : name.includes('.')
        ? name.split('.').pop() || ''
        : name
    return materialFileIcons[extension] || fileIcon
  }

