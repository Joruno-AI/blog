---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Link from '~/components/base/Link.astro'
import { withBasePath } from '~/utils/path'
import {
  formatCount,
  githubAvatar,
  installCommand,
  INSTALLABLE_CATEGORIES,
} from '~/utils/skills'

import type { CollectionEntry } from 'astro:content'

type Skill = CollectionEntry<'skills'>['data']

interface Props {
  skill?: Skill
}

const { skill } = Astro.props
const repo = skill?.id ?? ''
const installable = skill ? INSTALLABLE_CATEGORIES.has(skill.category) : false
const command = skill
  ? installable
    ? installCommand(skill.id)
    : `git clone https://github.com/${skill.id}.git`
  : ''
const description = skill?.descZh || skill?.desc || ''
const agentBase = withBasePath('/agent/')
const bootstrapJson = JSON.stringify({
  repo,
  skill: skill
    ? {
        name: skill.name,
        author: skill.author,
        description,
        stars: skill.stars,
        language: skill.language,
        command,
      }
    : null,
}).replace(/</g, '\\u003c')
---

<BaseLayout
  title={skill ? `${skill.name} - Agent 知识库` : 'Agent 知识库'}
  description={description ||
    '基于仓库源码生成的站内知识库、架构地图与文件浏览器'}
  bgType={false}
  hideFooter={true}
  stableNavigation={true}
>
  <div
    class="agent-knowledge"
    data-agent-knowledge
    data-agent-base={agentBase}
    data-atlas-open="false"
  >
    <header class="agent-knowledge-head">
      <div class="agent-knowledge-brand">
        <Link
          class="agent-back"
          href={withBasePath('/agent/')}
          aria-label="返回 Agent 目录"
        >
          <span class="i-ri-arrow-left-line" aria-hidden="true"></span>
        </Link>
        <img
          src={skill ? githubAvatar(skill.author, 96) : ''}
          alt=""
          data-repo-avatar
          hidden={!skill}
        />
        <div>
          <p>
            <span data-repo-owner>{skill?.author ?? 'GitHub'}</span><i>/</i>
          </p>
          <h1 data-repo-title>{skill?.name ?? '正在读取仓库…'}</h1>
        </div>
        <span class="agent-source-state" data-source-state>
          <i></i><span>连接中</span>
        </span>
      </div>

      <div class="agent-knowledge-actions">
        <button
          type="button"
          class="agent-mobile-nav"
          data-mobile-nav
          aria-label="打开文档目录"
        >
          <span class="i-ri-menu-2-line" aria-hidden="true"></span>
          目录
        </button>
        <button
          type="button"
          data-copy-command
          data-copy={command}
          hidden={!command}
        >
          <span class="i-ri-terminal-box-line" aria-hidden="true"></span>
          <span data-command-label>{installable ? '安装' : '克隆'}</span>
        </button>
        <button type="button" class="agent-atlas-launch" data-atlas-launch>
          <span class="i-ri-node-tree" aria-hidden="true"></span>
          仓库地图
        </button>
        <a
          href={repo ? `https://github.com/${repo}` : 'https://github.com'}
          data-github-link
          target="_blank"
          rel="noopener"
          aria-label="在 GitHub 查看"
        >
          <span class="i-uil-github-alt" aria-hidden="true"></span>
        </a>
      </div>
    </header>

    <div class="agent-reader-shell">
      <aside class="agent-wiki-nav" data-wiki-nav aria-label="知识库目录">
        <div class="agent-wiki-nav-head">
          <div>
            <span>KNOWLEDGE BASE</span>
            <strong>仓库文档</strong>
          </div>
          <button type="button" data-mobile-nav-close aria-label="关闭文档目录">
            <span class="i-ri-close-line" aria-hidden="true"></span>
          </button>
        </div>
        <label class="agent-nav-search">
          <span class="i-ri-search-line" aria-hidden="true"></span>
          <input
            type="search"
            data-doc-search
            placeholder="搜索章节"
            autocomplete="off"
          />
          <kbd>/</kbd>
        </label>
        <nav class="agent-wiki-pages" data-wiki-pages>
          <div class="agent-list-skeleton">
            <span></span><span></span><span></span><span></span>
          </div>
        </nav>
        <div class="agent-nav-repo-card">
          <span>仓库</span>
          <strong data-repo-full-name>{repo || '读取中…'}</strong>
          <small data-repo-description
            >{description || '正在读取仓库信息'}</small
          >
          <div>
            <span
              ><i class="i-ri-star-line"></i><b data-repo-stars
                >{skill ? formatCount(skill.stars) : '—'}</b
              ></span
            >
            <span data-language>{skill?.language ?? '—'}</span>
          </div>
        </div>
      </aside>

      <main class="agent-wiki-main">
        <div class="agent-reader-status" data-reader-status>
          <span class="agent-pulse"></span>
          正在生成源码知识库…
        </div>

        <article class="agent-wiki-article prose" data-wiki-content>
          <div class="agent-article-skeleton" aria-label="正在读取文档">
            <span></span><span></span><span></span><span></span><span
            ></span><span></span>
          </div>
        </article>

        <section
          class="agent-answer"
          data-answer-panel
          hidden
          aria-live="polite"
        >
          <header>
            <div>
              <span class="i-ri-sparkling-2-line"></span><strong
                >DeepWiki 回答</strong
              >
            </div>
            <button type="button" data-answer-close aria-label="关闭回答"
              ><span class="i-ri-close-line"></span></button
            >
          </header>
          <div class="agent-answer-question" data-answer-question></div>
          <article class="prose" data-answer-content></article>
        </section>
      </main>

      <aside class="agent-page-toc" aria-label="本页目录">
        <div class="agent-page-toc-inner">
          <span>ON THIS PAGE</span>
          <strong>本页目录</strong>
          <nav data-page-toc>
            <p>正文加载后显示标题</p>
          </nav>
          <div class="agent-page-links">
            <a
              href={repo
                ? `https://deepwiki.com/${repo}`
                : 'https://deepwiki.com'}
              data-deepwiki-link
              target="_blank"
              rel="noopener"
              >DeepWiki 原文<span class="i-ri-arrow-right-up-line"></span></a
            >
            <button type="button" data-atlas-launch
              ><span>打开仓库地图</span><i class="i-ri-arrow-right-line"
              ></i></button
            >
          </div>
        </div>
      </aside>
    </div>

    <form class="agent-ask" data-ask-form>
      <span class="i-ri-sparkling-2-line" aria-hidden="true"></span>
      <input
        type="text"
        name="question"
        data-ask-input
        maxlength="1200"
        placeholder="向 DeepWiki 询问这个仓库…"
        autocomplete="off"
      />
      <kbd>Enter</kbd>
      <button type="submit" data-ask-submit>
        <span>提问</span><i class="i-ri-arrow-up-line"></i>
      </button>
    </form>

    <button
      class="agent-atlas-scrim"
      data-atlas-close
      type="button"
      aria-label="关闭仓库地图"></button>
    <aside
      class="agent-atlas"
      data-atlas
      aria-label="仓库地图"
      aria-hidden="true"
    >
      <header class="agent-atlas-head">
        <div class="agent-atlas-title">
          <span class="i-ri-git-repository-line"></span>
          <div>
            <strong data-atlas-repo>{repo || 'Repository'}</strong>
            <small
              ><span data-default-branch>HEAD</span><i>·</i><span
                data-updated-at>读取中</span
              ></small
            >
          </div>
        </div>
        <div>
          <a
            href={repo ? `https://github.com/${repo}` : 'https://github.com'}
            data-atlas-github
            target="_blank"
            rel="noopener"
          >
            GitHub<span class="i-ri-arrow-right-up-line"></span>
          </a>
          <button type="button" data-atlas-close aria-label="关闭仓库地图"
            ><span class="i-ri-close-line"></span></button
          >
        </div>
      </header>

      <nav class="agent-atlas-tabs" aria-label="仓库地图视图">
        <button type="button" class="is-active" data-atlas-tab="overview"
          ><span class="i-ri-node-tree"></span>概览</button
        >
        <button type="button" data-atlas-tab="docs"
          ><span class="i-ri-book-2-line"></span>文档</button
        >
        <button type="button" data-atlas-tab="files"
          ><span class="i-ri-file-code-line"></span>文件</button
        >
      </nav>

      <div class="agent-atlas-body">
        <section data-atlas-panel="overview">
          <div class="agent-atlas-intro">
            <div>
              <h2>先建立边界，再沿入口阅读关键流程</h2>
              <p data-atlas-summary>正在核对仓库结构与模块边界…</p>
            </div>
            <button type="button" data-first-document
              >开始阅读<span class="i-ri-arrow-right-line"></span></button
            >
          </div>

          <div class="agent-overview-facts" data-overview-facts>
            <div><span>Stars</span><strong data-atlas-stars>—</strong></div>
            <div><span>Forks</span><strong data-atlas-forks>—</strong></div>
            <div>
              <span>Watchers</span><strong data-atlas-watchers>—</strong>
            </div>
            <div>
              <span>主要语言</span><strong data-atlas-language>—</strong>
            </div>
            <div><span>许可证</span><strong data-atlas-license>—</strong></div>
            <div><span>默认分支</span><strong data-atlas-branch>—</strong></div>
            <div><span>最近更新</span><strong data-atlas-update>—</strong></div>
            <div><span>仓库状态</span><strong data-atlas-state>—</strong></div>
          </div>
          <div class="agent-overview-topics" data-atlas-topics></div>

          <section class="agent-map-section">
            <header>
              <div>
                <h3>项目依赖总览</h3><p>
                  从 workspace 与 package.json 重建模块之间的真实依赖关系
                </p>
              </div><small data-tree-count>读取中</small>
            </header>
            <div class="agent-repo-map" data-repo-map>
              <div class="agent-graph-hint">拖动画布 · 滚轮缩放</div>
              <button
                class="agent-graph-fullscreen"
                type="button"
                data-graph-action="fullscreen"
                aria-label="全屏查看依赖图"
                ><span class="i-ri-fullscreen-line"></span></button
              >
              <div class="agent-graph-viewport" data-graph-viewport>
                <div class="agent-graph-canvas" data-graph-canvas>
                  <div class="agent-list-skeleton">
                    <span></span><span></span><span></span>
                  </div>
                </div>
              </div>
            </div>
            <div class="agent-module-detail" data-module-detail hidden></div>
          </section>

          <section class="agent-map-section">
            <header>
              <div>
                <span>READING PATH</span><h3>建议从这里开始读</h3>
              </div><small>按结构重要度排序</small>
            </header>
            <div class="agent-start-files" data-start-files>
              <div class="agent-list-skeleton"><span></span><span></span></div>
            </div>
          </section>
        </section>

        <section data-atlas-panel="docs" hidden>
          <div class="agent-atlas-section-head">
            <h2>代码库文档</h2>
            <p>
              这里展示仓库中的
              README、贡献指南与架构文档。选择后会切换到文件视图并直接回显内容。
            </p>
            <small data-repository-doc-count>正在整理文档…</small>
          </div>
          <div class="agent-atlas-docs" data-atlas-docs></div>
        </section>

        <section data-atlas-panel="files" hidden>
          <div class="agent-files-shell">
            <aside class="agent-file-browser">
              <div class="agent-file-browser-head">
                <div>
                  <strong>文件浏览器</strong><small data-file-count
                    >读取中</small
                  >
                </div>
                <button
                  type="button"
                  data-collapse-tree
                  aria-label="折叠全部目录"
                  ><span class="i-ri-collapse-diagonal-line"></span></button
                >
              </div>
              <label class="agent-file-search">
                <span class="i-ri-search-line"></span>
                <input
                  type="search"
                  data-file-search
                  placeholder="搜索文件路径"
                />
                <kbd>/</kbd>
              </label>
              <div class="agent-file-list" data-file-list></div>
            </aside>
            <article class="agent-file-viewer">
              <header>
                <div>
                  <span class="i-ri-file-code-line"></span><strong
                    data-file-breadcrumb>选择一个文件</strong
                  >
                </div>
                <a
                  href={repo
                    ? `https://github.com/${repo}`
                    : 'https://github.com'}
                  data-file-github
                  target="_blank"
                  rel="noopener"
                  hidden
                  >查看源文件<span class="i-ri-arrow-right-up-line"></span></a
                >
              </header>
              <div class="agent-file-content" data-file-content>
                <div class="agent-file-empty">
                  <span class="i-ri-code-box-line"></span><h3>
                    选择文件开始阅读
                  </h3><p>源码、Markdown 和图片都会留在博客内打开。</p>
                </div>
              </div>
            </article>
          </div>
        </section>
      </div>
    </aside>

    <button
      class="agent-mobile-scrim"
      data-mobile-nav-close
      type="button"
      aria-label="关闭目录"></button>
  </div>

  <script
    is:inline
    type="application/json"
    data-agent-bootstrap
    set:html={bootstrapJson}
  />
</BaseLayout>

<script>
  import DOMPurify from 'dompurify'
  import { Marked } from 'marked'

  interface Bootstrap {
    repo: string
    skill: null | {
      name: string
      author: string
      description: string
      stars: number
      language: string | null
      command: string
    }
  }
  interface RepoMeta {
    fullName: string
    name: string
    owner: string
    description: string
    stars: number
    forks: number
    watchers: number
    language: string | null
    defaultBranch: string
    updatedAt: string
    license: string | null
    topics: string[]
    archived: boolean
    homepage: string | null
  }
  interface WikiItem {
    depth: number
    id: string
    title: string
  }
  interface TreeItem {
    path: string
    type: 'blob' | 'tree'
    size: number | null
  }
  interface FileResponse {
    type: 'file'
    name: string
    path: string
    content: string | null
    downloadUrl: string | null
  }
  interface ManifestNode {
    id: string
    name: string
    path: string
    dependencies: string[]
    incoming: string[]
    workspace: boolean
  }

  const marked = new Marked({ gfm: true, breaks: false })
  let mermaidLoader: Promise<typeof import('mermaid').default> | null = null
  let shikiLoader: Promise<typeof import('shiki/bundle/full')> | null = null
  let dependencyGraphLoader: Promise<
    typeof import('./agent/AgentDependencyGraph')
  > | null = null
  let codeViewerLoader: Promise<
    typeof import('./agent/agent-code-viewer')
  > | null = null
  let mermaidSequence = 0

  const mountAgentKnowledge = () => {
    const rootElement = document.querySelector<HTMLElement>(
      '[data-agent-knowledge]'
    )
    const dataElement = document.querySelector<HTMLScriptElement>(
      '[data-agent-bootstrap]'
    )
    if (!rootElement || !dataElement || rootElement.dataset.bound === 'true')
      return
    const root = rootElement
    const data = dataElement
    root.dataset.bound = 'true'

    const bootstrap = JSON.parse(data.textContent || '{}') as Bootstrap
    const agentBase = root.dataset.agentBase || '/agent/'
    const basePath = agentBase.replace(/\/$/, '')
    const path = location.pathname.startsWith(basePath)
      ? location.pathname.slice(basePath.length)
      : location.pathname
    const pathParts = path.split('/').filter(Boolean).map(decodeURIComponent)
    const repo =
      bootstrap.repo ||
      new URLSearchParams(location.search).get('repo') ||
      (pathParts.length >= 2 && pathParts[0] !== 'repository'
        ? `${pathParts[0]}/${pathParts[1]}`
        : '')
    const [owner = '', repoName = ''] = repo.split('/')
    const blobIndex = pathParts.indexOf('blob')
    let activeRef = blobIndex >= 0 ? pathParts[blobIndex + 1] || 'HEAD' : 'HEAD'
    const requestedFile =
      blobIndex >= 0 ? pathParts.slice(blobIndex + 2).join('/') : ''
    const requestedLine = Number(location.hash.match(/^#L(\d+)/i)?.[1] || 0)
    const controller = new AbortController()
    const get = <T extends Element>(selector: string) =>
      root.querySelector<T>(selector)
    const getAll = <T extends Element>(selector: string) => [
      ...root.querySelectorAll<T>(selector),
    ]
    const wikiContent = get<HTMLElement>('[data-wiki-content]')!
    const fileList = get<HTMLElement>('[data-file-list]')!
    const fileContent = get<HTMLElement>('[data-file-content]')!
    const fileSearch = get<HTMLInputElement>('[data-file-search]')!
    const status = get<HTMLElement>('[data-reader-status]')!
    let meta: RepoMeta | null = null
    let wikiItems: WikiItem[] = []
    let treeItems: TreeItem[] = []
    let currentPage = 'Overview'
    let currentTheme = document.documentElement.classList.contains('dark')
    let currentFilePath = ''
    let manifestNodes: ManifestNode[] = []
    const treeChildren = new Map<string, TreeItem[]>()
    const expandedFolders = new Set<string>()
    const fileCache = new Map<string, FileResponse>()
    let fileLoadSequence = 0
    let dependencyGraph:
      import('./agent/AgentDependencyGraph').AgentDependencyGraphApi | null =
      null
    let codeViewer: import('./agent/agent-code-viewer').AgentCodeViewer | null =
      null

    document.addEventListener('astro:before-swap', () => controller.abort(), {
      once: true,
    })
    controller.signal.addEventListener(
      'abort',
      () => {
        dependencyGraph?.destroy()
        dependencyGraph = null
        codeViewer?.destroy()
        codeViewer = null
      },
      { once: true }
    )

    const escapeHtml = (value: string) =>
      value.replace(
        /[&<>"']/g,
        (character) =>
          ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;',
          })[character] as string
      )
    const compact = (value: number) =>
      new Intl.NumberFormat('zh-CN', {
        notation: 'compact',
        maximumFractionDigits: 1,
      }).format(value)
    const slug = (value: string) =>
      value
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[^\p{L}\p{N}]+/gu, '-')
        .replace(/^-|-$/g, '')
    const githubUrl = (suffix = '') => `https://github.com/${repo}${suffix}`
    const repoFileUrl = (file: string, ref = activeRef) =>
      `${agentBase}${repo}/blob/${encodeURIComponent(ref || meta?.defaultBranch || 'HEAD')}/${file}`
    const api = (
      kind: 'github' | 'deepwiki',
      action: string,
      params: Record<string, string> = {}
    ) => {
      const url = new URL(
        `/api/${kind}/${encodeURIComponent(owner)}/${encodeURIComponent(repoName)}/${action}`,
        location.origin
      )
      Object.entries(params).forEach(
        ([key, value]) => value && url.searchParams.set(key, value)
      )
      return url.toString()
    }
    const loadMermaid = () => {
      mermaidLoader ??= import('mermaid').then((module) => module.default)
      return mermaidLoader
    }
    async function fetchJson<T>(url: string, options: RequestInit = {}) {
      const response = await fetch(url, {
        ...options,
        headers: { Accept: 'application/json', ...(options.headers || {}) },
        signal: controller.signal,
      })
      const payload = (await response.json().catch(() => null)) as
        (T & { error?: string }) | null
      if (!response.ok)
        throw new Error(payload?.error || `请求失败 (${response.status})`)
      return payload as T
    }
    const decodeBase64 = (value: string) => {
      const binary = atob(value.replace(/\s/g, ''))
      return new TextDecoder().decode(
        Uint8Array.from(binary, (character) => character.charCodeAt(0))
      )
    }
    const showStatus = (
      message: string,
      kind: 'loading' | 'error' = 'loading'
    ) => {
      status.hidden = false
      status.dataset.kind = kind
      status.innerHTML = `${kind === 'loading' ? '<span class="agent-pulse"></span>' : '<span class="i-ri-error-warning-line"></span>'}${escapeHtml(message)}`
    }
    const hideStatus = () => {
      status.hidden = true
    }

    function applyMeta(next: RepoMeta) {
      meta = next
      if (activeRef === 'HEAD') activeRef = next.defaultBranch
      const values: [string, string][] = [
        ['[data-repo-owner]', next.owner],
        ['[data-repo-title]', next.name],
        ['[data-repo-full-name]', next.fullName],
        [
          '[data-repo-description]',
          next.description || '这个仓库暂时没有填写简介。',
        ],
        ['[data-repo-stars]', compact(next.stars)],
        ['[data-language]', next.language || '—'],
        ['[data-atlas-repo]', next.fullName],
        ['[data-default-branch]', next.defaultBranch],
        ['[data-atlas-stars]', compact(next.stars)],
        ['[data-atlas-forks]', compact(next.forks)],
        ['[data-atlas-watchers]', compact(next.watchers)],
        ['[data-atlas-language]', next.language || '未标注'],
        ['[data-atlas-license]', next.license || '未声明'],
        ['[data-atlas-branch]', next.defaultBranch],
        ['[data-atlas-state]', next.archived ? '已归档' : '活跃维护'],
      ]
      values.forEach(([selector, value]) => {
        const element = get<HTMLElement>(selector)
        if (element) element.textContent = value
      })
      const updated = get<HTMLElement>('[data-updated-at]')
      const updatedLabel = new Intl.DateTimeFormat('zh-CN', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      }).format(new Date(next.updatedAt))
      if (updated) updated.textContent = updatedLabel
      const atlasUpdate = get<HTMLElement>('[data-atlas-update]')
      if (atlasUpdate) atlasUpdate.textContent = updatedLabel
      const topics = get<HTMLElement>('[data-atlas-topics]')
      if (topics) {
        const topicMarkup = next.topics
          .slice(0, 12)
          .map((topic) => `<span>${escapeHtml(topic)}</span>`)
          .join('')
        const homepageMarkup = next.homepage
          ? `<a href="${escapeHtml(next.homepage)}" target="_blank" rel="noopener">项目主页<span class="i-ri-arrow-right-up-line"></span></a>`
          : ''
        topics.innerHTML =
          topicMarkup || homepageMarkup
            ? `${topicMarkup}${homepageMarkup}`
            : '<span>暂无主题标签</span>'
      }
      const avatar = get<HTMLImageElement>('[data-repo-avatar]')
      if (avatar) {
        avatar.src = `https://github.com/${encodeURIComponent(next.owner)}.png?size=96`
        avatar.hidden = false
      }
      getAll<HTMLAnchorElement>(
        '[data-github-link], [data-atlas-github]'
      ).forEach((link) => {
        link.href = githubUrl()
      })
