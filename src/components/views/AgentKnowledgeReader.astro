    async function highlightCode(source: string, language: string) {
      shikiLoader ??= import('shiki/bundle/full')
      const { codeToHtml } = await shikiLoader
      const candidates = [language, 'text']
      for (const candidate of candidates) {
        try {
          const html = await codeToHtml(source, {
            lang: candidate,
            themes: { light: 'vitesse-light', dark: 'vitesse-dark' },
            defaultColor: false,
          })
          const template = document.createElement('template')
          template.innerHTML = html
          const pre = template.content.querySelector('pre')
          if (!pre) continue
          pre.classList.add('agent-shiki-code')
          pre.querySelectorAll<HTMLElement>('.line').forEach((line, index) => {
            line.dataset.line = String(index + 1)
          })
          return template.innerHTML
        } catch {
          // Try the plain-text grammar next.
        }
      }
      return `<pre class="agent-code-fallback"><code>${escapeHtml(source)}</code></pre>`
    }

    async function decorateMarkdownCode(container: HTMLElement) {
      const blocks = [...container.querySelectorAll<HTMLPreElement>('pre')]
      for (const pre of blocks) {
        if (pre.closest('.agent-mermaid')) continue
        const code = pre.querySelector('code')
        const source = code?.textContent || pre.textContent || ''
        const languageClass = [...(code?.classList || [])].find((value) =>
          value.startsWith('language-')
        )
        const language = languageClass?.slice('language-'.length) || 'text'
        const wrapper = document.createElement('div')
        wrapper.className = 'agent-highlighted-block'
        wrapper.innerHTML = await highlightCode(
          source.replace(/\n+$/, ''),
          language
        )
        pre.replaceWith(wrapper)
      }
    }
    function renderToc() {
      const toc = get<HTMLElement>('[data-page-toc]')
      if (!toc) return
      const headings = [...wikiContent.querySelectorAll<HTMLElement>('h2, h3')]
      headings.forEach((heading, index) => {
        heading.id ||= `section-${index + 1}-${slug(heading.textContent || '')}`
      })
      toc.innerHTML = headings.length
        ? headings
            .map(
              (heading) =>
                `<a href="#${escapeHtml(heading.id)}" data-toc-target="${escapeHtml(heading.id)}" data-level="${heading.tagName === 'H3' ? '3' : '2'}">${escapeHtml(heading.textContent || '')}</a>`
            )
            .join('')
        : '<p>当前页面没有二级标题</p>'
    }
    async function renderMarkdown(
      container: HTMLElement,
      markdown: string,
      wiki = false,
      sourcePath = ''
    ) {
      const cleaned = markdown.replace(/^# Page:\s*.+\n+/i, '')
      container.innerHTML = DOMPurify.sanitize(await marked.parse(cleaned), {
        USE_PROFILES: { html: true },
        ADD_ATTR: ['target', 'rel'],
      })
      if (wiki) {
        rewriteWikiLinks(container, sourcePath)
        rewriteInlineFileReferences(container)
        container
          .querySelectorAll('details')
          .forEach((details) => details.classList.add('agent-source-files'))
      }
      await renderMermaid(container)
      await decorateMarkdownCode(container)
    }
    function updateDocumentUrl(title: string) {
      if (requestedFile) return
      const url = new URL(location.href)
      if (title === 'Overview') url.searchParams.delete('doc')
      else url.searchParams.set('doc', title)
      history.replaceState(
        history.state,
        '',
        `${url.pathname}${url.search}${url.hash}`
      )
    }
    function setActiveDocument(title: string) {
      getAll<HTMLElement>('[data-wiki-page]').forEach((element) => {
        element.classList.toggle(
          'is-active',
          element.dataset.wikiPage === title
