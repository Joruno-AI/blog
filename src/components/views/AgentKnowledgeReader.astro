  }
  .agent-knowledge-brand,
  .agent-knowledge-actions,
  .agent-atlas-title,
  .agent-atlas-head > div,
  .agent-file-viewer > header > div {
    display: flex;
    align-items: center;
  }
  .agent-knowledge-brand {
    gap: 0.7rem;
    min-width: 0;
  }
  .agent-back {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 0.55rem;
