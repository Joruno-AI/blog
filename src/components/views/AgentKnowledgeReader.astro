    const escapeHtml = (value: string) =>
      value.replace(
        /[&<>"']/g,
        (character) =>
          ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;',
          })[character] as string
      )
    // 外链协议白名单: 拦截 javascript:/data: 等危险 scheme (仓库 homepage 由所有者可控)
    const safeExternalUrl = (value: string) => {
      try {
        const parsed = new URL(value, 'https://github.com')
        return parsed.protocol === 'https:' || parsed.protocol === 'http:'
          ? parsed.href
          : ''
      } catch {
        return ''
      }
    }
    const compact = (value: number) =>
      new Intl.NumberFormat('zh-CN', {
        notation: 'compact',
        maximumFractionDigits: 1,
      }).format(value)
    const slug = (value: string) =>
      value
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[^\p{L}\p{N}]+/gu, '-')
        .replace(/^-|-$/g, '')
    const githubUrl = (suffix = '') => `https://github.com/${repo}${suffix}`
    const repoPageUrl = () => new URL(`${agentBase}${repo}/`, location.origin)
    const repoFileUrl = (file: string, ref = activeRef) => {
      const url = repoPageUrl()
      url.searchParams.set('file', file)
      url.searchParams.set('ref', ref || meta?.defaultBranch || 'HEAD')
      return `${url.pathname}${url.search}`
    }
    const api = (
      kind: 'github' | 'deepwiki' | 'zread',
      action: string,
      params: Record<string, string> = {}
    ) => {
      const url = new URL(
        `/api/${kind}/${encodeURIComponent(owner)}/${encodeURIComponent(repoName)}/${action}`,
        location.origin
      )
      Object.entries(params).forEach(
        ([key, value]) => value && url.searchParams.set(key, value)
      )
      return url.toString()
    }
    const loadMermaid = () => {
      mermaidLoader ??= import('mermaid')
        .then((module) => module.default)
        .catch((error) => {
          // A failed dynamic import must not poison every later diagram in
          // this session. Reset the promise so the automatic/manual retry can
          // request the chunk again.
          mermaidLoader = null
          throw error
        })
      return mermaidLoader
    }
    const jsonCacheKey = (url: string) => `agent-json:${url}`
    const readJsonCache = <T,>(url: string) => {
      const memory = jsonResponseCache.get(url)
      if (memory) return memory as { savedAt: number; payload: T }
      try {
        const stored = window.sessionStorage.getItem(jsonCacheKey(url))
        if (!stored) return null
        const parsed = JSON.parse(stored) as { savedAt: number; payload: T }
        if (!Number.isFinite(parsed.savedAt)) return null
        jsonResponseCache.set(url, parsed)
        return parsed
      } catch {
        return null
      }
    }
    const writeJsonCache = (url: string, payload: unknown) => {
      const entry = { savedAt: Date.now(), payload }
      jsonResponseCache.set(url, entry)
      try {
        const serialized = JSON.stringify(entry)
        // 单条树数据限制在 900 KB 内，避免多个大型仓库挤满会话存储。
        if (serialized.length <= 900_000)
          window.sessionStorage.setItem(jsonCacheKey(url), serialized)
      } catch {
        // 隐私模式或配额不足时仍保留当前页面的内存缓存。
      }
    }
    async function fetchJson<T>(url: string, options: RequestInit = {}) {
      const method = (options.method || 'GET').toUpperCase()
      const zreadRequest = new URL(url).pathname.startsWith('/api/zread/')
      // ZRead is the preferred Chinese source, but it must not delay the
      // DeepWiki fallback with repeated timeouts when its public page is
      // temporarily unavailable.
      const maximumAttempts = method === 'GET' && !zreadRequest ? 3 : 1
      const transientStatuses = new Set([429, 500, 502, 503, 504])
      const cached = method === 'GET' ? readJsonCache<T>(url) : null
      if (cached && Date.now() - cached.savedAt < 5 * 60_000)
        return cached.payload

      for (let attempt = 0; attempt < maximumAttempts; attempt += 1) {
        let response: Response
        const requestController = new AbortController()
        const abortRequest = () => requestController.abort()
        controller.signal.addEventListener('abort', abortRequest, {
          once: true,
        })
        const timeout = window.setTimeout(() => requestController.abort(), 9000)
        try {
          response = await fetch(url, {
            ...options,
            headers: { Accept: 'application/json', ...(options.headers || {}) },
            signal: requestController.signal,
          })
        } catch (error) {
          if (controller.signal.aborted) throw error
          if (attempt + 1 < maximumAttempts) {
            await new Promise((resolve) =>
              window.setTimeout(resolve, attempt === 0 ? 260 : 720)
            )
            continue
          }
          if (cached && Date.now() - cached.savedAt < 24 * 60 * 60_000)
            return cached.payload
          throw new Error('网络暂时不稳定，请稍后重试。')
        } finally {
          window.clearTimeout(timeout)
          controller.signal.removeEventListener('abort', abortRequest)
        }

        const payload = (await response.json().catch(() => null)) as
          (T & { error?: string }) | null
        if (response.ok && payload !== null) {
          if (method === 'GET') writeJsonCache(url, payload)
          return payload as T
        }
        if (
          (payload === null || transientStatuses.has(response.status)) &&
          attempt + 1 < maximumAttempts
        ) {
          const retryAfter = Number(response.headers.get('Retry-After') || 0)
          const delay =
            Number.isFinite(retryAfter) && retryAfter > 0
              ? Math.min(2400, retryAfter * 1000)
              : attempt === 0
                ? 260
                : 720
          await new Promise((resolve) => window.setTimeout(resolve, delay))
          continue
        }
        if (
          (payload === null || response.status >= 500) &&
          cached &&
          Date.now() - cached.savedAt < 24 * 60 * 60_000
        )
          return cached.payload
        if (payload === null || response.status >= 500)
          throw new Error('数据源暂时没有响应，请稍后重试。')
        throw new Error(payload?.error || '请求暂时未能完成。')
      }
      throw new Error('数据源暂时没有响应，请稍后重试。')
    }
    async function fetchWiki<T extends object>(
      action: string,
      params: Record<string, string> = {}
    ): Promise<T & { source: 'zread' | 'deepwiki' }> {
      let lastError: unknown = null
      for (const source of ['zread', 'deepwiki'] as const) {
        try {
          const payload = await fetchJson<
            T & { source?: 'zread' | 'deepwiki' }
          >(api(source, action, params))
          return Object.assign(payload, { source: payload.source || source })
        } catch (error) {
          lastError = error
        }
      }
      throw lastError instanceof Error
        ? lastError
        : new Error('中文文档源暂时不可用。')
    }
    const decodeBase64 = (value: string) => {
      const binary = atob(value.replace(/\s/g, ''))
      return new TextDecoder().decode(
        Uint8Array.from(binary, (character) => character.charCodeAt(0))
      )
    }
    const showStatus = (
      message: string,
      kind: 'loading' | 'error' = 'loading'
    ) => {
      status.hidden = false
      status.dataset.kind = kind
      status.innerHTML = `${kind === 'loading' ? '<span class="agent-pulse"></span>' : '<span class="i-ri-error-warning-line"></span>'}${escapeHtml(message)}`
    }
    const hideStatus = () => {
      status.hidden = true
    }
    const preferredScrollBehavior = (): ScrollBehavior =>
      reduceMotionMedia.matches ? 'auto' : 'smooth'

    const setMobileNav = (open: boolean, restoreFocus = true) => {
      const wasOpen = root.dataset.mobileNavOpen === 'true'
      const shouldOpen = open && mobileNavMedia.matches
      if (
        shouldOpen &&
        !wasOpen &&
        document.activeElement instanceof HTMLElement
      )
        mobileNavReturnFocus = document.activeElement

      root.dataset.mobileNavOpen = String(shouldOpen)
      mobileNavButton.setAttribute('aria-expanded', String(shouldOpen))
      mobileNavButton.setAttribute(
        'aria-label',
        shouldOpen ? '关闭文档目录' : '打开文档目录'
      )
      wikiNav.toggleAttribute('inert', mobileNavMedia.matches && !shouldOpen)
      wikiNav.setAttribute(
        'aria-hidden',
        String(mobileNavMedia.matches && !shouldOpen)
      )
      mobileNavScrim.setAttribute('aria-hidden', String(!shouldOpen))
      document.documentElement.classList.toggle(
        'agent-mobile-nav-lock',
        shouldOpen
      )

      if (shouldOpen && !wasOpen) {
        window.requestAnimationFrame(() =>
          wikiNav
            .querySelector<HTMLButtonElement>('[data-mobile-nav-close]')
            ?.focus({ preventScroll: true })
        )
      } else if (!shouldOpen && wasOpen) {
        const returnTarget = mobileNavReturnFocus
        mobileNavReturnFocus = null
        if (restoreFocus)
          window.requestAnimationFrame(() =>
            returnTarget?.focus({ preventScroll: true })
          )
      }
    }

    const syncMobileNav = () =>
      setMobileNav(root.dataset.mobileNavOpen === 'true', false)
    mobileNavMedia.addEventListener('change', syncMobileNav, {
      signal: controller.signal,
    })
    setMobileNav(false, false)

    const atlasDefaultWidth = () => Math.min(1120, window.innerWidth * 0.72)
    const atlasMinWidth = () => Math.min(680, window.innerWidth)
    const atlasMaxWidth = () =>
      Math.max(atlasMinWidth(), window.innerWidth - 32)
    const clampAtlasWidth = (width: number) =>
      Math.min(atlasMaxWidth(), Math.max(atlasMinWidth(), width))
    const readStoredAtlasWidth = () => {
      try {
        return Number(window.localStorage.getItem('agent-atlas-width-v2')) || 0
      } catch {
        return 0
      }
    }
    const applyAtlasWidth = (width: number, persist = false) => {
      if (window.innerWidth <= 760) {
        atlas.style.removeProperty('--agent-atlas-width')
        return
      }
      atlasWidth = clampAtlasWidth(width || atlasDefaultWidth())
      atlas.style.setProperty('--agent-atlas-width', `${atlasWidth}px`)
      atlasResize.setAttribute(
        'aria-valuemin',
        String(Math.round(atlasMinWidth()))
      )
      atlasResize.setAttribute(
        'aria-valuemax',
        String(Math.round(atlasMaxWidth()))
      )
      atlasResize.setAttribute('aria-valuenow', String(Math.round(atlasWidth)))
      atlasResize.setAttribute(
        'aria-valuetext',
        `${Math.round(atlasWidth)} 像素宽`
      )
      if (persist) {
        try {
          window.localStorage.setItem(
            'agent-atlas-width-v2',
            String(Math.round(atlasWidth))
          )
        } catch {
          // localStorage can be disabled in privacy modes; resizing still works.
        }
      }
    }
    const resetAtlasWidth = () => applyAtlasWidth(atlasDefaultWidth(), true)

    applyAtlasWidth(readStoredAtlasWidth() || atlasDefaultWidth())

    let resizePointer = -1
    let resizeStartX = 0
    let resizeStartWidth = 0
    atlasResize.addEventListener(
      'pointerdown',
      (event) => {
        if (event.button !== 0 || window.innerWidth <= 760) return
        event.preventDefault()
        resizePointer = event.pointerId
        resizeStartX = event.clientX
        resizeStartWidth = atlasWidth || atlas.getBoundingClientRect().width
        root.dataset.atlasResizing = 'true'
        atlasResize.setPointerCapture(event.pointerId)
      },
      { signal: controller.signal }
    )
    atlasResize.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerId !== resizePointer) return
        applyAtlasWidth(resizeStartWidth + resizeStartX - event.clientX)
      },
      { signal: controller.signal }
    )
    const finishAtlasResize = (event: PointerEvent) => {
      if (event.pointerId !== resizePointer) return
      resizePointer = -1
      delete root.dataset.atlasResizing
      if (atlasResize.hasPointerCapture(event.pointerId))
        atlasResize.releasePointerCapture(event.pointerId)
      applyAtlasWidth(atlasWidth, true)
    }
    atlasResize.addEventListener('pointerup', finishAtlasResize, {
      signal: controller.signal,
    })
    atlasResize.addEventListener('pointercancel', finishAtlasResize, {
      signal: controller.signal,
    })
    atlasResize.addEventListener('dblclick', resetAtlasWidth, {
      signal: controller.signal,
    })
    atlasResize.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Home') {
          event.preventDefault()
          applyAtlasWidth(atlasMinWidth(), true)
        } else if (event.key === 'End') {
          event.preventDefault()
          applyAtlasWidth(atlasMaxWidth(), true)
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') {
          event.preventDefault()
          applyAtlasWidth(atlasWidth - 24, true)
        } else if (event.key === 'ArrowRight' || event.key === 'ArrowUp') {
          event.preventDefault()
          applyAtlasWidth(atlasWidth + 24, true)
        }
      },
      { signal: controller.signal }
    )
    window.addEventListener(
      'resize',
      () => applyAtlasWidth(atlasWidth || atlasDefaultWidth()),
      { signal: controller.signal }
    )

    function applyMeta(next: RepoMeta) {
      meta = next
      if (activeRef === 'HEAD') activeRef = next.defaultBranch
      const values: [string, string][] = [
        ['[data-repo-owner]', next.owner],
        ['[data-repo-title]', next.name],
        ['[data-repo-full-name]', next.fullName],
        ['[data-repo-description]', '已连接仓库源码与文档'],
        ['[data-repo-stars]', compact(next.stars)],
        ['[data-language]', next.language || '—'],
        ['[data-atlas-repo]', next.fullName],
        ['[data-default-branch]', next.defaultBranch],
        ['[data-atlas-stars]', compact(next.stars)],
        ['[data-atlas-forks]', compact(next.forks)],
        ['[data-atlas-watchers]', compact(next.watchers)],
        ['[data-atlas-language]', next.language || '未标注'],
        ['[data-atlas-license]', next.license || '未声明'],
        ['[data-atlas-branch]', next.defaultBranch],
        ['[data-atlas-state]', next.archived ? '已归档' : '活跃维护'],
      ]
      values.forEach(([selector, value]) => {
        const element = get<HTMLElement>(selector)
        if (element) element.textContent = value
      })
      const updated = get<HTMLElement>('[data-updated-at]')
      const updatedLabel = new Intl.DateTimeFormat('zh-CN', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      }).format(new Date(next.updatedAt))
      if (updated) updated.textContent = updatedLabel
      const atlasUpdate = get<HTMLElement>('[data-atlas-update]')
      if (atlasUpdate) atlasUpdate.textContent = updatedLabel
      const topics = get<HTMLElement>('[data-atlas-topics]')
      if (topics) {
        const topicMarkup = next.topics
          .slice(0, 12)
          .map((topic) => `<span>${escapeHtml(topic)}</span>`)
          .join('')
        const homepageUrl = next.homepage ? safeExternalUrl(next.homepage) : ''
        const homepageMarkup = homepageUrl
          ? `<a href="${escapeHtml(homepageUrl)}" target="_blank" rel="noopener">项目主页<span class="i-ri-arrow-right-up-line"></span></a>`
          : ''
        topics.innerHTML =
          topicMarkup || homepageMarkup
            ? `${topicMarkup}${homepageMarkup}`
            : '<span>暂无主题标签</span>'
      }
      const avatar = get<HTMLImageElement>('[data-repo-avatar]')
      if (avatar) {
        avatar.src = `https://github.com/${encodeURIComponent(next.owner)}.png?size=96`
        avatar.hidden = false
      }
      getAll<HTMLAnchorElement>(
        '[data-github-link], [data-atlas-github]'
      ).forEach((link) => {
        link.href = githubUrl()
      })
      const deepwiki = get<HTMLAnchorElement>('[data-deepwiki-link]')
      if (deepwiki) deepwiki.href = `https://deepwiki.com/${next.fullName}`
      const copy = get<HTMLButtonElement>('[data-copy-command]')
      if (copy && !copy.dataset.copy) {
        copy.dataset.copy = `git clone https://github.com/${repo}.git`
        copy.hidden = false
      }
      document.title = `${next.name} - Agent 知识库`
    }

    function setSourceState(label: string, ready: boolean) {
      const state = get<HTMLElement>('[data-source-state]')
      if (!state) return
      state.classList.toggle('is-ready', ready)
      const labelElement = state.querySelector('span')
      if (labelElement) labelElement.textContent = label
    }

    function diagramThemeTokens() {
      const styles = getComputedStyle(root)
      const read = (name: string, fallback: string) =>
        styles.getPropertyValue(name).trim() || fallback
      return {
        paper: read('--diagram-paper', '#ffffff'),
        paper2: read('--diagram-paper-2', '#f7f7f7'),
        ink: read('--diagram-ink', '#111111'),
        muted: read('--diagram-muted', '#666666'),
        soft: read('--diagram-soft', '#777777'),
        rule: read('--diagram-rule', 'rgba(0, 0, 0, 0.12)'),
        ruleSolid: read('--diagram-rule-solid', '#b8b8b8'),
        accent: read('--diagram-accent', '#111111'),
        accentTint: read('--diagram-accent-tint', '#f1f1f1'),
        fontNode: read(
          '--diagram-font-node',
          'Inter, ui-sans-serif, system-ui, sans-serif'
        ),
      }
    }

    function mermaidConfig() {
      const tokens = diagramThemeTokens()
      return {
        startOnLoad: false,
        securityLevel: 'strict' as const,
        suppressErrorRendering: true,
        theme: 'base' as const,
        fontFamily: tokens.fontNode,
        // 顶层 htmlLabels 必须为 false: 仅设 flowchart.htmlLabels 不生效,
        // 标签仍走 foreignObject + XHTML div, 会被下游 DOMPurify 的 svg
        // profile 整段剥掉, 只剩空 rect, 表现为节点框有边框但没有文字
        htmlLabels: false,
        flowchart: {
          htmlLabels: false,
          useMaxWidth: true,
          curve: 'linear' as const,
          nodeSpacing: 26,
          rankSpacing: 30,
          padding: 8,
        },
        themeVariables: {
          background: tokens.paper,
          primaryColor: tokens.paper,
          primaryBorderColor: tokens.ruleSolid,
          primaryTextColor: tokens.ink,
          secondaryColor: tokens.paper2,
          secondaryBorderColor: tokens.ruleSolid,
          secondaryTextColor: tokens.ink,
          tertiaryColor: tokens.paper,
          tertiaryBorderColor: tokens.rule,
          tertiaryTextColor: tokens.ink,
          mainBkg: tokens.paper,
          nodeBorder: tokens.ruleSolid,
          textColor: tokens.ink,
          lineColor: tokens.muted,
          clusterBkg: tokens.paper2,
          clusterBorder: tokens.rule,
          edgeLabelBackground: tokens.paper,
          labelTextColor: tokens.muted,
          fontSize: '12px',
        },
      }
    }
    function normalizeMermaidSource(source: string) {
      // DeepWiki occasionally emits shorthand such as `[GC] -- "Client"`.
      // Mermaid treats that as an incomplete edge, so turn it into a regular
      // node declaration and unwrap bracketed IDs when they are used as edge
      // references. Keep every replacement line-local: `\s*` used here in the
      // past crossed a newline and mistook the next line for part of a label.
      let normalized = source
        .replace(/\r\n?/g, '\n')
        .replace(
          /^(\s*)\[([A-Za-z_][\w.-]*)\]\s*--\s*"([^"\n]+)"\s*$/gm,
          '$1$2["$3"]'
        )
        .replace(
          /(^|[ \t])\[([A-Za-z_][\w.-]*)\](?=[ \t]*(?:--|-.->|==>|~~~))/gm,
          '$1$2'
        )
        .replace(
          /((?:-->|---|-.->|==>|~~~)(?:\|[^|\n]*\|)?[ \t]*)\[([A-Za-z_][\w.-]*)\]/g,
          '$1$2'
        )

      const identifiers = new Map<string, string>()
      let sequence = 0
      const resolveIdentifier = (label: string) => {
        const existing = identifiers.get(label)
        if (existing) return existing
        const identifier = `node_${sequence++}`
        identifiers.set(label, identifier)
        return identifier
      }

      // DeepWiki 会输出 `["label"]` 这种没有节点 ID 的简写。它看起来
      // 像合法节点，实际会让 Mermaid 整张图解析失败；为它补一个稳定 ID。
      normalized = normalized.replace(
        /(^|[ \t>])\[\s*"([^"\n]+)"\s*\]/gm,
        (_, prefix: string, label: string) =>
          `${prefix}${resolveIdentifier(label)}["${label}"]`
      )

      normalized = normalized.replace(
        /"([^"\n]+)"(?=[ \t]*(?:\[|\(|\{))/g,
        (_, label: string) => resolveIdentifier(label)
      )
      for (const [label, identifier] of identifiers) {
        const escaped = label.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
        normalized = normalized
          .replace(
            new RegExp(`"${escaped}"(?=[ \\t]*(?:-->|---|-.->|==>|~~~))`, 'g'),
            identifier
          )
          .replace(
            new RegExp(
              `((?:-->|---|-.->|==>|~~~)(?:\\|[^|]*\\|)?[ \\t]*)"${escaped}"`,
              'g'
            ),
            `$1${identifier}`
          )
      }
      return normalized
    }
    function prepareMermaid(container: HTMLElement) {
      const loadingMarkup =
        '<div class="agent-diagram-loading" role="status" aria-label="正在绘制关系图"><span></span><span></span><span></span><em>正在绘制关系图</em></div>'
      container
        .querySelectorAll<HTMLElement>('pre > code.language-mermaid')
        .forEach((code) => {
          const pre = code.parentElement
          const source = code.textContent?.trim()
          if (!pre || !source) return
          const figure = document.createElement('figure')
          figure.className = 'agent-mermaid diagram-design'
          figure.dataset.motionMode = 'none'
          figure.dataset.mermaidOriginal = source
          figure.dataset.mermaidSource = normalizeMermaidSource(source)
          figure.innerHTML = `<div class="agent-mermaid-toolbar"><span><i class="i-ri-flow-chart"></i><b>手绘关系图</b><em>滚动查看 · 可缩放</em></span><div><button type="button" data-diagram-action="out" aria-label="缩小"><i class="i-ri-subtract-line"></i></button><label class="agent-mermaid-scale"><input type="number" data-diagram-scale step="10" value="100" inputmode="numeric" aria-label="图表缩放百分比"><span>%</span></label><button type="button" data-diagram-action="in" aria-label="放大"><i class="i-ri-add-line"></i></button><button type="button" data-diagram-action="fullscreen" aria-label="全屏查看图表" aria-pressed="false"><i class="i-ri-fullscreen-line"></i></button></div></div><div class="agent-mermaid-viewport"><div class="agent-mermaid-canvas">${loadingMarkup}</div></div>`
          pre.replaceWith(figure)
        })
    }

    function labelDiagramSvg(svg: SVGSVGElement, id: string) {
      const namespace = 'http://www.w3.org/2000/svg'
      const titleId = `${id}-title`
      const descriptionId = `${id}-desc`
      const title =
        svg.querySelector<SVGTitleElement>(':scope > title') ||
        document.createElementNS(namespace, 'title')
      const description =
        svg.querySelector<SVGDescElement>(':scope > desc') ||
        document.createElementNS(namespace, 'desc')
      title.id = titleId
      title.textContent = '仓库文档关系图'
      description.id = descriptionId
      description.textContent =
        '根据仓库文档中的 Mermaid 源码生成，可使用工具栏缩放查看。'
      svg.prepend(description)
      svg.prepend(title)
      svg.setAttribute('role', 'img')
      svg.setAttribute('aria-labelledby', `${titleId} ${descriptionId}`)
      svg.setAttribute('focusable', 'false')
    }

    function applyExcalidrawStyle(svg: SVGSVGElement, id: string) {
      const namespace = 'http://www.w3.org/2000/svg'
      const defs =
        svg.querySelector<SVGDefsElement>(':scope > defs') ||
        document.createElementNS(namespace, 'defs')
      if (!defs.parentNode) svg.prepend(defs)

      const filter = document.createElementNS(namespace, 'filter')
      filter.id = `${id}-hand-drawn`
      filter.setAttribute('x', '-8%')
      filter.setAttribute('y', '-8%')
      filter.setAttribute('width', '116%')
      filter.setAttribute('height', '116%')

      const noise = document.createElementNS(namespace, 'feTurbulence')
      noise.setAttribute('type', 'fractalNoise')
      noise.setAttribute('baseFrequency', '0.018')
      noise.setAttribute('numOctaves', '2')
      noise.setAttribute('seed', String((mermaidSequence % 7) + 2))
      noise.setAttribute('result', 'roughNoise')

      const displacement = document.createElementNS(
        namespace,
        'feDisplacementMap'
      )
      displacement.setAttribute('in', 'SourceGraphic')
      displacement.setAttribute('in2', 'roughNoise')
      displacement.setAttribute('scale', '0.8')
      displacement.setAttribute('xChannelSelector', 'R')
      displacement.setAttribute('yChannelSelector', 'G')
      filter.append(noise, displacement)
      defs.append(filter)
      svg.classList.add('agent-excalidraw-svg')
      svg.style.setProperty('--agent-hand-drawn-filter', `url(#${filter.id})`)
    }

    function applyDiagramPalette(svg: SVGSVGElement) {
      svg.querySelectorAll<SVGGElement>('g.node').forEach((node, index) => {
        node.dataset.palette = String(index % 4)
      })
      svg
        .querySelectorAll<SVGGElement>('g.cluster')
        .forEach((cluster, index) => {
          cluster.dataset.palette = String(index % 4)
        })
      svg.querySelectorAll<SVGGElement>('g.edgePath').forEach((edge, index) => {
        edge.dataset.palette = String(index % 4)
      })
    }

    function setMermaidScale(figure: HTMLElement, scale: number) {
      const canvas = figure.querySelector<HTMLElement>('.agent-mermaid-canvas')
      if (!canvas) return
      if (!Number.isFinite(scale) || scale <= 0) {
        const input = figure.querySelector<HTMLInputElement>(
          '[data-diagram-scale]'
        )
        if (input)
          input.value = String(
            Math.round(Number(figure.dataset.diagramScale || '1') * 100)
          )
        return
      }
      const next = scale
      figure.dataset.diagramScale = String(next)
      canvas.style.setProperty('--diagram-width', `${next * 100}%`)
      const input = figure.querySelector<HTMLInputElement>(
        '[data-diagram-scale]'
      )
      if (input) input.value = String(Math.round(next * 100))
    }

    function fitMermaidScale(figure: HTMLElement, svg: SVGSVGElement) {
      const viewport = figure.querySelector<HTMLElement>(
        '.agent-mermaid-viewport'
      )
      const viewBox = svg.viewBox.baseVal
      if (!viewport || !viewBox.width || !viewBox.height) {
        setMermaidScale(figure, 1)
        return
      }
      const availableWidth = Math.max(1, viewport.clientWidth - 48)
      const naturalHeight = availableWidth * (viewBox.height / viewBox.width)
      const comfortableHeight = Math.min(
        640,
        Math.max(360, window.innerHeight * 0.55)
      )
      const fittedScale =
        naturalHeight > comfortableHeight
          ? comfortableHeight / naturalHeight
          : 1
      // Auto-fit keeps very tall diagrams readable on first paint. This is
      // only the initial presentation size: the input and +/- controls remain
      // unbounded and can move below or above it freely.
      setMermaidScale(figure, Math.max(0.35, fittedScale))
    }

    function commitMermaidScaleInput(input: HTMLInputElement) {
      const figure = input.closest<HTMLElement>('.agent-mermaid')
      if (!figure) return
      const percentage = Number(input.value)
      if (input.value.trim() && Number.isFinite(percentage)) {
        setMermaidScale(figure, percentage / 100)
        return
      }
      setMermaidScale(figure, Number(figure.dataset.diagramScale || '1'))
    }

    function syncGraphDocumentLock() {
      const nativeFullscreen = document.fullscreenElement
      const open =
        (nativeFullscreen instanceof Element &&
          root.contains(nativeFullscreen)) ||
        Boolean(
          root.querySelector(
            '.agent-mermaid.is-fullscreen, .agent-repo-map.is-fullscreen'
          )
        )
      document.documentElement.classList.toggle('agent-graph-lock', open)
    }

    function updateMermaidFullscreenButton(figure: HTMLElement, open: boolean) {
      const button = figure.querySelector<HTMLButtonElement>(
        '[data-diagram-action="fullscreen"]'
      )
      if (button) {
        button.setAttribute('aria-pressed', String(open))
        button.setAttribute(
          'aria-label',
          open ? '退出全屏图表' : '全屏查看图表'
        )
        const icon = button.querySelector<HTMLElement>('i')
        icon?.classList.toggle('i-ri-fullscreen-line', !open)
        icon?.classList.toggle('i-ri-fullscreen-exit-line', open)
      }
    }

    function setMermaidFullscreen(figure: HTMLElement, open: boolean) {
      figure.classList.toggle('is-fullscreen', open)
      updateMermaidFullscreenButton(figure, open)
      syncGraphDocumentLock()
    }

    function syncMermaidFullscreen(figure: HTMLElement) {
      const nativeOpen = document.fullscreenElement === figure
      const fallbackOpen =
        document.fullscreenElement === null &&
        figure.classList.contains('is-fullscreen')
      updateMermaidFullscreenButton(figure, nativeOpen || fallbackOpen)
      syncGraphDocumentLock()
    }

    async function toggleMermaidFullscreen(figure: HTMLElement) {
      try {
        if (document.fullscreenElement === figure) {
          await document.exitFullscreen()
          return
        }
        if (document.fullscreenElement) await document.exitFullscreen()
        if (figure.requestFullscreen) {
          await figure.requestFullscreen()
          return
        }
      } catch {
        // Browsers that disallow the native Fullscreen API use the fixed
        // fallback below. The native path is preferred because it lives in
        // the top layer and therefore cannot be covered by the site navbar.
      }
      setMermaidFullscreen(figure, !figure.classList.contains('is-fullscreen'))
    }

    async function renderMermaidNow(container: HTMLElement) {
      prepareMermaid(container)
      const figures = [
        ...container.querySelectorAll<HTMLElement>('[data-mermaid-source]'),
      ]
      if (!figures.length) return
      try {
        const mermaid = await loadMermaid()
        mermaid.initialize(mermaidConfig())
        for (const figure of figures) {
          if (!figure.isConnected) continue
          const normalizedSource = figure.dataset.mermaidSource || ''
          const originalSource = figure.dataset.mermaidOriginal || ''
          const sources = [
            ...new Set([normalizedSource, originalSource]),
          ].filter(Boolean)
          const viewport = figure.querySelector<HTMLElement>(
            '.agent-mermaid-viewport'
          )
          if (!sources.length || !viewport) continue
          const canvas = document.createElement('div')
          canvas.className = 'agent-mermaid-canvas'
          canvas.style.setProperty('--diagram-width', '100%')
          figure.dataset.diagramScale = '1'
          let rendered = false
          let lastError: unknown = null
          for (const source of sources) {
            for (let attempt = 0; attempt < 3; attempt += 1) {
              const diagramId = `agent-mermaid-${mermaidSequence++}`
              try {
                const { svg, bindFunctions } = await mermaid.render(
                  diagramId,
                  source
                )
                canvas.innerHTML = DOMPurify.sanitize(svg, {
                  USE_PROFILES: { svg: true, svgFilters: true },
                })
                const svgElement = canvas.querySelector<SVGSVGElement>('svg')
                if (!svgElement)
                  throw new Error('Mermaid output did not contain an SVG')
                labelDiagramSvg(svgElement, diagramId)
                applyExcalidrawStyle(svgElement, diagramId)
                applyDiagramPalette(svgElement)
                viewport.replaceChildren(canvas)
                bindFunctions?.(canvas)
                requestAnimationFrame(() => {
                  if (figure.isConnected) fitMermaidScale(figure, svgElement)
                })
                rendered = true
                break
              } catch (error) {
                lastError = error
                // Mermaid may leave temporary render roots behind after a
                // rejected parse. Remove them before trying a fresh ID.
                document.getElementById(diagramId)?.remove()
                document.getElementById(`d${diagramId}`)?.remove()
                canvas.replaceChildren()
                if (attempt < 2)
                  await new Promise((resolve) =>
                    window.setTimeout(resolve, 50 + attempt * 70)
                  )
              }
            }
            if (rendered) break
          }
          if (!rendered) {
            const source = originalSource || normalizedSource
            canvas.innerHTML = `<div class="agent-diagram-error"><span class="i-ri-error-warning-line"></span><strong>这张关系图暂时没有画出来</strong><button type="button" data-diagram-action="retry"><i class="i-ri-refresh-line"></i>重新渲染</button><details><summary>查看图表源码</summary><pre><code>${escapeHtml(source)}</code></pre></details></div>`
            viewport.replaceChildren(canvas)
            console.warn('Mermaid diagram failed to render', lastError)
          }
        }
      } catch {
        figures.forEach((figure) => {
          const viewport = figure.querySelector<HTMLElement>(
            '.agent-mermaid-viewport'
          )
          if (!viewport) return
          const canvas = document.createElement('div')
          canvas.className = 'agent-mermaid-canvas'
          canvas.innerHTML = `<div class="agent-diagram-error"><span class="i-ri-error-warning-line"></span><strong>图表组件暂时没有加载完成</strong><button type="button" data-diagram-action="retry"><i class="i-ri-refresh-line"></i>重新渲染</button></div>`
          viewport.replaceChildren(canvas)
        })
      }
    }

    function renderMermaid(container: HTMLElement) {
      const task = mermaidRenderQueue.then(() => renderMermaidNow(container))
      mermaidRenderQueue = task.catch(() => undefined)
      return task
    }

    function resolveWikiTitle(raw: string, label = '') {
      if (raw.trim().toLowerCase() === 'overview' && wikiItems.length) {
        return wikiItems[0]?.title || 'Overview'
      }
      const decoded = safeDecode(raw).split('/').filter(Boolean).pop() || ''
      const candidates = [
        label,
        decoded,
        decoded.replace(/^\d+(?:\.\d+)*-/, '').replace(/-/g, ' '),
      ]
      return (
        wikiItems.find((item) =>
          candidates.some(
            (candidate) =>
              item.title.toLowerCase() === candidate.trim().toLowerCase() ||
              slug(item.title) === slug(candidate) ||
              item.slug?.toLowerCase() === decoded.toLowerCase()
          )
        )?.title ||
        label ||
        decoded
      )
    }

    function repositoryFileReference(
      raw: string,
      sourcePath = ''
    ): RepositoryFileReference | null {
      const value = raw.trim()
      const githubLocation = value.match(
        /#L(\d+)(?:C(\d+))?(?:-L?\d+(?:C\d+)?)?$/i
      )
      const colonLocation = value.match(/:(\d+)(?::(\d+))?(?:-\d+)?$/)
      const location = githubLocation || colonLocation
      const line = Number(location?.[1] || 0)
      const column = Number(location?.[2] || 0)
      const candidate = location
        ? value.slice(0, Math.max(0, value.length - location[0].length))
        : value
      try {
        const url = new URL(
          candidate,
          `https://github.com/${repo}/blob/${activeRef}/${sourcePath}`
        )
        const prefix = `/${owner}/${repoName}/blob/`
        if (url.hostname === 'github.com' && url.pathname.startsWith(prefix)) {
          const parts = url.pathname.slice(prefix.length).split('/')
          const ref = decodeURIComponent(parts.shift() || activeRef)
          const path = parts.map(decodeURIComponent).join('/')
          return path ? { path, ref, line, column } : null
        }
      } catch {
        return null
      }

      const repositoryCandidate = candidate.replace(/^\/+/, '')
      if (
        /^(?:\.\.\/|\.\/)?[\w@.-][\w@./ -]*\.[a-z0-9]{1,8}(?:#L\d+)?$/i.test(
          repositoryCandidate
        )
      ) {
        const sourceDirectory = sourcePath.includes('/')
          ? sourcePath.slice(0, sourcePath.lastIndexOf('/') + 1)
          : ''
        const path = new URL(
          repositoryCandidate,
          `https://local/${sourceDirectory}`
        ).pathname.slice(1)
        return { path, ref: activeRef, line, column }
      }
      return null
    }

    /**
     * Keep repository-reference icons semantic but theme-neutral. The editor
     * owns the Vitesse syntax palette; surrounding navigation follows the
     * blog's current light/dark theme instead of importing VS Code colours.
     */
    function markRepositoryFileLink(
      link: HTMLAnchorElement,
      reference: RepositoryFileReference
    ) {
      const locationHash = reference.line
        ? `#L${reference.line}${reference.column ? `C${reference.column}` : ''}`
        : ''
      link.href = `${repoFileUrl(reference.path, reference.ref)}${locationHash}`
      // 这些 href 只用于复制/新标签打开, 点击已被拦截走内部加载。
      // ClientRouter 会强制开启 prefetchAll, 不关掉预取会让浏览器
      // 去请求没有 getStaticPaths 条目的路径, dev 下刷出 router WARN。
      link.dataset.astroPrefetch = 'false'
      link.dataset.openFile = reference.path
      link.dataset.fileRef = reference.ref
      if (reference.line) link.dataset.fileLine = String(reference.line)
      if (reference.column) link.dataset.fileColumn = String(reference.column)
      link.classList.add('agent-file-reference')
      link.removeAttribute('target')
      link.removeAttribute('rel')
      // 图标以真实元素注入: ::before 无法承载 unocss 的 mask 背景。
      // 文字另包一层 span, 才能在窄列里做单行省略。
      if (!link.querySelector('.agent-file-reference-icon')) {
        const label = document.createElement('span')
        label.className = 'agent-file-reference-label'
        label.append(...link.childNodes)
        const icon = document.createElement('img')
        icon.className = 'agent-file-reference-icon'
        icon.src = materialIconFor(reference.path)
        icon.alt = ''
        icon.setAttribute('aria-hidden', 'true')
        link.replaceChildren(icon, label)
        // 窄列里长路径会省略, 悬停仍要能看到完整路径
        if (!link.title) link.title = reference.path
      }
    }

    function rewriteInlineFileReferences(container: HTMLElement) {
      const pattern =
        /^((?:\.{0,2}\/)?[\w@.+ -]+(?:\/[\w@.+ -]+)*\.(?:astro|c|cc|cpp|cs|css|go|graphql|gql|h|hpp|html|java|js|jsx|json|jsonc|kt|kts|md|mdx|mjs|php|py|rb|rs|scss|sh|sql|svelte|swift|toml|ts|tsx|txt|vue|xml|ya?ml))(?:(?:#L(\d+)(?:C(\d+))?(?:-L?\d+(?:C\d+)?)?)|(?::(\d+)(?::(\d+))?(?:-\d+)?))?$/i
      container
        .querySelectorAll<HTMLElement>('code:not(pre code)')
        .forEach((code) => {
          if (code.closest('a')) return
          const value = (code.textContent || '').trim()
          const match = value.match(pattern)
          if (!match?.[1]) return
          const path = match[1].replace(/^\.\//, '')
          const line = Number(match[2] || match[4] || 0)
          const column = Number(match[3] || match[5] || 0)
          const link = document.createElement('a')
          link.append(code.cloneNode(true))
          markRepositoryFileLink(link, {
            path,
            ref: activeRef,
            line,
            column,
          })
          code.replaceWith(link)
        })
    }

    function rewriteWikiLinks(container: HTMLElement, sourcePath = '') {
      container
        .querySelectorAll<HTMLAnchorElement>('a[href]')
        .forEach((link) => {
          const raw = link.getAttribute('href') || ''
          if (raw.startsWith('#')) {
            const id = raw.slice(1)
            const wikiTarget = wikiItems.find((item) => item.id === id)
            if (wikiTarget) {
              link.dataset.wikiPage = wikiTarget.title
              link.classList.add('agent-wiki-link')
              link.href = '#'
            }
            return
          }
          if (/^(javascript|data|vbscript|file):/i.test(raw)) {
            link.removeAttribute('href')
            return
          }
          if (
            raw.startsWith('/wiki/') ||
            (raw.includes('deepwiki.com/') && raw.includes('/wiki/'))
          ) {
            link.dataset.wikiPage = resolveWikiTitle(
              raw,
              link.textContent || ''
            )
            link.classList.add('agent-wiki-link')
            link.href = '#'
            return
          }
          const internalSlug = safeDecode(raw)
            .split('#')[0]
            ?.replace(/^\.\//, '')
            .replace(/^\//, '')
          const internalPage = wikiItems.find(
            (item) => item.slug === internalSlug
          )
          if (internalPage) {
            link.dataset.wikiPage = internalPage.title
            link.classList.add('agent-wiki-link')
            link.href = '#'
            return
          }
          const reference = repositoryFileReference(
            raw || (link.textContent || '').trim(),
            sourcePath
          )
          if (reference) {
            markRepositoryFileLink(link, reference)
            return
          }
          if (/^https?:/i.test(raw)) {
            link.target = '_blank'
            link.rel = 'noopener nofollow'
            // 动态渲染的仓库文档不会经过博客的 rehype-external-links，
            // 因此在这里补齐与博客一致的新标签页提示和交互钩子。
            if ((link.textContent || '').trim()) {
              link.classList.add('agent-external-link')
              const existingIcon = link.querySelector<HTMLElement>(
                '.agent-external-link-icon, .new-tab-icon, .i-ri-arrow-right-up-line'
              )
              if (existingIcon) {
                existingIcon.classList.add('agent-external-link-icon')
              } else {
                const icon = document.createElement('span')
                icon.className =
                  'i-ri-arrow-right-up-line agent-external-link-icon'
                icon.setAttribute('aria-hidden', 'true')
                link.append(icon)
              }
            }
            return
          }
          // mailto: 等其它协议保持原样 (javascript: 等危险协议已在上方剥除)
          if (/^[a-z][a-z0-9+.-]*:/i.test(raw)) return
          link.href = repoFileUrl(raw.replace(/^\.\//, ''))
          link.dataset.astroPrefetch = 'false'
        })
      rewriteMarkdownImages(container, sourcePath)
    }

    const encodedRepositoryPath = (path: string) =>
      path
        .split('/')
        .filter(Boolean)
        .map((part) => encodeURIComponent(safeDecode(part)))
        .join('/')

    function repositoryImageSources(raw: string, sourcePath = '') {
      const currentRef =
        activeRef === 'HEAD' ? meta?.defaultBranch || 'HEAD' : activeRef
      try {
        const url = new URL(raw)
        const githubAsset = url.pathname.match(
          /^\/([^/]+)\/([^/]+)\/(?:blob|raw)\/(?:refs\/heads\/)?([^/]+)\/(.+)$/i
        )
        if (url.hostname === 'github.com' && githubAsset) {
          const [, assetOwner = '', assetRepo = '', ref = '', path = ''] =
            githubAsset
          const encodedPath = encodedRepositoryPath(path)
          return [
            `https://raw.githubusercontent.com/${encodeURIComponent(assetOwner)}/${encodeURIComponent(assetRepo)}/${encodeURIComponent(ref)}/${encodedPath}`,
            `https://cdn.jsdelivr.net/gh/${encodeURIComponent(assetOwner)}/${encodeURIComponent(assetRepo)}@${encodeURIComponent(ref)}/${encodedPath}`,
          ]
        }
        const rawAsset = url.pathname.match(
          /^\/([^/]+)\/([^/]+)\/(?:refs\/heads\/)?([^/]+)\/(.+)$/i
        )
        if (url.hostname === 'raw.githubusercontent.com' && rawAsset) {
          const [, assetOwner = '', assetRepo = '', ref = '', path = ''] =
            rawAsset
          return [
            url.href,
            `https://cdn.jsdelivr.net/gh/${encodeURIComponent(assetOwner)}/${encodeURIComponent(assetRepo)}@${encodeURIComponent(ref)}/${encodedRepositoryPath(path)}`,
          ]
        }
        return [url.href]
      } catch {
        if (/^[a-z][a-z0-9+.-]*:/i.test(raw)) return []
        const sourceDirectory = sourcePath.includes('/')
          ? sourcePath.slice(0, sourcePath.lastIndexOf('/') + 1)
          : ''
        try {
          const path = new URL(raw, `https://local/${sourceDirectory}`).pathname
          const encodedPath = encodedRepositoryPath(path)
          return [
            `https://raw.githubusercontent.com/${repo}/${encodeURIComponent(currentRef)}/${encodedPath}`,
            `https://cdn.jsdelivr.net/gh/${repo}@${encodeURIComponent(currentRef)}/${encodedPath}`,
          ]
        } catch {
          return []
        }
      }
    }

    function rewriteMarkdownImages(container: HTMLElement, sourcePath = '') {
      container
        .querySelectorAll<HTMLImageElement>('img[src]')
        .forEach((image) => {
          const raw = image.getAttribute('src') || ''
          if (!raw || /^data:image\//i.test(raw)) return
          const sources = repositoryImageSources(raw, sourcePath)
          if (!sources.length) {
            image.remove()
            return
          }
          image.classList.add('agent-markdown-image')
          image.loading = 'lazy'
          image.decoding = 'async'
          image.referrerPolicy = 'no-referrer'
          let sourceIndex = 0
          const showUnavailableState = () => {
            const fallback = document.createElement('span')
            fallback.className = 'agent-image-unavailable'
            fallback.setAttribute('role', 'img')
            fallback.setAttribute('aria-label', image.alt || '图片暂时无法加载')
            fallback.innerHTML = `<span class="i-ri-image-line" aria-hidden="true"></span><span>${escapeHtml(image.alt || '图片暂时无法加载')}</span>`
            image.replaceWith(fallback)
          }
          image.addEventListener('error', () => {
            sourceIndex += 1
            if (sources[sourceIndex]) {
              image.src = sources[sourceIndex]
              return
            }
            showUnavailableState()
          })
          image.src = sources[0] || raw
        })
    }

