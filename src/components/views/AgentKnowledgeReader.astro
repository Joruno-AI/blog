      width: 2.55rem;
      padding: 0;
      justify-content: center;
    }
    .agent-atlas {
      width: 100vw;
    }
    .agent-atlas-head {
      min-height: 4rem;
      padding-inline: 0.8rem;
    }
    .agent-atlas-head a {
      display: none;
    }
    .agent-atlas-tabs {
      padding-inline: 0.9rem;
    }
    .agent-atlas-body {
      padding: 1.25rem 0.75rem 3rem;
    }
    .agent-atlas-intro {
      display: grid;
      gap: 1rem;
    }
    .agent-atlas-intro button {
      justify-self: start;
    }
    .agent-overview-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .agent-overview-facts > div:nth-child(4) {
      border-right: 1px solid var(--agent-line);
    }
    .agent-overview-facts > div:nth-child(even) {
      border-right: 0;
    }
    .agent-overview-facts > div:nth-child(-n + 6) {
      border-bottom: 1px solid var(--agent-line);
    }
    .agent-repo-map {
      min-height: 30rem;
      padding: 0;
      display: block;
    }
    .agent-graph-hint {
      display: none;
    }
    .agent-module-detail {
      grid-template-columns: 1fr;
