  @media (max-width: 980px) {
    .agent-reader-shell {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
    .agent-page-toc {
      display: none;
    }
    .agent-wiki-main {
      border-right: 0;
    }
    .agent-overview-facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .agent-overview-facts > div:nth-child(4) {
      border-right: 0;
    }
    .agent-overview-facts > div:nth-child(-n + 4) {
      border-bottom: 1px solid var(--agent-line);
    }
    .agent-module-detail {
      grid-template-columns: 1.2fr 1fr;
    }
    .agent-module-detail > button {
      justify-self: start;
    }
  }
  @media (max-width: 760px) {
