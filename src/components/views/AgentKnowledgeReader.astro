    inset: auto 0.9rem 0.75rem auto;
    padding: 0.3rem 0.5rem;
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--c-text) 82%, transparent);
    color: var(--c-bg);
    font-size: 0.6rem;
    pointer-events: none;
