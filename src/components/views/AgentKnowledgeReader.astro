    text-align: left;
  }
  .agent-atlas-docs button > span {
    color: var(--agent-muted);
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
  }
  .agent-atlas-docs button > i {
    color: var(--agent-muted);
  }
  .agent-atlas-docs button div {
    display: grid;
    gap: 0.25rem;
  }
