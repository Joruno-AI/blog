  }
  .agent-back:hover {
    color: var(--c-text);
    background: var(--agent-soft);
  }
  .agent-knowledge-brand img {
    width: 2rem;
    height: 2rem;
    border-radius: 0.55rem;
    background: var(--agent-soft);
  }
  .agent-knowledge-brand > div {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    min-width: 0;
  }
  .agent-knowledge-brand p {
    display: contents;
  }
  .agent-knowledge-brand p span,
  .agent-knowledge-brand p i {
    color: var(--agent-muted);
    font-size: 0.86rem;
    font-style: normal;
  }
  .agent-knowledge-brand h1 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .agent-source-state {
    margin-left: 0.35rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    color: var(--agent-muted);
  }
  .agent-source-state > i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--agent-muted);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c-text) 9%, transparent);
  }
  .agent-source-state.is-ready > i {
    background: var(--c-text);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c-text) 13%, transparent);
  }
  .agent-knowledge-actions {
    gap: 0.45rem;
  }
  .agent-knowledge-actions > button,
  .agent-knowledge-actions > a {
    min-height: 2.35rem;
    padding: 0 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--agent-line);
    border-radius: 0.48rem;
    background: var(--c-bg);
    color: var(--agent-muted);
    font-size: 0.8rem;
  }
  .agent-knowledge-actions > a {
    width: 2.35rem;
    padding: 0;
    justify-content: center;
    font-size: 1.1rem;
  }
  .agent-knowledge-actions > button:hover,
  .agent-knowledge-actions > a:hover {
    border-color: var(--agent-line-strong);
    color: var(--c-text);
    background: var(--agent-soft);
  }
  .agent-knowledge-actions .agent-atlas-launch {
    background: var(--c-text);
    color: var(--c-bg);
    border-color: var(--c-text);
  }
  .agent-mobile-nav {
    display: none !important;
  }

  .agent-reader-shell {
    display: grid;
    grid-template-columns: 16.5rem minmax(0, 50rem) 14rem;
    justify-content: center;
    min-height: calc(
      100vh - var(--navbar-height, 4rem) - var(--agent-reader-head)
    );
    border-bottom: 1px solid var(--agent-line);
  }
  .agent-wiki-nav {
    position: sticky;
    top: calc(var(--navbar-height, 4rem) + var(--agent-reader-head));
    align-self: start;
    height: calc(100vh - var(--navbar-height, 4rem) - var(--agent-reader-head));
    padding: 1.7rem 1rem 5rem;
    border-right: 1px solid var(--agent-line);
    overflow-y: auto;
  }
  .agent-wiki-nav-head {
    display: none;
  }
  .agent-wiki-nav-head div {
    display: grid;
    gap: 0.15rem;
  }
  .agent-wiki-nav-head span,
  .agent-page-toc-inner > span,
  .agent-atlas-intro span,
  .agent-map-section header span,
  .agent-atlas-section-head > span,
  .agent-file-browser-head span {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.13em;
    color: var(--agent-muted);
  }
  .agent-wiki-nav-head strong {
    font-size: 0.86rem;
  }
  .agent-wiki-nav-head > button {
    display: none;
    border: 0;
    background: transparent;
    font-size: 1.1rem;
  }
  .agent-nav-search,
  .agent-file-search {
    height: 2.55rem;
    padding: 0 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border: 0;
    border-radius: 0.48rem;
    background: var(--agent-soft);
    color: var(--agent-muted);
  }
  .agent-nav-search input,
  .agent-file-search input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--c-text);
    font-size: 0.78rem;
  }
  .agent-nav-search input::-webkit-search-cancel-button,
  .agent-file-search input::-webkit-search-cancel-button {
    display: none;
  }
  .agent-nav-search [data-doc-search-clear] {
    width: 1.55rem;
    height: 1.55rem;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-text) 7%, transparent);
    color: var(--agent-muted);
    transition:
      color 160ms ease,
      background-color 160ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .agent-nav-search [data-doc-search-clear][hidden] {
    display: none;
  }
  .agent-nav-search [data-doc-search-clear]:hover {
    background: color-mix(in srgb, var(--c-text) 12%, transparent);
    color: var(--c-text);
    transform: rotate(7deg) scale(1.06);
  }
  .agent-nav-search:focus-within,
  .agent-file-search:focus-within {
    background: var(--c-bg);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c-text) 14%, transparent);
  }
  .agent-nav-search kbd,
  .agent-file-search kbd {
    font-size: 0.65rem;
    border: 0;
    border-radius: 0.3rem;
    padding: 0.05rem 0.3rem;
    background: color-mix(in srgb, var(--c-text) 7%, var(--c-bg));
  }
  .agent-wiki-pages {
    margin-top: 1rem;
    display: grid;
    gap: 0.15rem;
  }
  .agent-nav-search-empty {
    margin: 0.8rem 0 0;
    padding: 0.75rem;
    border-radius: 0.55rem;
    background: var(--agent-soft);
    color: var(--agent-muted);
    font-size: 0.7rem;
    text-align: center;
  }
  .agent-wiki-pages button {
    width: 100%;
    min-height: 2.15rem;
    padding: 0.45rem 0.6rem 0.45rem calc(0.6rem + var(--depth) * 0.7rem);
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.35rem;
    align-items: center;
    text-align: left;
    border: 0;
    border-radius: 0.38rem;
    background: transparent;
    color: var(--agent-muted);
    font-size: 0.76rem;
  }
  .agent-wiki-pages button:hover {
    color: var(--c-text);
    background: transparent;
  }
  .agent-wiki-pages button.is-active {
    color: var(--c-text);
    background: transparent;
    box-shadow: none;
  }
  .agent-wiki-pages button span {
    font-family: ui-monospace, monospace;
    font-size: 0.64rem;
    color: var(--c-text-muted);
    line-height: 1.35;
  }
  .agent-wiki-pages button.is-active span {
    color: var(--c-text);
  }
  .agent-wiki-pages button strong {
    font-weight: 540;
    line-height: 1.35;
  }
  .agent-nav-repo-card {
    margin-top: 1.25rem;
    padding: 0.9rem;
    border-top: 1px solid var(--agent-line);
    display: grid;
    gap: 0.35rem;
  }
  .agent-nav-repo-card > span {
    font-size: 0.66rem;
    color: var(--agent-muted);
  }
  .agent-nav-repo-card > strong {
    font-size: 0.78rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .agent-nav-repo-card > small {
    color: var(--agent-muted);
    font-size: 0.68rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .agent-nav-repo-card > div {
    margin-top: 0.3rem;
    display: flex;
    gap: 0.65rem;
    color: var(--agent-muted);
    font-size: 0.67rem;
  }
  .agent-nav-repo-card > div span {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .agent-wiki-main {
    min-width: 0;
    padding: 2.65rem clamp(2rem, 3.2vw, 3rem) 9rem;
    border-right: 1px solid var(--agent-line);
    overflow-x: clip;
  }
  .agent-reader-status {
    min-height: 2rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--agent-muted);
    font-size: 0.75rem;
  }
  .agent-reader-status[data-kind='error'] {
    color: var(--c-text);
    font-weight: 600;
  }
  .agent-pulse {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--c-text);
    animation: agent-pulse 1.2s ease-in-out infinite;
  }
  @keyframes agent-pulse {
    50% {
      opacity: 0.2;
      transform: scale(0.76);
    }
  }
  .agent-wiki-article {
    min-width: 0;
    max-width: none;
    color: var(--c-text);
  }
  .agent-wiki-article > h1:first-child {
    margin-top: 0;
    padding-bottom: 0.08em;
    font-family: var(--font-article-title);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(2rem, 3vw, 2.55rem);
    line-height: 1.15;
  }
  .agent-wiki-article h2 {
    margin-top: 3rem;
    scroll-margin-top: 9rem;
    letter-spacing: -0.025em;
  }
  .agent-wiki-article h3 {
    margin-top: 2rem;
    scroll-margin-top: 9rem;
  }
  .agent-wiki-article p,
  .agent-wiki-article li {
    line-height: 1.82;
  }
  .agent-wiki-article img.agent-markdown-image,
  .agent-file-markdown img.agent-markdown-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto;
  }
  .agent-image-unavailable {
    min-height: 3.25rem;
    margin: 1.25rem 0;
    padding: 0.8rem 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px dashed var(--agent-line-strong);
    border-radius: 0.55rem;
    color: var(--agent-muted);
    font-size: 0.76rem;
  }
  .agent-image-unavailable > span:first-child {
    flex: 0 0 auto;
    font-size: 1rem;
  }
  .agent-wiki-article a,
  .agent-file-markdown a {
    color: inherit;
    border-bottom: 0 !important;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--c-text) 28%, transparent);
    text-underline-offset: 0.2em;
  }
  .agent-wiki-article a.agent-wiki-link,
  .agent-file-markdown a.agent-wiki-link {
    border-radius: 0.12em;
    color: var(--c-text);
    text-decoration: none;
    background-image: linear-gradient(
      90deg,
      var(--c-accent),
      var(--c-accent-strong)
    );
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 100% 1px;
    transition:
      color 180ms ease,
      background-size 260ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 180ms ease;
  }
  .agent-wiki-article a.agent-wiki-link:hover,
  .agent-wiki-article a.agent-wiki-link:focus-visible,
  .agent-file-markdown a.agent-wiki-link:hover,
  .agent-file-markdown a.agent-wiki-link:focus-visible {
    color: var(--c-accent-strong);
    background-color: color-mix(in srgb, var(--c-accent) 7%, transparent);
    background-size: 100% 2px;
  }
  .agent-wiki-article a.agent-wiki-link:focus-visible,
  .agent-file-markdown a.agent-wiki-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--c-accent) 46%, transparent);
    outline-offset: 0.18em;
  }
  .agent-wiki-article a.agent-file-reference,
  .agent-file-markdown a.agent-file-reference {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.08rem 0.34rem;
    border: 1px solid var(--agent-line);
    border-radius: 0.28rem;
    background: var(--agent-soft);
    font-family: var(--font-mono);
    font-size: 0.88em;
    text-decoration: none;
    cursor: pointer;
  }
  .agent-file-reference-icon {
    flex: none;
    width: 1em;
    height: 1em;
    /* 彩色图标是多色 mask/背景, 不能被父级 color 影响 */
    color: initial;
  }
  .agent-file-reference:hover {
    border-color: var(--agent-line-strong);
    background: color-mix(in srgb, var(--c-text) 8%, var(--c-bg));
  }
  .agent-wiki-article code:not(pre code) {
    border-radius: 0.35rem;
    background: var(--agent-soft);
    padding: 0.13em 0.35em;
  }
  .agent-wiki-article pre,
  .agent-file-markdown pre {
    border: 1px solid var(--agent-line);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--c-text) 4%, var(--c-bg));
  }
  .agent-source-files {
    margin: 0 0 2rem;
    padding: 0;
    border: 1px solid var(--agent-line);
    border-radius: 0.45rem;
    background: var(--agent-soft);
    overflow: hidden;
  }
  .agent-source-files summary {
    padding: 0.8rem 1rem;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 650;
  }
  .agent-source-files > *:not(summary) {
    margin-left: 1rem;
    margin-right: 1rem;
  }
  /* 源文件清单常有十几项, 默认单列竖排要滑很久:
     收成自适应多列, 并去掉项目符号与多余行距 */
  .agent-source-files > p {
    margin: 0 1rem 0.5rem;
    font-size: 0.78rem;
    color: var(--agent-muted);
  }
  .agent-source-files ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.3rem 0.7rem;
    margin: 0 1rem 1rem;
    padding: 0;
    list-style: none;
  }
  .agent-source-files li {
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .agent-source-files li::marker {
    content: none;
  }
  /* 正文通用列表会给 li 加一个灰色圆点, 这里每项自带类型图标,
     圆点属于重复信息, 去掉 */
  .agent-source-files li::before {
    content: none !important;
    display: none !important;
  }
  .agent-source-files li > a.agent-file-reference {
    max-width: 100%;
    font-size: 0.76rem;
  }
  .agent-source-files li .agent-file-reference-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .agent-article-skeleton {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.72rem;
    padding-top: 0.6rem;
  }
  .agent-article-skeleton span {
    height: 0.58rem;
    border-radius: 0.12rem;
    background: linear-gradient(
      90deg,
      var(--agent-soft),
      color-mix(in srgb, var(--c-text) 9%, var(--c-bg)),
      var(--agent-soft)
    );
    background-size: 220% 100%;
    animation: agent-shimmer 1.65s ease-in-out infinite;
  }
  .agent-article-skeleton span:first-child {
    width: min(28rem, 72%);
    height: 2.35rem;
    margin-bottom: 1.4rem;
  }
  .agent-article-skeleton span:nth-child(3) {
    width: 88%;
  }
  .agent-article-skeleton span:nth-child(5) {
    width: 72%;
  }
  .agent-article-skeleton span:nth-child(2) {
    width: 96%;
  }
  .agent-article-skeleton span:nth-child(4) {
    width: 82%;
    margin-bottom: 1.35rem;
  }
  .agent-article-skeleton span:nth-child(6) {
    width: 92%;
  }
  @keyframes agent-shimmer {
    to {
      background-position: -220% 0;
    }
  }
  .agent-wiki-error {
    min-height: 50vh;
    display: grid;
    place-items: center;
    align-content: center;
    text-align: center;
  }
  .agent-wiki-error > span {
    font-size: 2rem;
    color: var(--agent-muted);
  }
  .agent-wiki-error h2 {
    margin: 0.8rem 0 0;
  }
  .agent-wiki-error p {
    color: var(--agent-muted);
  }
  .agent-wiki-error button,
  .agent-wiki-error a {
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--agent-line);
    border-radius: 0.6rem;
    background: var(--c-text);
    color: var(--c-bg);
    text-decoration: none;
  }

  .agent-page-toc {
    position: sticky;
    top: calc(var(--navbar-height, 4rem) + var(--agent-reader-head));
    align-self: start;
    height: calc(100vh - var(--navbar-height, 4rem) - var(--agent-reader-head));
    padding: 2rem 1.2rem 7rem;
    overflow-y: auto;
  }
  .agent-page-toc-inner {
    display: grid;
  }
  .agent-page-toc-inner > strong {
    margin-top: 0.2rem;
    font-size: 0.82rem;
  }
  .agent-page-toc nav {
    margin-top: 1rem;
    display: grid;
    gap: 0.1rem;
    border-left: 1px solid var(--agent-line);
  }
  .agent-page-toc nav a {
    padding: 0.42rem 0.7rem;
    color: var(--agent-muted);
    font-size: 0.7rem;
    line-height: 1.4;
  }
  .agent-page-toc nav a[data-level='3'] {
    padding-left: 1.2rem;
    font-size: 0.66rem;
  }
  .agent-page-toc nav a:hover {
    color: var(--c-text);
  }
  .agent-page-toc nav p {
    padding-left: 0.7rem;
    color: var(--agent-muted);
    font-size: 0.68rem;
  }
  .agent-page-links {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--agent-line);
    display: grid;
    gap: 0.35rem;
  }
  .agent-page-links a,
  .agent-page-links button {
    min-height: 2rem;
    padding: 0.35rem 0.15rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 0;
    background: transparent;
    color: var(--agent-muted);
    font-size: 0.7rem;
    text-align: left;
  }
  .agent-page-links a:hover,
  .agent-page-links button:hover {
    color: var(--c-text);
  }

  .agent-atlas-scrim,
  .agent-mobile-scrim {
    position: fixed;
    inset: 0;
    border: 0;
    background: var(--c-scrim);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.26s ease;
  }
  .agent-atlas-scrim {
    z-index: 60;
  }
  .agent-mobile-scrim {
    z-index: 50;
  }
  .agent-atlas {
    --agent-atlas-width: min(70rem, 72vw);
    position: fixed;
    z-index: 70;
    inset: 0 0 0 auto;
    width: min(var(--agent-atlas-width), calc(100vw - 2rem));
    min-width: min(42.5rem, 100vw);
    display: flex;
    flex-direction: column;
    container: agent-atlas / inline-size;
    overflow: hidden;
    border-left: 0;
    background: var(--c-bg);
    box-shadow: -22px 0 72px var(--c-shadow-key);
    opacity: 0.98;
    transform: translate3d(102%, 0, 0);
    transition:
      transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.24s ease;
    will-change: transform;
  }
  .agent-knowledge[data-atlas-open='true'] .agent-atlas {
    opacity: 1;
    transform: none;
  }
  .agent-atlas:focus {
    outline: 0;
  }
  .agent-knowledge[data-atlas-open='true'] .agent-atlas-scrim {
    opacity: 1;
    pointer-events: auto;
  }
  .agent-knowledge[data-atlas-resizing='true'],
  .agent-knowledge[data-atlas-resizing='true'] * {
    cursor: col-resize !important;
    user-select: none !important;
  }
  .agent-knowledge[data-atlas-resizing='true'] .agent-atlas {
    transition: none;
  }
  .agent-atlas-resize {
    position: absolute;
    z-index: 8;
    inset: 0 auto 0 -0.5rem;
    width: 1rem;
    padding: 0;
    border: 0;
    background: transparent;
    touch-action: none;
    cursor: col-resize;
    outline: none;
  }
  .agent-atlas-resize::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0.45rem;
    width: 1px;
    background: transparent;
    transition: background 0.16s ease;
  }
  .agent-atlas-resize > span {
    position: absolute;
    top: 50%;
    left: 0.17rem;
    width: 0.62rem;
    height: 3.5rem;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-text) 16%, var(--c-bg));
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.12);
    opacity: 0;
    transform: translateY(-50%) scale(0.88);
    transition:
      opacity 0.16s ease,
      transform 0.16s ease;
  }
  .agent-atlas-resize:hover::before,
  .agent-atlas-resize:focus-visible::before,
  .agent-knowledge[data-atlas-resizing='true'] .agent-atlas-resize::before {
    background: color-mix(in srgb, var(--c-text) 70%, var(--agent-line));
  }
  .agent-atlas-resize:hover > span,
  .agent-atlas-resize:focus-visible > span,
  .agent-knowledge[data-atlas-resizing='true'] .agent-atlas-resize > span {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }
  .agent-atlas-head,
  .agent-atlas-tabs,
  .agent-atlas-body {
    opacity: 0;
    translate: 0.75rem 0;
    transition:
      opacity 0.24s ease,
      translate 0.34s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .agent-knowledge[data-atlas-open='true']
    :is(.agent-atlas-head, .agent-atlas-tabs, .agent-atlas-body) {
    opacity: 1;
    translate: 0;
  }
  .agent-knowledge[data-atlas-open='true'] .agent-atlas-tabs {
    transition-delay: 35ms;
  }
  .agent-knowledge[data-atlas-open='true'] .agent-atlas-body {
    transition-delay: 70ms;
  }
  .agent-atlas-head {
    min-height: 4.6rem;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: color-mix(in srgb, var(--c-text) 2%, var(--c-bg));
