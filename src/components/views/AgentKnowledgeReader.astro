    async function highlightCode(source: string, language: string) {
      shikiLoader ??= import('shiki/bundle/full')
      const { codeToHtml } = await shikiLoader
      const candidates = [language, 'text']
      for (const candidate of candidates) {
        try {
          const html = await codeToHtml(source, {
            lang: candidate,
            themes: { light: 'vitesse-light', dark: 'vitesse-dark' },
            defaultColor: false,
          })
          const template = document.createElement('template')
          template.innerHTML = html
          const pre = template.content.querySelector('pre')
          if (!pre) continue
          pre.classList.add('agent-shiki-code')
          pre.querySelectorAll<HTMLElement>('.line').forEach((line, index) => {
            line.dataset.line = String(index + 1)
          })
          return template.innerHTML
        } catch {
          // Try the plain-text grammar next.
        }
      }
      return `<pre class="agent-code-fallback"><code>${escapeHtml(source)}</code></pre>`
    }

    async function decorateMarkdownCode(container: HTMLElement) {
      const blocks = [...container.querySelectorAll<HTMLPreElement>('pre')]
      for (const pre of blocks) {
        if (pre.closest('.agent-mermaid')) continue
        const code = pre.querySelector('code')
        const source = code?.textContent || pre.textContent || ''
        const languageClass = [...(code?.classList || [])].find((value) =>
          value.startsWith('language-')
        )
        const language = languageClass?.slice('language-'.length) || 'text'
        const compactedSource =
          language === 'text' && /[├└│]/.test(source)
            ? source
                .split('\n')
                .map((line) =>
                  line
                    .replace(/[ \t]{3,}(?=(?:#|←|→|\/\/))/, '  ')
                    .replace(/[ \t]+$/, '')
                )
                .join('\n')
            : source
        const wrapper = document.createElement('div')
        wrapper.className = 'agent-highlighted-block'
        wrapper.innerHTML = await highlightCode(
          compactedSource.replace(/\n+$/, ''),
          language
        )
        pre.replaceWith(wrapper)
      }
    }
    function renderToc() {
      const toc = get<HTMLElement>('[data-page-toc]')
      if (!toc) return
      tocObserver?.disconnect()
      tocObserver = null
      tocTrackObserver?.disconnect()
      tocTrackObserver = null
      const headings = [...wikiContent.querySelectorAll<HTMLElement>('h2, h3')]
      headings.forEach((heading, index) => {
        heading.id ||= `section-${index + 1}-${slug(heading.textContent || '')}`
      })
      const linksMarkup = headings
        .map(
          (heading) =>
            `<a href="#${escapeHtml(heading.id)}" data-toc-target="${escapeHtml(heading.id)}" data-level="${heading.tagName === 'H3' ? '3' : '2'}"><span>${escapeHtml(heading.textContent || '')}</span></a>`
        )
        .join('')
      toc.innerHTML = headings.length
        ? `<div class="agent-toc-list" data-toc-list>
            <svg xmlns="http://www.w3.org/2000/svg" class="agent-toc-track agent-toc-track-base" data-toc-track-base aria-hidden="true" focusable="false"><path fill="none" vector-effect="non-scaling-stroke"></path></svg>
            <svg xmlns="http://www.w3.org/2000/svg" class="agent-toc-track agent-toc-track-active" data-toc-track-active aria-hidden="true" focusable="false"><path fill="none" vector-effect="non-scaling-stroke"></path></svg>
            ${linksMarkup}
          </div>`
        : '<p>当前页面没有二级标题</p>'
      if (!headings.length) return

      const tocLinks = [
        ...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-target]'),
      ]
      const tocList = toc.querySelector<HTMLElement>('[data-toc-list]')
      const baseTrack = toc.querySelector<SVGSVGElement>(
        '[data-toc-track-base]'
      )
      const activeTrack = toc.querySelector<SVGSVGElement>(
        '[data-toc-track-active]'
      )
      const trackDepth = (link: HTMLAnchorElement) =>
        Math.max(0, Number(link.dataset.level || 2) - 2)
      const trackX = (link: HTMLAnchorElement) => 8.5 + trackDepth(link) * 12
      const syncActiveTrack = () => {
        if (!activeTrack) return
        const activeLink = tocLinks.find((link) =>
          link.classList.contains('is-active')
        )
        if (!activeLink) return
        const activeBottom =
          activeLink.offsetTop + Math.max(8, activeLink.offsetHeight - 12)
        activeTrack.style.setProperty('--toc-track-bottom', `${activeBottom}px`)
      }
      const renderTocTrack = () => {
        if (!tocList || !baseTrack || !activeTrack || !tocLinks.length) return
        const maxDepth = Math.max(...tocLinks.map(trackDepth))
        const width = 16.5 + maxDepth * 12
        const lastLink = tocLinks.at(-1)!
        const height = Math.max(1, lastLink.offsetTop + lastLink.offsetHeight)
        let path = `M ${trackX(tocLinks[0]!)} 0`
        tocLinks.forEach((link, index) => {
          const x = trackX(link)
          const bottom = link.offsetTop + link.offsetHeight
          const transitionTop = Math.max(link.offsetTop, bottom - 12)
          path += ` L ${x} ${transitionTop}`
          const nextLink = tocLinks[index + 1]
          path += nextLink
            ? ` L ${trackX(nextLink)} ${bottom}`
            : ` L ${x} ${bottom}`
        })
        ;[baseTrack, activeTrack].forEach((track) => {
          track.setAttribute('viewBox', `0 0 ${width} ${height}`)
          track.setAttribute('width', String(width))
          track.setAttribute('height', String(height))
          track.style.width = `${width}px`
          track.style.height = `${height}px`
          track.querySelector('path')?.setAttribute('d', path)
        })
        syncActiveTrack()
      }

      const setActiveToc = (id: string) => {
        tocLinks.forEach((link) => {
          const active = link.dataset.tocTarget === id
          link.classList.toggle('is-active', active)
          link.dataset.active = String(active)
          if (active) link.setAttribute('aria-current', 'location')
          else link.removeAttribute('aria-current')
        })
        syncActiveTrack()
      }
      setActiveToc(headings[0]?.id || '')
      requestAnimationFrame(renderTocTrack)
      if ('ResizeObserver' in window && tocList) {
        tocTrackObserver = new ResizeObserver(() =>
          requestAnimationFrame(renderTocTrack)
        )
        tocTrackObserver.observe(tocList)
        tocLinks.forEach((link) => tocTrackObserver?.observe(link))
      }
      if (!('IntersectionObserver' in window)) return
      tocObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort(
              (left, right) =>
                Math.abs(left.boundingClientRect.top) -
                Math.abs(right.boundingClientRect.top)
            )
          const active = visible[0]?.target
          if (active instanceof HTMLElement) setActiveToc(active.id)
        },
        { rootMargin: '-16% 0px -68% 0px', threshold: [0, 1] }
      )
      headings.forEach((heading) => tocObserver?.observe(heading))
    }
    function localizeGeneratedLabels(container: HTMLElement) {
      container.querySelectorAll('details > summary').forEach((summary) => {
        if (
          summary.textContent?.trim().toLowerCase() === 'relevant source files'
        )
          summary.textContent = '相关源文件'
      })
      container.querySelectorAll('strong').forEach((strong) => {
        if (strong.textContent?.trim().toLowerCase() === 'sources:')
          strong.textContent = '来源：'
      })
    }
    function normalizeMarkdownLinkDestinations(markdown: string) {
      // DeepWiki occasionally emits relative Markdown links whose repository
      // path contains spaces. CommonMark requires those spaces to be encoded;
      // otherwise the visible label and `(target)` are rendered separately.
      return markdown.replace(
        /\[([^\]\n]+)\]\(([^)\n]+)\)/g,
        (match, label: string, target: string) =>
          /\s/.test(target)
            ? `[${label}](${target.replace(/\s/g, '%20')})`
            : match
      )
    }
    function normalizeLooseMarkdown(markdown: string) {
      let insideFence = false
      const repairEmphasis = (value: string) =>
        value
          .split(/(`+[^`\n]*`+)/g)
          .map((segment) => {
            if (segment.startsWith('`')) return segment
            const markerBoundary =
              '(?=\\s|[，。！？、,.;:：；!?\uff09)\\]】]|$)'
            return segment
              .replace(
                new RegExp(`\\*\\*([^*\\n]+?)\\*${markerBoundary}`, 'g'),
                '**$1**'
              )
              .replace(
                new RegExp(
                  `(^|[\\s([{（【])\\*([^*\\n]+?)\\*\\*${markerBoundary}`,
                  'g'
                ),
                '$1**$2**'
              )
          })
          .join('')
      return markdown
        .replace(/\r\n?/g, '\n')
        .split('\n')
        .map((line) => {
          if (/^\s*(?:```|~~~)/.test(line)) {
            insideFence = !insideFence
            return line
          }
          if (insideFence) return line
          let normalized = repairEmphasis(
            line.replace(/^(\s*[-+*])(?=\S)/, '$1 ')
          )
          const strongMarkers = normalized.match(/\*\*/g)?.length || 0
          if (strongMarkers % 2 === 1) {
            normalized = normalized.replace(
              /^(\s*(?:[-+*]|\d+[.)])\s+)\*\*([^*\n]+?)(\s*[—–:：]\s*)/,
              '$1**$2**$3'
            )
          }
          return normalized
        })
        .join('\n')
    }
    async function renderMarkdown(
      container: HTMLElement,
      markdown: string,
      wiki = false,
      sourcePath = '',
      deferMermaid = false
    ) {
      const cleaned = normalizeLooseMarkdown(
        normalizeMarkdownLinkDestinations(
          markdown.replace(/^# Page:\s*.+\n+/i, '')
        )
      )
      container.innerHTML = DOMPurify.sanitize(await marked.parse(cleaned), {
        USE_PROFILES: { html: true },
        ADD_ATTR: ['target', 'rel'],
      })
      if (wiki) {
        rewriteWikiLinks(container, sourcePath)
        rewriteInlineFileReferences(container)
        localizeGeneratedLabels(container)
        container
          .querySelectorAll('details')
          .forEach((details) => details.classList.add('agent-source-files'))
      }
      if (deferMermaid) prepareMermaid(container)
      else await renderMermaid(container)
      await decorateMarkdownCode(container)
    }
    function updateDocumentUrl(title: string) {
      const url = repoPageUrl()
      if (title !== 'Overview') url.searchParams.set('doc', title)
      history.replaceState(
        history.state,
        '',
        `${url.pathname}${url.search}${url.hash}`
      )
    }
    function setActiveDocument(title: string) {
      getAll<HTMLElement>('[data-wiki-page]').forEach((element) => {
        element.classList.toggle(
          'is-active',
          element.dataset.wikiPage === title
        )
        if (element instanceof HTMLButtonElement)
          element.setAttribute(
            'aria-current',
            element.dataset.wikiPage === title ? 'page' : 'false'
          )
      })
    }
    async function loadWikiPage(title = 'Overview', updateUrl = true) {
      // sequence 守卫: 快速连点章节时, 只有最后一次请求允许写回 DOM 与状态
      const sequence = ++wikiLoadSequence
      currentPage = title
      setActiveDocument(title)
      showStatus(`正在读取“${title === 'Overview' ? 'Overview' : title}”…`)
      wikiContent.innerHTML =
        '<div class="agent-article-skeleton" role="status" aria-label="正在读取文档"><span></span><span></span><span></span><span></span><span></span><span></span></div>'
      try {
        const action = title === 'Overview' ? 'overview' : 'page'
        const page = await fetchWiki<{ markdown: string }>(action, { title })
        if (sequence !== wikiLoadSequence) return
        // Parse and decorate in a detached container. A quick chapter switch
        // can no longer let the previous request partially overwrite the new
        // article or leave half-prepared Mermaid/code nodes behind.
        const stagedContent = document.createElement('div')
        await renderMarkdown(stagedContent, page.markdown, true, '', true)
        if (sequence !== wikiLoadSequence) return
        wikiContent.replaceChildren(...Array.from(stagedContent.childNodes))
        await renderMermaid(wikiContent)
        if (sequence !== wikiLoadSequence) return
        renderToc()
        setSourceState('文档已就绪', true)
        hideStatus()
        if (updateUrl) updateDocumentUrl(title)
        setMobileNav(false)
        window.scrollTo({ top: 0, behavior: preferredScrollBehavior() })
      } catch (error) {
        if (sequence !== wikiLoadSequence) return
        const message = error instanceof Error ? error.message : '文档读取失败'
        wikiContent.innerHTML = `<div class="agent-wiki-error"><span class="i-ri-book-open-line"></span><h2>文档暂时没有生成完成</h2><p>${escapeHtml(message)}</p><button type="button" data-retry-wiki>重新读取</button></div>`
        showStatus('中文文档源暂时没有返回该章节。', 'error')
        renderToc()
      }
    }
    function renderWikiStructure(items: WikiItem[]) {
      wikiItems = items
      const pages = get<HTMLElement>('[data-wiki-pages]')
      const markup = items.length
        ? items
            .map(
              (item) =>
                `<button type="button" aria-label="${escapeHtml(`${item.id.replace(/\.+$/, '')}. ${item.title}`)}" data-wiki-page="${escapeHtml(item.title)}" data-search="${escapeHtml(`${item.id} ${item.title}`.toLowerCase())}" style="--depth:${Math.min(item.depth, 3)}"><span>${escapeHtml(item.id.replace(/\.+$/, ''))}.</span><strong>${escapeHtml(item.title)}</strong></button>`
            )
            .join('')
        : '<p class="agent-empty">暂无文档目录</p>'
      if (pages) pages.innerHTML = markup
      setActiveDocument(currentPage)
    }
    async function loadWikiStructure() {
      try {
        const response = await fetchWiki<{ items: WikiItem[] }>('structure')
        if (currentPage === 'Overview' && response.items[0]?.title)
          currentPage = response.items[0].title
        renderWikiStructure(response.items)
        rewriteWikiLinks(wikiContent)
        setSourceState('文档已就绪', true)
      } catch {
        renderWikiStructure([{ depth: 0, id: '1', title: 'Overview' }])
        setSourceState('本地索引', false)
      }
    }

    function importantFiles(items: TreeItem[]) {
      const score = (path: string) => {
        const value = path.toLowerCase()
        let points = 0
        if (
          /^(package\.json|pyproject\.toml|cargo\.toml|go\.mod|composer\.json)$/.test(
            value
          )
        )
          points += 100
        if (/(^|\/)src\/(index|main)\.[^/]+$/.test(value)) points += 90
        if (
          /(^|\/)(architecture|contributing|development|security)\.(md|mdx)$/i.test(
            path
          )
        )
          points += 80
        if (/(^|\/)readme\.(md|mdx)$/i.test(path)) points += 55
        if (/(^|\/)(index|main)\.[jt]sx?$/.test(value)) points += 45
        return points - path.split('/').length * 2
      }
      return items
        .filter((item) => item.type === 'blob')
        .map((item) => ({ item, score: score(item.path) }))
        .filter((entry) => entry.score > 20)
        .sort((a, b) => b.score - a.score)
        .slice(0, 10)
        .map((entry) => entry.item)
    }
    function renderAtlas(items: TreeItem[]) {
      const top = items
        .filter(
          (item) =>
            item.type === 'tree' &&
            !item.path.includes('/') &&
            !item.path.startsWith('.')
        )
        .slice(0, 12)
      const start = get<HTMLElement>('[data-start-files]')
      const summary = get<HTMLElement>('[data-atlas-summary]')
      const count = get<HTMLElement>('[data-tree-count]')
      const modules = items.filter((item) => item.type === 'tree').length
      const files = items.filter((item) => item.type === 'blob').length
      if (summary)
        summary.textContent = `当前索引覆盖 ${files} 个文件、${modules} 个目录与 ${top.length} 个顶层边界。`
      if (count) count.textContent = '正在分析 package.json…'
      const recommended = importantFiles(items)
      if (start)
        start.innerHTML = recommended.length
          ? recommended
              .map(
                (item, index) =>
                  `<button type="button" data-open-file="${escapeHtml(item.path)}"><span>${String(index + 1).padStart(2, '0')}</span>${materialIconMarkup(item.path)}<strong>${escapeHtml(item.path)}</strong><b class="i-ri-arrow-right-s-line"></b></button>`
              )
              .join('')
          : '<p class="agent-empty">暂无推荐入口文件</p>'
      buildTreeIndex(items)
      renderRepositoryTree()
      renderRepositoryDocs(items)
      void buildManifestGraph(items).catch(showManifestGraphError)
    }

    function buildTreeIndex(items: TreeItem[]) {
      treeChildren.clear()
      for (const item of items) {
        const parent = item.path.includes('/')
          ? item.path.slice(0, item.path.lastIndexOf('/'))
          : ''
        const children = treeChildren.get(parent) || []
        children.push(item)
        treeChildren.set(parent, children)
      }
      for (const children of treeChildren.values()) {
        children.sort((a, b) => {
          if (a.type !== b.type) return a.type === 'tree' ? -1 : 1
          return a.path.localeCompare(b.path)
        })
      }
    }

    function renderTreeLevel(parent: string): string {
      const children = treeChildren.get(parent) || []
      return children
        .map((item) => {
          const name = item.path.split('/').pop() || item.path
          if (item.type === 'tree') {
            const expanded = expandedFolders.has(item.path)
            return `<div class="agent-tree-entry is-directory" data-tree-entry="${escapeHtml(item.path)}"><button type="button" data-tree-folder="${escapeHtml(item.path)}" aria-expanded="${expanded}"><i class="agent-tree-chevron i-ri-arrow-right-s-line"></i>${materialIconMarkup(item.path, 'tree', expanded)}<strong>${escapeHtml(name)}</strong></button><div class="agent-tree-group" data-tree-group="${escapeHtml(item.path)}" ${expanded ? '' : 'hidden'}>${expanded ? renderTreeLevel(item.path) : ''}</div></div>`
          }
          return `<div class="agent-tree-entry is-file" data-tree-entry="${escapeHtml(item.path)}"><button type="button" data-entry-path="${escapeHtml(item.path)}" data-entry-type="file"><i class="agent-tree-spacer"></i>${materialIconMarkup(item.path)}<strong>${escapeHtml(name)}</strong></button></div>`
        })
        .join('')
    }

    function renderRepositoryTree() {
      fileList.innerHTML =
        renderTreeLevel('') || '<p class="agent-empty">仓库文件树为空</p>'
      if (currentFilePath)
        fileList
          .querySelector<HTMLElement>(
            `[data-tree-entry="${CSS.escape(currentFilePath)}"]`
          )
          ?.classList.add('is-active')
      fileList.dataset.loaded = 'true'
      observeFilePrefetchTargets(fileList)
      void loadCodeViewerModule().catch(() => undefined)
      const count = get<HTMLElement>('[data-file-count]')
      if (count)
        count.textContent = `${treeItems.length.toLocaleString('zh-CN')} 个条目`
    }

    function renderRepositoryDocs(items: TreeItem[]) {
      const docs = items
        .filter(
          (item) => item.type === 'blob' && /\.(md|mdx)$/i.test(item.path)
        )
        .filter(
          (item) =>
            /(^|\/)(readme|contributing|architecture|development|security|code_of_conduct|maintenance|changelog)[^/]*\.(md|mdx)$/i.test(
              item.path
            ) || /^(docs?|documentation)\//i.test(item.path)
        )
        .sort((a, b) => {
          const score = (path: string) => {
            let value = 0
            if (/^readme\.mdx?$/i.test(path)) value += 1000
            if (/(^|\/)readme\.mdx?$/i.test(path)) value += 500
            if (/^(docs?|documentation)\//i.test(path)) value += 180
            if (/(contributing|architecture|development|security)/i.test(path))
              value += 120
            return value - path.split('/').length * 10
          }
          return score(b.path) - score(a.path) || a.path.localeCompare(b.path)
        })
        .slice(0, 120)
      const target = get<HTMLElement>('[data-atlas-docs]')
      const count = get<HTMLElement>('[data-repository-doc-count]')
      if (count) count.textContent = `${docs.length} 份仓库文档`
      if (!target) return
      target.innerHTML = docs.length
        ? docs
            .map((item, index) => {
              const minutes = Math.max(1, Math.round((item.size || 900) / 3800))
              const kind = /readme/i.test(item.path)
                ? 'readme'
                : /contributing/i.test(item.path)
                  ? 'contributing'
                  : 'document'
              return `<button type="button" data-open-file="${escapeHtml(item.path)}"><span>${String(index + 1).padStart(2, '0')}</span>${materialIconMarkup(item.path)}<div><strong>${escapeHtml(item.path)}</strong><small><b>${kind}</b>约 ${minutes} 分钟</small></div><b class="i-ri-arrow-right-line"></b></button>`
            })
            .join('')
        : '<p class="agent-empty">当前代码库没有检索到 Markdown 文档</p>'
    }

    const encodeRepositoryPath = (value: string) =>
      value.split('/').map(encodeURIComponent).join('/')

    async function fetchRawRepositoryFile(path: string, ref: string) {
      const rawUrl = `https://raw.githubusercontent.com/${encodeURIComponent(owner)}/${encodeURIComponent(repoName)}/${encodeURIComponent(ref)}/${encodeRepositoryPath(path)}`
      const rawController = new AbortController()
      const abortRawRequest = () => rawController.abort()
      controller.signal.addEventListener('abort', abortRawRequest, {
        once: true,
      })
      const timeout = window.setTimeout(() => rawController.abort(), 3200)
      try {
        const response = await fetch(rawUrl, {
          cache: 'force-cache',
          headers: { Accept: 'text/plain' },
          signal: rawController.signal,
        })
        if (!response.ok) throw new Error('Raw 文件读取失败')
        const text = await response.text()
        return {
          type: 'file',
          name: path.split('/').pop() || path,
          path,
          content: null,
          downloadUrl: rawUrl,
          text,
        } satisfies FileResponse
      } finally {
        window.clearTimeout(timeout)
        controller.signal.removeEventListener('abort', abortRawRequest)
      }
    }

    async function requestRepositoryFile(path: string, ref: string) {
      if (isText(path)) {
        try {
          return await fetchRawRepositoryFile(path, ref)
        } catch (error) {
          if (controller.signal.aborted) throw error
        }
      }
      return fetchJson<FileResponse>(api('github', 'contents', { path, ref }))
    }

    async function fetchRepositoryFile(path: string, ref = activeRef) {
      const cacheKey = `${ref}:${path}`
      const cached = fileCache.get(cacheKey)
      if (cached) return cached
      const pending = fileRequestCache.get(cacheKey)
      if (pending) return pending
      const request = requestRepositoryFile(path, ref)
        .then((file) => {
          if (file.type !== 'file') throw new Error('这不是可读取的文件。')
          fileCache.set(cacheKey, file)
          return file
        })
        .finally(() => fileRequestCache.delete(cacheKey))
      fileRequestCache.set(cacheKey, request)
      return request
    }

    async function buildManifestGraph(items: TreeItem[]) {
      const indexedManifests = items.filter(
        (item) =>
          item.type === 'blob' &&
          /(^|\/)package\.json$/i.test(item.path) &&
          !item.path.includes('node_modules/')
      )
      const manifests = (
        indexedManifests.some((item) => item.path === 'package.json')
          ? indexedManifests
          : [
              { path: 'package.json', type: 'blob', size: null } as TreeItem,
              ...indexedManifests,
            ]
      )
        .sort((a, b) => {
          if (a.path === 'package.json') return -1
          if (b.path === 'package.json') return 1
          return (
            a.path.split('/').length - b.path.split('/').length ||
            a.path.localeCompare(b.path)
          )
        })
        .slice(0, 8)

      const count = get<HTMLElement>('[data-tree-count]')
      if (count) count.textContent = `发现 ${manifests.length} 份清单`

      // 分批拉取 (每批 4), 避免 monorepo 一次打出 20+ 个 GitHub API 请求触发限流
      const parseManifest = async (manifest: { path: string }) => {
        try {
          const file = await fetchRepositoryFile(manifest.path)
          const json = JSON.parse(
            file.content ? decodeBase64(file.content) : '{}'
          ) as Record<string, unknown>
          const dependencies = {
            ...((json.dependencies as Record<string, string>) || {}),
            ...((json.peerDependencies as Record<string, string>) || {}),
            ...((json.optionalDependencies as Record<string, string>) || {}),
          }
          return {
            id: manifest.path,
            name:
              typeof json.name === 'string'
                ? json.name
                : manifest.path === 'package.json'
                  ? repoName
                  : manifest.path.split('/').at(-2) || manifest.path,
            path: manifest.path,
            dependencyNames: Object.keys(dependencies),
          }
        } catch {
          return null
        }
      }
      type ParsedManifest = NonNullable<
        Awaited<ReturnType<typeof parseManifest>>
      >
      const parsed: ParsedManifest[] = []
      const softTimeout = <T,>(promise: Promise<T>, timeoutMs: number) =>
        new Promise<T | null>((resolve) => {
          let settled = false
          const timer = window.setTimeout(() => {
            if (settled) return
            settled = true
            resolve(null)
          }, timeoutMs)
          void promise.then(
            (value) => {
              if (settled) return
              settled = true
              window.clearTimeout(timer)
              resolve(value)
            },
            () => {
              if (settled) return
              settled = true
              window.clearTimeout(timer)
              resolve(null)
            }
          )
        })

      const renderParsed = async (partial: boolean) => {
        const names = new Map(parsed.map((item) => [item.name, item.id]))
        manifestNodes = parsed.map((item) => ({
          id: item.id,
          name: item.name,
          path: item.path,
          dependencies: item.dependencyNames
            .map((name) => names.get(name))
            .filter((value): value is string => Boolean(value)),
          incoming: [],
          workspace: item.path !== 'package.json',
        }))
        const byId = new Map(manifestNodes.map((node) => [node.id, node]))
        manifestNodes.forEach((node) =>
          node.dependencies.forEach((dependency) =>
            byId.get(dependency)?.incoming.push(node.id)
          )
        )
        const edgeCount = manifestNodes.reduce(
          (total, node) => total + node.dependencies.length,
          0
        )
        if (count) count.textContent = '数据就绪 · 正在绘制'
        await new Promise<void>((resolve) =>
          window.requestAnimationFrame(() => resolve())
        )
        await renderManifestGraph(manifestNodes)
        if (count)
          count.textContent = `${manifestNodes.length} 个项目 · ${edgeCount} 条关系${partial ? ' · 部分结果' : ''}`
      }

      let attempted = 0
      const startedAt = performance.now()
      for (let start = 0; start < manifests.length; start += 4) {
        if (performance.now() - startedAt > 8500) break
        const batch = await Promise.all(
          manifests
            .slice(start, start + 4)
            .map((manifest) => softTimeout(parseManifest(manifest), 4500))
        )
        attempted += batch.length
        parsed.push(
          ...batch.filter((item): item is ParsedManifest => Boolean(item))
        )
        if (count)
          count.textContent = `已读取 ${attempted}/${manifests.length} 份清单`

        // 首批数据可用后立即呈现，后续关系在后台补全，不让抽屉长期停在加载态。
        if (start === 0 && parsed.length && manifests.length > 4)
          await renderParsed(true)
      }

      await renderParsed(
        attempted < manifests.length || parsed.length < attempted
      )
    }

    async function renderManifestGraph(nodes: ManifestNode[]) {
      const canvas = get<HTMLElement>('[data-graph-canvas]')
      if (!canvas) return
      dependencyGraph?.destroy()
      dependencyGraph = null
      if (!nodes.length) {
        canvas.innerHTML =
          '<div class="agent-graph-empty"><span class="i-ri-node-tree"></span><strong>没有检测到 package.json</strong><p>当前仓库可能使用其他包管理格式，文件浏览器仍可正常使用。</p></div>'
        return
      }
      canvas.innerHTML = ''
      dependencyGraphLoader ??= import('./agent/AgentDependencyGraph').catch(
        (error) => {
          dependencyGraphLoader = null
          throw error
        }
      )
      const { mountAgentDependencyGraph } = await dependencyGraphLoader
      if (controller.signal.aborted) return
      dependencyGraph = mountAgentDependencyGraph(canvas, nodes, (id) =>
        showModuleDetail(id)
      )
      showModuleDetail(nodes[0]?.id || '')
    }

    function showManifestGraphError(error: unknown) {
      const count = get<HTMLElement>('[data-tree-count]')
      const graphCanvas = get<HTMLElement>('[data-graph-canvas]')
      if (count) count.textContent = '依赖图暂不可用'
      if (graphCanvas)
        graphCanvas.innerHTML =
          '<div class="agent-graph-empty"><span class="i-ri-error-warning-line"></span><strong>依赖图模块加载失败</strong><p>开发服务器的模块缓存可能刚刚更新，请重新加载依赖图。</p><button type="button" data-retry-graph><span class="i-ri-refresh-line"></span>重新加载</button></div>'
      console.warn('Dependency graph failed to load', error)
    }

    function fitGraph() {
      dependencyGraph?.fit()
    }

    function syncDependencyGraphFullscreen(map: HTMLElement) {
      const nativeFullscreen = document.fullscreenElement === map
      const fallbackFullscreen = map.classList.contains('is-fullscreen')
      const open = nativeFullscreen || fallbackFullscreen
      const button = map.querySelector<HTMLButtonElement>(
        '[data-graph-action="fullscreen"]'
      )
      button?.setAttribute('aria-pressed', String(open))
      button?.setAttribute(
        'aria-label',
        open ? '退出全屏依赖图' : '全屏查看依赖图'
      )
      const icon = button?.querySelector<HTMLElement>('span')
      icon?.classList.toggle('i-ri-fullscreen-line', !open)
      icon?.classList.toggle('i-ri-fullscreen-exit-line', open)
      syncGraphDocumentLock()
      window.setTimeout(fitGraph, 80)
    }

    async function toggleDependencyGraphFullscreen(map: HTMLElement) {
      try {
        if (document.fullscreenElement === map) {
          await document.exitFullscreen()
          return
        }
        if (document.fullscreenElement) await document.exitFullscreen()
        if (map.requestFullscreen) {
          await map.requestFullscreen()
          return
        }
      } catch {
        // Fall back to the fixed-position mode below when native fullscreen is
        // unavailable (for example inside a restricted embedded browser).
      }
      map.classList.toggle('is-fullscreen')
      syncDependencyGraphFullscreen(map)
    }

    function showModuleDetail(id: string, focus = false) {
      const node = manifestNodes.find((entry) => entry.id === id)
      const target = get<HTMLElement>('[data-module-detail]')
      if (!node || !target) return
      const byId = new Map(manifestNodes.map((entry) => [entry.id, entry.name]))
      target.hidden = false
      target.innerHTML = `<div><h3>${escapeHtml(node.name)}</h3><span>${escapeHtml(node.path.replace(/\/package\.json$/, '') || '/')}</span></div><div><span>它依赖</span><p>${node.dependencies.length ? node.dependencies.map((item) => `<button type="button" data-graph-node="${escapeHtml(item)}">${escapeHtml(byId.get(item) || item)}</button>`).join('') : '—'}</p></div><div><span>依赖它</span><p>${node.incoming.length ? node.incoming.map((item) => `<button type="button" data-graph-node="${escapeHtml(item)}">${escapeHtml(byId.get(item) || item)}</button>`).join('') : '—'}</p></div><button type="button" data-open-file="${escapeHtml(node.path)}">打开 package.json<span class="i-ri-arrow-right-line"></span></button>`
      getAll<HTMLElement>('[data-graph-node]').forEach((element) =>
        element.classList.toggle('is-active', element.dataset.graphNode === id)
      )
      dependencyGraph?.select(id, focus)
    }

    async function loadGitHub() {
      const overview = await fetchJson<{ repo: RepoMeta }>(
        api('github', 'overview')
      )
      applyMeta(overview.repo)
      const tree = await fetchJson<{ items: TreeItem[] }>(
        api('github', 'tree', { ref: overview.repo.defaultBranch })
      )
      treeItems = tree.items
      renderAtlas(tree.items)
      if (requestedFile) {
        setAtlas(true)
        activateAtlasTab('files')
        await loadFile(requestedFile, false, requestedLine, requestedColumn)
      }
    }

    const handleGitHubError = (error: unknown) => {
      const graphCount = get<HTMLElement>('[data-tree-count]')
      const graphCanvas = get<HTMLElement>('[data-graph-canvas]')
      if (graphCount) graphCount.textContent = '仓库结构读取失败'
      if (graphCanvas)
        graphCanvas.innerHTML =
          '<div class="agent-graph-empty"><span class="i-ri-error-warning-line"></span><strong>暂时无法读取仓库结构</strong><p>文档仍可继续阅读，也可以现在重新读取。</p><button type="button" data-retry-github><span class="i-ri-refresh-line"></span>重新读取</button></div>'
      showStatus(
        error instanceof Error ? error.message : '仓库信息加载失败。',
        'error'
      )
    }

    function activateAtlasTab(tab: 'overview' | 'docs' | 'files') {
      getAll<HTMLButtonElement>('[data-atlas-tab]').forEach((button) => {
        const active = button.dataset.atlasTab === tab
        button.classList.toggle('is-active', active)
        button.setAttribute('aria-selected', String(active))
        button.tabIndex = active ? 0 : -1
      })
      getAll<HTMLElement>('[data-atlas-panel]').forEach((panel) => {
        const active = panel.dataset.atlasPanel === tab
        const wasHidden = panel.hidden
        panel.hidden = !active
        if (active && wasHidden && !reduceMotionMedia.matches) {
          panel.getAnimations().forEach((animation) => animation.cancel())
          panel.animate(
            [
              { opacity: 0, transform: 'translateY(7px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            {
              duration: 220,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            }
          )
        }
      })
      if (
        tab === 'files' &&
        fileList.dataset.loaded !== 'true' &&
        treeItems.length
      )
        renderRepositoryTree()
      if (tab === 'files') {
        void loadCodeViewerModule().catch(() => undefined)
        if (currentFilePath)
          window.requestAnimationFrame(() => revealTreePath(currentFilePath))
      }
    }
    function setAtlas(open: boolean) {
      const wasOpen = root.dataset.atlasOpen === 'true'
      if (open && !wasOpen && document.activeElement instanceof HTMLElement)
        atlasReturnFocus = document.activeElement
      if (open) setMobileNav(false, false)
      root.dataset.atlasOpen = String(open)
      atlas.setAttribute('aria-hidden', String(!open))
      atlas.toggleAttribute('inert', !open)
      atlasScrim.setAttribute('aria-hidden', String(!open))
      setAtlasBackgroundInert(open)
      getAll<HTMLButtonElement>('[data-atlas-launch]').forEach((button) =>
        button.setAttribute('aria-expanded', String(open))
      )
      document.documentElement.classList.toggle('agent-atlas-lock', open)
      if (open && !wasOpen)
        window.requestAnimationFrame(() => atlas.focus({ preventScroll: true }))
      if (!open) {
        const map = get<HTMLElement>('[data-repo-map]')
        if (document.fullscreenElement === map) void document.exitFullscreen()
        map?.classList.remove('is-fullscreen')
        document.documentElement.classList.remove('agent-graph-lock')
        if (wasOpen) {
          const returnTarget = atlasReturnFocus
          atlasReturnFocus = null
          const fallback = getAll<HTMLButtonElement>(
            '[data-atlas-launch]'
          ).find((button) => button.getClientRects().length > 0)
          const focusTarget =
            returnTarget &&
            returnTarget !== document.body &&
            returnTarget.isConnected
              ? returnTarget
              : fallback
          window.requestAnimationFrame(() =>
            focusTarget?.focus({ preventScroll: true })
          )
        }
      }
    }
    function toggleTreeFolder(button: HTMLButtonElement, force?: boolean) {
      const path = button.dataset.treeFolder || ''
      const entry = button.closest<HTMLElement>('.agent-tree-entry')
      const group = entry?.querySelector<HTMLElement>(
        ':scope > [data-tree-group]'
      )
      if (!path || !group) return
      const open = force ?? button.getAttribute('aria-expanded') !== 'true'
      const wasOpen = button.getAttribute('aria-expanded') === 'true'
      if (open === wasOpen) return
      button.setAttribute('aria-expanded', String(open))
      const folderImage = button.querySelector<HTMLImageElement>(
        ':scope > .agent-material-icon'
      )
      if (folderImage) folderImage.src = materialIconFor(path, 'tree', open)
      if (open) {
        expandedFolders.add(path)
        if (!group.dataset.rendered) {
          group.innerHTML = renderTreeLevel(path)
          group.dataset.rendered = 'true'
          observeFilePrefetchTargets(group)
        }
        group.getAnimations().forEach((animation) => animation.cancel())
        group.hidden = false
        if (!reduceMotionMedia.matches)
          group.animate(
            [
              { opacity: 0, transform: 'translateY(-4px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            { duration: 170, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
          )
      } else {
        expandedFolders.delete(path)
        group.getAnimations().forEach((animation) => animation.cancel())
        if (reduceMotionMedia.matches) group.hidden = true
        else {
          const animation = group.animate(
            [
              { opacity: 1, transform: 'translateY(0)' },
              { opacity: 0, transform: 'translateY(-3px)' },
            ],
            { duration: 130, easing: 'ease', fill: 'forwards' }
          )
          void animation.finished
            .then(() => {
              if (button.getAttribute('aria-expanded') !== 'true')
                group.hidden = true
            })
            .catch(() => undefined)
        }
      }
    }

    function revealTreePath(path: string) {
      if (!fileList.dataset.loaded) renderRepositoryTree()
      const segments = path.split('/').slice(0, -1)
      let current = ''
      for (const segment of segments) {
        current = current ? `${current}/${segment}` : segment
        const button = fileList.querySelector<HTMLButtonElement>(
          `[data-tree-folder="${CSS.escape(current)}"]`
        )
        if (button && button.getAttribute('aria-expanded') !== 'true')
          toggleTreeFolder(button, true)
      }
      getAll<HTMLElement>('[data-tree-entry]').forEach((entry) => {
        entry.classList.toggle('is-active', entry.dataset.treeEntry === path)
      })
      fileList
        .querySelector<HTMLElement>(`[data-tree-entry="${CSS.escape(path)}"]`)
        ?.scrollIntoView({ block: 'nearest' })
    }

    const isText = (path: string) =>
      /\.(md|mdx|txt|js|jsx|mjs|cjs|ts|tsx|astro|css|scss|less|html|vue|svelte|jsonc?|ya?ml|toml|xml|svg|py|rb|php|java|kt|kts|go|rs|swift|c|h|cpp|hpp|cs|sh|bash|zsh|sql|graphql|gql|env|gitignore|dockerfile)$/i.test(
        path
      ) ||
      /(^|\/)\.env(?:\.[^/]+)?$/i.test(path) ||
      /(^|\/)\.(?:dockerignore|gitignore|gitattributes|gitkeep|npmrc|yarnrc|nvmrc|editorconfig|prettierignore|eslintignore|stylelintignore|semgrepignore|tool-versions)$/i.test(
        path
      ) ||
      !path.split('/').pop()?.includes('.')

    function drainFilePrefetchQueue() {
      while (activeFilePrefetches < 3 && filePrefetchQueue.length) {
        const next = filePrefetchQueue.shift()
        if (!next) return
        const cacheKey = `${next.ref}:${next.path}`
        if (fileCache.has(cacheKey) || fileRequestCache.has(cacheKey)) {
          queuedFilePrefetches.delete(cacheKey)
          continue
        }
        activeFilePrefetches += 1
        void fetchRepositoryFile(next.path, next.ref)
          .catch(() => undefined)
          .finally(() => {
            activeFilePrefetches -= 1
            queuedFilePrefetches.delete(cacheKey)
            drainFilePrefetchQueue()
          })
      }
    }

    function queueFilePrefetch(path: string, ref = activeRef) {
      if (!path || !isText(path) || controller.signal.aborted) return
      const cacheKey = `${ref}:${path}`
      if (
        fileCache.has(cacheKey) ||
        fileRequestCache.has(cacheKey) ||
        queuedFilePrefetches.has(cacheKey)
      )
        return
      queuedFilePrefetches.add(cacheKey)
      filePrefetchQueue.push({ path, ref })
      drainFilePrefetchQueue()
    }

    function observeFilePrefetchTargets(scope: ParentNode) {
      if (!('IntersectionObserver' in window)) return
      filePrefetchObserver ??= new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            const target = entry.target as HTMLElement
            filePrefetchObserver?.unobserve(target)
            queueFilePrefetch(target.dataset.entryPath || '')
          }
        },
        { root: fileList, rootMargin: '180px 0px' }
      )
      scope
        .querySelectorAll<HTMLElement>(
          '[data-entry-path][data-entry-type="file"]'
        )
        .forEach((target) => filePrefetchObserver?.observe(target))
    }

    function hideCodeViewer() {
      fileContent.classList.remove('is-code-viewer')
    }

    function clearFileNotice() {
      window.clearTimeout(fileFeedbackTimer)
      delete fileContent.dataset.loadNotice
      delete fileContent.dataset.loadNoticeLabel
    }

    function showFileNotice(message: string) {
      clearFileNotice()
      fileContent.dataset.loadNotice = 'true'
      fileContent.dataset.loadNoticeLabel = message
      fileFeedbackTimer = window.setTimeout(clearFileNotice, 3600)
    }

    function syncFileHeader(path: string, ref: string) {
      const breadcrumb = get<HTMLElement>('[data-file-breadcrumb]')
      const icon = get<HTMLImageElement>('[data-file-icon]')
      const github = get<HTMLAnchorElement>('[data-file-github]')
      if (breadcrumb) breadcrumb.textContent = path
      if (icon) {
        icon.src = materialIconFor(path)
        icon.hidden = false
      }
      if (github) {
        github.href = githubUrl(
          `/blob/${encodeURIComponent(ref)}/${path.split('/').map(encodeURIComponent).join('/')}`
        )
        github.hidden = false
      }
    }

    function loadCodeViewerModule() {
      codeViewerLoader ??= import('./agent/agent-code-viewer').catch(
        (error) => {
          codeViewerLoader = null
          throw error
        }
      )
      return codeViewerLoader
    }

    async function showCodeFile(
      path: string,
      source: string,
      language: string,
      stateKey: string,
      sequence: number
    ) {
      if (!codeViewerHost) {
        codeViewerHost = document.createElement('div')
        codeViewerHost.className = 'agent-code-host'
        codeViewerHost.dataset.codeHost = ''
      }
      if (!codeViewer) {
        const { mountAgentCodeViewer } = await loadCodeViewerModule()
        if (controller.signal.aborted || sequence !== fileLoadSequence)
          return false
        if (codeViewerHost.parentElement !== fileContent)
          fileContent.replaceChildren(codeViewerHost)
        fileContent.classList.add('is-code-viewer')
        codeViewer = mountAgentCodeViewer(codeViewerHost, currentTheme)
      }
      if (controller.signal.aborted || sequence !== fileLoadSequence)
        return false
      if (codeViewerHost.parentElement !== fileContent)
        fileContent.replaceChildren(codeViewerHost)
      fileContent.classList.add('is-code-viewer')
      codeViewer.showFile(stateKey || path, source, language, path)
      return true
    }

    function revealFileLine(line: number, column = 0) {
      if (!line) return
      if (
        codeViewer &&
        codeViewerHost?.parentElement === fileContent &&
        fileContent.classList.contains('is-code-viewer')
      )
        codeViewer.revealLine(line, column || 1)
      else
        fileContent
          .querySelector<HTMLElement>(`.line[data-line="${line}"]`)
          ?.scrollIntoView({ block: 'center' })
    }

    async function loadFile(
      path: string,
      updateHistory = true,
      line = 0,
      column = 0
    ) {
      if (!path) return
      clearFileNotice()
      const sequence = ++fileLoadSequence
      const fileRef = activeRef
      const fileKey = `${fileRef}:${path}`
      const cachedFile = fileCache.get(fileKey)
      const sourceView =
        isText(path) && (!/\.(md|mdx)$/i.test(path) || line > 0)
      const desiredView = sourceView ? 'source' : 'preview'
      setAtlas(true)
      activateAtlasTab('files')
      if (fileSearch.value.trim()) {
        window.clearTimeout(fileSearchTimer)
        fileSearch.value = ''
        renderRepositoryTree()
      }
      revealTreePath(path)
      syncFileHeader(path, fileRef)
      const renderedLines = Number(fileContent.dataset.renderedLines || 0)
      if (
        currentFileKey === fileKey &&
        fileContent.dataset.ready === 'true' &&
        fileContent.dataset.viewMode === desiredView &&
        (!line || desiredView !== 'source' || renderedLines >= line)
      ) {
        revealFileLine(line, column)
        if (updateHistory && line)
          history.replaceState(
            history.state,
            '',
            `${repoFileUrl(path, fileRef)}#L${line}${column ? `C${column}` : ''}`
          )
        return
      }
      if (!cachedFile && !currentFilePath)
        fileContent.innerHTML =
          '<div class="agent-list-skeleton"><span></span><span></span><span></span></div>'
      // 首次进入保留骨架反馈；之后切换文件时继续显示当前代码，
      // 取到新内容后直接替换，避免每次点击都闪一次 loading。
      fileContent.dataset.loading = String(!cachedFile && !currentFilePath)
      fileContent.dataset.ready = 'false'
      try {
        const file = cachedFile || (await fetchRepositoryFile(path, fileRef))
        if (sequence !== fileLoadSequence) return
        if (!file.content && file.text == null) {
          hideCodeViewer()
          fileContent.innerHTML =
            '<div class="agent-file-empty"><span class="i-ri-file-download-line"></span><h3>这个文件不适合在线预览</h3><p>文件可能过大或使用了二进制格式。</p></div>'
        } else {
          const text = file.text ?? decodeBase64(file.content || '')
          if (/\.(md|mdx)$/i.test(path) && !sourceView) {
            const article = document.createElement('article')
            article.className = 'agent-file-markdown prose'
            await renderMarkdown(article, text, true, path)
            if (sequence !== fileLoadSequence) return
            hideCodeViewer()
            fileContent.replaceChildren(article)
          } else if (
            /\.(png|jpe?g|gif|webp|svg)$/i.test(path) &&
            file.downloadUrl
          ) {
            hideCodeViewer()
            fileContent.innerHTML = `<figure class="agent-file-image"><img src="${escapeHtml(file.downloadUrl)}" alt="${escapeHtml(file.name)}"><figcaption>${escapeHtml(path)}</figcaption></figure>`
          } else if (isText(path)) {
            const lines = text.split('\n')
            const renderedLineCount = Math.min(
              lines.length,
              Math.max(1800, line ? line + 200 : 0)
            )
            const source = lines.slice(0, renderedLineCount).join('\n')
            const rendered = await showCodeFile(
              path,
              source,
              languageForPath(path),
              `${fileKey}:${renderedLineCount}`,
              sequence
            )
            if (!rendered) return
            fileContent.dataset.renderedLines = String(renderedLineCount)
            fileContent.dataset.truncated = String(
              lines.length > renderedLineCount
            )
            fileContent.dataset.truncatedLabel =
              lines.length > renderedLineCount
                ? `大文件已加载到第 ${renderedLineCount} 行`
                : ''
          } else {
            hideCodeViewer()
            fileContent.innerHTML = `<div class="agent-file-empty"><span class="i-ri-file-code-line"></span><h3>暂不支持预览这个文件</h3><p>${escapeHtml(path)}</p></div>`
          }
        }
        // renderMarkdown/showCodeFile 是长 await, 结束后须再次确认没有被更新的请求超过
        if (sequence !== fileLoadSequence) return
        currentFilePath = path
        currentFileKey = fileKey
        currentFileRef = fileRef
        fileContent.dataset.viewMode = desiredView
        fileContent.dataset.loading = 'false'
        fileContent.dataset.ready = 'true'
        revealFileLine(line, column)
        if (updateHistory)
          history.replaceState(
            history.state,
            '',
            `${repoFileUrl(path, fileRef)}${line ? `#L${line}${column ? `C${column}` : ''}` : ''}`
          )
      } catch {
        if (sequence !== fileLoadSequence || controller.signal.aborted) return
        fileContent.dataset.loading = 'false'
        if (currentFilePath) {
          activeRef = currentFileRef || activeRef
          syncFileHeader(currentFilePath, activeRef)
          revealTreePath(currentFilePath)
          fileContent.dataset.ready = 'true'
          showFileNotice('网络有波动，已保留当前文件')
          if (updateHistory)
            history.replaceState(
              history.state,
              '',
              repoFileUrl(currentFilePath, activeRef)
            )
          return
        }
        hideCodeViewer()
        fileContent.dataset.ready = 'false'
        fileContent.innerHTML = `<div class="agent-file-recovery" role="status"><span class="i-ri-cloud-off-line"></span><h3>这个文件暂时没加载出来</h3><p>已经自动重试过，你可以稍后继续。</p><button type="button" data-retry-file="${escapeHtml(path)}" data-retry-line="${line}" data-retry-column="${column}"><span class="i-ri-refresh-line"></span>重新加载</button></div>`
      }
    }
    async function searchTree(query: string) {
      const value = query.trim().toLowerCase()
      if (!value) {
        renderRepositoryTree()
        if (currentFilePath) revealTreePath(currentFilePath)
        return
      }
      const matches = treeItems
        .filter((item) => item.path.toLowerCase().includes(value))
        .slice(0, 100)
      fileList.innerHTML = matches.length
        ? matches
            .map(
              (item) =>
                `<button type="button" class="agent-search-result" ${item.type === 'tree' ? `data-search-folder="${escapeHtml(item.path)}"` : `data-entry-path="${escapeHtml(item.path)}" data-entry-type="file"`}>${materialIconMarkup(item.path, item.type)}<strong>${escapeHtml(item.path)}</strong></button>`
            )
            .join('')
        : '<p class="agent-empty">没有匹配的文件</p>'
      observeFilePrefetchTargets(fileList)
    }

    function prefetchFileFromTarget(target: EventTarget | null) {
      if (!(target instanceof Element)) return
      const trigger = target.closest<HTMLElement>(
        '[data-entry-path], [data-open-file]'
      )
      if (!trigger) return
      const path = trigger.dataset.entryPath || trigger.dataset.openFile || ''
      if (!path || !isText(path)) return
      queueFilePrefetch(path, trigger.dataset.fileRef || activeRef)
    }

    root.addEventListener(
      'pointerover',
      (event) => prefetchFileFromTarget(event.target),
      { signal: controller.signal }
    )
    root.addEventListener(
      'focusin',
      (event) => prefetchFileFromTarget(event.target),
      { signal: controller.signal }
    )

    root.addEventListener(
      'click',
      (event) => {
        const target = event.target as HTMLElement
        const launch = target.closest('[data-atlas-launch]')
        if (launch) {
          setAtlas(true)
          return
        }
        const close = target.closest('[data-atlas-close]')
        if (close) {
          setAtlas(false)
          return
        }
        const tab = target.closest<HTMLButtonElement>('[data-atlas-tab]')
        if (tab) {
          activateAtlasTab(
            tab.dataset.atlasTab as 'overview' | 'docs' | 'files'
          )
          return
        }
        const wiki = target.closest<HTMLElement>('[data-wiki-page]')
        if (wiki) {
          event.preventDefault()
          setAtlas(false)
          void loadWikiPage(wiki.dataset.wikiPage || 'Overview')
          return
        }
        const toc = target.closest<HTMLAnchorElement>('[data-toc-target]')
        if (toc) {
          event.preventDefault()
          document.getElementById(toc.dataset.tocTarget || '')?.scrollIntoView({
            behavior: preferredScrollBehavior(),
            block: 'start',
          })
          return
        }
        const diagram = target.closest<HTMLButtonElement>(
          '[data-diagram-action]'
        )
        if (diagram) {
          const figure = diagram.closest<HTMLElement>('.agent-mermaid')
          if (!figure) return
          if (diagram.dataset.diagramAction === 'fullscreen') {
            void toggleMermaidFullscreen(figure)
            return
          }
          if (diagram.dataset.diagramAction === 'retry') {
            const viewport = figure.querySelector<HTMLElement>(
              '.agent-mermaid-viewport'
            )
            if (viewport)
              viewport.innerHTML =
                '<div class="agent-mermaid-canvas"><div class="agent-diagram-loading" role="status" aria-label="正在重新绘制关系图"><span></span><span></span><span></span><em>正在重新绘制关系图</em></div></div>'
            void renderMermaid(root)
            return
          }
          const current = Number(figure.dataset.diagramScale || '1')
          const next =
            diagram.dataset.diagramAction === 'in'
              ? current + 0.1
              : diagram.dataset.diagramAction === 'out'
                ? current - 0.1
                : 1
          setMermaidScale(figure, next)
          return
        }
        const graphAction = target.closest<HTMLButtonElement>(
          '[data-graph-action]'
        )
        if (graphAction) {
          const action = graphAction.dataset.graphAction
          if (action === 'fit') fitGraph()
          else if (action === 'fullscreen') {
            const map = get<HTMLElement>('[data-repo-map]')
            if (map) void toggleDependencyGraphFullscreen(map)
          } else if (action === 'in') dependencyGraph?.zoomIn()
          else if (action === 'out') dependencyGraph?.zoomOut()
          return
        }
        if (target.closest('[data-retry-graph]')) {
          const count = get<HTMLElement>('[data-tree-count]')
          const graphCanvas = get<HTMLElement>('[data-graph-canvas]')
          if (count) count.textContent = '正在重新加载依赖图…'
          if (graphCanvas)
            graphCanvas.innerHTML =
              '<div class="agent-list-skeleton"><span></span><span></span><span></span></div>'
          void renderManifestGraph(manifestNodes).catch(showManifestGraphError)
          return
        }
        if (target.closest('[data-retry-github]')) {
          showStatus('正在重新读取仓库信息…')
          void loadGitHub().then(hideStatus).catch(handleGitHubError)
          return
        }
        const graphNode = target.closest<HTMLElement>('[data-graph-node]')
        if (graphNode) {
          showModuleDetail(graphNode.dataset.graphNode || '', true)
          return
        }
        const retryFile = target.closest<HTMLButtonElement>('[data-retry-file]')
        if (retryFile) {
          void loadFile(
            retryFile.dataset.retryFile || '',
            false,
            Number(retryFile.dataset.retryLine || 0),
            Number(retryFile.dataset.retryColumn || 0)
          )
          return
        }
        const treeFolder =
          target.closest<HTMLButtonElement>('[data-tree-folder]')
        if (treeFolder) {
          toggleTreeFolder(treeFolder)
          return
        }
        const searchFolder = target.closest<HTMLButtonElement>(
          '[data-search-folder]'
        )
        if (searchFolder) {
          fileSearch.value = ''
          renderRepositoryTree()
          const folderPath = searchFolder.dataset.searchFolder || ''
          const parts = folderPath.split('/')
          let current = ''
          for (const part of parts) {
            current = current ? `${current}/${part}` : part
            const button = fileList.querySelector<HTMLButtonElement>(
              `[data-tree-folder="${CSS.escape(current)}"]`
            )
            if (button) toggleTreeFolder(button, true)
          }
          return
        }
        const recommended = target.closest<HTMLElement>('[data-open-file]')
        if (recommended) {
          event.preventDefault()
          const ref = recommended.dataset.fileRef
          if (ref) activeRef = ref
          void loadFile(
            recommended.dataset.openFile || '',
            true,
            Number(recommended.dataset.fileLine || 0),
            Number(recommended.dataset.fileColumn || 0)
          )
          return
        }
        const entry = target.closest<HTMLButtonElement>('[data-entry-path]')
        if (entry) {
          void loadFile(entry.dataset.entryPath || '')
          return
        }
        if (target.closest('[data-collapse-tree]')) {
          expandedFolders.clear()
          renderRepositoryTree()
          return
        }
        if (target.closest('[data-first-document]')) {
          setAtlas(false)
          void loadWikiPage(wikiItems[0]?.title || 'Overview')
          return
        }
        if (target.closest('[data-mobile-nav]')) {
          setMobileNav(true)
          return
        }
        if (target.closest('[data-mobile-nav-close]')) {
          setMobileNav(false)
          return
        }
        if (target.closest('[data-retry-wiki]'))
          void loadWikiPage(currentPage, false)
      },
      { signal: controller.signal }
    )

    fileSearch.addEventListener(
      'input',
      () => {
        window.clearTimeout(fileSearchTimer)
        fileSearchTimer = window.setTimeout(
          () => void searchTree(fileSearch.value),
          160
        )
      },
      { signal: controller.signal }
    )
    root.addEventListener(
      'change',
      (event) => {
        const input =
          event.target instanceof HTMLInputElement &&
          event.target.matches('[data-diagram-scale]')
            ? event.target
            : null
        if (input) commitMermaidScaleInput(input)
      },
      { signal: controller.signal }
    )
    const docSearch = get<HTMLInputElement>('[data-doc-search]')
    const docSearchClear = get<HTMLButtonElement>('[data-doc-search-clear]')
    const docSearchEmpty = get<HTMLElement>('[data-doc-search-empty]')
    const filterDocumentTree = () => {
      const value = docSearch?.value.trim().toLowerCase() || ''
      let visible = 0
      getAll<HTMLElement>('[data-wiki-pages] [data-wiki-page]').forEach(
        (button) => {
          const matched =
            !value || (button.dataset.search || '').includes(value)
          button.hidden = !matched
          if (matched) visible += 1
        }
      )
      if (docSearchClear) docSearchClear.hidden = !value
      if (docSearchEmpty) docSearchEmpty.hidden = !value || visible > 0
    }
    docSearch?.addEventListener('input', filterDocumentTree, {
      signal: controller.signal,
    })
    docSearch?.addEventListener('search', filterDocumentTree, {
      signal: controller.signal,
    })
    docSearchClear?.addEventListener(
      'click',
      () => {
        if (!docSearch) return
        docSearch.value = ''
        filterDocumentTree()
        docSearch.focus()
      },
      { signal: controller.signal }
    )
    get<HTMLButtonElement>('[data-copy-command]')?.addEventListener(
      'click',
      async (event) => {
        const button = event.currentTarget as HTMLButtonElement
        if (!button.dataset.copy) return
        await navigator.clipboard.writeText(button.dataset.copy)
        const label = button.querySelector<HTMLElement>('[data-command-label]')!
        const previous = label.textContent
        label.textContent = '已复制'
        window.setTimeout(() => {
          label.textContent = previous
        }, 1300)
      },
      { signal: controller.signal }
    )
    document.addEventListener(
      'keydown',
      (event) => {
        const diagramScaleInput =
          event.target instanceof HTMLInputElement &&
          event.target.matches('[data-diagram-scale]')
            ? event.target
            : null
        if (diagramScaleInput && event.key === 'Enter') {
          event.preventDefault()
          commitMermaidScaleInput(diagramScaleInput)
          diagramScaleInput.select()
          return
        }
        const atlasTab =
          event.target instanceof HTMLElement
            ? event.target.closest<HTMLButtonElement>('[data-atlas-tab]')
            : null
        if (
          atlasTab &&
          ['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)
        ) {
          const tabs = getAll<HTMLButtonElement>('[data-atlas-tab]')
          const currentIndex = tabs.indexOf(atlasTab)
          const nextIndex =
            event.key === 'Home'
              ? 0
              : event.key === 'End'
                ? tabs.length - 1
                : (currentIndex +
                    (event.key === 'ArrowRight' ? 1 : -1) +
                    tabs.length) %
                  tabs.length
          const nextTab = tabs[nextIndex]
          if (nextTab) {
            event.preventDefault()
            activateAtlasTab(
              nextTab.dataset.atlasTab as 'overview' | 'docs' | 'files'
            )
            nextTab.focus()
          }
        }
        if (event.key === 'Tab' && root.dataset.mobileNavOpen === 'true') {
          const focusable = [
            ...wikiNav.querySelectorAll<HTMLElement>(
              'a[href], button:not([disabled]), input:not([disabled]), [tabindex="0"]'
            ),
          ].filter(
            (element) =>
              !element.hidden &&
              element.getAttribute('aria-hidden') !== 'true' &&
              element.getClientRects().length > 0
          )
          const first = focusable[0]
          const last = focusable.at(-1)
          if (
            first &&
            last &&
            (!wikiNav.contains(document.activeElement) ||
              (event.shiftKey
                ? document.activeElement === first
                : document.activeElement === last))
          ) {
            event.preventDefault()
            ;(event.shiftKey ? last : first).focus()
          }
        }
        if (event.key === 'Tab' && root.dataset.atlasOpen === 'true') {
          const focusable = [
            ...atlas.querySelectorAll<HTMLElement>(
              'a[href], button:not([disabled]), input:not([disabled]), [tabindex="0"]'
            ),
          ].filter(
            (element) =>
              !element.hidden &&
              element.getAttribute('aria-hidden') !== 'true' &&
              element.getClientRects().length > 0
          )
          const first = focusable[0]
          const last = focusable.at(-1)
          if (
            first &&
            last &&
            (!atlas.contains(document.activeElement) ||
              (event.shiftKey
                ? document.activeElement === first
                : document.activeElement === last))
          ) {
            event.preventDefault()
            ;(event.shiftKey ? last : first).focus()
          }
        }
        if (event.key === 'Escape') {
          const nativeDiagram =
            document.fullscreenElement instanceof HTMLElement &&
            document.fullscreenElement.matches('.agent-mermaid')
              ? document.fullscreenElement
              : null
          const fullscreenDiagram = root.querySelector<HTMLElement>(
            '.agent-mermaid.is-fullscreen'
          )
          if (nativeDiagram) void document.exitFullscreen()
          else if (fullscreenDiagram)
            setMermaidFullscreen(fullscreenDiagram, false)
          else if (root.dataset.atlasOpen === 'true') setAtlas(false)
          else setMobileNav(false)
        }
        if (
          event.key === '/' &&
          !(event.target instanceof HTMLInputElement) &&
          !(event.target instanceof HTMLTextAreaElement)
        ) {
          event.preventDefault()
          if (
            root.dataset.atlasOpen === 'true' &&
            get<HTMLElement>('[data-atlas-panel="files"]')?.hidden === false
          )
            fileSearch.focus()
          else get<HTMLInputElement>('[data-doc-search]')?.focus()
        }
      },
      { signal: controller.signal }
    )

    document.addEventListener(
      'fullscreenchange',
      () => {
        const map = get<HTMLElement>('[data-repo-map]')
        if (map) syncDependencyGraphFullscreen(map)
        getAll<HTMLElement>('.agent-mermaid').forEach((figure) =>
          syncMermaidFullscreen(figure)
        )
        syncGraphDocumentLock()
      },
      { signal: controller.signal }
    )

    const observer = new MutationObserver(() => {
      const dark = document.documentElement.classList.contains('dark')
      if (dark === currentTheme) return
      currentTheme = dark
      codeViewer?.setTheme(dark)
      void renderMermaid(root)
    })
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    })
    document.addEventListener(
      'astro:before-swap',
      () => observer.disconnect(),
      { once: true }
    )

    if (!repo || !owner || !repoName) {
      setSourceState('未连接', false)
      hideStatus()
      document.title = '未指定仓库 - Agent 知识库'
      const title = get<HTMLElement>('[data-repo-title]')
      if (title) title.textContent = '未指定仓库'
      const fullName = get<HTMLElement>('[data-repo-full-name]')
      if (fullName) fullName.textContent = '—'
      const repoDescription = get<HTMLElement>('[data-repo-description]')
      if (repoDescription)
        repoDescription.textContent = '从 Agent 目录进入仓库后展示'
      const pages = get<HTMLElement>('[data-wiki-pages]')
      if (pages) pages.innerHTML = '<p class="agent-empty">暂无文档目录</p>'
      wikiContent.innerHTML = `<div class="agent-wiki-error"><span class="i-ri-compass-3-line"></span><h2>仓库地址不完整</h2><p>该页面需要携带仓库信息访问, 请从 Agent 目录选择一个仓库进入。</p><a href="${agentBase}">返回 Agent 目录</a></div>`
      return
    }
    const requestedDocument =
      new URLSearchParams(location.search).get('doc') || 'Overview'
    void loadWikiStructure()
    void loadWikiPage(resolveWikiTitle(requestedDocument) || 'Overview', false)
    void loadGitHub().catch(handleGitHubError)
  }

  mountAgentKnowledge()
  document.addEventListener('astro:page-load', mountAgentKnowledge)
</script>

