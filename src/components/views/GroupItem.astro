---
import Link from '~/components/base/Link.astro'
import { UI } from '~/config'

export interface GroupItemData {
  id: string
  link: string
  desc: string
  icon: string
}

interface Props {
  items: GroupItemData[]
}

const { items } = Astro.props
const { maxGroupColumns, showGroupItemColorOnHover } = UI.groupView

// Helper function to check if icon is a URL
const isImageUrl = (icon: string) => /^https?:\/\//.test(icon)

const getLinkKind = (link: string) => {
  try {
    const hostname = new URL(link).hostname
    if (hostname === 'github.com' || hostname.endsWith('.github.com')) {
      return 'GitHub'
    }
    return '网站'
  } catch {
    return '链接'
  }
}
---

<div class="project-items-grid" style={`--project-columns:${maxGroupColumns};`}>
  {
    items.map((item) => (
      <Link
        class={`project-item-link group relative flex items-center
          px-3.5 pt-2 pb-3.5 rounded-md
          bg-transparent hover:bg-[#88888816]
          op-86! hover:op-100! text-4.4 transition-all duration-300`}
        href={item.link}
        title={`${item.id} - ${item.desc}`}
        external={true}
      >
        {isImageUrl(item.icon) ? (
          <img
            src={item.icon}
            alt={item.id}
            class="group-hover:data-[show-color]:saturate-100 op-65 saturate-0 w-15 h-15 object-contain mr-5 transition-all duration-300"
            data-show-color={showGroupItemColorOnHover ? '' : undefined}
          />
        ) : (
          <div
            class={`group-hover:data-[show-color]:saturate-100 op-65 saturate-0 leading-9 text-7.5 ${item.icon} w-15 h-15 mr-5 transition-all duration-300`}
            data-show-color={showGroupItemColorOnHover ? '' : undefined}
          />
        )}
        <div class="project-item-body flex-auto min-w-0">
          <div class="project-item-head">
            <span class="project-item-title">{item.id}</span>
            <span class="project-item-kind">{getLinkKind(item.link)}</span>
          </div>
          <div class="project-item-desc">{item.desc}</div>
        </div>
      </Link>
    ))
  }
</div>

<style>
  .project-items-grid {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    padding-block: 1.25rem;
    margin-inline: auto;
    grid-template-columns: repeat(var(--project-columns, 3), minmax(0, 1fr));
  }

  :global(.project-item-link) {
    position: relative;
    display: flex !important;
    align-items: center;
    min-height: 5.75rem;
    padding: 0.75rem 0.875rem 0.875rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--c-text-soft);
    min-width: 0;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease,
      transform var(--motion-fast) var(--ease-out-quart);
  }

  :global(.project-item-link:hover),
  :global(.project-item-link:focus-visible) {
    background: var(--c-surface-hover) !important;
    border-color: transparent;
    color: var(--c-text);
    transform: translateY(-1px);
  }

  :global(.project-item-link img),
  :global(.project-item-link > div[class*='i-']) {
    filter: saturate(0.42);
    opacity: 0.78;
  }

  :global(.project-item-link:nth-child(3n + 1) > div[class*='i-']) {
    color: var(--c-accent);
  }

  :global(.project-item-link:nth-child(3n + 2) > div[class*='i-']) {
    color: var(--c-accent-alt);
  }

  :global(.project-item-link:nth-child(3n) > div[class*='i-']) {
    color: var(--c-accent-gold);
  }

  :global(.project-item-link:hover img),
  :global(.project-item-link:focus-visible img),
  :global(.project-item-link:hover > div[class*='i-']),
  :global(.project-item-link:focus-visible > div[class*='i-']) {
    filter: saturate(1);
    opacity: 1;
  }

  .project-item-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .project-item-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
  }

  .project-item-kind {
    flex: none;
    border-left: 1px solid var(--c-border-soft);
    padding-left: 0.5rem;
    color: var(--c-text-faint);
    font-size: 0.675rem;
    line-height: 1.35;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  :global(.project-item-link:hover) .project-item-kind,
  :global(.project-item-link:focus-visible) .project-item-kind {
    color: var(--c-accent-strong);
  }

  :global(.project-item-link:active) {
    transform: translateY(0) scale(0.99);
  }

  .project-item-desc {
    margin-top: 0.15rem;
    color: var(--c-text-muted);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.45;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @media (max-width: 480px) {
    .project-items-grid {
      grid-template-columns: 1fr;
    }

    :global(.project-item-link) {
      align-items: flex-start !important;
      gap: 1rem;
      padding-inline: 0.75rem;
    }

    :global(.project-item-link img),
    :global(.project-item-link > div[class*='i-']) {
      width: 3.25rem;
      height: 3.25rem;
      margin-right: 0 !important;
      flex: none;
    }

    /* Keep title + kind badge on one line, description below,
       matching desktop hierarchy instead of stacking three rows. */
    .project-item-head {
      align-items: baseline;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
  }

  @media (min-width: 481px) and (max-width: 980px) {
    .project-items-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
