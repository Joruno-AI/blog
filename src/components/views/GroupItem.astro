---
import Link from '~/components/base/Link.astro'
import { UI } from '~/config'

export interface GroupItemData {
  id: string
  link: string
  desc: string
  icon: string
}

interface Props {
  items: GroupItemData[]
}

const { items } = Astro.props
const { maxGroupColumns, showGroupItemColorOnHover } = UI.groupView

// Helper function to check if icon is a URL
const isImageUrl = (icon: string) => /^https?:\/\//.test(icon)

const getLinkKind = (link: string) => {
  try {
    const hostname = new URL(link).hostname
    if (hostname === 'github.com' || hostname.endsWith('.github.com')) {
      return 'GitHub'
    }
    return 'Site'
  } catch {
    return 'Link'
  }
}
---

<div
  class={`project-items-grid grid gap-3
    py-5 mx-auto lt-lgp:max-w-[712px]! lt-md:max-w-full!`}
  style={`max-width: calc(350px * ${maxGroupColumns} + ${maxGroupColumns - 1} * 0.75rem);`}
>
  {
    items.map((item) => (
      <Link
        class={`project-item-link group relative flex items-center
          px-3.5 pt-2 pb-3.5 rounded-md
          bg-transparent hover:bg-[#88888816]
          op-86! hover:op-100! text-4.4 transition-all duration-300`}
        href={item.link}
        title={`${item.id} - ${item.desc}`}
        external={true}
      >
        {isImageUrl(item.icon) ? (
          <img
            src={item.icon}
            alt={item.id}
            class="group-hover:data-[show-color]:saturate-100 op-65 saturate-0 w-15 h-15 object-contain mr-5 transition-all duration-300"
            data-show-color={showGroupItemColorOnHover ? '' : undefined}
          />
        ) : (
          <div
            class={`group-hover:data-[show-color]:saturate-100 op-65 saturate-0 leading-9 text-7.5 ${item.icon} w-15 h-15 mr-5 transition-all duration-300`}
            data-show-color={showGroupItemColorOnHover ? '' : undefined}
          />
        )}
        <div class="project-item-body flex-auto min-w-0">
          <div class="project-item-head">
            <span class="project-item-title">{item.id}</span>
            <span class="project-item-kind">{getLinkKind(item.link)}</span>
          </div>
          <div class="project-item-desc">{item.desc}</div>
        </div>
      </Link>
    ))
  }
</div>

<style>
  .project-items-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }

  :global(.project-item-link) {
    border: 1px solid transparent;
    color: var(--c-text-soft);
    min-width: 0;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  :global(.project-item-link:hover),
  :global(.project-item-link:focus-visible) {
    background: var(--c-surface-hover) !important;
    border-color: var(--c-border-soft);
    color: var(--c-text);
    transform: translateY(-1px);
  }

  .project-item-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .project-item-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
  }

  .project-item-kind {
    flex: none;
    border: 1px solid var(--c-border-soft);
    border-radius: 999px;
    padding: 0.05rem 0.4rem;
    color: var(--c-text-faint);
    font-size: 0.675rem;
    line-height: 1.35;
    font-weight: 500;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  :global(.project-item-link:hover) .project-item-kind,
  :global(.project-item-link:focus-visible) .project-item-kind {
    border-color: var(--c-border-strong);
    color: var(--c-text-muted);
  }

  .project-item-desc {
    margin-top: 0.15rem;
    color: var(--c-text-muted);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.45;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @media (max-width: 480px) {
    :global(.project-item-link) {
      align-items: flex-start !important;
      gap: 1rem;
      padding-inline: 0.75rem;
    }

    :global(.project-item-link img),
    :global(.project-item-link > div[class*='i-']) {
      width: 3.25rem;
      height: 3.25rem;
      margin-right: 0 !important;
      flex: none;
    }

    /* Keep title + kind badge on one line, description below,
       matching desktop hierarchy instead of stacking three rows. */
    .project-item-head {
      align-items: baseline;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
  }
</style>
