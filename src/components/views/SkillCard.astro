---
import Link from '~/components/base/Link.astro'
import { withBasePath } from '~/utils/path'
import {
  CATEGORY_LABELS,
  INSTALLABLE_CATEGORIES,
  SECURITY_GRADES,
  formatCount,
  githubAvatar,
  installCommand,
} from '~/utils/skills'

import type { CollectionEntry } from 'astro:content'

interface Props {
  skill: CollectionEntry<'skills'>['data']
}

const { skill } = Astro.props

const detailPath = withBasePath(`/agent/${skill.id}/`)
const grade = SECURITY_GRADES[skill.securityGrade] ?? SECURITY_GRADES.unknown
const installable = INSTALLABLE_CATEGORIES.has(skill.category)
const displayDesc = skill.descZh || skill.desc
const searchText =
  `${skill.name} ${skill.author} ${skill.desc} ${skill.descZh} ${skill.keywords}`.toLowerCase()
---

<article
  class="skill-card"
  data-skill
  data-category={skill.category}
  data-stars={skill.stars}
  data-installs={skill.installs ?? 0}
  data-quality={skill.qualityScore}
  data-search={searchText}
  data-name={skill.name}
  data-author={skill.author}
  data-detail={detailPath}
>
  <div class="skill-card-head">
    <img
      class="skill-card-avatar"
      src={githubAvatar(skill.author, 96)}
      alt={skill.author}
      loading="lazy"
      decoding="async"
    />
    <div class="skill-card-title-group">
      <div class="skill-card-title-row">
        <Link class="skill-card-name" href={detailPath}>{skill.name}</Link>
        {skill.official && <span class="skill-card-official">官方</span>}
      </div>
      <span class="skill-card-author">{skill.author}</span>
    </div>
    <span
      class="skill-card-grade"
      title={`安全等级: ${grade.label}`}
      style={`--grade-color: ${grade.color}`}
    >
      {grade.label}
    </span>
  </div>

  <p class="skill-card-desc">{displayDesc || '暂无描述'}</p>

  <div class="skill-card-metrics">
    <span title={`${skill.stars} stars`}>
      <span class="i-ri-star-line" aria-hidden="true"></span>
      {formatCount(skill.stars)}
    </span>
    {
      skill.installs !== null && (
        <span title={`安装量 ${skill.installs}`}>
          <span class="i-ri-download-2-line" aria-hidden="true" />
          {formatCount(skill.installs)}
        </span>
      )
    }
    <span title={`质量分 ${skill.qualityScore}`}>
      <span class="i-ri-medal-line" aria-hidden="true"></span>
      {skill.qualityScore}
    </span>
    <span class="skill-card-category">{CATEGORY_LABELS[skill.category]}</span>
  </div>

  <div class="skill-card-foot">
    {
      installable ? (
        <button
          type="button"
          class="skill-card-install"
          data-copy={installCommand(skill.id)}
          title="复制安装命令"
        >
          <code>{installCommand(skill.id)}</code>
          <span
            class="i-ri-file-copy-line skill-card-copy-icon"
            aria-hidden="true"
          />
          <span
            class="i-ri-check-line skill-card-copied-icon"
            aria-hidden="true"
          />
        </button>
      ) : (
        <Link class="skill-card-repo" href={detailPath}>
          <span class="i-ri-book-open-line" aria-hidden="true" />
          <span>站内阅读</span>
        </Link>
      )
    }
    <Link
      class="skill-card-more"
      href={detailPath}
      title="查看详情"
      aria-label={`查看 ${skill.name} 详情`}
    >
      详情
      <span class="i-ri-arrow-right-line" aria-hidden="true"></span>
    </Link>
  </div>
</article>

<style>
  .skill-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.05rem;
    overflow: hidden;
    border: 1px solid var(--skills-border, var(--c-border-strong));
    border-radius: var(--skills-radius-lg, 0.75rem);
    background: var(--c-bg);
    transition:
      background 0.16s ease,
      border-color 0.16s ease,
      opacity 0.3s ease;
    cursor: pointer;
    min-width: 0;
  }

  .skill-card::before {
    content: none;
  }

  .skill-card:hover {
    border-color: var(--skills-border, var(--c-border-strong));
    background: var(--c-surface-soft);
  }

  .skill-card.is-hidden {
    display: none;
  }

  .skill-card-head {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }

  .skill-card-avatar {
    width: 2.55rem;
    height: 2.55rem;
    border: 1px solid var(--c-border-soft);
    border-radius: var(--skills-radius-sm, 0.375rem);
    background: var(--c-surface-soft);
    flex: none;
  }

  .skill-card-title-group {
    flex: auto;
    min-width: 0;
  }

  .skill-card-title-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }

  :global(.skill-card-name) {
    font-weight: 600;
    color: var(--c-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    opacity: 1 !important;
  }

  :global(.skill-card-name:hover) {
    text-decoration: underline;
  }

  .skill-card-official {
    flex: none;
    font-size: 0.65rem;
    padding: 0.05rem 0.4rem;
    border-radius: var(--skills-radius-sm, 0.375rem);
    border: 1px solid var(--skills-border, var(--c-border-soft));
    color: var(--c-text-muted);
  }

  .skill-card-author {
    display: block;
    font-size: 0.75rem;
    color: var(--c-text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .skill-card-grade {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    color: var(--c-text-muted);
  }

  .skill-card-grade::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--grade-color);
  }

  .skill-card-desc {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.65;
    color: var(--c-text-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 3.75rem;
    text-align: left;
    -webkit-line-clamp: 3;
  }

  .skill-card-metrics {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.68rem;
    color: var(--c-text-soft);
  }

  .skill-card-metrics > span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .skill-card-category {
    margin-left: auto;
    font-size: 0.68rem;
    color: var(--c-text-faint);
    border: 1px solid var(--skills-border, var(--c-border-soft));
    border-radius: var(--skills-radius-sm, 0.375rem);
    padding: 0.05rem 0.5rem;
  }

  .skill-card-foot {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--skills-border, var(--c-border-soft));
  }

  .skill-card-install {
    flex: auto;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--skills-border, var(--c-border-soft));
    border-radius: var(--skills-radius-sm, 0.375rem);
    background: var(--c-surface-soft);
    color: var(--c-text-soft);
    font-size: 0.65rem;
    cursor: copy;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .skill-card-install:hover {
    border-color: var(--c-border-strong);
    background: var(--c-surface-hover);
  }

  .skill-card-install code {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    font-size: 0.72rem;
  }

  .skill-card-install .skill-card-copied-icon {
    display: none;
    color: #22c55e;
  }

  .skill-card-install.is-copied .skill-card-copied-icon {
    display: inline-block;
  }

  .skill-card-install.is-copied .skill-card-copy-icon {
    display: none;
  }

  .skill-card-install > span {
    flex: none;
  }

  :global(.skill-card-repo) {
    flex: auto;
    display: inline-flex !important;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    border: 1px solid var(--skills-border, var(--c-border-soft));
    border-radius: var(--skills-radius-sm, 0.375rem);
    padding: 0 0.55rem;
    font-size: 0.65rem;
    color: var(--c-text-muted);
  }

  :global(.skill-card-more) {
    flex: none;
    margin-left: auto;
    display: inline-flex !important;
    align-items: center;
    gap: 0.2rem;
    min-height: 2rem;
    border: 1px solid var(--skills-border, var(--c-border-soft));
    border-radius: var(--skills-radius-sm, 0.375rem);
    padding: 0 0.55rem;
    font-size: 0.65rem;
    color: var(--c-text-muted);
  }

  :global(.skill-card-more:hover) {
    color: var(--c-text);
  }
</style>
