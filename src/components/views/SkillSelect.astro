---
interface SelectOption {
  value: string
  label: string
  icon?: string
  iconSrc?: string
}

interface Props {
  options: SelectOption[]
  value?: string
  ariaLabel: string
  dataAttribute?: string
  class?: string
}

const {
  options,
  value = options[0]?.value ?? '',
  ariaLabel,
  dataAttribute,
  class: className,
} = Astro.props
const current = options.find((option) => option.value === value) ?? options[0]
const nativeAttributes = dataAttribute ? { [dataAttribute]: '' } : {}
---

<skill-select
  class:list={['skill-select', className]}
  data-aria-label={ariaLabel}
>
  <select
    class="skill-select-native"
    aria-label={ariaLabel}
    {...nativeAttributes}
  >
    {
      options.map((option) => (
        <option value={option.value} selected={option.value === current.value}>
          {option.label}
        </option>
      ))
    }
  </select>

  <div class="skill-select-ui">
    <button
      class="skill-select-trigger"
      type="button"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label={`${ariaLabel}：${current.label}`}
      data-select-trigger
    >
      <span class="skill-select-current">
        <span class="skill-select-icon" data-current-icon>
          {
            current.iconSrc ? (
              <img src={current.iconSrc} alt="" />
            ) : current.icon ? (
              <span class={current.icon} aria-hidden="true" />
            ) : null
          }
        </span>
        <span data-current-label>{current.label}</span>
      </span>
      <span
        class="i-ri-arrow-down-s-line skill-select-chevron"
        aria-hidden="true"></span>
    </button>

    <div class="skill-select-menu" role="listbox" aria-label={ariaLabel}>
      {
        options.map((option) => (
          <button
            class="skill-select-option"
            type="button"
            role="option"
            aria-selected={option.value === current.value ? 'true' : 'false'}
            data-select-option={option.value}
          >
            <span class="skill-select-option-main">
              <span class="skill-select-icon" data-option-icon>
                {option.iconSrc ? (
                  <img src={option.iconSrc} alt="" />
                ) : option.icon ? (
                  <span class={option.icon} aria-hidden="true" />
                ) : null}
              </span>
              <span data-option-label>{option.label}</span>
            </span>
            <span
              class="i-ri-check-line skill-select-check"
              aria-hidden="true"
            />
          </button>
        ))
      }
    </div>
  </div>
</skill-select>

<script>
  class SkillSelectElement extends HTMLElement {
    private nativeSelect: HTMLSelectElement | null = null
    private trigger: HTMLButtonElement | null = null
    private menu: HTMLElement | null = null
    private options: HTMLButtonElement[] = []

    private closeOnOutsidePress = (event: PointerEvent) => {
      if (!this.contains(event.target as Node)) this.close()
    }

    connectedCallback() {
      if (this.hasAttribute('data-ready')) return

      this.nativeSelect = this.querySelector('.skill-select-native')
      this.trigger = this.querySelector('[data-select-trigger]')
      this.menu = this.querySelector('.skill-select-menu')
      this.options = [
        ...this.querySelectorAll<HTMLButtonElement>('[data-select-option]'),
      ]
      if (!this.nativeSelect || !this.trigger || !this.menu) return

      this.setAttribute('data-ready', '')
      this.nativeSelect.tabIndex = -1
      this.nativeSelect.setAttribute('aria-hidden', 'true')

      this.trigger.addEventListener('click', () => {
        this.hasAttribute('data-open') ? this.close() : this.open()
      })
      this.trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault()
          this.open(event.key === 'ArrowDown' ? 1 : -1)
        }
        if (event.key === 'Escape') this.close()
      })

      this.options.forEach((option, index) => {
        option.addEventListener('click', () => {
          this.select(option.dataset.selectOption ?? '', true)
          this.close()
          this.trigger?.focus()
        })
        option.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault()
            const direction = event.key === 'ArrowDown' ? 1 : -1
            this.options[
              (index + direction + this.options.length) % this.options.length
            ]?.focus()
          }
          if (event.key === 'Home' || event.key === 'End') {
            event.preventDefault()
            this.options[
              event.key === 'Home' ? 0 : this.options.length - 1
            ]?.focus()
          }
          if (event.key === 'Escape') {
            event.preventDefault()
            this.close()
            this.trigger?.focus()
          }
          if (event.key === 'Tab') this.close()
        })
      })

      this.nativeSelect.addEventListener('skill-select-sync', () =>
        this.select(this.nativeSelect?.value ?? '', false)
      )
      document.addEventListener('pointerdown', this.closeOnOutsidePress)
      this.select(this.nativeSelect.value, false)
    }

    disconnectedCallback() {
      document.removeEventListener('pointerdown', this.closeOnOutsidePress)
    }

    private open(direction = 0) {
      document
        .querySelectorAll<SkillSelectElement>('skill-select[data-open]')
        .forEach((select) => {
          if (select !== this) select.close()
        })
      this.setAttribute('data-open', '')
      this.trigger?.setAttribute('aria-expanded', 'true')

      if (direction !== 0) {
        const selectedIndex = Math.max(
          0,
          this.options.findIndex(
            (option) => option.getAttribute('aria-selected') === 'true'
          )
        )
        const nextIndex = Math.min(
          this.options.length - 1,
          Math.max(0, selectedIndex + direction)
        )
        this.options[nextIndex]?.focus()
      }
    }

    close() {
      this.removeAttribute('data-open')
      this.trigger?.setAttribute('aria-expanded', 'false')
    }

    private select(value: string, emitChange: boolean) {
      if (!this.nativeSelect || !this.trigger) return
      const selected = this.options.find(
        (option) => option.dataset.selectOption === value
      )
      if (!selected) return

      this.nativeSelect.value = value
      this.options.forEach((option) =>
        option.setAttribute(
          'aria-selected',
          String(option.dataset.selectOption === value)
        )
      )

      const label = selected.querySelector<HTMLElement>('[data-option-label]')
      const optionIcon =
        selected.querySelector<HTMLElement>('[data-option-icon]')
      const currentLabel = this.querySelector<HTMLElement>(
        '[data-current-label]'
      )
      const currentIcon = this.querySelector<HTMLElement>('[data-current-icon]')
      if (currentLabel) currentLabel.textContent = label?.textContent ?? ''
      if (currentIcon) currentIcon.innerHTML = optionIcon?.innerHTML ?? ''
      this.trigger.setAttribute(
        'aria-label',
        `${this.dataset.ariaLabel ?? ''}：${label?.textContent ?? ''}`
      )

      if (emitChange)
        this.nativeSelect.dispatchEvent(new Event('change', { bubbles: true }))
    }
  }

  if (!customElements.get('skill-select'))
    customElements.define('skill-select', SkillSelectElement)
</script>

<style>
  .skill-select {
    position: relative;
    display: inline-block;
    min-width: 8.25rem;
    color: var(--c-text);
  }

  .skill-select-native,
  .skill-select-trigger {
    width: 100%;
    min-height: 2.15rem;
    border: 0;
    border-radius: 0.5rem;
    padding: 0.5rem 0.65rem;
    background: var(--c-surface-soft);
    color: var(--c-text-muted);
    font-size: 0.7rem;
  }

  .skill-select-ui {
    display: none;
  }

  .skill-select[data-ready] .skill-select-native {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .skill-select[data-ready] .skill-select-ui {
    display: block;
  }

  .skill-select-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    cursor: pointer;
    transition:
      background 150ms ease,
      color 150ms ease;
  }

  .skill-select-trigger:hover,
  .skill-select[data-open] .skill-select-trigger {
    background: var(--c-surface-active);
    color: var(--c-text);
  }

  .skill-select-trigger:focus-visible {
    outline: 0 !important;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c-text) 18%, transparent);
  }

  .skill-select-current,
  .skill-select-option-main {
    display: flex;
    align-items: center;
    gap: 0.48rem;
    min-width: 0;
  }

  .skill-select-current > span:last-child,
  .skill-select-option-main > span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .skill-select-icon {
    display: grid;
    width: 1rem;
    height: 1rem;
    flex: none;
    place-items: center;
  }

  .skill-select-icon > span,
  .skill-select-icon > img {
    display: block;
    width: 1rem;
    height: 1rem;
    object-fit: contain;
  }

  .skill-select-icon > img {
    border-radius: 0.25rem;
  }

  .skill-select-chevron {
    flex: none;
    color: var(--c-text-faint);
    font-size: 0.95rem;
    transition: transform 160ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .skill-select[data-open] .skill-select-chevron {
    transform: rotate(180deg);
  }

  .skill-select-menu {
    position: absolute;
    z-index: 50;
    top: calc(100% + 0.42rem);
    right: 0;
    min-width: max(100%, 10.5rem);
    padding: 0.32rem;
    visibility: hidden;
    border-radius: 0.68rem;
    background: var(--c-bg);
    box-shadow:
      0 18px 48px -24px rgb(0 0 0 / 45%),
      0 4px 12px -8px rgb(0 0 0 / 22%);
    opacity: 0;
    transform: translateY(-0.3rem) scale(0.985);
    transform-origin: top right;
    pointer-events: none;
    transition:
      opacity 140ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 140ms ease;
  }

  .skill-select[data-open] .skill-select-menu {
    visibility: visible;
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .skill-select-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-height: 2.2rem;
    border: 0;
    border-radius: 0.42rem;
    padding: 0.48rem 0.55rem;
    background: transparent;
    color: var(--c-text-muted);
    font-size: 0.72rem;
    text-align: left;
    cursor: pointer;
  }

  .skill-select-option:hover,
  .skill-select-option:focus-visible {
    outline: 0;
    background: var(--c-surface-soft);
    color: var(--c-text);
  }

  .skill-select-option[aria-selected='true'] {
    background: var(--c-surface-active);
    color: var(--c-text);
    font-weight: 620;
  }

  .skill-select-check {
    flex: none;
    opacity: 0;
  }

  .skill-select-option[aria-selected='true'] .skill-select-check {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-select-chevron,
    .skill-select-menu {
      transition: none;
    }
  }
</style>
