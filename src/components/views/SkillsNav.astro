---
import Link from '~/components/base/Link.astro'
import { withBasePath } from '~/utils/path'

interface Props {
  active:
    | 'overview'
    | 'all'
    | 'scenes'
    | 'trending'
    | 'masters'
    | 'compare'
    | 'analyzer'
    | 'about'
}

const { active } = Astro.props

const tabs = [
  {
    key: 'overview',
    label: '概览',
    icon: 'i-ri-dashboard-line',
    path: '/agent/',
  },
  {
    key: 'all',
    label: '全部',
    icon: 'i-ri-apps-2-line',
    path: '/agent/all/',
  },
  {
    key: 'scenes',
    label: '场景',
    icon: 'i-ri-compass-3-line',
    path: '/agent/scenes/',
  },
  {
    key: 'trending',
    label: '趋势',
    icon: 'i-ri-line-chart-line',
    path: '/agent/trending/',
  },
  {
    key: 'masters',
    label: '大师',
    icon: 'i-ri-vip-crown-line',
    path: '/agent/masters/',
  },
] as const
---

<div class="skills-nav-wrap">
  <nav class="skills-nav" aria-label="Agent 能力导航">
    {
      tabs.map((tab) => (
        <Link
          class:list={['skills-nav-tab', { 'is-active': tab.key === active }]}
          href={withBasePath(tab.path)}
          aria-current={tab.key === active ? 'page' : undefined}
        >
          <span class={`skills-nav-icon ${tab.icon}`} aria-hidden="true" />
          <span>{tab.label}</span>
        </Link>
      ))
    }
  </nav>
</div>

<style is:global>
  #main:has(.skills-nav-wrap) {
    --skills-border: color-mix(in srgb, var(--c-text) 22%, transparent);
    --skills-radius-sm: 0.375rem;
    --skills-radius: 0.55rem;
    --skills-radius-lg: 0.75rem;
  }

  header:has(.skills-nav-wrap) {
    position: relative;
    width: min(100%, 75rem);
    max-width: none;
    padding: 0.85rem 0 0.25rem;
  }

  header:has(.skills-nav-wrap) > h1 {
    margin: 0;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  header:has(.skills-nav-wrap) > p {
    max-width: 38rem;
    margin: 0.85rem auto 0 !important;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--c-text-muted);
    opacity: 1;
  }

  .skills-nav-wrap {
    position: relative;
    z-index: 5;
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 1.15rem;
  }

  .skills-nav {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    max-width: 100%;
    padding: 0.25rem;
    overflow-x: auto;
    border: 1px solid var(--skills-border);
    border-radius: var(--skills-radius-lg);
    background: var(--c-bg);
    scrollbar-width: none;
  }

  .skills-nav::-webkit-scrollbar {
    display: none;
  }

  .skills-nav-tab {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    gap: 0.38rem;
    min-width: 4.85rem;
    padding: 0.56rem 0.88rem;
    border: 0;
    border-radius: var(--skills-radius);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
    color: var(--c-text-soft);
    opacity: 1 !important;
    transition:
      color 160ms ease,
      background 160ms ease;
  }

  .skills-nav-tab:hover {
    background: var(--c-surface-soft);
    color: var(--c-text);
  }

  .skills-nav-tab.is-active {
    background: var(--c-text);
    color: var(--c-bg);
  }

  .skills-nav-tab:active {
    background: var(--c-surface-active);
  }

  .skills-nav-tab.is-active:active {
    background: var(--c-text);
  }

  .skills-nav-icon {
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    header:has(.skills-nav-wrap) {
      padding-top: 0.35rem;
    }

    .skills-nav-wrap {
      width: calc(100vw - 1rem);
      margin-left: calc(50% - 50vw + 0.5rem);
      justify-content: flex-start;
    }

    .skills-nav {
      width: 100%;
      border-radius: var(--skills-radius-lg);
    }

    .skills-nav-tab {
      min-width: 4.65rem;
      padding: 0.56rem 0.72rem;
    }

    .skills-nav-icon {
      display: none;
    }
  }
</style>
