---
import Link from '~/components/base/Link.astro'
import { withBasePath } from '~/utils/path'

interface Props {
  active: 'overview' | 'all' | 'scenes' | 'trending' | 'masters' | 'about'
}

const { active } = Astro.props

const tabs = [
  {
    key: 'overview',
    label: '精选',
    icon: 'i-ri-dashboard-line',
    path: '/agent/',
  },
  {
    key: 'all',
    label: '项目库',
    icon: 'i-ri-apps-2-line',
    path: '/agent/all/',
  },
  {
    key: 'scenes',
    label: '场景',
    icon: 'i-ri-compass-3-line',
    path: '/agent/scenes/',
  },
  {
    key: 'trending',
    label: '趋势',
    icon: 'i-ri-line-chart-line',
    path: '/agent/trending/',
  },
  {
    key: 'masters',
    label: '创作者',
    icon: 'i-ri-vip-crown-line',
    path: '/agent/masters/',
  },
] as const

const activeIndex = Math.max(
  0,
  tabs.findIndex((tab) => tab.key === active)
)
---

<div class="skills-nav-wrap" transition:persist="agent-skills-nav">
  <nav
    class="skills-nav"
    aria-label="Agent 能力导航"
    style={`--active-index:${activeIndex};--active-track-offset:${activeIndex * -20}%`}
  >
    <span class="skills-nav-indicator" aria-hidden="true">
      <span class="skills-nav-indicator-track">
        {
          tabs.map((tab) => (
            <span class="skills-nav-indicator-item">
              <span class={`skills-nav-icon ${tab.icon}`} />
              <span>{tab.label}</span>
            </span>
          ))
        }
      </span>
    </span>
    {
      tabs.map((tab) => (
        <Link
          class:list={['skills-nav-tab', { 'is-active': tab.key === active }]}
          href={withBasePath(tab.path)}
          data-tab-index={tabs.indexOf(tab)}
          aria-current={tab.key === active ? 'page' : undefined}
        >
          <span class={`skills-nav-icon ${tab.icon}`} aria-hidden="true" />
          <span>{tab.label}</span>
        </Link>
      ))
    }
  </nav>
</div>

<style is:global>
  /* Radii map onto the theme's four-step scale instead of inventing a
     parallel system (DESIGN.md: Shapes). */
  #main:has(.skills-nav-wrap) {
    --skills-border: var(--c-border-strong);
    --skills-radius-sm: var(--radius-sm);
    --skills-radius: var(--radius-sm);
    --skills-radius-lg: var(--radius-md);
  }

  header:has(.skills-nav-wrap) {
    position: relative;
    width: min(100%, 75rem);
    max-width: none;
    padding: 0.85rem 0 0.25rem;
    text-align: left;
  }

  header:has(.skills-nav-wrap) > h1 {
    margin: 0;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  header:has(.skills-nav-wrap) > p {
    max-width: 38rem;
    margin: 0.85rem 0 0 !important;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--c-text-muted);
    opacity: 1;
  }

  .skills-nav-wrap {
    position: relative;
    z-index: 5;
    display: flex;
    justify-content: flex-start;
    width: 100%;
    margin-top: 1.15rem;
  }

  .skills-nav {
    --tab-width: 5.2rem;

    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    max-width: 100%;
    padding: 0.22rem;
    overflow-x: auto;
    border: 0 !important;
    border-radius: var(--skills-radius-lg);
    background: var(--c-surface-soft);
    isolation: isolate;
    scrollbar-width: none;
  }

  .skills-nav-indicator {
    position: absolute;
    z-index: 2;
    inset: 0.22rem auto 0.22rem 0.22rem;
    width: var(--tab-width);
    overflow: hidden;
    border-radius: var(--skills-radius);
    background: var(--c-text);
    transform: translate3d(calc(var(--active-index) * 100%), 0, 0);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    pointer-events: none;
  }

  .skills-nav-indicator-track {
    display: flex;
    width: 500%;
    height: 100%;
    transform: translate3d(var(--active-track-offset), 0, 0);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .skills-nav-indicator-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.38rem;
    width: 20%;
    min-width: 20%;
    height: 100%;
    padding: 0.56rem 0.88rem;
    color: var(--c-bg);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
  }

  .skills-nav::-webkit-scrollbar {
    display: none;
  }

  .skills-nav-tab {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    gap: 0.38rem;
    position: relative;
    z-index: 1;
    width: var(--tab-width);
    min-width: var(--tab-width);
    padding: 0.56rem 0.88rem;
    border: 0 !important;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
    color: var(--c-text-soft);
    opacity: 1 !important;
    transition:
      color 160ms ease,
      opacity 160ms ease;
  }

  .skills-nav-tab:hover {
    color: var(--c-text);
    opacity: 1 !important;
  }

  .skills-nav-tab.is-active {
    background: transparent;
    opacity: 1 !important;
  }

  .skills-nav-tab:active {
    background: transparent;
  }

  .skills-nav-tab.is-active:active {
    background: transparent;
  }

  .skills-nav-icon {
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    header:has(.skills-nav-wrap) {
      padding: 0.25rem 0 0;
    }

    header:has(.skills-nav-wrap) > h1 {
      font-size: clamp(1.85rem, 9vw, 2.15rem);
      line-height: 1.05;
    }

    header:has(.skills-nav-wrap) > p {
      margin-top: 0.65rem !important;
      padding-inline: 0.75rem;
      font-size: 0.82rem;
      line-height: 1.5;
    }

    .skills-nav-wrap {
      width: 100%;
      margin-left: 0;
      margin-top: 0.9rem;
      justify-content: flex-start;
    }

    .skills-nav {
      --tab-width: calc((100% - 0.44rem) / 5);

      width: 100%;
      overflow: hidden;
      border-radius: var(--skills-radius-lg);
    }

    .skills-nav-tab {
      flex: 1 1 0;
      width: 0;
      min-width: 0;
      min-height: 2.75rem;
      padding: 0.7rem 0.2rem;
      white-space: nowrap;
    }

    .skills-nav-indicator-item {
      min-height: 2.75rem;
      padding: 0.7rem 0.2rem;
      white-space: nowrap;
    }

    .skills-nav-icon {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skills-nav-indicator,
    .skills-nav-indicator-track {
      transition: none;
    }
  }
</style>

<script>
  function setAgentTab(nav: HTMLElement, tab: HTMLAnchorElement) {
    const tabs = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>('.skills-nav-tab')
    )
    const nextIndex = Number(tab.dataset.tabIndex || 0)

    nav.style.setProperty('--active-index', String(nextIndex))
    nav.style.setProperty('--active-track-offset', `${nextIndex * -20}%`)
    tabs.forEach((item) => {
      const isActive = item === tab
      item.classList.toggle('is-active', isActive)
      if (isActive) item.setAttribute('aria-current', 'page')
      else item.removeAttribute('aria-current')
    })
  }

  function syncAgentTabWithLocation() {
    const nav = document.querySelector<HTMLElement>('.skills-nav')
    if (!nav) return

    const currentPath = `${location.pathname.replace(/\/+$/, '')}/`
    const tabs = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>('.skills-nav-tab')
    )
    const activeTab = tabs.find((tab) => {
      const tabPath = `${new URL(tab.href).pathname.replace(/\/+$/, '')}/`
      return tabPath === currentPath
    })

    if (activeTab) setAgentTab(nav, activeTab)
  }

  document.addEventListener('click', (event) => {
    const target = event.target
    if (!(target instanceof Element)) return

    const tab = target.closest<HTMLAnchorElement>('.skills-nav-tab')
    const nav = tab?.closest<HTMLElement>('.skills-nav')
    if (tab && nav) setAgentTab(nav, tab)
  })

  syncAgentTabWithLocation()
  document.addEventListener('astro:page-load', syncAgentTabWithLocation)
</script>
