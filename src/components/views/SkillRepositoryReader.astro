---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Link from '~/components/base/Link.astro'
import { withBasePath } from '~/utils/path'
import {
  CATEGORY_LABELS,
  INSTALLABLE_CATEGORIES,
  SECURITY_GRADES,
  formatCount,
  githubAvatar,
  installCommand,
} from '~/utils/skills'

import type { CollectionEntry } from 'astro:content'

type Skill = CollectionEntry<'skills'>['data']

interface Props {
  skill?: Skill
  readmeHtml?: string
  readmeRaw?: string
}

const { skill, readmeHtml = '', readmeRaw = '' } = Astro.props
const repo = skill?.id ?? ''
const grade = skill
  ? (SECURITY_GRADES[skill.securityGrade] ?? SECURITY_GRADES.unknown)
  : SECURITY_GRADES.unknown
const installable = skill ? INSTALLABLE_CATEGORIES.has(skill.category) : false
const command = skill
  ? installable
    ? installCommand(skill.id)
    : `git clone https://github.com/${skill.id}.git`
  : ''
const displayDesc = skill?.descZh || skill?.desc || ''
const bootstrapJson = JSON.stringify({
  repo,
  skill: skill
    ? {
        name: skill.name,
        author: skill.author,
        description: displayDesc,
        category: skill.category,
        stars: skill.stars,
        installs: skill.installs,
        qualityScore: skill.qualityScore,
        securityGrade: skill.securityGrade,
        official: skill.official,
        language: skill.language,
        tags: [...new Set([...skill.platforms, ...skill.tags])],
        command,
      }
    : null,
  readmeRaw,
}).replace(/</g, '\\u003c')
const skillsBase = withBasePath('/skills/')
---

<BaseLayout
  title={skill ? `${skill.name} - Skills` : '仓库阅读 - Skills'}
  description={displayDesc || '在站内阅读 GitHub 仓库的 README、目录与源文件'}
  bgType={false}
  hideFooter={true}
  stableNavigation={true}
>
  <div
    class="repo-reader"
    data-repo-reader
    data-skills-base={skillsBase}
    data-has-static-readme={readmeHtml ? 'true' : 'false'}
  >
    <div class="repo-reader-crumbs">
      <Link href={withBasePath('/agent/')}>
        <span class="i-ri-arrow-left-line" aria-hidden="true"></span>
        Skills
      </Link>
      <span aria-hidden="true">/</span>
      <span data-repo-crumb>{repo || '仓库阅读'}</span>
    </div>

    <header class="repo-reader-head">
      <div class="repo-reader-identity">
        <img
          class="repo-reader-avatar"
          data-repo-avatar
          src={skill ? githubAvatar(skill.author, 160) : ''}
          alt={skill?.author ?? ''}
          hidden={!skill}
        />
        <div class="repo-reader-title-group">
          <div class="repo-reader-eyebrow" data-repo-owner>
            {skill?.author ?? 'GitHub Repository'}
          </div>
          <h1 data-repo-title>{skill?.name ?? '正在读取仓库…'}</h1>
          <p data-repo-description>
            {displayDesc || '正在获取仓库简介、README 与文件目录。'}
          </p>
        </div>
      </div>

      <div class="repo-reader-actions">
        <button
          type="button"
          class="repo-reader-copy"
          data-copy-command
          data-copy={command}
          hidden={!command}
        >
          <span class="i-ri-terminal-box-line" aria-hidden="true"></span>
          <span data-command-label
            >{installable ? '复制安装命令' : '复制克隆命令'}</span
          >
        </button>
        <a
          class="repo-reader-github"
          data-github-link
          href={repo ? `https://github.com/${repo}` : 'https://github.com'}
          target="_blank"
          rel="noopener"
        >
          <span class="i-uil-github-alt" aria-hidden="true"></span>
          GitHub
          <span class="i-ri-arrow-right-up-line" aria-hidden="true"></span>
        </a>
      </div>
    </header>

    <div class="repo-reader-metrics" data-repo-metrics>
      {
        skill && (
          <>
            <span>
              <span class="i-ri-star-line" aria-hidden="true" />
              {formatCount(skill.stars)} Stars
            </span>
            {skill.installs !== null && (
              <span>
                <span class="i-ri-download-2-line" aria-hidden="true" />
                {formatCount(skill.installs)} 安装
              </span>
            )}
            <span>{CATEGORY_LABELS[skill.category]}</span>
            <span>{`质量分 ${skill.qualityScore}`}</span>
            <span
              style={`--grade-color:${grade.color}`}
              class="repo-reader-grade"
            >
              {grade.label}
            </span>
          </>
        )
      }
    </div>

    <div class="repo-reader-layout">
      <aside class="repo-reader-nav" aria-label="仓库导航">
        <p class="repo-reader-panel-label">站内阅读</p>
        <nav>
          <a
            class="is-active"
            data-overview-link
            href={repo ? `${skillsBase}${repo}/` : '#'}
          >
            <span class="i-ri-book-open-line" aria-hidden="true"></span>
            README
          </a>
          <button type="button" data-focus-files>
            <span class="i-ri-folder-3-line" aria-hidden="true"></span>
            文件目录
          </button>
        </nav>

        <div class="repo-reader-about">
          <p class="repo-reader-panel-label">仓库信息</p>
          <dl>
            <div>
              <dt>默认分支</dt>
              <dd data-default-branch>—</dd>
            </div>
            <div>
              <dt>主要语言</dt>
              <dd data-language>{skill?.language ?? '—'}</dd>
            </div>
            <div>
              <dt>最近更新</dt>
              <dd data-updated-at>—</dd>
            </div>
            <div>
              <dt>许可证</dt>
              <dd data-license>—</dd>
            </div>
          </dl>
        </div>
      </aside>

      <section class="repo-reader-document" aria-live="polite">
        <div class="repo-reader-status" data-reader-status hidden></div>
        <div class="repo-reader-filebar" data-filebar hidden>
          <button type="button" data-file-back title="返回 README">
            <span class="i-ri-arrow-left-line" aria-hidden="true"></span>
          </button>
          <div data-file-breadcrumb></div>
          <a
            data-file-github
            href={repo ? `https://github.com/${repo}` : skillsBase}
            target="_blank"
            rel="noopener"
          >
            查看源文件
            <span class="i-ri-arrow-right-up-line" aria-hidden="true"></span>
          </a>
        </div>
        <article class="repo-reader-content prose" data-reader-content>
          {
            readmeHtml ? (
              <div set:html={readmeHtml} />
            ) : (
              <div class="repo-reader-skeleton" aria-label="正在加载 README">
                <span />
                <span />
                <span />
                <span />
                <span />
              </div>
            )
          }
        </article>
      </section>

      <aside class="repo-reader-files" data-files-panel>
        <div class="repo-reader-files-head">
          <div>
            <p class="repo-reader-panel-label">来源文件</p>
            <p data-current-folder>/</p>
          </div>
          <button type="button" data-folder-up title="返回上级目录" hidden>
            <span class="i-ri-corner-left-up-line" aria-hidden="true"></span>
          </button>
        </div>
        <label class="repo-reader-search">
          <span class="i-ri-search-line" aria-hidden="true"></span>
          <input type="search" data-file-search placeholder="搜索仓库文件" />
          <kbd>/</kbd>
        </label>
        <div class="repo-reader-file-list" data-file-list>
          <div class="repo-reader-file-loading">
            <span></span><span></span><span></span>
          </div>
        </div>
        <p class="repo-reader-files-note" data-files-note>
          文件与 README 默认留在站内打开。
        </p>
      </aside>
    </div>
  </div>

  <script
    is:inline
    type="application/json"
    data-repo-bootstrap
    set:html={bootstrapJson}
  />
</BaseLayout>

<script>
  import DOMPurify from 'dompurify'
  import { Marked } from 'marked'

  interface SkillBootstrap {
    name: string
    author: string
    description: string
    category: string
    stars: number
    installs: number | null
    qualityScore: number
    securityGrade: string
    official: boolean
    language: string | null
    tags: string[]
    command: string
  }

  interface Bootstrap {
    repo: string
    skill: SkillBootstrap | null
    readmeRaw: string
  }

  interface RepoMeta {
    fullName: string
    name: string
    owner: string
    description: string
    stars: number
    forks: number
    watchers: number
    language: string | null
    defaultBranch: string
    updatedAt: string
    license: string | null
    topics: string[]
    archived: boolean
    homepage: string | null
  }

  interface RepoItem {
    name: string
    path: string
    type: 'file' | 'dir' | 'symlink' | 'submodule'
    size: number
    downloadUrl: string | null
  }

  interface TreeItem {
    path: string
    type: 'blob' | 'tree'
    size: number | null
  }

  interface OverviewResponse {
    repo: RepoMeta
    readme: { path: string; content: string; encoding: string } | null
  }

  interface DirectoryResponse {
    type: 'dir'
    path: string
    items: RepoItem[]
  }

  interface FileResponse {
    type: 'file'
    name: string
    path: string
    size: number
    content: string | null
    encoding: string | null
    downloadUrl: string | null
  }

  interface TreeResponse {
    items: TreeItem[]
    truncated: boolean
  }

  const root = document.querySelector<HTMLElement>('[data-repo-reader]')
  const bootstrapElement = document.querySelector<HTMLScriptElement>(
    '[data-repo-bootstrap]'
  )

  if (root && bootstrapElement) {
    const bootstrap = JSON.parse(
      bootstrapElement.textContent || '{}'
    ) as Bootstrap
    const skillsBase = root.dataset.skillsBase || '/skills/'
    const hasStaticReadme = root.dataset.hasStaticReadme === 'true'
    const get = <T extends Element>(selector: string) =>
      root.querySelector<T>(selector)

    const content = get<HTMLElement>('[data-reader-content]')!
    const status = get<HTMLElement>('[data-reader-status]')!
    const filebar = get<HTMLElement>('[data-filebar]')!
    const fileList = get<HTMLElement>('[data-file-list]')!
    const search = get<HTMLInputElement>('[data-file-search]')!
    const folderUp = get<HTMLButtonElement>('[data-folder-up]')!
    const currentFolder = get<HTMLElement>('[data-current-folder]')!
    const filesNote = get<HTMLElement>('[data-files-note]')!
    const marked = new Marked({ gfm: true, breaks: false })

    function locationState() {
      const basePath = skillsBase.replace(/\/$/, '')
      const pathname = location.pathname.startsWith(basePath)
        ? location.pathname.slice(basePath.length)
        : location.pathname
      const parts = pathname.split('/').filter(Boolean).map(decodeURIComponent)
      const queryRepo = new URLSearchParams(location.search).get('repo') || ''
      const repo =
        bootstrap.repo ||
        queryRepo ||
        (parts.length >= 2 && parts[0] !== 'repository'
          ? `${parts[0]}/${parts[1]}`
          : '')
      const blobIndex = parts.indexOf('blob')
      return {
        repo,
        requestedRef: blobIndex >= 0 ? parts[blobIndex + 1] || 'HEAD' : 'HEAD',
        requestedPath:
          blobIndex >= 0 ? parts.slice(blobIndex + 2).join('/') : '',
      }
    }

    const route = locationState()
    const [owner, repoName] = route.repo.split('/')
    let meta: RepoMeta | null = null
    let activeRef = route.requestedRef
    let folderPath = ''
    let treeItems: TreeItem[] | null = null

    const escapeHtml = (value: string) =>
      value.replace(
        /[&<>"']/g,
        (character) =>
          ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;',
          })[character] as string
      )

    const formatCount = (value: number) =>
      value >= 1_000_000
        ? `${(value / 1_000_000).toFixed(1)}M`
        : value >= 1_000
          ? `${(value / 1_000).toFixed(1)}k`
          : String(value)

    const githubUrl = (path = '') =>
      `https://github.com/${route.repo}${path ? `/${path.replace(/^\/+/, '')}` : ''}`

    const apiUrl = (action: string, params: Record<string, string> = {}) => {
      const url = new URL(
        `/api/github/${encodeURIComponent(owner)}/${encodeURIComponent(repoName)}/${action}`,
        location.origin
      )
      for (const [key, value] of Object.entries(params)) {
        if (value) url.searchParams.set(key, value)
      }
      return url.toString()
    }

    async function fetchJson<T>(url: string): Promise<T> {
      const response = await fetch(url, {
        headers: { Accept: 'application/json' },
      })
      const payload = (await response.json().catch(() => null)) as
        (T & { error?: string }) | null
      if (!response.ok)
        throw new Error(payload?.error || `请求失败 (${response.status})`)
      return payload as T
    }

    function showStatus(
      message: string,
      kind: 'loading' | 'error' = 'loading'
    ) {
      status.hidden = false
      status.classList.toggle('is-error', kind === 'error')
      status.innerHTML =
        kind === 'loading'
          ? `<span class="repo-reader-pulse"></span>${escapeHtml(message)}`
          : `<span class="i-ri-error-warning-line"></span>${escapeHtml(message)}`
    }

    function hideStatus() {
      status.hidden = true
      status.textContent = ''
    }

    function decodeBase64(value: string) {
      const binary = atob(value.replace(/\s/g, ''))
      const bytes = Uint8Array.from(binary, (character) =>
        character.charCodeAt(0)
      )
      return new TextDecoder().decode(bytes)
    }

    function repoFileUrl(path: string, ref = activeRef) {
      const resolvedRef = ref || meta?.defaultBranch || 'HEAD'
      return `${skillsBase}${route.repo}/blob/${encodeURIComponent(resolvedRef)}/${path}`
    }

    function rewriteDocumentLinks(container: HTMLElement, sourcePath = '') {
      const sourceDir = sourcePath.includes('/')
        ? sourcePath.slice(0, sourcePath.lastIndexOf('/') + 1)
        : ''
      container
        .querySelectorAll<HTMLAnchorElement>('a[href]')
        .forEach((link) => {
          const raw = link.getAttribute('href') || ''
          if (!raw || raw.startsWith('#') || raw.startsWith('mailto:')) return
          if (raw.startsWith(`${skillsBase}${route.repo}/`)) return
          if (/^(javascript|data|vbscript|file):/i.test(raw)) {
            link.removeAttribute('href')
            return
          }
          try {
            const absolute = new URL(
              raw,
              githubUrl(`/blob/${activeRef}/${sourceDir}`)
            )
            const repoPrefix = `/${owner}/${repoName}/`
            if (
              absolute.hostname === 'github.com' &&
              absolute.pathname.startsWith(repoPrefix)
            ) {
              const parts = absolute.pathname
                .slice(repoPrefix.length)
                .split('/')
              if (
                (parts[0] === 'blob' || parts[0] === 'tree') &&
                parts.length >= 3
              ) {
                link.href = repoFileUrl(parts.slice(2).join('/'), parts[1])
                link.removeAttribute('target')
                link.removeAttribute('rel')
                return
              }
            }
            if (!/^[a-z][a-z\d+.-]*:/i.test(raw) && !raw.startsWith('//')) {
              const normalized = new URL(
                raw,
                `https://local/${sourceDir}`
              ).pathname.slice(1)
              link.href = repoFileUrl(normalized)
              link.removeAttribute('target')
              link.removeAttribute('rel')
              return
            }
            link.target = '_blank'
            link.rel = 'noopener nofollow'
          } catch {
            link.removeAttribute('href')
          }
        })

      container
        .querySelectorAll<HTMLImageElement>('img[src]')
        .forEach((image) => {
          const raw = image.getAttribute('src') || ''
          if (!raw || /^(https?:)?\/\//i.test(raw) || raw.startsWith('data:'))
            return
          const normalized = new URL(
            raw,
            `https://local/${sourceDir}`
          ).pathname.slice(1)
          image.src = `https://raw.githubusercontent.com/${route.repo}/${activeRef}/${normalized}`
          image.loading = 'lazy'
          image.decoding = 'async'
        })
    }

    async function renderMarkdown(markdown: string, sourcePath = 'README.md') {
      const html = await marked.parse(markdown)
      content.innerHTML = DOMPurify.sanitize(html, {
        USE_PROFILES: { html: true },
        ADD_ATTR: ['target', 'rel'],
      })
      rewriteDocumentLinks(content, sourcePath)
    }

    function applyMeta(next: RepoMeta) {
      meta = next
      if (activeRef === 'HEAD') activeRef = next.defaultBranch
      const title = get<HTMLElement>('[data-repo-title]')
      const description = get<HTMLElement>('[data-repo-description]')
      const repoOwner = get<HTMLElement>('[data-repo-owner]')
      const crumb = get<HTMLElement>('[data-repo-crumb]')
      const avatar = get<HTMLImageElement>('[data-repo-avatar]')
      const githubLink = get<HTMLAnchorElement>('[data-github-link]')
      const overviewLink = get<HTMLAnchorElement>('[data-overview-link]')
      if (title) title.textContent = next.name
      if (description)
        description.textContent =
          next.description || '这个仓库暂时没有填写简介。'
      if (repoOwner) repoOwner.textContent = next.owner
      if (crumb) crumb.textContent = next.fullName
      if (avatar) {
        avatar.src = `https://github.com/${encodeURIComponent(next.owner)}.png?size=160`
        avatar.alt = next.owner
        avatar.hidden = false
      }
      if (githubLink) githubLink.href = githubUrl()
      if (overviewLink) overviewLink.href = `${skillsBase}${route.repo}/`
      const defaultBranch = get<HTMLElement>('[data-default-branch]')
      const language = get<HTMLElement>('[data-language]')
      const updatedAt = get<HTMLElement>('[data-updated-at]')
      const license = get<HTMLElement>('[data-license]')
      if (defaultBranch) defaultBranch.textContent = next.defaultBranch
      if (language) language.textContent = next.language || '—'
      if (updatedAt)
        updatedAt.textContent = new Intl.DateTimeFormat('zh-CN', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        }).format(new Date(next.updatedAt))
      if (license) license.textContent = next.license || '未声明'
      document.title = `${next.name} - 仓库阅读`

      if (!bootstrap.skill) {
        const metrics = get<HTMLElement>('[data-repo-metrics]')
        if (metrics) {
          metrics.innerHTML = `
            <span><span class="i-ri-star-line"></span>${formatCount(next.stars)} Stars</span>
            <span><span class="i-ri-git-fork-line"></span>${formatCount(next.forks)} Forks</span>
            ${next.language ? `<span>${escapeHtml(next.language)}</span>` : ''}
            ${next.archived ? '<span>已归档</span>' : ''}
          `
        }
        const copyButton = get<HTMLButtonElement>('[data-copy-command]')
        const label = get<HTMLElement>('[data-command-label]')
        if (copyButton) {
          copyButton.dataset.copy = `git clone https://github.com/${route.repo}.git`
          copyButton.hidden = false
        }
        if (label) label.textContent = '复制克隆命令'
      }
    }

    async function loadOverview() {
      if (!route.repo || !owner || !repoName) {
        showStatus('仓库地址不完整，请从 Skills 列表重新进入。', 'error')
        return
      }
      try {
        const overview = await fetchJson<OverviewResponse>(apiUrl('overview'))
        applyMeta(overview.repo)
        if (route.requestedPath) {
          await loadFile(route.requestedPath)
        } else if (!hasStaticReadme) {
          if (overview.readme?.content) {
            await renderMarkdown(
              decodeBase64(overview.readme.content),
              overview.readme.path
            )
          } else {
            content.innerHTML = `<div class="repo-reader-empty"><span class="i-ri-file-list-3-line"></span><h2>仓库没有 README</h2><p>可以从右侧文件目录继续浏览源文件。</p></div>`
          }
        } else {
          rewriteDocumentLinks(content, 'README.md')
        }
        hideStatus()
        await loadDirectory('')
      } catch (error) {
        if (hasStaticReadme) {
          rewriteDocumentLinks(content, 'README.md')
          hideStatus()
        } else {
          content.innerHTML = ''
          showStatus(
            error instanceof Error
              ? error.message
              : '仓库加载失败，请稍后重试。',
            'error'
          )
        }
        fileList.innerHTML = `<div class="repo-reader-file-error">文件目录暂时不可用</div>`
      }
    }

    function fileIcon(item: RepoItem | TreeItem) {
      if (item.type === 'dir' || item.type === 'tree')
        return 'i-ri-folder-3-line'
      const path = 'path' in item ? item.path : ''
      if (/\.(md|mdx)$/i.test(path)) return 'i-ri-markdown-line'
      if (/\.(png|jpe?g|gif|webp|svg)$/i.test(path)) return 'i-ri-image-line'
      if (/\.(json|ya?ml|toml)$/i.test(path)) return 'i-ri-braces-line'
      return 'i-ri-file-code-line'
    }

    function renderDirectory(items: RepoItem[]) {
      const ordered = [...items].sort((a, b) => {
        if (a.type === b.type) return a.name.localeCompare(b.name)
        return a.type === 'dir' ? -1 : 1
      })
      fileList.innerHTML = ordered.length
        ? ordered
            .map((item) => {
              const isDirectory = item.type === 'dir'
              return `<a href="${isDirectory ? '#' : repoFileUrl(item.path)}" data-entry-path="${escapeHtml(item.path)}" data-entry-type="${item.type}">
                <span class="${fileIcon(item)}"></span>
                <span>${escapeHtml(item.name)}</span>
                ${isDirectory ? '<span class="i-ri-arrow-right-s-line"></span>' : ''}
              </a>`
            })
            .join('')
        : '<div class="repo-reader-file-error">这个目录是空的</div>'
      currentFolder.textContent = folderPath ? `/${folderPath}` : '/'
      folderUp.hidden = !folderPath
      filesNote.textContent = `${ordered.length} 个条目 · 点击文件在站内打开`
    }

    async function loadDirectory(path: string) {
      folderPath = path
      fileList.innerHTML = `<div class="repo-reader-file-loading"><span></span><span></span><span></span></div>`
      try {
        const directory = await fetchJson<DirectoryResponse>(
          apiUrl('contents', { path, ref: activeRef })
        )
        renderDirectory(directory.items)
      } catch (error) {
        fileList.innerHTML = `<div class="repo-reader-file-error">${escapeHtml(error instanceof Error ? error.message : '目录加载失败')}</div>`
      }
    }

    function isProbablyText(path: string) {
      return (
        /\.(md|mdx|txt|js|jsx|mjs|cjs|ts|tsx|astro|css|scss|less|html|vue|svelte|json|ya?ml|toml|xml|svg|py|rb|php|java|kt|kts|go|rs|swift|c|h|cpp|hpp|cs|sh|bash|zsh|fish|sql|graphql|gql|env|gitignore|dockerfile)$/i.test(
          path
        ) || !path.split('/').pop()?.includes('.')
      )
    }

    async function loadFile(path: string) {
      showStatus(`正在读取 ${path}…`)
      filebar.hidden = false
      const breadcrumb = get<HTMLElement>('[data-file-breadcrumb]')
      const githubFile = get<HTMLAnchorElement>('[data-file-github]')
      if (breadcrumb) breadcrumb.textContent = path
      if (githubFile) githubFile.href = githubUrl(`/blob/${activeRef}/${path}`)
      try {
        const file = await fetchJson<FileResponse | DirectoryResponse>(
          apiUrl('contents', { path, ref: activeRef })
        )
        if (file.type === 'dir') {
          content.innerHTML = `<div class="repo-reader-empty"><span class="i-ri-folder-open-line"></span><h2>${escapeHtml(path)}</h2><p>这是一个目录，已在右侧打开其中的文件。</p></div>`
          await loadDirectory(path)
        } else if (!file.content) {
          content.innerHTML = `<div class="repo-reader-empty"><span class="i-ri-file-download-line"></span><h2>这个文件不适合在线预览</h2><p>文件可能过大或使用了二进制格式。</p>${file.downloadUrl ? `<a href="${escapeHtml(file.downloadUrl)}" target="_blank" rel="noopener">下载原文件</a>` : ''}</div>`
        } else {
          const text = decodeBase64(file.content)
          if (/\.(md|mdx)$/i.test(path)) await renderMarkdown(text, path)
          else if (
            /\.(png|jpe?g|gif|webp|svg)$/i.test(path) &&
            file.downloadUrl
          ) {
            content.innerHTML = `<figure class="repo-reader-image"><img src="${escapeHtml(file.downloadUrl)}" alt="${escapeHtml(file.name)}"><figcaption>${escapeHtml(path)}</figcaption></figure>`
          } else if (isProbablyText(path)) {
            content.innerHTML = `<pre class="repo-reader-code"><code>${escapeHtml(text)}</code></pre>`
          } else {
            content.innerHTML = `<div class="repo-reader-empty"><span class="i-ri-file-code-line"></span><h2>暂不支持预览这个文件</h2><p>${escapeHtml(path)}</p></div>`
          }
        }
        hideStatus()
      } catch (error) {
        content.innerHTML = ''
        showStatus(
          error instanceof Error ? error.message : '文件加载失败，请稍后重试。',
          'error'
        )
      }
    }

    async function searchTree(query: string) {
      const normalized = query.trim().toLowerCase()
      if (!normalized) {
        await loadDirectory(folderPath)
        return
      }
      fileList.innerHTML = `<div class="repo-reader-file-loading"><span></span><span></span><span></span></div>`
      try {
        if (!treeItems) {
          const tree = await fetchJson<TreeResponse>(
            apiUrl('tree', { ref: activeRef })
          )
          treeItems = tree.items
          if (tree.truncated)
            filesNote.textContent =
              '仓库文件较多，搜索结果来自 GitHub 返回的部分目录。'
        }
        const matches = treeItems
          .filter((item) => item.path.toLowerCase().includes(normalized))
          .slice(0, 80)
        fileList.innerHTML = matches.length
          ? matches
              .map(
                (
                  item
                ) => `<a href="${item.type === 'tree' ? '#' : repoFileUrl(item.path)}" data-entry-path="${escapeHtml(item.path)}" data-entry-type="${item.type === 'tree' ? 'dir' : 'file'}">
                  <span class="${fileIcon(item)}"></span>
                  <span>${escapeHtml(item.path)}</span>
                </a>`
              )
              .join('')
          : '<div class="repo-reader-file-error">没有匹配的文件</div>'
        currentFolder.textContent = `搜索：${query}`
        folderUp.hidden = true
        filesNote.textContent = `找到 ${matches.length} 个匹配项`
      } catch (error) {
        fileList.innerHTML = `<div class="repo-reader-file-error">${escapeHtml(error instanceof Error ? error.message : '搜索失败')}</div>`
      }
    }

    fileList.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>(
        '[data-entry-path]'
      )
      if (!link || link.dataset.entryType !== 'dir') return
      event.preventDefault()
      search.value = ''
      loadDirectory(link.dataset.entryPath || '')
    })

    folderUp.addEventListener('click', () => {
      const parent = folderPath.includes('/')
        ? folderPath.slice(0, folderPath.lastIndexOf('/'))
        : ''
      loadDirectory(parent)
    })

    let searchTimer = 0
    search.addEventListener('input', () => {
      window.clearTimeout(searchTimer)
      searchTimer = window.setTimeout(() => searchTree(search.value), 180)
    })

    get<HTMLButtonElement>('[data-focus-files]')?.addEventListener(
      'click',
      () => {
        get<HTMLElement>('[data-files-panel]')?.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        })
        search.focus()
      }
    )

    get<HTMLButtonElement>('[data-file-back]')?.addEventListener(
      'click',
      () => {
        location.href = `${skillsBase}${route.repo}/`
      }
    )

    get<HTMLButtonElement>('[data-copy-command]')?.addEventListener(
      'click',
      async (event) => {
        const button = event.currentTarget as HTMLButtonElement
        const value = button.dataset.copy
        if (!value) return
        await navigator.clipboard.writeText(value)
        button.classList.add('is-copied')
        const label = button.querySelector<HTMLElement>('[data-command-label]')
        const before = label?.textContent || ''
        if (label) label.textContent = '已复制'
        window.setTimeout(() => {
          button.classList.remove('is-copied')
          if (label) label.textContent = before
        }, 1400)
      }
    )

    document.addEventListener('keydown', (event) => {
      if (
        event.key === '/' &&
        !(event.target instanceof HTMLInputElement) &&
        !(event.target instanceof HTMLTextAreaElement)
      ) {
        event.preventDefault()
        search.focus()
      }
    })

    if (bootstrap.readmeRaw && !hasStaticReadme) {
      renderMarkdown(bootstrap.readmeRaw)
    }
    loadOverview()
  }
</script>

