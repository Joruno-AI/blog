---
import { render } from 'astro:content'

import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import PostMeta from '~/components/base/PostMeta.astro'
import Warning from '~/components/base/Warning.astro'
import BlogCatalog from '~/components/blog/BlogCatalog.astro'
import DesktopAside from '~/components/base/DesktopAside.astro'
import MobileControl from '~/components/base/MobileControl.astro'
import PostCover from '~/components/base/PostCover.astro'
import ShareLink from '~/components/widgets/ShareLink.astro'
import PostActions from '~/components/widgets/PostActions.astro'
import Giscus from '~/components/widgets/Giscus.astro'
import ImageViewer from '~/components/widgets/ImageViewer.astro'

import {
  buildNestedCategoryTree,
  getFilteredPosts,
  getLastCategorySegment,
  getMinutesRead,
  type CategoryTreeNode,
} from '~/utils/data'
import { withBasePath } from '~/utils/path'
import { FEATURES, SITE } from '~/config'

import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog' | 'changelog' | 'shorts'>
  isCommentable?: boolean
  pageToc?: boolean
}

const { post, isCommentable = false, pageToc = true } = Astro.props
const { toc, share, giscus, search } = FEATURES

const { data: frontmatter } = post
const { Content, headings, remarkPluginFrontmatter } = await render(post)

const title = frontmatter.title
const titleIcon = frontmatter.titleIcon
const description = frontmatter.description
const ogImage = frontmatter.ogImage
const pubDate = frontmatter.pubDate.toISOString()
const lastModDate =
  frontmatter.lastModDate && frontmatter.lastModDate.toISOString()
const bgType = frontmatter.bgType
const subtitle = frontmatter.subtitle
const minutesRead = getMinutesRead(
  frontmatter.minutesRead,
  remarkPluginFrontmatter.minutesRead as number
)
const tags = frontmatter.tags
const category = frontmatter.category
const isDraft = frontmatter.draft

const cover = frontmatter.cover
const coverAlt = frontmatter.coverAlt

const tocEnabled = Array.isArray(toc) && toc[0] && frontmatter.toc && pageToc
const haveHeadings = tocEnabled && headings.length > 0
const hasEnabledShareTarget =
  Array.isArray(share) &&
  share[1] != null &&
  Object.values(share[1]).some(Boolean)
const shareEnabled =
  Array.isArray(share) && share[0] && frontmatter.share && hasEnabledShareTarget
const giscusEnabled =
  isCommentable && Array.isArray(giscus) && giscus[0] && frontmatter.giscus

const collectionType = post.collection
const isSearchable =
  Array.isArray(search) &&
  search[0] &&
  search[1].includes.includes(collectionType) &&
  frontmatter.search
const searchFilter =
  isSearchable && search[1].filter ? `collection:${collectionType}` : undefined

// Post actions (Copy MD / Open in AI) — blog posts only.
const showPostActions =
  collectionType === 'blog' && typeof post.body === 'string'
const postActionsMarkdown = showPostActions ? (post.body as string) : ''
const postActionsUrl = new URL(withBasePath(`/blog/${post.id}/`), SITE.website)
  .href

const WARNING = `This is a draft post that will not be published
in production. Set the post's <code>draft</code> property in
frontmatter to <code>false</code> or remove it to publish the post.`

function collectPostsFromTree(
  nodes: CategoryTreeNode[]
): CollectionEntry<'blog' | 'changelog'>[] {
  const posts: CollectionEntry<'blog' | 'changelog'>[] = []

  const collect = (node: CategoryTreeNode) => {
    posts.push(...node.posts)
    node.children.forEach(collect)
  }

  nodes.forEach(collect)
  return posts
}

let previousBlogPost: CollectionEntry<'blog'> | undefined
let nextBlogPost: CollectionEntry<'blog'> | undefined
let currentCategoryLabel: string | undefined
let relatedPosts: CollectionEntry<'blog'>[] = []
let blogCatalogPosts: CollectionEntry<'blog'>[] = []

if (collectionType === 'blog') {
  const blogPosts = await getFilteredPosts('blog')
  blogCatalogPosts = blogPosts
  const orderedBlogPosts = collectPostsFromTree(
    buildNestedCategoryTree(blogPosts)
  ).filter(
    (item): item is CollectionEntry<'blog'> => item.collection === 'blog'
  )
  const currentPostIndex = orderedBlogPosts.findIndex(
    (item) => item.id === post.id
  )

  if (currentPostIndex >= 0) {
    previousBlogPost = orderedBlogPosts[currentPostIndex - 1]
    nextBlogPost = orderedBlogPosts[currentPostIndex + 1]
  }

  if (category) {
    currentCategoryLabel = getLastCategorySegment(category)
  }

  // Related posts: rank other blog posts by shared-tag count, then recency.
  const currentTags = new Set(tags ?? [])
  if (currentTags.size > 0) {
    relatedPosts = blogPosts
      .filter(
        (item): item is CollectionEntry<'blog'> =>
          item.collection === 'blog' && item.id !== post.id
      )
      .map((item) => {
        const shared = (item.data.tags ?? []).filter((t) =>
          currentTags.has(t)
        ).length
        return { item, shared }
      })
      .filter(({ shared }) => shared > 0)
      .sort((a, b) => {
        if (b.shared !== a.shared) return b.shared - a.shared
        return b.item.data.pubDate.valueOf() - a.item.data.pubDate.valueOf()
      })
      .slice(0, 3)
      .map(({ item }) => item)
  }
}
---

<BaseLayout
  {title}
  {description}
  {ogImage}
  {pubDate}
  {lastModDate}
  {bgType}
  {tags}
  {category}
  stableNavigation={collectionType === 'blog'}
>
  {
    collectionType === 'blog' && (
      <BlogCatalog
        posts={blogCatalogPosts}
        mode="reader"
        activePostId={post.id}
      />
    )
  }
  <StandardLayout
    {title}
    {titleIcon}
    {subtitle}
    {isSearchable}
    {searchFilter}
    titleClass={collectionType === 'blog' ? 'blog-article-title' : undefined}
  >
    <Fragment slot="head">
      <PostMeta {pubDate} {lastModDate} {minutesRead} {tags} />
      {
        showPostActions && (
          <PostActions
            markdown={postActionsMarkdown}
            postUrl={postActionsUrl}
            {title}
          />
        )
      }
    </Fragment>
    <Fragment slot="article">
      {isDraft && <Warning html={WARNING} />}
      {
        haveHeadings && (
          <>
            <DesktopAside
              {headings}
              position={collectionType === 'blog' ? 'right' : undefined}
              context={collectionType === 'blog' ? 'blog' : undefined}
            />
            <MobileControl {headings} />
          </>
        )
      }
      <PostCover {cover} {coverAlt} />
      <Content />
      {
        relatedPosts.length > 0 && (
          <section class="related-posts" aria-label="相关文章">
            <h2 class="related-posts-title">相关文章</h2>
            <ul class="related-posts-list">
              {relatedPosts.map((item) => (
                <li>
                  <a
                    class="related-post-link"
                    href={withBasePath(`/blog/${item.id}/`)}
                  >
                    <span class="related-post-name">{item.data.title}</span>
                    {item.data.description && (
                      <span class="related-post-desc">
                        {item.data.description}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        collectionType === 'blog' && (
          <nav class="post-neighbor-nav" aria-label="文章导航">
            <a class="post-neighbor-back" href={withBasePath('/blog/')}>
              <span class="i-ri-arrow-left-line" aria-hidden="true" />
              <span>返回 Blog</span>
              {currentCategoryLabel && (
                <span class="post-neighbor-category">
                  {currentCategoryLabel}
                </span>
              )}
            </a>
            <div class="post-neighbor-links">
              {previousBlogPost ? (
                <a
                  class="post-neighbor-link"
                  href={withBasePath(`/blog/${previousBlogPost.id}/`)}
                  rel="prev"
                >
                  <span class="post-neighbor-label">上一篇</span>
                  <span class="post-neighbor-title">
                    {previousBlogPost.data.title}
                  </span>
                </a>
              ) : (
                <span class="post-neighbor-link is-disabled" aria-hidden="true">
                  <span class="post-neighbor-label">上一篇</span>
                  <span class="post-neighbor-title">已经是第一篇</span>
                </span>
              )}
              {nextBlogPost ? (
                <a
                  class="post-neighbor-link align-right"
                  href={withBasePath(`/blog/${nextBlogPost.id}/`)}
                  rel="next"
                >
                  <span class="post-neighbor-label">下一篇</span>
                  <span class="post-neighbor-title">
                    {nextBlogPost.data.title}
                  </span>
                </a>
              ) : (
                <span
                  class="post-neighbor-link align-right is-disabled"
                  aria-hidden="true"
                >
                  <span class="post-neighbor-label">下一篇</span>
                  <span class="post-neighbor-title">已经是最后一篇</span>
                </span>
              )}
            </div>
          </nav>
        )
      }
    </Fragment>
  </StandardLayout>
  <Fragment slot="share">
    {shareEnabled && <ShareLink config={share[1]} />}
  </Fragment>
  {
    giscusEnabled && (
      <div slot="giscus" class="prose mx-auto mt-8">
        <hr />
        <Giscus />
      </div>
    )
  }
  <ImageViewer selector="article" options={{ title: 0, navbar: 0 }} />
</BaseLayout>

<style>
  :global(.prose h1.blog-article-title) {
    padding-bottom: 0.08em;
    font-family: var(--font-article-title);
    font-weight: 400;
    font-style: italic;
    line-height: 1.15;
  }

  /* Let the reading column grow gradually on wide screens without turning
     paragraphs into full-viewport lines. The sidebars still retain clear
     ownership of the outer columns. */
  @media (min-width: 1280px) {
    :global(
      html:not([data-immersive])
        body:has(blog-catalog[data-mode='reader'])
        #main
        > :is(header, article).prose
    ) {
      max-width: clamp(42rem, 50vw, 60rem);
    }
  }

  @media (min-width: 1600px) {
    :global(blog-catalog[data-mode='reader'] .blog-catalog-nav) {
      left: max(2rem, calc(50vw - 49rem));
      width: 17rem;
    }

    :global(#desktop-aside[data-context='blog']) {
      right: max(2rem, calc(50vw - 49rem));
      left: auto !important;
    }
  }

  @media (min-width: 1128px) and (max-width: 1399px) {
    :global(#desktop-aside[data-context='blog']) {
      display: none;
    }

    :global(body:has(#desktop-aside[data-context='blog']) #toc-open-button) {
      opacity: 1 !important;
      pointer-events: auto;
      transform: translateY(0) scale(1);
      visibility: visible;
    }
  }

  .related-posts {
    margin-top: 3.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-border-soft);
  }

  .related-posts-title {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--c-text);
  }

  .related-posts-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Kill the global prose list bullet (::before dot) and its indent so
     cards align flush with the section title. */
  .related-posts-list li {
    padding-left: 0 !important;
  }

  .related-posts-list li::before {
    display: none !important;
  }

  .related-post-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--c-border-soft);
    border-radius: 0.6rem;
    text-decoration: none;
    background: var(--related-card-bg, transparent);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  /* Soft tinted cards, low-saturation so they sit well with the minimal
     black/white theme. Each card gets a distinct hue. */
  .related-posts-list li:nth-child(3n + 1) .related-post-link {
    --related-card-bg: hsl(210 60% 97%);
    border-color: hsl(210 45% 88%);
  }

  .related-posts-list li:nth-child(3n + 2) .related-post-link {
    --related-card-bg: hsl(150 45% 96%);
    border-color: hsl(150 35% 86%);
  }

  .related-posts-list li:nth-child(3n + 3) .related-post-link {
    --related-card-bg: hsl(270 50% 97%);
    border-color: hsl(270 35% 89%);
  }

  .related-post-link:hover {
    transform: translateY(-1px);
    filter: brightness(0.98);
  }

  /* Dark mode: dim, desaturated tints instead of bright pastels. */
  :global(html.dark)
    .related-posts-list
    li:nth-child(3n + 1)
    .related-post-link {
    --related-card-bg: hsl(210 30% 12%);
    border-color: hsl(210 25% 22%);
  }

  :global(html.dark)
    .related-posts-list
    li:nth-child(3n + 2)
    .related-post-link {
    --related-card-bg: hsl(150 25% 11%);
    border-color: hsl(150 20% 20%);
  }

  :global(html.dark)
    .related-posts-list
    li:nth-child(3n + 3)
    .related-post-link {
    --related-card-bg: hsl(270 28% 13%);
    border-color: hsl(270 22% 23%);
  }

  .related-post-name {
    font-weight: 500;
    color: var(--c-text);
  }

  .related-post-desc {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-neighbor-nav {
    margin-top: 3.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-border-soft);
  }

  .post-neighbor-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: 0.375rem;
    color: var(--c-text-muted);
    font-size: 0.875rem;
    text-decoration: none;
    border-bottom: none !important;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .post-neighbor-back:hover,
  .post-neighbor-back:focus-visible {
    background: var(--c-surface-hover);
    color: var(--c-text);
  }

  .post-neighbor-category {
    color: var(--c-text-faint);
  }

  .post-neighbor-category::before {
    content: '/';
    margin-right: 0.4rem;
    color: var(--c-border-strong);
  }

  .post-neighbor-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .post-neighbor-link {
    display: flex;
    min-width: 0;
    min-height: 5rem;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--c-border-soft) !important;
    border-radius: 0.5rem;
    color: var(--c-text-soft);
    text-decoration: none;
    background: transparent;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .post-neighbor-link:hover,
  .post-neighbor-link:focus-visible {
    background: var(--c-surface-hover);
    border-color: var(--c-border-strong) !important;
    color: var(--c-text);
    transform: translateY(-1px);
  }

  .post-neighbor-link.align-right {
    text-align: right;
  }

  .post-neighbor-link.is-disabled {
    color: var(--c-text-faint);
    opacity: 0.52;
    pointer-events: none;
  }

  .post-neighbor-label {
    color: var(--c-text-faint);
    font-size: 0.75rem;
  }

  .post-neighbor-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.95rem;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .post-neighbor-links {
      grid-template-columns: 1fr;
    }

    .post-neighbor-link.align-right {
      text-align: left;
    }
  }
</style>
