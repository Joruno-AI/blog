---
import Link from '~/components/base/Link.astro'

import { withBasePath } from '~/utils/path'
import { formatDate } from '~/utils/datetime'

interface Props {
  idx: number
  collectionType: string
  redirect?: string
  postSlug?: string
  title: string
  titleIcon?: string
  tags?: string[]
  video?: boolean
  radio?: boolean
  date: string | Date
  minutesRead?: number
  platform?: string
}

const {
  idx,
  redirect,
  collectionType,
  postSlug,
  title,
  titleIcon,
  tags,
  video,
  radio,
  date,
  minutesRead,
  platform,
} = Astro.props

// Check if titleIcon is a URL or an icon class
const isImageUrl = titleIcon ? /^https?:\/\//.test(titleIcon) : false
const iconClass =
  titleIcon && !isImageUrl
    ? titleIcon.startsWith('i-')
      ? titleIcon
      : `i-${titleIcon}`
    : undefined

const normalizedRedirect = redirect?.trim()
const href =
  normalizedRedirect || withBasePath(`/${collectionType}/${postSlug}/`)
const revealStage = idx % 5
---

<div
  class="slide-enter"
  style={{ '--enter-stage': revealStage }}
  data-tags={tags}
>
  <Link
    u-flex="~ items-center lt-md:(col items-start) gap-2"
    class="blog-list-link border-b-none! mb-5 mt-1.5 op-transition!"
    {href}
    {title}
    external={normalizedRedirect ? true : false}
    enableNewTabWarning={normalizedRedirect ? true : false}
  >
    <Fragment slot="title">
      <span class="list-item-title-row">
        {
          titleIcon &&
            (isImageUrl ? (
              <img
                src={titleIcon}
                alt=""
                class="list-item-icon inline-block h-[1.2em] w-[1.2em] align-text-bottom object-contain"
                aria-hidden="true"
              />
            ) : iconClass ? (
              <span class={`list-item-icon ${iconClass}`} aria-hidden="true" />
            ) : null)
        }
        <span class="list-item-title">{title}</span>
      </span>
    </Fragment>
    <span slot="end" u-flex="~ gap-2 items-center" class="list-item-meta">
      {
        video && (
          <span
            u-i-ri-film-line
            class="flex-none op-50 align-middle"
            title="Provided in video"
            aria-label="Provided in video"
          />
        )
      }
      {
        radio && (
          <span
            u-i-ri-radio-line
            class="flex-none op-50 align-middle"
            title="Provided in radio"
            aria-label="Provided in radio"
          />
        )
      }
      <time
        class="op-50 text-sm ws-nowrap"
        datetime={new Date(date).toISOString()}
      >
        {formatDate(date, false)}
      </time>
      {
        typeof minutesRead === 'number' && minutesRead > 0 && (
          <span class="op-40 text-sm ws-nowrap">· {minutesRead} min</span>
        )
      }
      {platform && <span class="op-40 text-sm ws-nowrap">· {platform}</span>}
      <span class="list-item-arrow i-ri-arrow-right-line" aria-hidden="true"
      ></span>
    </span>
  </Link>
</div>

<style>
  :global(.blog-list-link) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-inline-start: -0.5rem;
    padding: 0.35rem 0.5rem 0.45rem;
    border-radius: 0.55rem;
    color: var(--c-text-soft);
    opacity: 0.9 !important;
    transform: translate3d(0, 0, 0);
    transition:
      color 180ms ease,
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.blog-list-link)::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    border: 1px solid transparent;
    border-radius: inherit;
    background: var(--c-surface-soft);
    opacity: 0;
    transform: scaleX(0.985);
    transform-origin: left center;
    transition:
      border-color 180ms ease,
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.blog-list-link)::after {
    content: '';
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 0;
    width: 2px;
    border-radius: 2px;
    background: var(--c-text);
    opacity: 0;
    transform: scaleY(0.35);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.blog-list-link:hover),
  :global(.blog-list-link:focus-visible) {
    color: var(--c-text);
    opacity: 1 !important;
    transform: translate3d(0.2rem, 0, 0);
  }

  :global(.blog-list-link:hover)::before,
  :global(.blog-list-link:focus-visible)::before {
    border-color: var(--c-border-soft);
    opacity: 1;
    transform: scaleX(1);
  }

  :global(.blog-list-link:hover)::after,
  :global(.blog-list-link:focus-visible)::after {
    opacity: 0.78;
    transform: scaleY(1);
  }

  :global(.blog-list-link:active) {
    transform: translate3d(0.1rem, 1px, 0) scale(0.995);
  }

  .list-item-title-row {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.55rem;
  }

  .list-item-icon {
    flex: none;
    color: var(--c-text-muted);
    opacity: 0.72;
    transition:
      color 180ms ease,
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .list-item-title {
    min-width: 0;
    font-weight: 540;
    letter-spacing: -0.012em;
    color: inherit;
  }

  .list-item-meta {
    color: var(--c-text-faint);
    font-variant-numeric: tabular-nums;
    transition: color 180ms ease;
  }

  .list-item-arrow {
    flex: none;
    color: var(--c-text-muted);
    font-size: 0.9rem;
    opacity: 0;
    transform: translateX(-0.3rem);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.blog-list-link:hover) .list-item-meta,
  :global(.blog-list-link:focus-visible) .list-item-meta {
    color: var(--c-text-muted);
  }

  :global(.blog-list-link:hover) .list-item-icon,
  :global(.blog-list-link:focus-visible) .list-item-icon {
    color: var(--c-text);
    opacity: 1;
    transform: scale(1.04);
  }

  :global(.blog-list-link:hover) .list-item-arrow,
  :global(.blog-list-link:focus-visible) .list-item-arrow {
    opacity: 0.8;
    transform: translateX(0);
  }

  @media (max-width: 767px) {
    :global(.blog-list-link) {
      width: 100%;
      margin-inline-start: 0;
      padding: 0.55rem 0.625rem;
    }

    .list-item-arrow {
      opacity: 0.58;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.blog-list-link),
    :global(.blog-list-link)::before,
    :global(.blog-list-link)::after,
    .list-item-icon,
    .list-item-arrow {
      transition: none;
    }

    :global(.blog-list-link:hover),
    :global(.blog-list-link:focus-visible),
    :global(.blog-list-link:active) {
      transform: none;
    }
  }
</style>
