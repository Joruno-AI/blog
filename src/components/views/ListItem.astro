---
import Link from '~/components/base/Link.astro'

import { withBasePath } from '~/utils/path'
import { formatDate } from '~/utils/datetime'

interface Props {
  idx: number
  collectionType: string
  redirect?: string
  postSlug?: string
  title: string
  titleIcon?: string
  tags?: string[]
  video?: boolean
  radio?: boolean
  date: string | Date
  minutesRead?: number
  platform?: string
}

const {
  idx,
  redirect,
  collectionType,
  postSlug,
  title,
  titleIcon,
  tags,
  video,
  radio,
  date,
  minutesRead,
  platform,
} = Astro.props

// Check if titleIcon is a URL or an icon class
const isImageUrl = titleIcon ? /^https?:\/\//.test(titleIcon) : false
const iconClass =
  titleIcon && !isImageUrl
    ? titleIcon.startsWith('i-')
      ? titleIcon
      : `i-${titleIcon}`
    : undefined

const normalizedRedirect = redirect?.trim()
const href =
  normalizedRedirect || withBasePath(`/${collectionType}/${postSlug}/`)
---

<div class="slide-enter" style={{ '--enter-stage': idx }} data-tags={tags}>
  <Link
    u-flex="~ items-center lt-md:(col items-start) gap-2"
    class="blog-list-link border-b-none! mb-5 mt-1.5 op-transition!"
    {href}
    {title}
    external={normalizedRedirect ? true : false}
    enableNewTabWarning={normalizedRedirect ? true : false}
  >
    <Fragment slot="title">
      {
        titleIcon &&
          (isImageUrl ? (
            <img
              src={titleIcon}
              alt=""
              class="inline-block h-[1.2em] w-[1.2em] align-text-bottom object-contain"
              aria-hidden="true"
            />
          ) : iconClass ? (
            <span class={`${iconClass}`} aria-hidden="true" />
          ) : null)
      }
      <span class="list-item-title ml-2.5">{title}</span>
    </Fragment>
    <span slot="end" u-flex="~ gap-2 items-center" class="list-item-meta">
      {
        video && (
          <span
            u-i-ri-film-line
            class="flex-none op-50 align-middle"
            title="Provided in video"
            aria-label="Provided in video"
          />
        )
      }
      {
        radio && (
          <span
            u-i-ri-radio-line
            class="flex-none op-50 align-middle"
            title="Provided in radio"
            aria-label="Provided in radio"
          />
        )
      }
      <time
        class="op-50 text-sm ws-nowrap"
        datetime={new Date(date).toISOString()}
      >
        {formatDate(date, false)}
      </time>
      {
        typeof minutesRead === 'number' && minutesRead > 0 && (
          <span class="op-40 text-sm ws-nowrap">· {minutesRead} min</span>
        )
      }
      {platform && <span class="op-40 text-sm ws-nowrap">· {platform}</span>}
    </span>
  </Link>
</div>

<style>
  :global(.blog-list-link) {
    margin-inline-start: -0.5rem;
    padding: 0.35rem 0.5rem 0.45rem;
    border-radius: 0.375rem;
    color: var(--c-text-soft);
    opacity: 0.86 !important;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  :global(.blog-list-link:hover),
  :global(.blog-list-link:focus-visible) {
    background: var(--c-surface-hover);
    color: var(--c-text);
    opacity: 1 !important;
  }

  .list-item-title {
    font-weight: 500;
    color: inherit;
  }

  .list-item-meta {
    color: var(--c-text-faint);
    transition: color 0.2s ease;
  }

  :global(.blog-list-link:hover) .list-item-meta,
  :global(.blog-list-link:focus-visible) .list-item-meta {
    color: var(--c-text-muted);
  }

  @media (max-width: 767px) {
    :global(.blog-list-link) {
      width: 100%;
      margin-inline-start: 0;
      padding: 0.55rem 0.625rem;
    }

    /* Stacked layout: align title flush with the meta row below it
       by dropping the icon gap margin that only makes sense inline. */
    :global(.blog-list-link .list-item-title) {
      margin-left: 0;
    }
  }
</style>
