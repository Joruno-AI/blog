---
import Link from '~/components/base/Link.astro'
import {
  buildNestedCategoryTree,
  flattenCategoryTree,
  getFilteredPosts,
} from '~/utils/data'
import { withBasePath } from '~/utils/path'

import type { CollectionEntry } from 'astro:content'

type BlogDirectoryPost = CollectionEntry<'blog' | 'changelog'>

interface Props {
  currentPostId: string
}

const { currentPostId } = Astro.props

const blogItems = await getFilteredPosts('blog')
const categoryTree = buildNestedCategoryTree(blogItems)
const flattenedCategories = flattenCategoryTree(categoryTree)
const currentCategoryPath = currentPostId.split('/').slice(0, -1).join('/')

function isCurrentBranch(path: string, posts: BlogDirectoryPost[]) {
  if (posts.some((post) => post.id === currentPostId)) return true
  return (
    !!currentCategoryPath &&
    (path === currentCategoryPath || currentCategoryPath.startsWith(`${path}/`))
  )
}

function getPostHref(post: BlogDirectoryPost) {
  const redirect = post.data.redirect?.trim()
  return redirect || withBasePath(`/${post.collection}/${post.id}/`)
}

function isExternalPost(post: BlogDirectoryPost) {
  return !!post.data.redirect?.trim()
}
---

<aside class="blog-directory-aside lt-lgp:hidden" data-pagefind-ignore="all">
  <div class="blog-directory-header">
    <a href={withBasePath('/blog/')} class="blog-directory-title">Blog</a>
    <span class="blog-directory-count">{blogItems.length}</span>
  </div>
  <nav aria-label="Blog directory" class="blog-directory-nav">
    <ul>
      {
        flattenedCategories.map(
          ({ node, depth, hasChildren, totalPosts }) => {
            const expanded = isCurrentBranch(node.path, node.posts)

            return (
              <li
                class="blog-directory-group"
                data-expanded={expanded ? 'true' : 'false'}
                style={`--depth: ${depth};`}
              >
                <button
                  type="button"
                  class="blog-directory-category"
                  data-blog-directory-toggle
                  aria-expanded={expanded ? 'true' : 'false'}
                >
                  {(hasChildren || node.posts.length > 0) && (
                    <span class="blog-directory-arrow i-ri-arrow-right-s-line" />
                  )}
                  <span class="blog-directory-name">{node.name}</span>
                  <span class="blog-directory-total">({totalPosts})</span>
                </button>
                {node.posts.length > 0 && (
                  <ul class="blog-directory-posts">
                    {node.posts.map((post) => {
                      const isCurrent = post.id === currentPostId

                      return (
                        <li>
                          <Link
                            href={getPostHref(post)}
                            external={isExternalPost(post)}
                            enableNewTabWarning={isExternalPost(post)}
                            aria-current={isCurrent ? 'page' : undefined}
                            class="blog-directory-post"
                          >
                            {post.data.title}
                          </Link>
                        </li>
                      )
                    })}
                  </ul>
                )}
              </li>
            )
          }
        )
      }
    </ul>
  </nav>
</aside>

<style>
  .blog-directory-aside {
    position: fixed;
    top: 5.5rem;
    bottom: 1rem;
    left: 2rem;
    z-index: 90;
    display: flex;
    width: 15.625rem;
    flex-direction: column;
    overflow: hidden;
    font-size: 0.875rem;
  }

  .blog-directory-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0 0.75rem 0.625rem 0.5rem;
    color: var(--c-text);
  }

  .blog-directory-title {
    border-bottom: none;
    color: inherit;
    font-weight: 600;
    opacity: 0.72;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .blog-directory-title:hover {
    opacity: 1;
  }

  .blog-directory-count {
    color: inherit;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.48;
  }

  .blog-directory-nav {
    min-height: 0;
    overflow-y: auto;
    padding-right: 0.75rem;
    scrollbar-color: rgba(125, 125, 125, 0.3) transparent;
    scrollbar-width: thin;
  }

  .blog-directory-nav::-webkit-scrollbar {
    width: 4px;
  }

  .blog-directory-nav::-webkit-scrollbar-thumb {
    border-radius: 2px;
    background: rgba(125, 125, 125, 0.25);
  }

  .blog-directory-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog-directory-group {
    margin-bottom: 0.25rem;
  }

  .blog-directory-category {
    display: flex;
    min-height: 2rem;
    width: 100%;
    align-items: center;
    gap: 0.25rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: 0.875rem;
    opacity: 0.82;
    padding: 0.375rem 0.5rem 0.375rem
      calc(0.5rem + var(--depth) * 0.75rem);
    text-align: left;
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
  }

  .blog-directory-category:hover,
  .blog-directory-group[data-expanded='true'] > .blog-directory-category {
    background: rgba(125, 125, 125, 0.08);
    opacity: 1;
  }

  :global(.dark)
    .blog-directory-group[data-expanded='true']
    > .blog-directory-category,
  :global(.dark) .blog-directory-category:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .blog-directory-arrow {
    flex: none;
    font-size: 1rem;
    transition: transform 0.2s ease;
  }

  .blog-directory-group[data-expanded='true']
    > .blog-directory-category
    .blog-directory-arrow {
    transform: rotate(90deg);
  }

  .blog-directory-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .blog-directory-total {
    flex: none;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.68;
  }

  .blog-directory-posts {
    display: none;
    padding-left: calc(1.5rem + var(--depth) * 0.75rem) !important;
  }

  .blog-directory-group[data-expanded='true'] > .blog-directory-posts {
    display: block;
  }

  .blog-directory-posts li {
    margin: 0;
    padding: 0.125rem 0;
  }

  .blog-directory-post {
    display: block;
    overflow: hidden;
    border-bottom: none;
    border-radius: 4px;
    color: inherit;
    font-size: 0.8125rem;
    opacity: 0.68;
    padding: 0.125rem 0.25rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
  }

  .blog-directory-post:hover,
  .blog-directory-post[aria-current='page'] {
    background: rgba(125, 125, 125, 0.08);
    opacity: 1 !important;
  }

  .blog-directory-post[aria-current='page'] {
    font-weight: 600;
  }

  @media (max-width: 1279px) {
    .blog-directory-aside {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggles = document.querySelectorAll<HTMLElement>(
      '[data-blog-directory-toggle]'
    )

    toggles.forEach((toggle) => {
      if (toggle.dataset.initialized === 'true') return
      toggle.dataset.initialized = 'true'

      toggle.addEventListener('click', () => {
        const group = toggle.closest<HTMLElement>('.blog-directory-group')
        if (!group) return

        const expanded = group.dataset.expanded === 'true'
        group.dataset.expanded = expanded ? 'false' : 'true'
        toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true')
      })
    })
  })
</script>
