---
import {
  buildNestedCategoryTree,
  flattenCategoryTree,
  type CategoryTreeNode,
} from '~/utils/data'
import { withBasePath } from '~/utils/path'

import type { CollectionEntry } from 'astro:content'

interface Props {
  posts: CollectionEntry<'blog'>[]
  mode?: 'filter' | 'reader'
  activePostId?: string
}

const { posts, mode = 'filter', activePostId } = Astro.props
const categoryTree = buildNestedCategoryTree(posts)
const flattenedCategories = flattenCategoryTree(categoryTree)
const blogHref = withBasePath('/blog/')

function findPostNode(
  nodes: CategoryTreeNode[],
  postId: string | undefined
): CategoryTreeNode | undefined {
  if (!postId) return undefined

  for (const node of nodes) {
    if (node.posts.some((post) => post.id === postId)) return node
    const childMatch = findPostNode(node.children, postId)
    if (childMatch) return childMatch
  }

  return undefined
}

const activeNode = findPostNode(categoryTree, activePostId)
const activeCategoryPath = activeNode?.path
const categoryHref = (path: string) =>
  `${blogHref}?category=${encodeURIComponent(path)}`
const shouldShowPosts = (node: CategoryTreeNode) => node.posts.length > 0
const isActiveBranch = (path: string) =>
  !!activeCategoryPath &&
  (activeCategoryPath === path || activeCategoryPath.startsWith(`${path}/`))
---

<blog-catalog data-mode={mode} data-active-category={activeCategoryPath}>
  <aside class="category-sidebar lt-lgp:hidden">
    <nav
      class="toc-desktop toc-desktop-content blog-catalog-nav"
      aria-label="博客目录"
    >
      <div class="catalog-heading">
        <a
          href={blogHref}
          class="catalog-home"
          aria-current={mode === 'filter' ? 'page' : undefined}
        >
          <span class="i-ri-book-open-line" aria-hidden="true"></span>
          <span>Blog</span>
          <span class="catalog-total">{posts.length}</span>
        </a>
      </div>

      <div class="search-box" id="blog-catalog-search-box">
        <button
          type="button"
          class="search-trigger"
          id="blog-catalog-search-trigger"
          aria-label="搜索目录"
        >
          <span class="i-ri-search-line" aria-hidden="true"></span>
        </button>
        <input
          type="search"
          class="search-input"
          id="blog-catalog-search-input"
          aria-label="搜索博客文章"
          placeholder="搜索文章"
          autocomplete="off"
        />
        <button
          type="button"
          class="search-clear hidden"
          id="blog-catalog-search-clear"
          aria-label="清除搜索"
        >
          <span class="i-ri-close-line" aria-hidden="true"></span>
        </button>
      </div>

      <ul id="blog-filter-toc-list" class="category-nav">
        <li class="category-group" data-depth="0">
          {
            mode === 'filter' ? (
              <button
                type="button"
                class="category-header active"
                data-category="all"
              >
                <span class="category-name">全部</span>
                <span class="category-count">({posts.length})</span>
              </button>
            ) : (
              <a class="category-header" href={blogHref}>
                <span class="i-ri-layout-grid-line" aria-hidden="true" />
                <span class="category-name">全部文章</span>
                <span class="category-count">({posts.length})</span>
              </a>
            )
          }
        </li>

        {
          flattenedCategories.map(
            ({ node, depth, hasChildren, totalPosts }) => {
              const isCurrent = node.path === activeCategoryPath
              const inActiveBranch = isActiveBranch(node.path)
              const renderPosts = shouldShowPosts(node)

              return (
                <li
                  class="category-group"
                  data-depth={depth}
                  data-path={node.path}
                >
                  {mode === 'filter' ? (
                    <button
                      type="button"
                      class="category-header"
                      data-category={node.path}
                      data-has-children={hasChildren || node.posts.length > 0}
                      style={`padding-left: ${depth * 0.75}rem`}
                    >
                      {(hasChildren || node.posts.length > 0) && (
                        <span
                          class="expand-icon i-ri-arrow-right-s-line"
                          aria-hidden="true"
                        />
                      )}
                      <span class="category-name">{node.name}</span>
                      <span class="category-count">({totalPosts})</span>
                    </button>
                  ) : (
                    <a
                      href={categoryHref(node.path)}
                      class:list={[
                        'category-header',
                        { 'active': isCurrent, 'is-parent': inActiveBranch },
                      ]}
                      aria-current={isCurrent ? 'location' : undefined}
                      style={`padding-left: ${depth * 0.75}rem`}
                    >
                      {(hasChildren || node.posts.length > 0) && (
                        <span
                          class:list={[
                            'expand-icon i-ri-arrow-right-s-line',
                            { expanded: isCurrent },
                          ]}
                          aria-hidden="true"
                        />
                      )}
                      <span class="category-name">{node.name}</span>
                      <span class="category-count">({totalPosts})</span>
                    </a>
                  )}

                  {renderPosts && (
                    <ul
                      class:list={[
                        'category-posts',
                        { expanded: mode === 'reader' && isCurrent },
                      ]}
                      style={`padding-left: ${depth * 0.75 + 1.25}rem`}
                    >
                      {node.posts.map((post) => (
                        <li>
                          <a
                            href={withBasePath(`/blog/${post.id}/`)}
                            class:list={[
                              'post-link',
                              { active: post.id === activePostId },
                            ]}
                            aria-current={
                              post.id === activePostId ? 'page' : undefined
                            }
                            title={post.data.title}
                          >
                            {post.data.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              )
            }
          )
        }
      </ul>
    </nav>
  </aside>

  <button
    type="button"
    class="category-drawer-trigger floating-tool-button hidden lt-lgp:flex"
    aria-label="打开博客目录"
    aria-expanded="false"
    data-catalog-open
  >
    <span
      class="drawer-trigger-icon drawer-trigger-icon-collapsed i-lucide-panel-left-open"
      aria-hidden="true"></span>
    <span
      class="drawer-trigger-icon drawer-trigger-icon-expanded i-lucide-panel-left-close"
      aria-hidden="true"></span>
  </button>

  <div
    class="category-drawer hidden lt-lgp:block"
    aria-hidden="true"
    inert
    data-catalog-drawer
  >
    <button
      type="button"
      class="drawer-overlay"
      aria-label="关闭博客目录"
      data-catalog-close></button>
    <div
      class="drawer-content"
      role="dialog"
      aria-modal="true"
      aria-label="博客目录"
    >
      <div class="drawer-header">
        <div
          class="search-box mobile-search-box"
          id="blog-catalog-mobile-search-box"
        >
          <button
            type="button"
            class="search-trigger"
            id="blog-catalog-mobile-search-trigger"
            aria-label="搜索目录"
          >
            <span class="i-ri-search-line" aria-hidden="true"></span>
          </button>
          <input
            type="search"
            class="search-input"
            id="blog-catalog-mobile-search-input"
            aria-label="搜索博客文章"
            placeholder="搜索文章"
            autocomplete="off"
          />
          <button
            type="button"
            class="search-clear hidden"
            id="blog-catalog-mobile-search-clear"
            aria-label="清除搜索"
          >
            <span class="i-ri-close-line" aria-hidden="true"></span>
          </button>
        </div>
        <button
          type="button"
          class="drawer-close"
          aria-label="关闭博客目录"
          data-catalog-close
        >
          <span class="i-ri-arrow-left-s-line text-xl" aria-hidden="true"
          ></span>
        </button>
      </div>

      <ul class="category-nav mobile-nav">
        <li class="category-group" data-depth="0">
          {
            mode === 'filter' ? (
              <button
                type="button"
                class="category-header active"
                data-category="all"
              >
                <span class="category-name">全部</span>
                <span class="category-count">({posts.length})</span>
              </button>
            ) : (
              <a class="category-header" href={blogHref}>
                <span class="i-ri-layout-grid-line" aria-hidden="true" />
                <span class="category-name">全部文章</span>
                <span class="category-count">({posts.length})</span>
              </a>
            )
          }
        </li>

        {
          flattenedCategories.map(
            ({ node, depth, hasChildren, totalPosts }) => {
              const isCurrent = node.path === activeCategoryPath
              const inActiveBranch = isActiveBranch(node.path)
              const renderPosts = shouldShowPosts(node)

              return (
                <li
                  class="category-group"
                  data-depth={depth}
                  data-path={node.path}
                >
                  {mode === 'filter' ? (
                    <button
                      type="button"
                      class="category-header"
                      data-category={node.path}
                      data-has-children={hasChildren || node.posts.length > 0}
                      style={`padding-left: ${depth * 0.75}rem`}
                    >
                      {(hasChildren || node.posts.length > 0) && (
                        <span
                          class="expand-icon i-ri-arrow-right-s-line"
                          aria-hidden="true"
                        />
                      )}
                      <span class="category-name">{node.name}</span>
                      <span class="category-count">({totalPosts})</span>
                    </button>
                  ) : (
                    <a
                      href={categoryHref(node.path)}
                      class:list={[
                        'category-header',
                        { 'active': isCurrent, 'is-parent': inActiveBranch },
                      ]}
                      aria-current={isCurrent ? 'location' : undefined}
                      style={`padding-left: ${depth * 0.75}rem`}
                    >
                      {(hasChildren || node.posts.length > 0) && (
                        <span
                          class:list={[
                            'expand-icon i-ri-arrow-right-s-line',
                            { expanded: isCurrent },
                          ]}
                          aria-hidden="true"
                        />
                      )}
                      <span class="category-name">{node.name}</span>
                      <span class="category-count">({totalPosts})</span>
                    </a>
                  )}

                  {renderPosts && (
                    <ul
                      class:list={[
                        'category-posts',
                        { expanded: mode === 'reader' && isCurrent },
                      ]}
                      style={`padding-left: ${depth * 0.75 + 1.25}rem`}
                    >
                      {node.posts.map((post) => (
                        <li>
                          <a
                            href={withBasePath(`/blog/${post.id}/`)}
                            class:list={[
                              'post-link',
                              { active: post.id === activePostId },
                            ]}
                            aria-current={
                              post.id === activePostId ? 'page' : undefined
                            }
                            title={post.data.title}
                          >
                            {post.data.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              )
            }
          )
        }
      </ul>
    </div>
  </div>
</blog-catalog>

<style>
  .catalog-heading {
    flex-shrink: 0;
    padding: 0 0.25rem 0.75rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--c-border-soft);
  }

  .catalog-home,
  .drawer-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-text);
    font-size: 0.925rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    border-bottom: 0 !important;
  }

  .catalog-home {
    min-height: 2rem;
    padding: 0.25rem 0.35rem;
    border-radius: 6px;
  }

  .catalog-home:hover,
  .catalog-home:focus-visible {
    background: var(--c-surface-hover);
  }

  .catalog-total {
    margin-left: auto;
    color: var(--c-text-faint);
    font-size: 0.75rem;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .search-box {
    position: relative;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    height: 2rem;
    margin-bottom: 0.75rem;
    cursor: text;
  }

  .search-box::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 2rem;
    height: 1px;
    background: currentColor;
    opacity: 0.2;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .search-box.expanded::after {
    transform: scaleX(1);
  }

  .search-trigger,
  .search-clear,
  .drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .search-trigger {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: 50%;
    font-size: 1rem;
    opacity: 0.65;
  }

  .search-trigger:hover,
  .search-trigger:focus-visible,
  .search-clear:hover,
  .search-clear:focus-visible,
  .drawer-close:hover,
  .drawer-close:focus-visible {
    background: var(--c-surface-hover);
    opacity: 1;
  }

  .search-box.expanded .search-trigger {
    opacity: 0.6;
    pointer-events: none;
  }

  .search-input {
    position: absolute;
    right: 1.5rem;
    left: 2rem;
    padding: 0.25rem 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 0.8125rem;
    outline: none;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .search-box.expanded .search-input {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  .search-input::placeholder {
    color: inherit;
    opacity: 0.5;
  }

  .search-input::-webkit-search-cancel-button,
  .search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .search-clear {
    position: absolute;
    right: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    font-size: 0.75rem;
    opacity: 0;
  }

  .search-box.expanded .search-clear:not(.hidden) {
    opacity: 0.55;
  }

  .search-clear.hidden,
  .search-no-match {
    display: none !important;
  }

  .category-nav {
    max-height: calc(100vh - 10rem);
    margin: 0;
    padding: 0 0.75rem 0 0;
    overflow-y: auto;
    list-style: none;
    /* The shared desktop TOC fades its list until hover. The blog catalog is
       persistent navigation, so keep its hierarchy crisp at all times. */
    opacity: 1 !important;
    scrollbar-color: var(--c-border-strong) transparent;
    scrollbar-width: thin;
  }

  .category-nav::-webkit-scrollbar {
    width: 4px;
  }

  .category-nav::-webkit-scrollbar-thumb {
    border-radius: 2px;
    background: var(--c-border-strong);
  }

  .category-group {
    margin: 0 0 0.25rem;
    padding-left: 0 !important;
  }

  .category-group::before,
  .category-posts li::before {
    display: none !important;
    content: none !important;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    width: 100%;
    min-height: 2rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid transparent !important;
    border-radius: 6px;
    background: none;
    color: var(--c-text-soft);
    font-size: 0.875rem;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    opacity: 1 !important;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .category-header:hover,
  .category-header:focus-visible {
    background: var(--c-surface-hover);
    color: var(--c-text);
  }

  .category-header.active {
    border-color: var(--c-border-soft) !important;
    background: var(--c-surface-active);
    color: var(--c-text);
    font-weight: 600;
  }

  .category-header.is-parent:not(.active) {
    color: var(--c-text);
    font-weight: 500;
  }

  .expand-icon {
    flex-shrink: 0;
    font-size: 1rem;
    opacity: 0.72;
    transition: transform 0.2s ease;
  }

  .category-header.expanded .expand-icon,
  .expand-icon.expanded {
    transform: rotate(90deg);
  }

  .category-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .category-count {
    flex-shrink: 0;
    padding-right: 0.5rem;
    color: var(--c-text-faint);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .category-posts {
    max-height: 0;
    margin: 0;
    padding-left: 1.25rem;
    overflow: hidden;
    list-style: none;
    transition: max-height 0.25s ease;
  }

  .category-posts.expanded {
    max-height: 2000px;
  }

  .category-posts li {
    margin: 0;
    padding: 0.2rem 0 0.2rem 0 !important;
  }

  .post-link {
    display: block;
    overflow: hidden;
    padding: 0.2rem 0.4rem;
    border: 0 !important;
    border-radius: 4px;
    color: var(--c-text-muted);
    font-size: 0.8125rem;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 1 !important;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .post-link:hover,
  .post-link:focus-visible {
    background: var(--c-surface-hover);
    color: var(--c-text);
  }

  .post-link.active {
    background: var(--c-surface-active);
    color: var(--c-text);
    font-weight: 600;
  }

  .category-drawer-trigger {
    --blog-drawer-width: min(82vw, 20rem);

    z-index: 202;
    top: 50%;
    bottom: auto;
    left: -0.9375rem;
    width: 1.875rem;
    height: 1.875rem;
    transform: translateY(-50%);
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease;
    will-change: transform;
  }

  .drawer-trigger-icon {
    position: absolute;
    font-size: 1rem !important;
    transition:
      opacity 180ms ease,
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .drawer-trigger-icon-collapsed {
    opacity: 1;
    transform: scale(1);
  }

  .drawer-trigger-icon-expanded {
    opacity: 0;
    transform: scale(0.72);
  }

  .category-drawer-trigger[aria-expanded='true'] {
    transform: translate(var(--blog-drawer-width), -50%);
  }

  .category-drawer-trigger[aria-expanded='true']
    .drawer-trigger-icon-collapsed {
    opacity: 0;
    transform: scale(0.72);
  }

  .category-drawer-trigger[aria-expanded='true'] .drawer-trigger-icon-expanded {
    opacity: 1;
    transform: scale(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .category-drawer-trigger:not([aria-expanded='true']):hover {
      transform: translate(50%, -50%);
    }
  }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    border: 0;
    background: rgb(0 0 0 / 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .drawer-content {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 201;
    display: flex;
    flex-direction: column;
    width: min(82vw, 20rem);
    border-right: 1px solid var(--c-border-soft);
    background: var(--c-bg);
    box-shadow: 2px 0 16px rgb(0 0 0 / 0.14);
    transform: translateX(-100%);
    transition: transform 0.25s ease;
  }

  .category-drawer.open .drawer-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .category-drawer.open .drawer-content {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--c-border-soft);
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
  }

  .drawer-title {
    flex: 1;
  }

  .drawer-close {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: 6px;
    opacity: 0.65;
  }

  .mobile-search-box {
    flex: 1;
    margin: 0 0.5rem 0 0;
  }

  .mobile-nav {
    flex: 1;
    max-height: none;
    padding: 1rem;
  }

  .mobile-nav .category-header {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  :global(html[data-immersive]) .category-sidebar {
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer-overlay,
    .drawer-content,
    .category-drawer-trigger,
    .drawer-trigger-icon,
    .category-posts,
    .expand-icon {
      transition-duration: 1ms;
    }
  }
</style>

<script>
  let readerCatalogScrollState:
    { category: string; positions: number[] } | undefined

  class BlogCatalogElement extends HTMLElement {
    private controller?: AbortController

    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      const { signal } = this.controller
      const categoryNavs = Array.from(
        this.querySelectorAll<HTMLElement>('.category-nav')
      )

      if (
        this.dataset.mode === 'reader' &&
        this.dataset.activeCategory &&
        readerCatalogScrollState?.category === this.dataset.activeCategory
      ) {
        categoryNavs.forEach((nav, index) => {
          nav.scrollTop = readerCatalogScrollState?.positions[index] ?? 0
        })
      }

      document.addEventListener(
        'astro:before-swap',
        () => {
          if (this.dataset.mode !== 'reader') return

          readerCatalogScrollState = {
            category: this.dataset.activeCategory ?? '',
            positions: categoryNavs.map((nav) => nav.scrollTop),
          }
        },
        { signal }
      )

      if (this.dataset.mode === 'reader') {
        this.setupReaderSearch(signal)
      }

      const trigger = this.querySelector<HTMLButtonElement>(
        '[data-catalog-open]'
      )
      const drawer = this.querySelector<HTMLElement>('[data-catalog-drawer]')
      const closeButtons = this.querySelectorAll('[data-catalog-close]')
      const drawerLinks = drawer?.querySelectorAll('a') ?? []

      const close = (restoreFocus = false) => {
        drawer?.classList.remove('open')
        drawer?.setAttribute('aria-hidden', 'true')
        drawer?.setAttribute('inert', '')
        trigger?.setAttribute('aria-expanded', 'false')
        trigger?.setAttribute('aria-label', '打开博客目录')
        document.documentElement.style.removeProperty('overflow')
        if (restoreFocus) trigger?.focus()
      }

      const open = () => {
        drawer?.classList.add('open')
        drawer?.setAttribute('aria-hidden', 'false')
        drawer?.removeAttribute('inert')
        trigger?.setAttribute('aria-expanded', 'true')
        trigger?.setAttribute('aria-label', '关闭博客目录')
        document.documentElement.style.overflow = 'hidden'
        drawer?.querySelector<HTMLButtonElement>('.drawer-close')?.focus()
      }

      trigger?.addEventListener(
        'click',
        () => (drawer?.classList.contains('open') ? close() : open()),
        { signal }
      )
      closeButtons.forEach((button) => {
        button.addEventListener('click', () => close(true), { signal })
      })
      drawerLinks.forEach((link) => {
        link.addEventListener('click', () => close(), { signal })
      })
      document.addEventListener(
        'keydown',
        (event) => {
          if (!drawer?.classList.contains('open')) return

          if (event.key === 'Escape') {
            close(true)
            return
          }

          if (event.key === 'Tab') {
            const focusable = Array.from(
              drawer.querySelectorAll<HTMLElement>(
                '.drawer-title[href], .search-trigger, .search-box.expanded .search-input, .search-box.expanded .search-clear:not(.hidden), .drawer-close, .category-header, .category-posts.expanded .post-link'
              )
            ).filter((element) => element.getClientRects().length > 0)
            const first = focusable[0]
            const last = focusable.at(-1)

            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault()
              last?.focus()
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault()
              first?.focus()
            }
          }
        },
        { signal }
      )
    }

    private setupReaderSearch(signal: AbortSignal) {
      const searchBoxes = Array.from(
        this.querySelectorAll<HTMLElement>('.search-box')
      )
      const searchInputs = searchBoxes
        .map((box) => box.querySelector<HTMLInputElement>('.search-input'))
        .filter((input): input is HTMLInputElement => !!input)
      const clearButtons = searchBoxes
        .map((box) => box.querySelector<HTMLButtonElement>('.search-clear'))
        .filter((button): button is HTMLButtonElement => !!button)

      const filterCatalog = (value: string) => {
        const keyword = value.trim().toLowerCase()

        this.querySelectorAll<HTMLElement>('.category-group').forEach(
          (group) => {
            const category = group.dataset.path
            const header = group.querySelector<HTMLElement>('.category-header')
            const posts = group.querySelector<HTMLElement>('.category-posts')

            if (!category) {
              group.classList.toggle('search-no-match', !!keyword)
              return
            }

            const categoryName =
              header?.querySelector('.category-name')?.textContent ?? ''
            const categoryMatches = categoryName.toLowerCase().includes(keyword)
            let hasMatchingPost = false

            posts?.querySelectorAll<HTMLElement>('li').forEach((item) => {
              const matches =
                !keyword ||
                categoryMatches ||
                (item.textContent ?? '').toLowerCase().includes(keyword)
              item.classList.toggle('search-no-match', !matches)
              hasMatchingPost ||= matches
            })

            if (keyword) {
              const matches = categoryMatches || hasMatchingPost
              group.classList.toggle('search-no-match', !matches)
              posts?.classList.toggle('expanded', matches)
              header?.classList.toggle('expanded', matches)
            } else {
              const isActive = category === this.dataset.activeCategory
              group.classList.remove('search-no-match')
              posts?.classList.toggle('expanded', isActive)
              header?.classList.remove('expanded')
            }
          }
        )
      }

      const syncSearch = (value: string) => {
        searchInputs.forEach((input) => {
          input.value = value
        })
        clearButtons.forEach((button) => {
          button.classList.toggle('hidden', !value)
        })
        filterCatalog(value)
      }

      searchBoxes.forEach((box) => {
        const input = box.querySelector<HTMLInputElement>('.search-input')
        const clearButton =
          box.querySelector<HTMLButtonElement>('.search-clear')
        if (!input) return

        const expand = () => {
          box.classList.add('expanded')
          window.setTimeout(() => input.focus(), 50)
        }

        box.addEventListener(
          'click',
          (event) => {
            if ((event.target as HTMLElement).closest('.search-clear')) return
            expand()
          },
          { signal }
        )
        input.addEventListener('focus', expand, { signal })
        input.addEventListener(
          'blur',
          () => {
            window.setTimeout(() => {
              if (!input.value && document.activeElement !== input) {
                box.classList.remove('expanded')
              }
            }, 150)
          },
          { signal }
        )
        input.addEventListener('input', () => syncSearch(input.value), {
          signal,
        })
        clearButton?.addEventListener(
          'click',
          (event) => {
            event.stopPropagation()
            syncSearch('')
            searchBoxes.forEach((searchBox) => {
              searchBox.classList.remove('expanded')
            })
          },
          { signal }
        )
      })
    }

    disconnectedCallback() {
      this.controller?.abort()
      document.documentElement.style.removeProperty('overflow')
    }
  }

  if (!customElements.get('blog-catalog')) {
    customElements.define('blog-catalog', BlogCatalogElement)
  }
</script>
