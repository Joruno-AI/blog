---
interface Props {
  audioUrl?: string
  narrator?: string
  duration?: number
  size?: number
  title?: string
  dynamic?: boolean
  id?: string
  status?: string
  podcastApiUrl?: string
  podcastSlug?: string
}

const {
  audioUrl = '',
  narrator = 'AI 双人播客',
  duration = 0,
  size = 0,
  title = '文章播客讲解',
  id,
  status = audioUrl ? 'ready' : 'none',
  podcastApiUrl = '',
  podcastSlug = '',
} = Astro.props

const isHidden = !audioUrl
---

<article-audio-player
  {id}
  class="article-audio-player"
  data-src={audioUrl || undefined}
  data-narrator={narrator}
  data-duration={duration || undefined}
  data-size={size || undefined}
  data-title={title}
  data-status={audioUrl ? 'ready' : status}
  data-podcast-api-url={podcastApiUrl || undefined}
  data-podcast-slug={podcastSlug || undefined}
  hidden={isHidden ? true : undefined}
>
  <audio preload="metadata" src={audioUrl || undefined}>
    <track
      kind="captions"
      src="/audio/empty-captions.vtt"
      srclang="zh"
      label="中文"
      default
    />
  </audio>

  <button
    class="article-audio-toggle"
    type="button"
    aria-label="播放播客讲解"
    data-audio-toggle
    disabled={!audioUrl}
  >
    <span class="article-audio-play i-ri-play-fill" aria-hidden="true"></span>
    <span class="article-audio-pause i-ri-pause-fill" aria-hidden="true"></span>
  </button>

  <div class="article-audio-main">
    <div class="article-audio-line">
      <div class="article-audio-progress-row">
        <output class="article-audio-current" data-audio-current>00:00</output>
        <label class="article-audio-range-wrap">
          <span class="sr-only">播客播放进度</span>
          <input
            class="article-audio-range"
            type="range"
            min="0"
            max={duration || 0}
            value="0"
            step="0.1"
            data-audio-range
          />
        </label>
        <output class="article-audio-duration" data-audio-duration>--:--</output
        >
      </div>

      <label class="article-audio-speed-wrap">
        <span class="sr-only">播放速度</span>
        <select class="article-audio-speed" data-audio-speed>
          <option value="0.75">0.75×</option>
          <option value="1" selected>1.0×</option>
          <option value="1.25">1.25×</option>
          <option value="1.5">1.5×</option>
          <option value="2">2.0×</option>
        </select>
      </label>
    </div>

    <dl class="sr-only">
      <div>
        <dt>播放状态</dt>
        <dd data-audio-narrator>音频讲解</dd>
      </div>
      <div data-audio-size-item hidden={!size}>
        <dt>音频</dt>
        <dd data-audio-size></dd>
      </div>
    </dl>
  </div>
</article-audio-player>

<script>
  class ArticleAudioPlayer extends HTMLElement {
    static observedAttributes = [
      'data-src',
      'data-narrator',
      'data-duration',
      'data-size',
      'data-title',
      'data-status',
    ]

    private audio!: HTMLAudioElement
    private toggle!: HTMLButtonElement
    private range!: HTMLInputElement
    private current!: HTMLOutputElement
    private durationOutput!: HTMLElement
    private narratorOutput!: HTMLElement
    private sizeOutput!: HTMLElement
    private sizeItem!: HTMLElement
    private speed!: HTMLSelectElement
    private initialized = false
    private podcastPollTimer?: number
    private podcastRequestStarted = false

    connectedCallback() {
      if (!this.initialized) {
        this.audio = this.querySelector('audio')!
        this.toggle = this.querySelector('[data-audio-toggle]')!
        this.range = this.querySelector('[data-audio-range]')!
        this.current = this.querySelector('[data-audio-current]')!
        this.durationOutput = this.querySelector('[data-audio-duration]')!
        this.narratorOutput = this.querySelector('[data-audio-narrator]')!
        this.sizeOutput = this.querySelector('[data-audio-size]')!
        this.sizeItem = this.querySelector('[data-audio-size-item]')!
        this.speed = this.querySelector('[data-audio-speed]')!

        this.toggle.addEventListener('click', this.handleToggle)
        this.range.addEventListener('input', this.handleSeek)
        this.speed.addEventListener('change', this.handleSpeed)
        this.audio.addEventListener('loadedmetadata', this.syncDuration)
        this.audio.addEventListener('durationchange', this.syncDuration)
        this.audio.addEventListener('timeupdate', this.syncProgress)
        this.audio.addEventListener('play', this.syncPlaybackState)
        this.audio.addEventListener('pause', this.syncPlaybackState)
        this.audio.addEventListener('ended', this.syncPlaybackState)
        this.audio.addEventListener('error', this.handleError)
        this.initialized = true
      }

      this.syncConfiguration()
      if (!this.podcastRequestStarted && this.dataset.podcastApiUrl) {
        this.podcastRequestStarted = true
        void this.ensureRemotePodcast()
      }
    }

    disconnectedCallback() {
      this.audio?.pause()
      if (this.podcastPollTimer) window.clearTimeout(this.podcastPollTimer)
      this.podcastRequestStarted = false
    }

    attributeChangedCallback() {
      if (this.initialized) this.syncConfiguration()
    }

    private handleToggle = async () => {
      if (!this.audio.src) return
      if (this.audio.paused) {
        document
          .querySelectorAll<ArticleAudioPlayer>('article-audio-player')
          .forEach((player) => {
            if (player !== this) player.pause()
          })
        try {
          await this.audio.play()
        } catch {
          this.handleError()
        }
      } else {
        this.audio.pause()
      }
    }

    private handleSeek = () => {
      if (!Number.isFinite(this.audio.duration)) return
      this.audio.currentTime = Number(this.range.value)
      this.syncProgress()
    }

    private handleSpeed = (event: Event) => {
      const select = event.currentTarget as HTMLSelectElement
      this.audio.playbackRate = Number(select.value) || 1
    }

    private syncConfiguration() {
      const source = this.dataset.src || ''
      const status = this.dataset.status || (source ? 'ready' : 'none')
      const processing = [
        'pending',
        'scripting',
        'synthesizing',
        'uploading',
      ].includes(status)
      const sourceUrl = source ? new URL(source, window.location.href).href : ''
      if (sourceUrl !== this.audio.src) {
        this.audio.pause()
        delete this.dataset.error
        this.audio.removeAttribute('src')
        if (source) this.audio.src = source
        this.audio.load()
        this.range.value = '0'
        this.current.textContent = '00:00'
      }

      this.hidden = !source
      this.toggle.disabled = !source
      this.range.disabled = !source
      this.speed.disabled = !source
      this.toggle.setAttribute('aria-busy', processing ? 'true' : 'false')
      this.narratorOutput.textContent = processing
        ? (
            {
              pending: '已进入本地生成队列',
              scripting: 'Ollama 正在生成双人脚本',
              synthesizing: '正在合成主持人和嘉宾语音',
              uploading: '音频已生成，正在上传',
            } as Record<string, string>
          )[status] || '正在生成播客'
        : '双人对谈'
      this.narratorOutput.title = processing
        ? this.narratorOutput.textContent || ''
        : this.dataset.narrator || 'AI 双人播客'
      const configuredDuration = Number(this.dataset.duration) || 0
      if (configuredDuration) {
        this.range.max = String(configuredDuration)
        this.durationOutput.textContent = this.formatTime(configuredDuration)
      } else {
        this.range.max = '0'
        this.durationOutput.textContent = processing ? '生成中' : '--:--'
      }

      const size = Number(this.dataset.size) || 0
      this.sizeItem.hidden = !size
      this.sizeOutput.textContent = size ? this.formatSize(size) : ''
      const title = this.dataset.title || '文章播客讲解'
      this.toggle.setAttribute(
        'aria-label',
        processing
          ? `正在生成《${title}》的播客讲解`
          : `播放《${title}》的播客讲解`
      )
      this.syncPlaybackState()
      this.syncRangeFill()
    }

    private applyRemotePodcast(podcast: {
      status?: string
      audioUrl?: string | null
      narrator?: string | null
      duration?: number | null
      size?: number | null
    }) {
      if (podcast.status === 'ready' && podcast.audioUrl) {
        this.dataset.src = podcast.audioUrl
        this.dataset.status = 'ready'
        this.dataset.narrator = podcast.narrator || 'AI 双人播客'
        this.dataset.duration = String(podcast.duration || 0)
        this.dataset.size = String(podcast.size || 0)
        return
      }

      if (
        podcast.status &&
        ['pending', 'scripting', 'synthesizing', 'uploading'].includes(
          podcast.status
        )
      ) {
        this.removeAttribute('data-src')
        delete this.dataset.narrator
        delete this.dataset.duration
        delete this.dataset.size
        this.dataset.status = podcast.status
        this.scheduleRemotePodcastPoll()
        return
      }

      this.removeAttribute('data-src')
      this.dataset.status = podcast.status || 'none'
    }

    private async ensureRemotePodcast() {
      const apiUrl = this.dataset.podcastApiUrl
      const slug = this.dataset.podcastSlug
      if (!apiUrl || !slug || this.dataset.src) return

      try {
        const url = new URL(apiUrl)
        url.searchParams.set('slug', slug)
        const response = await fetch(url)
        if (!response.ok) throw new Error('Podcast status request failed')
        this.applyRemotePodcast(await response.json())
      } catch {
        this.dataset.status = 'none'
      }
    }

    private scheduleRemotePodcastPoll() {
      if (this.podcastPollTimer) window.clearTimeout(this.podcastPollTimer)
      this.podcastPollTimer = window.setTimeout(async () => {
        const apiUrl = this.dataset.podcastApiUrl
        const slug = this.dataset.podcastSlug
        if (!apiUrl || !slug || !this.isConnected) return
        const url = new URL(apiUrl)
        url.searchParams.set('slug', slug)
        try {
          const response = await fetch(url)
          if (!response.ok) throw new Error('Podcast status request failed')
          this.applyRemotePodcast(await response.json())
        } catch {
          this.scheduleRemotePodcastPoll()
        }
      }, 15_000)
    }

    private syncDuration = () => {
      const duration = Number.isFinite(this.audio.duration)
        ? this.audio.duration
        : Number(this.dataset.duration) || 0
      if (!duration) return
      this.range.max = String(duration)
      this.durationOutput.textContent = this.formatTime(duration)
    }

    private syncProgress = () => {
      this.range.value = String(this.audio.currentTime || 0)
      this.current.textContent = this.formatTime(this.audio.currentTime || 0)
      this.syncRangeFill()
    }

    private syncRangeFill() {
      const max = Number(this.range.max) || 0
      const value = Number(this.range.value) || 0
      this.range.style.setProperty(
        '--audio-progress',
        `${max ? (value / max) * 100 : 0}%`
      )
    }

    private syncPlaybackState = () => {
      const playing = !this.audio.paused && !this.audio.ended
      this.toggle.dataset.playing = playing ? 'true' : 'false'
      const title = this.dataset.title || '文章播客讲解'
      if (this.toggle.getAttribute('aria-busy') === 'true') {
        this.toggle.setAttribute('aria-label', `正在生成《${title}》的播客讲解`)
        return
      }
      this.toggle.setAttribute(
        'aria-label',
        `${playing ? '暂停' : '播放'}《${title}》的播客讲解`
      )
    }

    private handleError = () => {
      this.audio.pause()
      this.dataset.error = 'true'
      this.toggle.disabled = true
      this.range.disabled = true
      this.speed.disabled = true
      this.narratorOutput.textContent = '音频暂时无法播放，请稍后重试'
      this.toggle.setAttribute('aria-label', '音频暂时无法播放')
    }

    pause() {
      this.audio?.pause()
    }

    private formatTime(value: number) {
      if (!Number.isFinite(value) || value < 0) return '00:00'
      const seconds = Math.floor(value)
      const hours = Math.floor(seconds / 3600)
      const minutes = Math.floor((seconds % 3600) / 60)
      const remainder = seconds % 60
      return hours
        ? `${hours}:${String(minutes).padStart(2, '0')}:${String(remainder).padStart(2, '0')}`
        : `${String(minutes).padStart(2, '0')}:${String(remainder).padStart(2, '0')}`
    }

    private formatSize(bytes: number) {
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`
      return `${(bytes / 1024 / 1024).toFixed(2)} MB`
    }
  }

  if (!customElements.get('article-audio-player')) {
    customElements.define('article-audio-player', ArticleAudioPlayer)
  }
</script>

<style>
  .article-audio-player {
    display: grid;
    grid-template-columns: 2.125rem minmax(0, 1fr);
    align-items: center;
    gap: 0.7rem;
    box-sizing: border-box;
    width: 100%;
    margin: 0 0 1.35rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--c-border-soft);
    background: transparent;
    color: var(--c-text);
  }

  .article-audio-player[hidden] {
    display: none;
  }

  .article-audio-toggle {
    position: relative;
    display: inline-flex;
    width: 2.125rem;
    height: 2.125rem;
    flex: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--c-text);
    border-radius: 50%;
    outline: none;
    background: var(--c-text);
    color: var(--c-bg);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease,
      transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .article-audio-toggle:hover:not(:disabled) {
      transform: translateY(-1px);
    }
  }

  .article-audio-toggle:active {
    transform: scale(0.94);
  }

  .article-audio-toggle:focus-visible {
    box-shadow: 0 0 0 3px var(--c-focus-ring);
  }

  .article-audio-toggle:disabled {
    cursor: wait;
    opacity: 0.58;
  }

  .article-audio-toggle[aria-busy='true'] {
    border-color: var(--c-border-strong);
    background: transparent;
    color: var(--c-text-muted);
    animation: article-audio-pulse 1.8s ease-in-out infinite;
  }

  .article-audio-toggle[aria-busy='true'] span {
    opacity: 0.5;
  }

  .article-audio-toggle span {
    font-size: 1rem;
  }

  .article-audio-pause,
  .article-audio-toggle[data-playing='true'] .article-audio-play {
    display: none;
  }

  .article-audio-toggle[data-playing='true'] .article-audio-pause {
    display: block;
  }

  .article-audio-main,
  .article-audio-line,
  .article-audio-progress-row,
  .article-audio-range-wrap {
    min-width: 0;
  }

  .article-audio-line {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .article-audio-progress-row {
    display: grid;
    grid-template-columns: 2.35rem minmax(3rem, 1fr) 2.35rem;
    flex: 1;
    align-items: center;
    gap: 0.45rem;
  }

  .article-audio-current,
  .article-audio-duration {
    color: var(--c-text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .article-audio-current {
    color: var(--c-text);
  }

  .article-audio-duration {
    text-align: right;
  }

  .article-audio-range-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .article-audio-range {
    --audio-progress: 0%;
    width: 100%;
    height: 1rem;
    margin: 0;
    appearance: none;
    background: transparent;
    cursor: pointer;
  }

  .article-audio-range::-webkit-slider-runnable-track {
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      var(--c-text) var(--audio-progress),
      var(--c-border-strong) var(--audio-progress)
    );
  }

  .article-audio-range::-webkit-slider-thumb {
    width: 0.55rem;
    height: 0.55rem;
    margin-top: -0.22rem;
    appearance: none;
    border: 2px solid var(--c-bg);
    border-radius: 50%;
    background: var(--c-text);
    box-shadow: 0 0 0 1px var(--c-border-strong);
  }

  .article-audio-range::-moz-range-track {
    height: 2px;
    border-radius: 999px;
    background: var(--c-border-strong);
  }

  .article-audio-range::-moz-range-progress {
    height: 2px;
    border-radius: 999px;
    background: var(--c-text);
  }

  .article-audio-range::-moz-range-thumb {
    width: 0.55rem;
    height: 0.55rem;
    border: 2px solid var(--c-bg);
    border-radius: 50%;
    background: var(--c-text);
  }

  .article-audio-range:focus-visible::-webkit-slider-thumb {
    box-shadow: 0 0 0 3px var(--c-focus-ring);
  }

  .article-audio-speed-wrap {
    display: flex;
    flex: none;
  }

  .article-audio-speed {
    min-width: 3.2rem;
    height: 1.7rem;
    padding: 0 0.15rem;
    border: 1px solid transparent;
    border-radius: 0.3rem;
    outline: 0;
    background: transparent;
    color: var(--c-text-muted);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-variant-numeric: tabular-nums;
  }

  .article-audio-speed:hover,
  .article-audio-speed:focus-visible {
    border-color: var(--c-border-soft);
    background: var(--c-surface-soft);
    color: var(--c-text);
  }

  .article-audio-speed:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .article-audio-player:has(.article-audio-toggle[aria-busy='true'])
    .article-audio-range-wrap::after {
    position: absolute;
    left: 0;
    width: 28%;
    height: 2px;
    border-radius: 999px;
    background: var(--c-text-muted);
    animation: article-audio-loading 1.8s ease-in-out infinite;
    content: '';
    pointer-events: none;
  }

  .article-audio-player[data-error='true'] .article-audio-toggle {
    border-color: var(--c-border-strong);
    background: transparent;
    color: var(--c-text-muted);
  }

  @keyframes article-audio-pulse {
    50% {
      border-color: var(--c-text-muted);
      opacity: 0.72;
    }
  }

  @keyframes article-audio-loading {
    0%,
    100% {
      translate: 0 0;
      opacity: 0.3;
    }

    50% {
      translate: 255% 0;
      opacity: 0.75;
    }
  }

  @media (max-width: 40rem) {
    .article-audio-player {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.55rem;
      margin-bottom: 1.1rem;
      padding: 0.45rem 0;
    }

    .article-audio-toggle {
      width: 2rem;
      height: 2rem;
    }

    .article-audio-toggle span {
      font-size: 0.95rem;
    }

    .article-audio-line {
      gap: 0.45rem;
    }

    .article-audio-current {
      display: none;
    }

    .article-audio-progress-row {
      grid-template-columns: minmax(3rem, 1fr) 2.15rem;
      gap: 0.32rem;
    }

    .article-audio-current,
    .article-audio-duration {
      font-size: 0.62rem;
    }

    .article-audio-speed {
      min-width: 2.9rem;
      font-size: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-audio-toggle {
      transition: none;
    }

    .article-audio-toggle[aria-busy='true'],
    .article-audio-player:has(.article-audio-toggle[aria-busy='true'])
      .article-audio-range-wrap::after {
      animation: none;
    }
  }

  @media print {
    .article-audio-player {
      display: none;
    }
  }
</style>
