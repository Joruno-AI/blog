---
import { slug } from '~/utils/toc'

interface Props {
  idx?: number
  text: string
  needId?: boolean
  wide?: boolean
}

const { idx, text, needId = false, wide = false } = Astro.props
---

<div
  {...needId ? { id: slug(text) } : {}}
  class:list={[
    'toc-heading relative pointer-events-none select-none',
    wide ? 'project-section-heading' : 'h-20',
    { 'slide-enter': idx !== undefined },
  ]}
  style={idx !== undefined ? { '--enter-stage': idx - 2 } : undefined}
>
  {
    !wide ? (
      <span
        class="absolute left--12 top--4
          lt-lg:text-5em
          lt-md:(left-0 top-1/2 translate-y--1/2 text-3.2em)
          op-10 dark:op-8 text-6em
          text-stroke-2 text-stroke-hex-aaa font-bold color-transparent
          leading-1em whitespace-nowrap"
      >
        {text}
      </span>
    ) : (
      <span class="project-section-label">
        <strong>{text}</strong>
        <i aria-hidden="true" />
      </span>
    )
  }
</div>

<style>
  .project-section-heading {
    height: auto;
    padding-top: 1.8rem;
  }

  .project-section-label {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.85rem;
    color: var(--c-text);
  }

  .project-section-label strong {
    flex: none;
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  .project-section-label i {
    width: 100%;
    height: 1px;
    background: var(--c-border-soft);
  }
</style>
