---
import { formatDate } from '~/utils/datetime'
import { UI } from '~/config'

interface Props {
  pubDate: string
  lastModDate: string | undefined
  minutesRead: number
  tags?: string[]
}

const { pubDate, lastModDate, minutesRead, tags = [] } = Astro.props

const isMinimal = UI.postView.postMetaStyle === 'minimal'
---

<div class="post-meta-wrapper">
  {
    isMinimal ? (
      <div class="post-meta-primary">
        <time datetime={pubDate}>{formatDate(pubDate)}</time>
        {minutesRead > 0 && <span> · {minutesRead} min</span>}
        {lastModDate && (
          <time class="lt-sm:hidden" datetime={lastModDate}>
            · Updated {formatDate(lastModDate)}
          </time>
        )}
      </div>
    ) : (
      <div class="post-meta-primary flex flex-wrap justify-start items-center gap-x-4 gap-y-2">
        <div class="flex items-center">
          <span class="i-ri-calendar-line mr-1.2" />
          <time datetime={pubDate}>{formatDate(pubDate)}</time>
        </div>
        {lastModDate && (
          <div class="flex items-center lt-sm:hidden">
            <span class="i-ri-history-fill mr-1.2" />
            <time datetime={lastModDate}>{formatDate(lastModDate)}</time>
          </div>
        )}
        {minutesRead > 0 && (
          <div class="flex items-center">
            <span class="i-ri-timer-line mr-1.2" />
            <span>{minutesRead} min read</span>
          </div>
        )}
      </div>
    )
  }

  {
    tags.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 mt-3">
        <span class="i-ri-price-tag-3-line post-meta-tag-icon text-sm" />
        {tags.map((tag) => (
          <span class="tag-item">{tag}</span>
        ))}
      </div>
    )
  }
</div>

<style>
  .post-meta-wrapper {
    margin-top: -1.5rem;
    margin-bottom: 1.5rem;
    color: var(--c-text-muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  .post-meta-primary {
    color: var(--c-text-muted);
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    padding: 0.1rem 0;
    border-bottom: 1px solid var(--c-border-soft);
    color: var(--c-text-muted);
    font-size: 0.76rem;
    font-weight: 540;
    transition:
      border-color var(--motion-fast) ease,
      color var(--motion-fast) ease;
  }

  .tag-item::before {
    content: '#';
    margin-right: 0.12rem;
    color: var(--c-text-faint);
  }

  .tag-item:hover {
    border-color: var(--c-border-strong);
    color: var(--c-text);
  }

  .post-meta-tag-icon {
    color: var(--c-text-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-item {
      transition: none;
    }
  }
</style>
