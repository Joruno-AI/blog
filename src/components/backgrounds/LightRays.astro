---
// Adapted from React Bits Light Rays (MIT + Commons Clause).
// https://reactbits.dev/backgrounds/light-rays
// The site version uses the Music room palette and a deliberately capped
// render loop so a decorative background never competes with reading.
---

<ambient-light-rays aria-hidden="true">
  <span class="ambient-cover"></span>
  <span class="ambient-light"></span>
  <span class="ambient-noise"></span>
</ambient-light-rays>

<style>
  ambient-light-rays {
    position: fixed;
    z-index: 0;
    inset: 0;
    display: none;
    overflow: hidden;
    --album-color: var(--music-album-color, #7c8796);
    --album-tint: color-mix(in srgb, var(--album-color) 42%, #eef1f5 58%);
    --ambient-stage: color-mix(in srgb, var(--album-color) 12%, #eef2f7 88%);
    --ambient-edge: rgb(255 255 255 / 62%);
    --ambient-edge-soft: rgb(0 0 0 / 2.5%);
    background-color: var(--c-bg);
    background-image:
      radial-gradient(
        ellipse 110% 60% at 50% -8%,
        var(--ambient-stage) 0%,
        color-mix(in srgb, var(--ambient-stage) 66%, transparent) 42%,
        transparent 70%
      ),
      radial-gradient(
        ellipse at 78% 46%,
        color-mix(in srgb, var(--album-tint) 9%, transparent),
        transparent 42%
      ),
      radial-gradient(
        ellipse at 18% 78%,
        color-mix(in srgb, var(--album-color) 5%, transparent),
        transparent 48%
      ),
      linear-gradient(
        180deg,
        var(--c-bg) 0,
        transparent 16%,
        transparent 82%,
        var(--c-bg) 100%
      ),
      linear-gradient(
        100deg,
        var(--ambient-edge) 0%,
        var(--ambient-edge-soft) 32%,
        transparent 62%,
        var(--ambient-edge-soft) 86%,
        var(--ambient-edge) 100%
      );
    background-size:
      100% 100%,
      140% 140%,
      130% 130%,
      100% 100%,
      100% 100%;
    pointer-events: none;
  }

  :global(body:has(> ambient-light-rays) > #main),
  :global(body:has(> ambient-light-rays) > footer) {
    position: relative;
    z-index: 1;
  }

  ambient-light-rays::before {
    position: absolute;
    z-index: 1;
    inset: -8% -16% 8%;
    content: '';
    background: conic-gradient(
      at 50% -8%,
      transparent 0deg 142deg,
      rgb(255 255 255 / 72%) 149deg 158deg,
      transparent 165deg 174deg,
      rgb(255 255 255 / 92%) 181deg 194deg,
      transparent 201deg 211deg,
      rgb(255 255 255 / 58%) 218deg 226deg,
      transparent 233deg 360deg
    );
    filter: blur(20px);
    opacity: 0.82;
    transform-origin: 50% 0;
    animation: ambient-ray-breathe 13s ease-in-out infinite alternate;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 46%,
      rgb(0 0 0 / 76%) 66%,
      transparent 90%
    );
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 46%,
      rgb(0 0 0 / 76%) 66%,
      transparent 90%
    );
  }

  ambient-light-rays::after {
    position: absolute;
    z-index: 0;
    inset: -8% -16% 12%;
    content: '';
    background: conic-gradient(
      at 50% -8%,
      transparent 0deg 157deg,
      rgb(74 88 108 / 18%) 166deg 176deg,
      transparent 182deg 195deg,
      rgb(74 88 108 / 14%) 203deg 214deg,
      transparent 222deg 360deg
    );
    filter: blur(26px);
    opacity: 0.52;
    transform-origin: 50% 0;
    animation: ambient-ray-breathe 15s ease-in-out infinite alternate-reverse;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      rgb(0 0 0 / 86%) 48%,
      rgb(0 0 0 / 56%) 68%,
      transparent 88%
    );
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      rgb(0 0 0 / 86%) 48%,
      rgb(0 0 0 / 56%) 68%,
      transparent 88%
    );
  }

  ambient-light-rays span {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  ambient-light-rays .ambient-cover {
    inset: -12%;
    background-image: var(--music-album-cover, none);
    background-position: center;
    background-size: cover;
    filter: blur(76px) saturate(0.42) brightness(1.2);
    opacity: 0.055;
    transform: scale(1.1);
    animation: ambient-cover-drift 24s ease-in-out infinite alternate;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      black 18%,
      black 82%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      black 18%,
      black 82%,
      transparent 100%
    );
  }

  ambient-light-rays .ambient-light {
    background:
      radial-gradient(
        circle at 71% 43%,
        color-mix(in srgb, var(--album-tint) 12%, transparent),
        transparent 35%
      ),
      radial-gradient(
        ellipse at 18% 72%,
        color-mix(in srgb, var(--album-color) 14%, transparent),
        transparent 45%
      ),
      linear-gradient(
        90deg,
        var(--ambient-edge-soft),
        transparent 46% 74%,
        var(--ambient-edge-soft)
      );
    opacity: 0.1;
    animation: ambient-light-drift 16s ease-in-out infinite alternate;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      black 16%,
      black 84%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      black 16%,
      black 84%,
      transparent 100%
    );
  }

  ambient-light-rays .ambient-noise {
    z-index: 2;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.78' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.52'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
    opacity: 0.012;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      black 12%,
      black 88%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  ambient-light-rays :global(canvas) {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    filter: invert(1) brightness(1.1) contrast(1.14) saturate(0.14)
      drop-shadow(0 5px 16px rgb(74 88 108 / 26%))
      drop-shadow(0 0 1px rgb(74 88 108 / 36%));
    opacity: 1;
    mix-blend-mode: normal;
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 44%,
      rgb(0 0 0 / 72%) 72%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 44%,
      rgb(0 0 0 / 72%) 72%,
      transparent 100%
    );
  }

  :global(.dark) ambient-light-rays {
    display: block;
    --ambient-stage: transparent;
    --ambient-edge: rgba(7, 8, 10, 0.72);
    --ambient-edge-soft: rgba(7, 8, 10, 0.28);
  }

  :global(.dark) ambient-light-rays::before,
  :global(.dark) ambient-light-rays::after {
    display: none;
  }

  :global(.dark) ambient-light-rays .ambient-cover {
    filter: blur(82px) saturate(1.02) brightness(0.58);
    opacity: 0.38;
  }

  :global(.dark) ambient-light-rays .ambient-light {
    opacity: 0.82;
  }

  :global(.dark) ambient-light-rays .ambient-noise {
    opacity: 0.045;
  }

  :global(.dark) ambient-light-rays :global(canvas) {
    filter: none;
    opacity: 1;
    mix-blend-mode: normal;
    -webkit-mask-image: none;
    mask-image: none;
  }

  @keyframes ambient-cover-drift {
    from {
      transform: scale(1.1) translate3d(-1.5%, -1%, 0);
    }
    to {
      transform: scale(1.15) translate3d(1.5%, 1%, 0);
    }
  }

  @keyframes ambient-light-drift {
    from {
      transform: translate3d(-1.5%, 0, 0) scale(1.02);
    }
    to {
      transform: translate3d(1.5%, -1%, 0) scale(1.06);
    }
  }

  @keyframes ambient-ray-breathe {
    from {
      transform: translate3d(-1.2%, 0, 0) rotate(-0.7deg) scaleX(0.98);
    }
    to {
      transform: translate3d(1.2%, -0.5%, 0) rotate(0.7deg) scaleX(1.03);
    }
  }

  @media (max-width: 767px) {
    ambient-light-rays {
      background-size:
        100% 100%,
        160% 140%,
        150% 140%,
        100% 100%,
        100% 100%;
    }

    ambient-light-rays .ambient-cover {
      filter: blur(72px) saturate(0.4) brightness(1.2);
      opacity: 0.05;
    }

    ambient-light-rays::before,
    ambient-light-rays::after {
      inset-inline: -42%;
      filter: blur(16px);
    }

    ambient-light-rays::before {
      opacity: 0.74;
    }

    ambient-light-rays::after {
      opacity: 0.46;
    }

    ambient-light-rays :global(canvas) {
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ambient-light-rays .ambient-cover,
    ambient-light-rays .ambient-light,
    ambient-light-rays::before,
    ambient-light-rays::after {
      animation: none;
    }
  }

  @media print {
    ambient-light-rays {
      display: none;
    }
  }
</style>

<script>
  import { Mesh, Program, Renderer, Triangle } from 'ogl'

  const VERTEX = `
attribute vec2 position;
varying vec2 vUv;
void main() {
  vUv = position * 0.5 + 0.5;
  gl_Position = vec4(position, 0.0, 1.0);
}`

  const FRAGMENT = `precision highp float;

uniform float iTime;
uniform vec2 iResolution;
uniform vec2 rayPos;
uniform vec2 rayDir;
uniform vec3 raysColor;
uniform float raysSpeed;
uniform float lightSpread;
uniform float rayLength;
uniform float fadeDistance;
uniform float saturation;
uniform vec2 mousePos;
uniform float mouseInfluence;
uniform float noiseAmount;
uniform float distortion;

varying vec2 vUv;

float noise(vec2 st) {
  return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);
}

float rayStrength(vec2 raySource, vec2 rayRefDirection, vec2 coord,
                  float seedA, float seedB, float speed) {
  vec2 sourceToCoord = coord - raySource;
  vec2 dirNorm = normalize(sourceToCoord);
  float cosAngle = dot(dirNorm, rayRefDirection);
  float distortedAngle = cosAngle + distortion *
    sin(iTime * 2.0 + length(sourceToCoord) * 0.01) * 0.2;
  float spreadFactor = pow(
    max(distortedAngle, 0.0),
    1.0 / max(lightSpread, 0.001)
  );
  float distance = length(sourceToCoord);
  float maxDistance = iResolution.x * rayLength;
  float lengthFalloff = clamp(
    (maxDistance - distance) / maxDistance,
    0.0,
    1.0
  );
  float fadeFalloff = clamp(
    (iResolution.x * fadeDistance - distance) /
      (iResolution.x * fadeDistance),
    0.5,
    1.0
  );
  float baseStrength = clamp(
    (0.45 + 0.15 * sin(distortedAngle * seedA + iTime * speed)) +
    (0.3 + 0.2 * cos(-distortedAngle * seedB + iTime * speed)),
    0.0,
    1.0
  );
  return baseStrength * lengthFalloff * fadeFalloff * spreadFactor;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
  vec2 coord = vec2(fragCoord.x, iResolution.y - fragCoord.y);
  vec2 finalRayDir = rayDir;
  if (mouseInfluence > 0.0) {
    vec2 mouseScreenPos = mousePos * iResolution.xy;
    vec2 mouseDirection = normalize(mouseScreenPos - rayPos);
    finalRayDir = normalize(mix(rayDir, mouseDirection, mouseInfluence));
  }

  vec4 rays1 = vec4(1.0) * rayStrength(
    rayPos, finalRayDir, coord, 36.2214, 21.11349, 1.5 * raysSpeed
  );
  vec4 rays2 = vec4(1.0) * rayStrength(
    rayPos, finalRayDir, coord, 22.3991, 18.0234, 1.1 * raysSpeed
  );
  fragColor = rays1 * 0.5 + rays2 * 0.4;

  if (noiseAmount > 0.0) {
    float n = noise(coord * 0.01 + iTime * 0.1);
    fragColor.rgb *= 1.0 - noiseAmount + noiseAmount * n;
  }

  float brightness = 1.0 - coord.y / iResolution.y;
  fragColor.x *= 0.1 + brightness * 0.8;
  fragColor.y *= 0.3 + brightness * 0.6;
  fragColor.z *= 0.5 + brightness * 0.5;

  if (saturation != 1.0) {
    float gray = dot(fragColor.rgb, vec3(0.299, 0.587, 0.114));
    fragColor.rgb = mix(vec3(gray), fragColor.rgb, saturation);
  }
  fragColor.rgb *= raysColor;
}

void main() {
  vec4 color;
  mainImage(color, gl_FragCoord.xy);
  gl_FragColor = color;
}`

  type Rgb = [number, number, number]

  function parseColor(value: string): Rgb | null {
    const hex = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(value.trim())
    if (hex)
      return [
        parseInt(hex[1], 16) / 255,
        parseInt(hex[2], 16) / 255,
        parseInt(hex[3], 16) / 255,
      ]
    const rgb = /^rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)/i.exec(
      value.trim()
    )
    return rgb
      ? [Number(rgb[1]) / 255, Number(rgb[2]) / 255, Number(rgb[3]) / 255]
      : null
  }

  function mixColor(a: Rgb, b: Rgb, amount: number): Rgb {
    return a.map((channel, index) =>
      Math.min(1, Math.max(0, channel * (1 - amount) + b[index] * amount))
    ) as Rgb
  }

  class AmbientLightRays extends HTMLElement {
    cleanup?: () => void

    connectedCallback() {
      if (this.dataset.bound === 'true') return
      this.dataset.bound = 'true'

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
      const compact = window.matchMedia('(max-width: 767px)')
      const controller = new AbortController()
      const renderer = new Renderer({
        dpr: Math.min(window.devicePixelRatio, compact.matches ? 1 : 1.35),
        alpha: true,
      })
      const gl = renderer.gl
      gl.canvas.style.width = '100%'
      gl.canvas.style.height = '100%'
      this.appendChild(gl.canvas)

      const uniforms = {
        iTime: { value: 0 },
        iResolution: { value: [1, 1] },
        rayPos: { value: [0, 0] },
        rayDir: { value: [0, 1] },
        raysColor: { value: [0.72, 0.76, 0.84] as Rgb },
        raysSpeed: { value: 1.2 },
        lightSpread: { value: 0.9 },
        rayLength: { value: 2.2 },
        fadeDistance: { value: 1 },
        saturation: { value: 1 },
        mousePos: { value: [0.5, 0.5] },
        mouseInfluence: { value: 0.12 },
        noiseAmount: { value: 0.06 },
        distortion: { value: 0.02 },
      }

      const geometry = new Triangle(gl)
      const program = new Program(gl, {
        vertex: VERTEX,
        fragment: FRAGMENT,
        uniforms,
      })
      const mesh = new Mesh(gl, { geometry, program })
      const mouse = { x: 0.5, y: 0.5 }
      const smooth = { x: 0.5, y: 0.5 }

      const updatePalette = () => {
        const rootStyle = getComputedStyle(document.documentElement)
        const rawAlbumColor = rootStyle.getPropertyValue('--music-album-color')
        const rawThemeRay = rootStyle.getPropertyValue('--music-light-ray')
        const album =
          parseColor(rawAlbumColor) ??
          parseColor(rawThemeRay) ??
          ([26 / 255, 26 / 255, 46 / 255] as Rgb)
        const dark = document.documentElement.classList.contains('dark')
        uniforms.raysColor.value = dark
          ? [245 / 255, 215 / 255, 137 / 255]
          : mixColor(album, [0.12, 0.14, 0.18], 0.82)
        uniforms.lightSpread.value = dark ? 0.9 : 0.5
        uniforms.mouseInfluence.value = dark ? 0.12 : 0.18
        uniforms.distortion.value = dark ? 0.02 : 0.028
        uniforms.saturation.value = dark ? 1 : 0.86
        uniforms.noiseAmount.value = dark ? 0.06 : 0.035
        if (reduceMotion.matches) renderer.render({ scene: mesh })
      }

      const updatePlacement = () => {
        renderer.dpr = Math.min(
          window.devicePixelRatio,
          compact.matches ? 1 : 1.35
        )
        const widthCss = this.clientWidth || window.innerWidth
        const heightCss = this.clientHeight || window.innerHeight
        renderer.setSize(widthCss, heightCss)
        const width = widthCss * renderer.dpr
        const height = heightCss * renderer.dpr
        uniforms.iResolution.value = [width, height]
        uniforms.rayPos.value = [width * 0.5, height * -0.2]
        uniforms.rayDir.value = [0, 1]
        if (reduceMotion.matches) renderer.render({ scene: mesh })
      }

      const themeObserver = new MutationObserver(updatePalette)
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class', 'style'],
      })
      const resizeObserver = new ResizeObserver(updatePlacement)
      resizeObserver.observe(this)

      window.addEventListener(
        'mousemove',
        (event) => {
          mouse.x = event.clientX / window.innerWidth
          mouse.y = event.clientY / window.innerHeight
        },
        { signal: controller.signal, passive: true }
      )

      let animationFrame = 0
      let lastFrame = 0
      const loop = (time: number) => {
        animationFrame = requestAnimationFrame(loop)
        if (
          document.hidden ||
          !this.isConnected ||
          !document.documentElement.classList.contains('dark')
        )
          return
        const frameInterval = 1000 / (compact.matches ? 24 : 30)
        if (lastFrame && time - lastFrame < frameInterval) return
        lastFrame = time
        uniforms.iTime.value = time * 0.001
        smooth.x = smooth.x * 0.93 + mouse.x * 0.07
        smooth.y = smooth.y * 0.93 + mouse.y * 0.07
        uniforms.mousePos.value = [smooth.x, smooth.y]
        renderer.render({ scene: mesh })
      }

      updatePalette()
      updatePlacement()
      if (reduceMotion.matches) renderer.render({ scene: mesh })
      else animationFrame = requestAnimationFrame(loop)

      this.cleanup = () => {
        cancelAnimationFrame(animationFrame)
        controller.abort()
        themeObserver.disconnect()
        resizeObserver.disconnect()
        try {
          gl.getExtension('WEBGL_lose_context')?.loseContext()
        } catch {
          // The browser may have released the context already.
        }
        gl.canvas.remove()
        delete this.dataset.bound
      }
    }

    disconnectedCallback() {
      this.cleanup?.()
      this.cleanup = undefined
    }
  }

  if (!customElements.get('ambient-light-rays'))
    customElements.define('ambient-light-rays', AmbientLightRays)
</script>
