---
import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import { geektimeCatalog, getGeektimeCourseUrl } from '~/utils/geektime'

const { categories, stats, sources } = geektimeCatalog
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<BaseLayout
  title="Docs"
  description="按课程整理的技术学习文档库"
  bgType="rose"
  stableNavigation={true}
>
  <StandardLayout
    class="geektime-shell max-w-[86rem]"
    title="Docs"
    subtitle="来自多个资料源、以课程为单位整理的技术学习资料"
    isCentered={true}
  >
    <section class="geektime-overview" aria-label="文档库概览">
      <p>
        从分类进入课程，再按章节阅读。两套资料统一检索和阅读，并与博客文章分开管理。
      </p>
      <dl class="geektime-stats" aria-label="文档统计">
        <div><dt>{stats.categories}</dt><dd>个分类</dd></div>
        <div><dt>{stats.courses}</dt><dd>门课程</dd></div>
        <div>
          <dt>{stats.articles.toLocaleString('zh-CN')}</dt><dd>篇章节</dd>
        </div>
      </dl>
    </section>

    <geektime-search data-catalog-url="/docs/catalog.json?v=2">
      <label class="geektime-search-box">
        <span class="i-ri-search-line" aria-hidden="true"></span>
        <span class="sr-only">搜索课程和章节</span>
        <input
          type="search"
          placeholder="搜索课程或章节，例如 React、Nest、分布式"
          autocomplete="off"
        />
        <kbd>/</kbd>
      </label>
      <div class="geektime-search-status" aria-live="polite"></div>
      <div class="geektime-search-results" hidden></div>
    </geektime-search>

    <nav class="geektime-category-nav" aria-label="知识方向">
      {
        categories.map((category) => (
          <a href={`#${category.id}`}>{category.name}</a>
        ))
      }
    </nav>

    <div class="geektime-category-list">
      {
        categories.map((category, categoryIndex) => (
          <section id={category.id} class="geektime-category">
            <header>
              <div class="geektime-category-number">
                {String(categoryIndex + 1).padStart(2, '0')}
              </div>
              <div>
                <h2>{category.name}</h2>
                <p>
                  {category.courseCount} 门课程 ·{' '}
                  {category.articleCount.toLocaleString('zh-CN')} 篇章节
                </p>
              </div>
            </header>
            <div class="geektime-course-grid">
              {category.courses.map((course) => (
                <a
                  class="geektime-course-card"
                  href={getGeektimeCourseUrl(course.id)}
                >
                  <span class="geektime-course-name">{course.name}</span>
                  <span class="geektime-course-meta">
                    {course.articles.length} 篇
                    <span class="i-ri-arrow-right-up-line" aria-hidden="true" />
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <footer class="geektime-source-note" aria-label="资料来源">
      {
        sources.map((item) => (
          <span class="geektime-source-item">
            <span>{item.name}</span>
            <span aria-hidden="true">·</span>
            <span>{dateFormatter.format(new Date(item.generatedAt))}</span>
            <span aria-hidden="true">·</span>
            <a href={`${item.source}/commit/${item.commit}`}>
              {item.commit.slice(0, 7)}
            </a>
            <span aria-hidden="true">·</span>
            <a href={item.source}>源仓库</a>
          </span>
        ))
      }
    </footer>
  </StandardLayout>
</BaseLayout>

<style>
  .geektime-shell {
    --library-line: var(--c-border-soft);
    --library-muted: var(--c-text-muted);
  }

  .geektime-overview {
    max-width: 65ch;
    margin: 2.25rem auto 0;
    text-align: center;
  }

  .geektime-overview > p {
    max-width: 38rem;
    margin: 0 auto;
    color: var(--c-text-muted);
    font-size: 0.9rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .geektime-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
    margin: 1.75rem 0 0;
    font-variant-numeric: tabular-nums;
  }

  .geektime-stats div {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .geektime-stats div + div::before {
    margin: 0 1rem;
    color: var(--c-border-strong);
    content: '/';
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .geektime-stats dt {
    color: var(--c-text);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .geektime-stats dd {
    margin: 0;
    color: var(--c-text-faint);
    font-size: 0.75rem;
  }

  geektime-search {
    position: relative;
    z-index: 4;
    display: block;
    max-width: 65ch;
    margin: 2.75rem auto 0;
  }

  .geektime-search-box {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.72rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    background: var(--c-surface-soft);
    color: var(--c-text-muted);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .geektime-search-box:hover,
  .geektime-search-box:focus-within {
    border-color: var(--c-border-soft);
    background: var(--c-surface-hover);
    color: var(--c-text);
  }

  .geektime-search-box input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--c-text);
    font: inherit;
    font-size: 0.875rem;
  }

  .geektime-search-box input::placeholder {
    color: var(--c-text-faint);
    opacity: 1;
  }

  .geektime-search-box kbd {
    flex: none;
    color: var(--c-text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .geektime-search-status {
    min-height: 1.5rem;
    padding: 0.45rem 0.8rem 0;
    color: var(--c-text-faint);
    font-size: 0.7rem;
  }

  .geektime-search-results {
    position: absolute;
    top: 3.5rem;
    right: 0;
    left: 0;
    max-height: min(65vh, 34rem);
    overflow-y: auto;
    padding: 0.4rem;
    border: 1px solid var(--c-border-soft);
    border-radius: 0.5rem;
    background: var(--c-bg);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.09);
  }

  :global(.dark .geektime-search-results) {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.34);
  }

  :global(.geektime-search-result) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0.7rem;
    border: 0;
    border-radius: 0.375rem;
    color: var(--c-text-soft);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  :global(.geektime-search-result:hover),
  :global(.geektime-search-result:focus-visible) {
    background: var(--c-surface-hover);
    color: var(--c-text);
  }

  :global(.geektime-search-result-copy) {
    min-width: 0;
  }

  :global(.geektime-search-result-title) {
    display: block;
    overflow: hidden;
    font-size: 0.84rem;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.geektime-search-result-meta) {
    display: block;
    overflow: hidden;
    margin-top: 0.18rem;
    color: var(--c-text-faint);
    font-size: 0.68rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.geektime-search-result-kind) {
    flex: none;
    color: var(--c-text-faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .geektime-category-nav {
    display: flex;
    max-width: 65ch;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.15rem;
    margin: 2.75rem auto 4.5rem;
  }

  .geektime-category-nav a {
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
    color: var(--c-text-muted);
    font-size: 0.75rem;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .geektime-category-nav a:hover,
  .geektime-category-nav a:focus-visible {
    border-color: var(--c-border-strong);
    color: var(--c-text);
  }

  .geektime-category-list {
    display: grid;
    gap: 4.5rem;
  }

  .geektime-category {
    scroll-margin-top: 6rem;
  }

  .geektime-category > header {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  .geektime-category-number {
    color: var(--c-text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .geektime-category h2 {
    margin: 0;
    color: var(--c-text);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .geektime-category header p {
    margin: 0.25rem 0 0;
    color: var(--c-text-faint);
    font-size: 0.7rem;
  }

  .geektime-course-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 1rem;
    border-top: 1px solid var(--library-line);
  }

  .geektime-course-card {
    display: flex;
    min-width: 0;
    min-height: 3.35rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.5rem;
    border-bottom: 1px solid var(--library-line);
    border-radius: 0.375rem;
    color: var(--c-text-soft);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .geektime-course-card:hover,
  .geektime-course-card:focus-visible {
    background: var(--c-surface-hover);
    color: var(--c-text);
    transform: translateX(2px);
  }

  .geektime-course-card:active {
    transform: translateX(2px) scale(0.99);
  }

  .geektime-course-name {
    min-width: 0;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .geektime-course-meta {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.2rem;
    color: var(--c-text-faint);
    font-family: var(--font-mono);
    font-size: 0.63rem;
    white-space: nowrap;
  }

  .geektime-source-note {
    display: grid;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 5rem;
    color: var(--c-text-faint);
    font-size: 0.7rem;
  }

  .geektime-source-item {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }

  .geektime-source-note a {
    color: inherit;
    transition: color 0.2s ease;
  }

  .geektime-source-note a:hover {
    color: var(--c-text);
  }

  @media (max-width: 900px) {
    .geektime-course-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1536px) {
    .geektime-course-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .geektime-category-list {
      gap: 4rem;
    }
  }

  @media (max-width: 600px) {
    .geektime-overview {
      margin-top: 1.75rem;
    }

    .geektime-stats div + div::before {
      margin-inline: 0.65rem;
    }

    .geektime-search-box kbd {
      display: none;
    }

    .geektime-category-nav {
      justify-content: flex-start;
      margin-bottom: 3.5rem;
    }

    .geektime-category-list {
      gap: 3.75rem;
    }

    .geektime-category > header {
      align-items: flex-start;
    }

    .geektime-course-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .geektime-course-card {
      padding-inline: 0.35rem;
    }
  }
</style>

<script>
  interface Article {
    title: string
    path: string
  }

  interface Course {
    id: string
    sourceId?: string
    name: string
    articles: Article[]
  }

  interface Category {
    name: string
    courses: Course[]
  }

  interface Catalog {
    categories: Category[]
  }

  class GeektimeSearch extends HTMLElement {
    private input: HTMLInputElement | null = null
    private results: HTMLElement | null = null
    private status: HTMLElement | null = null
    private catalogPromise: Promise<Catalog> | null = null
    private timer: ReturnType<typeof setTimeout> | null = null

    connectedCallback() {
      this.input = this.querySelector('input')
      this.results = this.querySelector('.geektime-search-results')
      this.status = this.querySelector('.geektime-search-status')

      this.input?.addEventListener('input', () => this.queueSearch())
      this.addEventListener('click', this.rememberArticlePath)
      document.addEventListener('keydown', this.handleShortcut)
      document.addEventListener('click', this.handleOutsideClick)
    }

    disconnectedCallback() {
      this.removeEventListener('click', this.rememberArticlePath)
      document.removeEventListener('keydown', this.handleShortcut)
      document.removeEventListener('click', this.handleOutsideClick)
    }

    private handleShortcut = (event: KeyboardEvent) => {
      if (
        event.key === '/' &&
        !['INPUT', 'TEXTAREA'].includes((event.target as HTMLElement).tagName)
      ) {
        event.preventDefault()
        this.input?.focus()
      }
    }

    private rememberArticlePath = (event: MouseEvent) => {
      if (!(event.target instanceof Element)) return
      const link = event.target.closest<HTMLAnchorElement>('a[href]')
      if (!link) return

      const articlePath = new URL(link.href).searchParams.get('path')
      if (!articlePath) return

      const sourceId =
        new URL(link.href).searchParams.get('source') || 'geektime'

      try {
        sessionStorage.setItem('geektime:last-article-path', articlePath)
        sessionStorage.setItem('geektime:last-source-id', sourceId)
      } catch {
        // Search navigation still works when storage is unavailable.
      }
    }

    private handleOutsideClick = (event: MouseEvent) => {
      if (!this.contains(event.target as Node)) this.hideResults()
    }

    private queueSearch() {
      if (this.timer) clearTimeout(this.timer)
      this.timer = setTimeout(() => this.search(), 140)
    }

    private getCatalog() {
      if (!this.catalogPromise) {
        const url = this.dataset.catalogUrl || '/docs/catalog.json'
        this.catalogPromise = fetch(url).then((response) => {
          if (!response.ok) throw new Error('无法加载搜索索引')
          return response.json() as Promise<Catalog>
        })
      }
      return this.catalogPromise
    }

    private async search() {
      const query = this.input?.value.trim().toLocaleLowerCase('zh-CN') || ''
      if (!query) {
        this.hideResults()
        if (this.status) this.status.textContent = ''
        return
      }

      if (this.status) this.status.textContent = '正在检索…'

      try {
        const catalog = await this.getCatalog()
        const matches: {
          title: string
          meta: string
          kind: string
          href: string
          score: number
        }[] = []

        for (const category of catalog.categories) {
          for (const course of category.courses) {
            const courseName = course.name.toLocaleLowerCase('zh-CN')
            if (courseName.includes(query)) {
              const firstArticle = course.articles[0]
              matches.push({
                title: course.name,
                meta: `${category.name} · ${course.articles.length} 篇章节`,
                kind: '课程',
                href: firstArticle
                  ? this.getArticleUrl(
                      firstArticle.path,
                      course.sourceId || 'geektime'
                    )
                  : '/docs/',
                score: courseName.startsWith(query) ? 0 : 1,
              })
            }

            for (const article of course.articles) {
              const articleTitle = article.title.toLocaleLowerCase('zh-CN')
              if (!articleTitle.includes(query)) continue
              matches.push({
                title: article.title,
                meta: `${category.name} / ${course.name}`,
                kind: '章节',
                href: this.getArticleUrl(
                  article.path,
                  course.sourceId || 'geektime'
                ),
                score: articleTitle.startsWith(query) ? 2 : 3,
              })
            }
          }
        }

        matches.sort(
          (a, b) => a.score - b.score || a.title.localeCompare(b.title, 'zh-CN')
        )
        this.renderResults(matches.slice(0, 60), matches.length)
      } catch (error) {
        if (this.status) {
          this.status.textContent =
            error instanceof Error ? error.message : '搜索暂时不可用'
        }
      }
    }

    private renderResults(
      matches: {
        title: string
        meta: string
        kind: string
        href: string
      }[],
      total: number
    ) {
      if (!this.results || !this.status) return
      this.results.replaceChildren()

      if (matches.length === 0) {
        this.status.textContent = '没有找到匹配的课程或章节'
        this.results.hidden = true
        return
      }

      this.status.textContent = `找到 ${total.toLocaleString('zh-CN')} 条结果${total > matches.length ? `，显示前 ${matches.length} 条` : ''}`

      for (const match of matches) {
        const link = document.createElement('a')
        link.className = 'geektime-search-result'
        link.href = match.href

        const copy = document.createElement('span')
        copy.className = 'geektime-search-result-copy'
        const title = document.createElement('span')
        title.className = 'geektime-search-result-title'
        title.textContent = match.title
        const meta = document.createElement('span')
        meta.className = 'geektime-search-result-meta'
        meta.textContent = match.meta
        copy.append(title, meta)

        const kind = document.createElement('span')
        kind.className = 'geektime-search-result-kind'
        kind.textContent = match.kind
        link.append(copy, kind)
        this.results.append(link)
      }

      this.results.hidden = false
    }

    private hideResults() {
      if (this.results) this.results.hidden = true
    }

    private getArticleUrl(path: string, sourceId: string) {
      const params = new URLSearchParams({ source: sourceId, path })
      return `/docs/read/?${params.toString()}`
    }
  }

  if (!customElements.get('geektime-search')) {
    customElements.define('geektime-search', GeektimeSearch)
  }
</script>
