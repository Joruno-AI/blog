---
import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import PostActions from '~/components/widgets/PostActions.astro'
---

<BaseLayout
  title="课程文档"
  description="技术课程文档阅读页"
  bgType="rose"
  stableNavigation={true}
  hideFooter={true}
>
  <StandardLayout class="reader-shell">
    <geektime-reader
      data-catalog-url="/docs/catalog.json?v=3"
      data-loading
      aria-busy="true"
    >
      <div class="reader-layout">
        <aside
          class="reader-panel-skeleton reader-panel-skeleton-course"
          aria-hidden="true"
        >
          <span class="reader-panel-skeleton-heading"></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <div class="reader-panel-skeleton-fill"></div>
        </aside>

        <aside
          id="reader-course-panel"
          class="reader-course-panel"
          data-course-panel
          hidden
        >
          <div class="reader-aside-heading">
            <span class="i-ri-book-open-line" aria-hidden="true"></span>
            <a data-course-panel-link href="/docs/">本课程</a>
            <span data-course-count></span>
          </div>
          <ol class="reader-course-list" data-course-list></ol>
        </aside>

        <div class="reader-main">
          <div class="reader-breadcrumb-skeleton" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <nav class="reader-breadcrumb" aria-label="面包屑">
            <a href="/docs/">Docs</a>
            <span data-course-separator aria-hidden="true" hidden>/</span>
            <a data-course-link href="/docs/">
              <span class="sr-only">课程</span>
            </a>
          </nav>

          <header class="reader-header">
            <div class="reader-header-skeleton" aria-hidden="true">
              <span class="reader-header-skeleton-title"></span>
              <span
                class="reader-header-skeleton-title reader-header-skeleton-title-short"
              ></span>
              <span class="reader-header-skeleton-actions"></span>
            </div>
            <div class="reader-header-content">
              <h1 data-title><span class="sr-only">正在加载文档</span></h1>
              <div class="reader-actions" data-reader-actions hidden>
                <PostActions markdown="" postUrl="" title="课程文档" />
                <button
                  type="button"
                  class="reader-mindmap-trigger"
                  data-mindmap-trigger
                  aria-haspopup="dialog"
                  aria-controls="reader-mindmap-dialog"
                >
                  <span class="i-ri-node-tree" aria-hidden="true"></span>
                  <span>思维导图</span>
                </button>
              </div>
            </div>
          </header>

          <div class="reader-state" data-state aria-live="polite">
            <span class="sr-only">正在从内容快照加载正文</span>
            <div class="reader-skeleton" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span class="reader-skeleton-media"></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span class="reader-skeleton-media"></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>

          <article class="prose reader-content" data-content hidden></article>

          <nav class="reader-neighbors" aria-label="章节导航" hidden>
            <a data-previous href="/docs/">
              <span>上一篇</span>
              <strong></strong>
            </a>
            <a data-next href="/docs/">
              <span>下一篇</span>
              <strong></strong>
            </a>
          </nav>
        </div>

        <aside
          id="reader-toc-panel"
          class="reader-toc-panel"
          data-toc-panel
          hidden
        >
          <div class="reader-aside-heading">
            <span class="i-ri-menu-2-line" aria-hidden="true"></span>
            <span>本页目录</span>
          </div>
          <nav class="reader-toc-list" data-toc-list aria-label="本页目录">
          </nav>
        </aside>

        <aside
          class="reader-panel-skeleton reader-panel-skeleton-toc"
          aria-hidden="true"
        >
          <span class="reader-panel-skeleton-heading"></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <div class="reader-panel-skeleton-fill"></div>
        </aside>
      </div>

      <div class="reader-floating-controls" aria-label="阅读面板">
        <button
          type="button"
          class="reader-panel-toggle reader-course-toggle"
          data-reader-panel-toggle="course"
          aria-label="打开课程目录"
          aria-controls="reader-course-panel"
          aria-expanded="false"
        >
          <span
            class="reader-toggle-icon-collapsed i-lucide-panel-left-open"
            aria-hidden="true"></span>
          <span
            class="reader-toggle-icon-expanded i-lucide-panel-left-close"
            aria-hidden="true"></span>
        </button>
        <button
          type="button"
          class="reader-panel-toggle reader-toc-toggle"
          data-reader-panel-toggle="toc"
          aria-label="打开本页目录"
          aria-controls="reader-toc-panel"
          aria-expanded="false"
        >
          <span
            class="reader-toggle-icon-collapsed i-lucide-panel-right-open"
            aria-hidden="true"></span>
          <span
            class="reader-toggle-icon-expanded i-lucide-panel-right-close"
            aria-hidden="true"></span>
        </button>
      </div>

      <dialog
        id="reader-mindmap-dialog"
        class="reader-mindmap-dialog"
        data-mindmap-dialog
        aria-labelledby="reader-mindmap-title"
      >
        <section class="reader-mindmap-shell">
          <header class="reader-mindmap-header">
            <div class="reader-mindmap-heading">
              <span class="reader-mindmap-kicker">文章导图</span>
              <h2 id="reader-mindmap-title" data-mindmap-title>思维导图</h2>
            </div>
            <div class="reader-mindmap-tools" aria-label="导图控制">
              <button
                type="button"
                data-mindmap-action="zoom-out"
                aria-label="缩小导图"
                title="缩小"
              >
                <span class="i-ri-subtract-line" aria-hidden="true"></span>
              </button>
              <button
                type="button"
                class="reader-mindmap-fit"
                data-mindmap-action="fit"
                aria-label="适应画布"
              >
                适应
              </button>
              <button
                type="button"
                data-mindmap-action="zoom-in"
                aria-label="放大导图"
                title="放大"
              >
                <span class="i-ri-add-line" aria-hidden="true"></span>
              </button>
              <button
                type="button"
                class="reader-mindmap-close"
                data-mindmap-action="close"
                aria-label="关闭思维导图"
                title="关闭"
              >
                <span class="i-ri-close-line" aria-hidden="true"></span>
              </button>
            </div>
          </header>
          <div class="reader-mindmap-viewport" data-mindmap-viewport>
            <svg
              class="reader-mindmap-canvas"
              data-mindmap-canvas
              role="img"
              aria-labelledby="reader-mindmap-title"></svg>
          </div>
          <p class="reader-mindmap-hint">
            点击节点即可跳转到对应章节，放大后可滚动查看。
          </p>
        </section>
      </dialog>
    </geektime-reader>
  </StandardLayout>
</BaseLayout>

<style>
  geektime-reader {
    --reader-line: var(--c-border-soft);
    --reader-muted: var(--c-text-muted);
    --reader-math-accent: #b05c78;
    --reader-math-ink: color-mix(
      in srgb,
      var(--c-text) 68%,
      var(--reader-math-accent) 32%
    );
    --reader-math-line: color-mix(
      in srgb,
      var(--c-border-soft) 48%,
      var(--reader-math-accent) 52%
    );
    --reader-math-surface: color-mix(
      in srgb,
      var(--c-bg) 95%,
      var(--reader-math-accent) 5%
    );
    --reader-skeleton-base: color-mix(
      in srgb,
      var(--c-surface-soft) 90%,
      var(--c-text) 10%
    );
    --reader-skeleton-glow: color-mix(in srgb, var(--c-bg) 74%, white 26%);
    display: block;
  }

  .reader-layout {
    width: 100%;
    max-width: 96rem;
    margin-inline: auto;
  }

  geektime-reader[data-loading] .reader-layout {
    min-height: calc(100svh - 7rem);
  }

  .reader-main {
    position: relative;
    width: 100%;
    max-width: 54rem;
    min-width: 0;
    margin-inline: auto;
  }

  .reader-course-panel,
  .reader-toc-panel,
  .reader-panel-skeleton {
    display: none;
  }

  .reader-floating-controls {
    display: none;
  }

  geektime-reader[data-loading] .reader-floating-controls {
    display: none;
  }

  geektime-reader[data-loading] .reader-course-panel,
  geektime-reader[data-loading] .reader-toc-panel {
    display: none !important;
  }

  .reader-course-panel[hidden],
  .reader-toc-panel[hidden],
  .reader-actions[hidden] {
    display: none;
  }

  .reader-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.75rem;
    color: var(--c-text-faint);
    font-size: 0.7rem;
  }

  .reader-breadcrumb-skeleton {
    display: none;
    height: 1rem;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.75rem;
  }

  geektime-reader[data-loading] .reader-breadcrumb {
    display: none;
  }

  geektime-reader[data-loading] .reader-breadcrumb-skeleton {
    display: flex;
  }

  .reader-breadcrumb-skeleton span {
    width: 2.6rem;
    height: 0.58rem;
    border-radius: 999px;
  }

  .reader-breadcrumb-skeleton span:nth-child(2) {
    width: 0.35rem;
  }

  .reader-breadcrumb-skeleton span:nth-child(3) {
    width: 6.5rem;
  }

  .reader-breadcrumb a {
    border-bottom: 1px solid transparent;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .reader-breadcrumb a:hover,
  .reader-breadcrumb a:focus-visible {
    border-color: var(--c-border-strong);
    color: var(--c-text);
  }

  .reader-header {
    position: relative;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--reader-line);
  }

  .reader-header-skeleton {
    display: none;
  }

  geektime-reader[data-loading] .reader-header-skeleton {
    display: grid;
    gap: 0.7rem;
  }

  geektime-reader[data-loading] .reader-header-content {
    display: none;
  }

  .reader-breadcrumb-skeleton span,
  .reader-header-skeleton span,
  .reader-skeleton span,
  .reader-panel-skeleton span {
    display: block;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 0.25rem;
    background: var(--reader-skeleton-base);
  }

  .reader-breadcrumb-skeleton span::after,
  .reader-header-skeleton span::after,
  .reader-skeleton span::after,
  .reader-panel-skeleton span::after,
  .reader-panel-skeleton-fill::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 18%,
      color-mix(in srgb, var(--reader-skeleton-glow) 82%, transparent) 46%,
      transparent 72%
    );
    content: '';
    transform: translate3d(-115%, 0, 0);
    animation: reader-shimmer 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    will-change: transform;
  }

  .reader-header-skeleton-title {
    width: min(38rem, 88%);
    height: clamp(2rem, 5vw, 2.8rem);
    margin-top: 0.2rem;
  }

  .reader-header-skeleton-title-short {
    width: min(25rem, 58%);
    margin-top: -0.35rem;
  }

  .reader-header-skeleton-actions {
    width: min(19rem, 72%);
    height: 2rem;
    margin-top: 0.65rem;
  }

  .reader-header h1 {
    max-width: 100%;
    margin: 0;
    color: var(--c-text);
    font-family: var(--font-article-title);
    font-size: clamp(1.85rem, 3.4vw, 2.75rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.15;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
    text-wrap: wrap;
  }

  .reader-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .reader-actions :global(.post-actions) {
    display: contents;
    margin-bottom: 0;
  }

  .reader-mindmap-trigger {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--c-border-soft);
    border-radius: 4px;
    background: transparent;
    color: var(--c-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.14s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .reader-mindmap-trigger:hover,
  .reader-mindmap-trigger:focus-visible {
    border-color: rgb(96 165 250);
    color: rgb(59 130 246);
  }

  :global(.dark) .reader-mindmap-trigger:hover,
  :global(.dark) .reader-mindmap-trigger:focus-visible {
    color: rgb(147 197 253);
  }

  .reader-mindmap-trigger:active {
    transform: scale(0.97);
  }

  .reader-mindmap-dialog {
    width: min(94vw, 84rem);
    height: min(88svh, 54rem);
    max-width: none;
    max-height: none;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--c-border-soft);
    border-radius: 0.9rem;
    background: var(--c-bg);
    box-shadow: 0 30px 90px rgb(0 0 0 / 0.25);
    color: var(--c-text);
  }

  .reader-mindmap-dialog::backdrop {
    background: rgb(15 23 42 / 0.38);
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
  }

  .reader-mindmap-shell {
    display: flex;
    height: 100%;
    min-height: 0;
    flex-direction: column;
  }

  .reader-mindmap-header {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 0.85rem 1rem 0.85rem 1.15rem;
    border-bottom: 1px solid var(--reader-line);
    background: color-mix(in srgb, var(--c-bg) 94%, var(--c-surface-soft) 6%);
  }

  .reader-mindmap-heading {
    min-width: 0;
  }

  .reader-mindmap-kicker {
    display: block;
    margin-bottom: 0.12rem;
    color: var(--c-text-faint);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
  }

  .reader-mindmap-heading h2 {
    overflow: hidden;
    margin: 0;
    color: var(--c-text);
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    font-weight: 600;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reader-mindmap-tools {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.3rem;
  }

  .reader-mindmap-tools button {
    display: inline-flex;
    min-width: 2.1rem;
    height: 2.1rem;
    align-items: center;
    justify-content: center;
    padding: 0 0.5rem;
    border: 1px solid transparent;
    border-radius: 0.4rem;
    background: transparent;
    color: var(--c-text-muted);
    cursor: pointer;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .reader-mindmap-tools button:hover,
  .reader-mindmap-tools button:focus-visible {
    border-color: var(--c-border-soft);
    background: var(--c-surface-hover);
    color: var(--c-text);
  }

  .reader-mindmap-tools .reader-mindmap-fit {
    min-width: 3.2rem;
    font-size: 0.72rem;
  }

  .reader-mindmap-tools .reader-mindmap-close {
    margin-left: 0.35rem;
  }

  .reader-mindmap-viewport {
    position: relative;
    min-height: 0;
    flex: 1;
    overflow: auto;
    padding: 1rem;
    background-color: color-mix(in srgb, var(--c-bg) 97%, var(--c-text) 3%);
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-text-faint) 24%, transparent) 0.7px,
      transparent 0.8px
    );
    background-size: 18px 18px;
    scrollbar-color: var(--c-border-strong) transparent;
    scrollbar-width: thin;
    overscroll-behavior: contain;
  }

  .reader-mindmap-canvas {
    display: block;
    max-width: none;
    overflow: visible;
    margin: auto;
    transform-origin: left top;
  }

  .reader-mindmap-canvas :global(.reader-mindmap-edge) {
    fill: none;
    stroke: color-mix(in srgb, var(--c-text-faint) 42%, transparent);
    stroke-linecap: round;
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }

  .reader-mindmap-canvas :global(.reader-mindmap-node) {
    color: var(--c-text);
    cursor: pointer;
    outline: none;
  }

  .reader-mindmap-canvas :global(.reader-mindmap-node rect) {
    fill: color-mix(in srgb, var(--c-bg) 92%, #60a5fa 8%);
    stroke: color-mix(in srgb, var(--c-border-strong) 72%, #60a5fa 28%);
    stroke-width: 1;
    transition:
      fill 160ms ease,
      stroke 160ms ease;
  }

  .reader-mindmap-canvas :global(.reader-mindmap-node[data-root='true'] rect) {
    fill: color-mix(in srgb, var(--c-bg) 82%, #3b82f6 18%);
    stroke: color-mix(in srgb, var(--c-border-strong) 42%, #3b82f6 58%);
    stroke-width: 1.25;
  }

  .reader-mindmap-canvas :global(.reader-mindmap-node:hover rect),
  .reader-mindmap-canvas :global(.reader-mindmap-node:focus rect) {
    fill: color-mix(in srgb, var(--c-bg) 78%, #60a5fa 22%);
    stroke: #3b82f6;
  }

  .reader-mindmap-canvas :global(.reader-mindmap-node text) {
    fill: currentColor;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    pointer-events: none;
  }

  .reader-mindmap-canvas :global(.reader-mindmap-node[data-root='true'] text) {
    font-size: 14px;
    font-weight: 650;
  }

  .reader-mindmap-hint {
    flex: none;
    margin: 0;
    padding: 0.55rem 1rem 0.65rem;
    border-top: 1px solid var(--reader-line);
    color: var(--c-text-faint);
    font-size: 0.68rem;
    text-align: center;
  }

  .reader-state {
    min-height: max(34rem, calc(100svh - 14rem));
    padding-top: 2.25rem;
  }

  .reader-state.is-error {
    display: flex;
    min-height: 16rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    color: #dc2626;
    font-size: 0.8rem;
    text-align: center;
  }

  :global(.dark) .reader-state.is-error {
    color: #f87171;
  }

  :global(.reader-error-back) {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--reader-line);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--c-text-muted);
    cursor: pointer;
    font: inherit;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  :global(.reader-error-back:hover),
  :global(.reader-error-back:focus-visible) {
    border-color: var(--c-border-strong);
    background: var(--c-surface-hover);
    color: var(--c-text);
  }

  :global(.reader-error-actions) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 0.35rem;
  }

  :global(.reader-error-retry) {
    border-color: var(--c-border-strong);
    background: var(--c-surface-soft);
    color: var(--c-text);
  }

  .reader-state[hidden] {
    display: none;
  }

  .reader-skeleton {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding-bottom: 2rem;
  }

  .reader-skeleton span {
    height: 0.82rem;
    border-radius: 0.2rem;
  }

  .reader-skeleton span:nth-child(1) {
    width: 94%;
  }

  .reader-skeleton span:nth-child(2) {
    width: 100%;
  }

  .reader-skeleton span:nth-child(3) {
    width: 86%;
  }

  .reader-skeleton span:nth-child(4) {
    width: 100%;
  }

  .reader-skeleton span:nth-child(5) {
    width: 97%;
  }

  .reader-skeleton span:nth-child(6) {
    width: 88%;
  }

  .reader-skeleton span:nth-child(7) {
    width: 94%;
    margin-top: 0.9rem;
  }

  .reader-skeleton span:nth-child(8) {
    width: 72%;
  }

  .reader-skeleton span:nth-child(9),
  .reader-skeleton span:nth-child(15) {
    width: 34%;
    height: 1.25rem;
    margin-top: 1rem;
  }

  .reader-skeleton span:nth-child(10),
  .reader-skeleton span:nth-child(16) {
    width: 98%;
  }

  .reader-skeleton span:nth-child(11),
  .reader-skeleton span:nth-child(17) {
    width: 91%;
  }

  .reader-skeleton span:nth-child(12),
  .reader-skeleton span:nth-child(18) {
    width: 76%;
  }

  .reader-skeleton span:nth-child(13) {
    width: 95%;
  }

  .reader-skeleton .reader-skeleton-media {
    width: 100%;
    height: clamp(10rem, 23vw, 15rem);
    margin-block: 1rem 0.6rem;
    border-radius: 0.5rem;
  }

  .reader-content {
    max-width: none;
    padding-top: 1.75rem;
  }

  .reader-content :global(img) {
    height: auto;
    border-radius: 0.5rem;
  }

  .reader-content :global(.katex) {
    color: var(--reader-math-ink);
  }

  .reader-content :global(.katex-display) {
    max-width: 100%;
    margin: 1.5rem 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding: clamp(0.85rem, 2vw, 1.15rem) clamp(0.9rem, 2.4vw, 1.35rem);
    border: 1px solid var(--reader-math-line);
    border-left-width: 3px;
    border-radius: 0.5rem;
    background: var(--reader-math-surface);
    scrollbar-color: var(--reader-math-line) transparent;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  .reader-content :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid var(--reader-line);
    border-radius: 0.5rem;
    background: var(--c-surface-soft);
  }

  .reader-content :global(pre code) {
    padding: 0;
    background: transparent;
    font-size: 0.82rem;
  }

  .reader-content :global(:not(pre) > code) {
    color: color-mix(in srgb, var(--c-text) 70%, #b45372 30%);
    font-weight: 520;
  }

  :global(.dark) .reader-content :global(:not(pre) > code) {
    color: color-mix(in srgb, var(--c-text) 72%, #f9a8d4 28%);
  }

  .reader-content :global(.reader-code-block) {
    --reader-code-bg: #fff;
    --reader-code-header-bg: #fff;
    --reader-code-border: var(--c-border-soft);
    --reader-code-shadow: rgb(15 23 42 / 0.05);
    position: relative;
    margin: 1em 0;
    overflow: hidden;
    border: 1px solid var(--reader-code-border);
    border-radius: 0.4rem;
    background: var(--reader-code-bg);
    box-shadow: 0 1px 2px var(--reader-code-shadow);
  }

  .reader-content :global(.reader-code-toolbar) {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0.45rem 0.65rem;
    border-bottom: 1px solid var(--reader-code-border);
    background: var(--reader-code-header-bg);
    color: var(--c-text-muted);
    pointer-events: none;
  }

  .reader-content :global(.reader-code-window-controls) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .reader-content :global(.reader-code-window-dot) {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
  }

  .reader-content :global(.reader-code-window-dot.is-close) {
    background: #ff5f57;
  }

  .reader-content :global(.reader-code-window-dot.is-minimize) {
    background: #ffbd2e;
  }

  .reader-content :global(.reader-code-window-dot.is-maximize) {
    background: #28c840;
  }

  .reader-content :global(.reader-code-language) {
    position: absolute;
    right: 0.5rem;
    bottom: 0.35rem;
    padding: 0.1rem 0.45rem;
    border-radius: 0.25rem;
    color: var(--c-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    opacity: 0.78;
    text-transform: uppercase;
  }

  .reader-content
    :global(.reader-code-block[data-terminal='true'] .reader-code-language) {
    display: none;
  }

  .reader-content :global(.reader-code-copy) {
    position: absolute;
    top: 0.175rem;
    right: 0.25rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 0.3rem;
    color: var(--c-text-muted);
    background: transparent;
    font-size: 0.95rem;
    opacity: 0.68;
    pointer-events: auto;
    transition:
      opacity 160ms ease,
      background-color 160ms ease,
      color 160ms ease,
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .reader-content :global(.reader-code-block:hover .reader-code-copy),
  .reader-content :global(.reader-code-block:focus-within .reader-code-copy),
  .reader-content :global(.reader-code-copy:hover),
  .reader-content :global(.reader-code-copy:focus-visible),
  .reader-content :global(.reader-code-copy[data-copied='true']) {
    background: var(--c-surface-hover);
    color: var(--c-text);
    opacity: 1;
  }

  .reader-content :global(.reader-code-copy:active) {
    transform: scale(0.96);
  }

  .reader-content :global(.reader-code-copy:focus-visible) {
    outline: 2px solid var(--c-border-strong);
    outline-offset: 1px;
  }

  .reader-content :global(.reader-code-copy-label) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .reader-content :global(.reader-code-copy-feedback) {
    position: absolute;
    top: 50%;
    right: 2.55rem;
    z-index: 2;
    padding: 0.25rem 0.55rem;
    border-radius: 0.35rem;
    background: var(--c-text);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.12);
    color: var(--c-bg);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(0.25rem, -50%) scale(0.97);
    transform-origin: right center;
    transition:
      opacity 160ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      visibility 0s linear 160ms;
  }

  .reader-content :global(.reader-code-copy-feedback::after) {
    content: '';
    position: absolute;
    top: 50%;
    right: -0.38rem;
    width: 0;
    height: 0;
    border-top: 0.38rem solid transparent;
    border-bottom: 0.38rem solid transparent;
    border-left: 0.42rem solid var(--c-text);
    transform: translateY(-50%);
  }

  .reader-content :global(.reader-code-copy-feedback[data-visible='true']) {
    opacity: 1;
    visibility: visible;
    transform: translate(0, -50%) scale(1);
    transition-delay: 0s;
  }

  .reader-content :global(.reader-code-block > pre) {
    margin: 0;
    padding: 0.85rem 1rem;
    border: 0;
    border-radius: 0;
    background: var(--reader-code-bg);
  }

  :global(.dark) .reader-content :global(.reader-code-block) {
    --reader-code-bg: #121212;
    --reader-code-header-bg: #121212;
    --reader-code-border: var(--c-border-soft);
    --reader-code-shadow: rgb(0 0 0 / 0.16);
  }

  .reader-content :global(.reader-code-block .shiki) {
    color: var(--shiki-light);
  }

  .reader-content :global(.reader-code-block .shiki span) {
    color: var(--shiki-light);
  }

  :global(.dark) .reader-content :global(.reader-code-block .shiki),
  :global(.dark) .reader-content :global(.reader-code-block .shiki span) {
    color: var(--shiki-dark);
  }

  .reader-content :global(.reader-code-block .line) {
    display: inline-block;
    width: 100%;
    min-height: 1.35em;
  }

  .reader-content :global(.reader-code-block code) {
    background: transparent !important;
    border-radius: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    user-select: text;
  }

  .reader-content :global(h2),
  .reader-content :global(h3),
  .reader-content :global(h4) {
    scroll-margin-top: 5rem;
    text-wrap: pretty;
  }

  .reader-neighbors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 3.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--reader-line);
  }

  .reader-neighbors[hidden] {
    display: none;
  }

  .reader-neighbors a {
    display: flex;
    min-width: 0;
    min-height: 5rem;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--reader-line);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--c-text-soft);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .reader-neighbors a:hover,
  .reader-neighbors a:focus-visible {
    border-color: var(--c-border-strong);
    background: var(--c-surface-hover);
    color: var(--c-text);
    transform: translateY(-1px);
  }

  .reader-neighbors a:last-child {
    text-align: right;
  }

  .reader-neighbors a[hidden] {
    visibility: hidden;
  }

  .reader-neighbors span {
    color: var(--c-text-faint);
    font-size: 0.7rem;
  }

  .reader-neighbors strong {
    overflow: hidden;
    font-size: 0.78rem;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @keyframes reader-shimmer {
    0% {
      transform: translate3d(-115%, 0, 0);
    }
    58%,
    100% {
      transform: translate3d(115%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reader-breadcrumb-skeleton span::after,
    .reader-header-skeleton span::after,
    .reader-skeleton span::after,
    .reader-panel-skeleton span::after,
    .reader-panel-skeleton-fill::after {
      animation: none;
      opacity: 0;
    }

    .reader-content :global(.reader-code-copy-feedback) {
      transition: none;
    }

    .reader-mindmap-trigger,
    .reader-mindmap-tools button,
    .reader-mindmap-canvas :global(.reader-mindmap-node rect) {
      transition: none;
    }
  }

  /* Keep the course directory and table of contents visible on normal
     desktop monitors as well as wide screens. At smaller widths the reader
     intentionally falls back to a single column so the content stays usable. */
  @media (min-width: 1128px) {
    .reader-layout {
      display: grid;
      grid-template-columns:
        minmax(11rem, 15rem) minmax(0, 1fr)
        minmax(10rem, 13rem);
      gap: clamp(1rem, 1.8vw, 2rem);
      align-items: start;
    }

    .reader-main {
      grid-column: 2;
      grid-row: 1;
      max-width: none;
      margin: 0;
    }

    .reader-course-panel,
    .reader-panel-skeleton-course {
      grid-column: 1;
      grid-row: 1;
    }

    .reader-toc-panel,
    .reader-panel-skeleton-toc {
      grid-column: 3;
      grid-row: 1;
    }

    geektime-reader[data-loading] .reader-panel-skeleton {
      display: flex;
      height: calc(100svh - 7rem);
      min-height: 38rem;
      flex-direction: column;
      gap: 0.78rem;
      padding: 0.2rem 0.35rem;
    }

    .reader-panel-skeleton span {
      width: 86%;
      height: 0.62rem;
      border-radius: 0.2rem;
    }

    .reader-panel-skeleton span:nth-child(3n) {
      width: 68%;
    }

    .reader-panel-skeleton span:nth-child(3n + 2) {
      width: 96%;
    }

    .reader-panel-skeleton .reader-panel-skeleton-heading {
      width: 100%;
      height: 1.55rem;
      flex: none;
      margin-bottom: 0.35rem;
      border-radius: 0.3rem;
    }

    .reader-panel-skeleton-fill {
      position: relative;
      isolation: isolate;
      width: 100%;
      min-height: 8rem;
      flex: 1;
      overflow: hidden;
      background: var(--reader-skeleton-base);
      -webkit-mask-image:
        linear-gradient(to bottom, #000 0 0.62rem, transparent 0.62rem),
        linear-gradient(to bottom, #000 0 0.62rem, transparent 0.62rem),
        linear-gradient(to bottom, #000 0 0.62rem, transparent 0.62rem),
        linear-gradient(to bottom, #000 0 0.62rem, transparent 0.62rem);
      mask-image:
        linear-gradient(to bottom, #000 0 0.62rem, transparent 0.62rem),
        linear-gradient(to bottom, #000 0 0.62rem, transparent 0.62rem),
        linear-gradient(to bottom, #000 0 0.62rem, transparent 0.62rem),
        linear-gradient(to bottom, #000 0 0.62rem, transparent 0.62rem);
      -webkit-mask-position:
        0 0,
        0 1.4rem,
        0 2.8rem,
        0 4.2rem;
      mask-position:
        0 0,
        0 1.4rem,
        0 2.8rem,
        0 4.2rem;
      -webkit-mask-repeat: repeat-y;
      mask-repeat: repeat-y;
      -webkit-mask-size:
        96% 5.6rem,
        68% 5.6rem,
        86% 5.6rem,
        76% 5.6rem;
      mask-size:
        96% 5.6rem,
        68% 5.6rem,
        86% 5.6rem,
        76% 5.6rem;
    }

    .reader-course-panel,
    .reader-toc-panel {
      position: sticky;
      top: 5.5rem;
      display: flex;
      max-height: calc(100vh - 7rem);
      flex-direction: column;
      overflow: hidden;
      color: var(--c-text-muted);
    }

    .reader-aside-heading {
      display: flex;
      flex: none;
      align-items: center;
      gap: 0.45rem;
      min-height: 2.25rem;
      padding: 0.2rem 0.35rem 0.65rem;
      border-bottom: 1px solid var(--reader-line);
      color: var(--c-text);
      font-size: 0.78rem;
      font-weight: 600;
    }

    .reader-aside-heading a {
      min-width: 0;
      overflow: hidden;
      border: 0;
      color: inherit;
      text-decoration: none;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .reader-aside-heading [data-course-count] {
      margin-left: auto;
      color: var(--c-text-faint);
      font-family: var(--font-mono);
      font-size: 0.62rem;
      font-weight: 400;
    }

    .reader-course-list,
    .reader-toc-list {
      overflow-y: auto;
      padding: 0.65rem 0.35rem 1rem;
      margin: 0;
      scrollbar-color: var(--c-border-strong) transparent;
      scrollbar-width: thin;
    }

    :global(.reader-course-item) {
      margin: 0;
      list-style: none;
    }

    :global(.reader-course-item::before) {
      display: none;
    }

    :global(.reader-course-link) {
      display: grid;
      grid-template-columns: 1.55rem minmax(0, 1fr);
      gap: 0.35rem;
      padding: 0.42rem 0.4rem;
      border-radius: 0.35rem;
      color: var(--c-text-muted);
      font-size: 0.72rem;
      line-height: 1.45;
      text-decoration: none;
      transition:
        background-color 0.2s ease,
        color 0.2s ease;
    }

    :global(.reader-course-link:hover),
    :global(.reader-course-link:focus-visible) {
      background: var(--c-surface-hover);
      color: var(--c-text);
    }

    :global(.reader-course-link[aria-current='page']) {
      background: var(--c-surface-active);
      color: var(--c-text);
      font-weight: 600;
    }

    :global(.reader-course-index) {
      color: var(--c-text-faint);
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 400;
    }

    :global(.reader-toc-link) {
      display: block;
      overflow: hidden;
      padding: 0.38rem 0.45rem;
      border-left: 1px solid transparent;
      color: var(--c-text-muted);
      font-size: 0.72rem;
      line-height: 1.4;
      text-decoration: none;
      text-overflow: ellipsis;
      white-space: nowrap;
      transition:
        border-color 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
    }

    :global(.reader-toc-link[data-depth='3']) {
      padding-left: 1rem;
    }

    :global(.reader-toc-link[data-depth='4']) {
      padding-left: 1.55rem;
    }

    :global(.reader-toc-link:hover),
    :global(.reader-toc-link:focus-visible),
    :global(.reader-toc-link[aria-current='true']) {
      border-left-color: var(--c-border-strong);
      color: var(--c-text);
      transform: translateX(2px);
    }

    :global(html[data-immersive]) .reader-layout {
      display: block;
      max-width: 72rem;
    }

    :global(html[data-immersive]) .reader-course-panel,
    :global(html[data-immersive]) .reader-toc-panel {
      display: none;
    }

    :global(html[data-immersive]) .reader-main {
      max-width: 72rem;
      margin-inline: auto;
    }
  }

  @media (max-width: 640px) {
    .reader-breadcrumb {
      margin-bottom: 1.5rem;
    }

    .reader-header h1 {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
    }

    .reader-header-skeleton-title {
      height: 2.15rem;
    }

    .reader-neighbors {
      grid-template-columns: 1fr;
    }

    .reader-neighbors a:last-child {
      text-align: left;
    }

    .reader-mindmap-dialog {
      width: 100vw;
      height: 100svh;
      border-width: 0;
      border-radius: 0;
    }

    .reader-mindmap-header {
      min-height: 6.4rem;
      flex-direction: column;
      align-items: stretch;
      gap: 0.55rem;
      padding: max(0.75rem, env(safe-area-inset-top)) 0.75rem 0.65rem;
    }

    .reader-mindmap-tools {
      justify-content: flex-end;
    }

    .reader-mindmap-tools .reader-mindmap-close {
      margin-left: auto;
    }

    .reader-mindmap-viewport {
      padding: 0.55rem;
    }

    .reader-mindmap-hint {
      padding-bottom: max(0.65rem, env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 1127px) {
    geektime-reader {
      --reader-drawer-width: min(22rem, calc(100vw - 2rem));
      --reader-toggle-open-offset: calc(var(--reader-drawer-width) + 1rem);
      --reader-toggle-open-offset-negative: calc(
        0px - var(--reader-toggle-open-offset)
      );
      --reader-drawer-duration: 300ms;
      --reader-drawer-ease: cubic-bezier(0.22, 1, 0.36, 1);
    }

    .reader-floating-controls {
      display: flex;
      position: fixed;
      z-index: 180;
      inset-inline: -0.9375rem;
      top: 50%;
      align-items: center;
      justify-content: space-between;
      pointer-events: none;
      transform: translateY(-50%);
    }

    .reader-panel-toggle {
      display: inline-flex;
      position: relative;
      width: 1.875rem;
      height: 1.875rem;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: color-mix(in srgb, var(--c-bg) 30%, transparent);
      box-shadow:
        0 3px 10px rgb(0 0 0 / 0.08),
        inset 0 1px 0 rgb(255 255 255 / 0.12);
      color: var(--c-text-muted);
      cursor: pointer;
      pointer-events: auto;
      -webkit-backdrop-filter: saturate(150%) blur(14px);
      backdrop-filter: saturate(150%) blur(14px);
      transition:
        transform var(--reader-drawer-duration) var(--reader-drawer-ease),
        background-color 160ms ease,
        color 160ms ease,
        box-shadow 160ms ease;
      will-change: transform;
    }

    .reader-panel-toggle > span {
      position: absolute;
      font-size: 1rem;
      line-height: 1;
      transition:
        opacity 180ms ease,
        transform var(--reader-drawer-duration) var(--reader-drawer-ease);
    }

    .reader-toggle-icon-collapsed {
      opacity: 1;
      transform: scale(1);
    }

    .reader-toggle-icon-expanded {
      opacity: 0;
      transform: scale(0.72);
    }

    .reader-panel-toggle:hover {
      background: var(--c-bg);
      box-shadow:
        0 5px 16px rgb(0 0 0 / 0.12),
        inset 0 1px 0 rgb(255 255 255 / 0.14);
      color: var(--c-text);
    }

    .reader-panel-toggle:focus-visible {
      background: var(--c-bg);
      color: var(--c-text);
    }

    .reader-panel-toggle[aria-expanded='true'] {
      background: color-mix(in srgb, var(--c-bg) 38%, transparent);
      box-shadow:
        0 4px 14px rgb(0 0 0 / 0.1),
        inset 0 1px 0 rgb(255 255 255 / 0.14);
      color: var(--c-text);
    }

    .reader-course-toggle:not([aria-expanded='true']):is(
        :hover,
        :focus-visible
      ) {
      transform: translateX(0.9375rem);
    }

    .reader-toc-toggle:not([aria-expanded='true']):is(:hover, :focus-visible) {
      transform: translateX(-0.9375rem);
    }

    .reader-course-toggle[aria-expanded='true'] {
      transform: translateX(var(--reader-toggle-open-offset));
    }

    .reader-toc-toggle[aria-expanded='true'] {
      transform: translateX(var(--reader-toggle-open-offset-negative));
    }

    .reader-panel-toggle[aria-expanded='true'] .reader-toggle-icon-collapsed {
      opacity: 0;
      transform: scale(0.72);
    }

    .reader-panel-toggle[aria-expanded='true'] .reader-toggle-icon-expanded {
      opacity: 1;
      transform: scale(1);
    }

    .reader-course-panel[data-reader-panel-ready],
    .reader-toc-panel[data-reader-panel-ready] {
      position: fixed;
      z-index: 170;
      top: 5.5rem;
      bottom: 1.5rem;
      display: flex;
      visibility: hidden;
      width: var(--reader-drawer-width);
      max-height: none;
      flex-direction: column;
      overflow: hidden;
      padding: 1rem;
      border: 1px solid var(--c-border-soft);
      border-radius: 0.9rem;
      background: color-mix(in srgb, var(--c-bg) 94%, transparent);
      box-shadow: 0 18px 48px rgb(0 0 0 / 0.16);
      -webkit-backdrop-filter: saturate(150%) blur(18px);
      backdrop-filter: saturate(150%) blur(18px);
      color: var(--c-text-muted);
      opacity: 0;
      pointer-events: none;
      transition:
        visibility 0s linear var(--reader-drawer-duration),
        opacity 180ms ease,
        transform var(--reader-drawer-duration) var(--reader-drawer-ease);
      will-change: transform, opacity;
    }

    .reader-course-panel[data-reader-panel-ready] {
      left: 1rem;
      transform: translateX(calc(-100% - 1.5rem));
    }

    .reader-toc-panel[data-reader-panel-ready] {
      right: 1rem;
      transform: translateX(calc(100% + 1.5rem));
