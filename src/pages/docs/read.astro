<script>
  import DOMPurify from 'dompurify'
  import renderMathInElement from 'katex/contrib/auto-render'
  import { Marked, type TokenizerAndRendererExtension } from 'marked'
  import {
    bundledLanguages,
    codeToHtml,
    type BundledLanguage,
  } from 'shiki/bundle/full'
  import imageFallbacks from '~/data/nuggets-image-fallbacks.json'
  import { finishProgress, startProgress } from '~/scripts/progress'

  const COURSE_PROGRESS_TASK = 'course-reader'
  const FETCH_RETRY_DELAYS = [240, 700, 1400] as const
  const COURSE_MATH_DELIMITERS = [
    { left: '$$', right: '$$', display: true },
    { left: '\\[', right: '\\]', display: true },
    { left: '\\(', right: '\\)', display: false },
    { left: '$', right: '$', display: false },
  ] as const

  const waitForRetry = (delay: number, signal?: AbortSignal) =>
    new Promise<void>((resolve, reject) => {
      if (signal?.aborted) {
        reject(new DOMException('Aborted', 'AbortError'))
        return
      }

      const timer = window.setTimeout(() => {
        signal?.removeEventListener('abort', handleAbort)
        resolve()
      }, delay)
      const handleAbort = () => {
        window.clearTimeout(timer)
        reject(new DOMException('Aborted', 'AbortError'))
      }
      signal?.addEventListener('abort', handleAbort, { once: true })
    })

  const shouldRetryStatus = (status: number) =>
    status === 403 ||
    status === 404 ||
    status === 408 ||
    status === 425 ||
    status === 429 ||
    status >= 500

  const legacyStrongExtension: TokenizerAndRendererExtension = {
    name: 'courseLegacyStrong',
    level: 'inline',
    start(source) {
      return source.indexOf('**')
    },
    tokenizer(source) {
      const match = /^\*\*(?!\*)([^\n]+?)(?<!\*)\*\*(?!\*)/.exec(source)
      if (!match) return

      const content = match[1]
      const text = content.trim()
      if (!text) return

      return {
        type: 'courseLegacyStrong',
        raw: match[0],
        leading: content.match(/^\s*/)?.[0] || '',
        trailing: content.match(/\s*$/)?.[0] || '',
        tokens: this.lexer.inlineTokens(text),
      }
    },
    renderer(token) {
      const leading = typeof token.leading === 'string' ? token.leading : ''
      const trailing = typeof token.trailing === 'string' ? token.trailing : ''
      const tokens = Array.isArray(token.tokens) ? token.tokens : []
      return `${leading}<strong>${this.parser.parseInline(tokens)}</strong>${trailing}`
    },
    childTokens: ['tokens'],
  }

  const courseMarkdown = new Marked({
    gfm: true,
    breaks: false,
  })
  courseMarkdown.use({ extensions: [legacyStrongExtension] })

  const CODE_LANGUAGE_ALIASES: Record<string, BundledLanguage> = {
    'bash': 'shellscript',
    'bat': 'bat',
    'c': 'c',
    'c#': 'csharp',
    'c++': 'cpp',
    'cjs': 'javascript',
    'console': 'shellscript',
    'cpp': 'cpp',
    'cs': 'csharp',
    'csharp': 'csharp',
    'css': 'css',
    'docker': 'dockerfile',
    'dockerfile': 'dockerfile',
    'dotenv': 'dotenv',
    'graphql': 'graphql',
    'go': 'go',
    'golang': 'go',
    'html': 'html',
    'http': 'http',
    'ini': 'ini',
    'java': 'java',
    'javascript': 'javascript',
    'js': 'javascript',
    'json': 'json',
    'json5': 'json5',
    'jsx': 'jsx',
    'kotlin': 'kotlin',
    'kt': 'kotlin',
    'make': 'makefile',
    'makefile': 'makefile',
    'md': 'markdown',
    'markdown': 'markdown',
    'mts': 'typescript',
    'mysql': 'sql',
    'nginx': 'nginx',
    'objectivec': 'objective-c',
    'perl': 'perl',
    'php': 'php',
    'powershell': 'powershell',
    'ps1': 'powershell',
    'py': 'python',
    'python': 'python',
    'rb': 'ruby',
    'ruby': 'ruby',
    'rs': 'rust',
    'rust': 'rust',
    'scala': 'scala',
    'sh': 'shellscript',
    'shell': 'shellscript',
    'shellscript': 'shellscript',
    'curl': 'shellscript',
    'sql': 'sql',
    'swift': 'swift',
    'terminal': 'shellscript',
    'toml': 'toml',
    'ts': 'typescript',
    'tsx': 'tsx',
    'typescript': 'typescript',
    'vue': 'vue',
    'xml': 'xml',
    'yaml': 'yaml',
    'yml': 'yaml',
  }

  const DIFF_LANGUAGE_TOKENS = new Set(['dif', 'diff', 'patch'])
  const GENERIC_LANGUAGE_TOKENS = new Set([
    'none',
    'plain',
    'plaintext',
    'text',
    'txt',
  ])
  const CODE_LANGUAGE_LABELS: Partial<Record<BundledLanguage, string>> = {
    shellscript: 'bash',
  }
  const COURSE_COMMENTS_HEADING = /^精选留言(?:[（(]\d+[）)])?$/

  const isCourseCommentsHeading = (value: string) => {
    const normalized = value
      .replace(/^\s{0,3}#{1,6}\s*/, '')
      .replace(/^\s*>\s*/, '')
      .replace(/<[^>]+>/g, '')
      .replace(/\*\*|__/g, '')
      .replace(/[\s\u200b\ufeff]/g, '')
    return COURSE_COMMENTS_HEADING.test(normalized)
  }

  const stripCourseComments = (markdown: string) => {
    const lines = markdown.split(/\r?\n/)
    const commentsIndex = lines.findIndex(isCourseCommentsHeading)
    return commentsIndex >= 0
      ? lines.slice(0, commentsIndex).join('\n').trimEnd()
      : markdown
  }

  const stripRenderedCourseComments = (root: DocumentFragment) => {
    const marker = Array.from(
      root.querySelectorAll<HTMLElement>(
        'h1, h2, h3, h4, h5, h6, p, div, strong, b'
      )
    ).find((element) => isCourseCommentsHeading(element.textContent || ''))
    if (!marker) return

    let block: Element = marker
    while (block.parentElement) block = block.parentElement
    while (block.nextSibling) block.nextSibling.remove()
    block.remove()
  }

  const hasDiffMarkers = (source: string) =>
    /^(?:diff --git|index [\da-f]+|@@\s|---\s|\+\+\+\s|[+-](?![+-]))/im.test(
      source
    )

  const inferCodeLanguage = (source: string): BundledLanguage | undefined => {
    const code = source.trim()
    if (!code) return undefined

    if (code.startsWith('{') || code.startsWith('[')) {
      try {
        JSON.parse(code)
        return 'json'
      } catch {
        // Continue with syntax-based detection.
      }
    }
    if (/<template(?:\s|>)|<script\s+setup|defineComponent\s*\(/i.test(code))
      return 'vue'
    if (/^<\?php|\b(?:namespace|use)\s+[A-Z\\][\w\\]*;/m.test(code))
      return 'php'
    if (
      /(?:^|\n)\s*package\s+\w+\b|(?:^|\n)\s*func\s+(?:\([^)]*\)\s*)?\w+\s*\(|\bfmt\.(?:Print|Printf|Println)\b/m.test(
        code
      )
    )
      return 'go'
    if (
      /(?:^|\n)\s*(?:use\s+(?:std|crate)::|fn\s+\w+\s*\(|let\s+mut\s+\w+)|\bprintln!\s*\(/m.test(
        code
      )
    )
      return 'rust'
    if (/(?:^|\n)\s*#include\s*[<"]|\bstd::|\b(?:cout|cin)\s*<</m.test(code))
      return 'cpp'
    if (
      /(?:^|\n)\s*(?:using\s+System\b|namespace\s+\w+)|\bConsole\.WriteLine\s*\(/m.test(
        code
      )
    )
      return 'csharp'
    if (
      /(?:^|\n)\s*(?:interface|type|enum|namespace)\s+\w+|:\s*(?:string|number|boolean|unknown|never)(?:\W|$)|\b(?:as const|satisfies)\b/m.test(
        code
      )
    )
      return 'typescript'
    if (/^\s*export\s+[A-Z_][A-Z0-9_]*\s*=/m.test(code)) return 'shellscript'
    if (
      /(?:^|\n)\s*(?:FROM|RUN|COPY|ADD|ENTRYPOINT|CMD|WORKDIR|EXPOSE)\s+/m.test(
        code
      )
    )
      return 'dockerfile'
    if (
      /(?:^|\n)\s*(?:from\s+[\w.]+\s+import\s+|import\s+(?:os|sys|json|re|math|pathlib|typing|openai|langchain)\b)/m.test(
        code
      ) ||
      /\b(?:os\.environ|client\.(?:chat\.)?completions\.create|True|False|None)\b/.test(
        code
      )
    )
      return 'python'
    if (
      /(?:^|\n)\s*(?:require\s+['"][^'"]+['"]|puts\s+|class\s+\w+\s*<)|\.each\s+do\s*\|/m.test(
        code
      )
    )
      return 'ruby'
    if (
      /(?:^|\n)\s*(?:import|export)\b|\b(?:const|let|var)\s+[$\w]+|=>|\bfunction\s+[$\w]+|\b(?:window|document|console)\./m.test(
        code
      )
    )
      return 'javascript'
    if (/<[a-z][\s\S]*>/i.test(code)) return 'html'
    if (
      /(?:^|\n)\s*(?:[.#][\w-]+|@media\b)[^{\n]*\{|\b(?:display|color|margin|padding|background):\s*/m.test(
        code
      )
    )
      return 'css'
    if (
      /(?:^|\n)\s*(?:[$#]\s+)?(?:sudo\s+)?(?:npm|pnpm|yarn|bun|pip|pip3|python|python3|uv|poetry|pipx|curl|wget|git|cd|mkdir|docker|kubectl|mysql|psql|sqlite3|apt|apt-get|brew|echo|export|source|chmod|chown|rm|cp|mv|cat|grep|sed|awk|md5sum|sha256sum|groupadd|useradd|tar|ln|rpm|yum|dnf|service|systemctl|more|less|head|tail|make|cmake)\b|(?:^|\n)\s*\.\/(?:configure|[\w.-]+)|(?:^|\n)\s*(?:mysql|psql)>\s*|^#!\/.*(?:ba|z)?sh|(?:^|\n)\s*(?:if\s+\[|for\s+\w+\s+in\b|case\s+.+\s+in\b|[A-Z_][A-Z0-9_]*=)/m.test(
        code
      )
    )
      return 'shellscript'
    if (
      ((code.match(/(?:^|\n)\s*[\w.-]+:\s+[^\n]+/g) || []).length >= 2 ||
        /(?:^|\n)\s*---\s*$/.test(code)) &&
      !/<[a-z][\s\S]*>/i.test(code) &&
      !/[{}()]|(?:^|\n)\s*(?:def|class|from|import)\b/m.test(code)
    )
      return 'yaml'
    if (
      /(?:^|\n)\s*\[[\w.-]+\]\s*$/m.test(code) ||
      ((code.match(/(?:^|\n)\s*[\w.-]+\s*=\s*(?:"[^"]*"|'[^']*'|\d+)/g) || [])
        .length >= 2 &&
        !/[(){}:]|(?:^|\n)\s*(?:def|class|from|import)\b/m.test(code))
    )
      return 'toml'
    if (
      /(?:^|\n)\s*(?:def|class)\s+\w+|(?:^|\n)\s*from\s+[\w.]+\s+import\s+|(?:^|\n)\s*import\s+[\w.]+|\bprint\s*\(|\b(?:model|temperature|max_tokens|prompt|messages)\s*=|\b(?:client|response)\.[\w.]+\(/m.test(
        code
      )
    )
      return 'python'
    if (
      /\b(?:SELECT|INSERT|UPDATE|DELETE|CREATE TABLE|ALTER TABLE)\b/i.test(code)
    )
      return 'sql'
    if (
      /(?:^|\n)\s*(?:val|var)\s+\w+\s*(?::[^=]+)?=|(?:^|\n)\s*(?:object|case class|trait)\s+\w+/m.test(
        code
      )
    )
      return 'scala'
    if (/\bpublic\s+(?:static\s+)?(?:class|void)|\bSystem\.out\./m.test(code))
      return 'java'

    if (!/[A-Za-z_$][\w$]*(?:\s*[=().:]|\s|$)/.test(code))
      return 'text' as BundledLanguage

    return undefined
  }

  interface Article {
    title: string
    path: string
    bytes?: number
  }

  interface Course {
    id: string
    sourceId?: string
    name: string
    path: string
    articles: Article[]
  }

  interface Category {
    id: string
    name: string
    courses: Course[]
  }

  interface Catalog {
    sources?: Source[]
    source?: string
    commit?: string
    categories: Category[]
  }

  interface Source {
    id: string
    name: string
    source: string
    repository: string
    commit: string
  }

  interface MindMapNode {
    title: string
    headingId?: string
    depth: number
    children: MindMapNode[]
    lines?: string[]
    x?: number
    y?: number
    width?: number
    height?: number
  }

  class GeektimeReader extends HTMLElement {
    private catalog!: Catalog
    private article!: Article
    private course!: Course
    private category!: Category
    private source!: Source
    private headingObserver?: IntersectionObserver
    private requestController?: AbortController
    private loadSequence = 0
    private markdownCache = new Map<string, string>()
    private requestedLocationKey = ''
    private copyFeedbackTimers = new WeakMap<HTMLButtonElement, number>()
    private mindMapRoot?: MindMapNode
    private mindMapScale = 1
    private mindMapWidth = 0
    private mindMapHeight = 0
    private mindMapResizeFrame?: number

    connectedCallback() {
      this.addEventListener('click', this.handleReaderLink)
      this.addEventListener('click', this.handleCodeCopy)
      this.addEventListener('click', this.handlePanelToggle)
      this.addEventListener('click', this.handleMindMapClick)
      this.addEventListener('keydown', this.handleMindMapKeydown)
      this.addEventListener('pointerover', this.prefetchReaderLink)
      window.addEventListener('popstate', this.handlePopState)
      window.addEventListener('resize', this.handleMindMapResize)
      document.addEventListener('astro:page-load', this.handlePageLoad)
      startProgress(COURSE_PROGRESS_TASK)
      this.load()
        .catch((error) => this.showError(error))
        .finally(() => finishProgress(COURSE_PROGRESS_TASK))
    }

    disconnectedCallback() {
      this.removeEventListener('click', this.handleReaderLink)
      this.removeEventListener('click', this.handleCodeCopy)
      this.removeEventListener('click', this.handlePanelToggle)
      this.removeEventListener('click', this.handleMindMapClick)
      this.removeEventListener('keydown', this.handleMindMapKeydown)
      this.removeEventListener('pointerover', this.prefetchReaderLink)
      window.removeEventListener('popstate', this.handlePopState)
      window.removeEventListener('resize', this.handleMindMapResize)
      document.removeEventListener('astro:page-load', this.handlePageLoad)
      this.headingObserver?.disconnect()
      this.requestController?.abort()
      if (this.mindMapResizeFrame)
        window.cancelAnimationFrame(this.mindMapResizeFrame)
      finishProgress(COURSE_PROGRESS_TASK)
    }

    private async load() {
      const location = this.resolveArticleLocation()
      if (!location) {
        window.location.replace('/docs/')
        return
      }

      const catalogUrl = this.dataset.catalogUrl || '/docs/catalog.json'
      const catalogResponse = await this.fetchCatalog(catalogUrl)
      this.catalog = (await catalogResponse.json()) as Catalog

      await this.loadArticle(
        location.path,
        true,
        location.sourceId,
        location.courseId
      )
    }

    private async loadArticle(
      articlePath: string,
      initial = false,
      sourceId = this.source?.id || 'geektime',
      courseId?: string
    ) {
      const locationKey = this.getLocationKey(articlePath, sourceId, courseId)
      if (!initial && locationKey === this.requestedLocationKey) return
      this.requestedLocationKey = locationKey

      const located = this.findArticle(articlePath, sourceId, courseId)
      if (!located) throw new Error('没有在当前内容快照中找到这篇文档。')

      const sequence = ++this.loadSequence
      this.requestController?.abort()
      this.requestController = new AbortController()
      this.closeMindMap()
      const readerMain = this.querySelector<HTMLElement>('.reader-main')
      startProgress(COURSE_PROGRESS_TASK)
      if (!initial) {
        readerMain?.setAttribute('data-switching', '')
        readerMain?.setAttribute('aria-busy', 'true')
      }

      try {
        const markdown = await this.fetchMarkdown(
          located.article.path,
          located.source,
          this.requestController.signal
        )
        if (sequence !== this.loadSequence) return
        const articleMarkdown = stripCourseComments(markdown)

        ;({
          article: this.article,
          course: this.course,
          category: this.category,
          source: this.source,
        } = located)

        this.canonicalizeLocation()

        this.updateHeader()
        const rendered = courseMarkdown.parse(articleMarkdown)
        const safeHtml = DOMPurify.sanitize(rendered as string, {
          USE_PROFILES: { html: true },
        })
        const template = document.createElement('template')
        template.innerHTML = safeHtml
        template.content.querySelector('h1')?.remove()
        stripRenderedCourseComments(template.content)
        this.rewriteResources(template.content)
        this.addHeadingAnchors(template.content)
        await this.decorateCodeBlocks(template.content)

        const content = this.querySelector<HTMLElement>('[data-content]')
        const state = this.querySelector<HTMLElement>('[data-state]')
        if (!content || !state) return

        content.replaceChildren(template.content)
        renderMathInElement(content, {
          delimiters: COURSE_MATH_DELIMITERS,
          ignoredTags: [
            'script',
            'noscript',
            'style',
            'textarea',
            'pre',
            'code',
          ],
          throwOnError: false,
          strict: false,
          trust: false,
        })
        content.hidden = false
        state.hidden = true
        state.classList.remove('is-error')
        this.removeAttribute('data-loading')
        this.removeAttribute('aria-busy')
        this.updateCoursePanel()
        this.updatePostActions(articleMarkdown)
        this.updateMindMap(content)
        this.updateToc(content)
        this.updateNavigation()

        if (!initial) {
          const header = this.querySelector<HTMLElement>('.reader-breadcrumb')
          const top = header
            ? header.getBoundingClientRect().top + window.scrollY - 80
            : 0
          window.scrollTo({ top: Math.max(0, top), behavior: 'auto' })
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            content.animate(
              [
                { opacity: 0.55, transform: 'translateY(6px)' },
                { opacity: 1, transform: 'translateY(0)' },
              ],
              {
                duration: 180,
                easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
              }
            )
          }
        }

        this.prefetchNeighbors()
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return
        if (sequence === this.loadSequence) this.requestedLocationKey = ''
        throw error
      } finally {
        if (sequence === this.loadSequence) {
          finishProgress(COURSE_PROGRESS_TASK)
          readerMain?.removeAttribute('data-switching')
          readerMain?.removeAttribute('aria-busy')
        }
      }
    }

    private async decorateCodeBlocks(root: DocumentFragment) {
      const blocks = Array.from(root.querySelectorAll('pre'))
      for (const pre of blocks) {
        const code = pre.querySelector('code')
        const source = (code?.textContent || pre.textContent || '').replace(
          /\n+$/,
          ''
        )
        const languageClass = Array.from(
          new Set([...pre.classList, ...(code?.classList || [])])
        ).find((name) => name.startsWith('language-'))
        const languageToken = languageClass
          ?.slice('language-'.length)
          .split(/[\s,{]/, 1)[0]
          .toLowerCase()
        const declaredLanguage = languageToken
          ? CODE_LANGUAGE_ALIASES[languageToken] ||
            (languageToken in bundledLanguages
              ? (languageToken as BundledLanguage)
              : undefined)
          : undefined
        const shouldInfer =
          !languageToken ||
          !declaredLanguage ||
          GENERIC_LANGUAGE_TOKENS.has(languageToken) ||
          (DIFF_LANGUAGE_TOKENS.has(languageToken) && !hasDiffMarkers(source))
        const inferredLanguage = inferCodeLanguage(source)
        const hasLanguageMismatch =
          inferredLanguage &&
          declaredLanguage &&
          inferredLanguage !== declaredLanguage &&
          (inferredLanguage === 'shellscript' || inferredLanguage === 'python')
        const language = shouldInfer
          ? inferredLanguage || declaredLanguage
          : hasLanguageMismatch
            ? inferredLanguage
            : declaredLanguage
        const resolvedLanguage = language || ('text' as BundledLanguage)

        let highlightedPre: HTMLPreElement | null = null
        let highlightedLanguage = resolvedLanguage
        const candidates = Array.from(
          new Set<BundledLanguage>([
            resolvedLanguage,
            'text' as BundledLanguage,
          ])
        )
        for (const candidate of candidates) {
          try {
            const highlighted = await codeToHtml(source, {
              lang: candidate,
              themes: {
                light: 'vitesse-light',
                dark: 'vitesse-dark',
              },
              defaultColor: false,
            })
            const highlightedTemplate = document.createElement('template')
            highlightedTemplate.innerHTML = highlighted
            highlightedPre = highlightedTemplate.content.querySelector('pre')
            if (highlightedPre) {
              highlightedLanguage = candidate
              break
            }
          } catch (error) {
            if (candidate === candidates.at(-1)) {
              console.warn('[course-reader] code highlighting failed', {
                language: resolvedLanguage,
                error,
              })
            }
          }
        }

        const wrapper = document.createElement('div')
        wrapper.className = 'reader-code-block'
        wrapper.dataset.code = source
        if (languageToken) wrapper.dataset.sourceLanguage = languageToken
        wrapper.dataset.highlighted = String(Boolean(highlightedPre))
        wrapper.dataset.language = highlightedLanguage
        const isTerminal = highlightedLanguage === 'shellscript'
        wrapper.dataset.terminal = String(isTerminal)

        const toolbar = document.createElement('div')
        toolbar.className = 'reader-code-toolbar'
        toolbar.dataset.terminal = String(isTerminal)

        const windowControls = document.createElement('span')
        windowControls.className = 'reader-code-window-controls'
        windowControls.setAttribute('aria-hidden', 'true')
        windowControls.innerHTML =
          '<span class="reader-code-window-dot is-close"></span><span class="reader-code-window-dot is-minimize"></span><span class="reader-code-window-dot is-maximize"></span>'
        toolbar.append(windowControls)

        const languageLabel = document.createElement('span')
        languageLabel.className = 'reader-code-language'
        languageLabel.textContent =
          CODE_LANGUAGE_LABELS[highlightedLanguage] ||
          (highlightedLanguage === ('text' as BundledLanguage)
            ? '代码'
            : highlightedLanguage) ||
          languageToken ||
          '代码'

        const copyButton = document.createElement('button')
        copyButton.type = 'button'
        copyButton.className = 'reader-code-copy'
        copyButton.dataset.copyCode = ''
        copyButton.dataset.copyLabel = '复制'
        copyButton.setAttribute('aria-label', '复制代码')
        copyButton.innerHTML =
          '<span class="i-ri-file-copy-line" aria-hidden="true"></span><span class="reader-code-copy-label" data-copy-label>复制</span>'

        const copyFeedback = document.createElement('span')
        copyFeedback.className = 'reader-code-copy-feedback'
        copyFeedback.dataset.copyFeedback = ''
        copyFeedback.setAttribute('role', 'status')
        copyFeedback.setAttribute('aria-live', 'polite')

        toolbar.append(copyFeedback, copyButton)
        wrapper.append(
          toolbar,
          highlightedPre || (pre.cloneNode(true) as HTMLPreElement),
          languageLabel
        )
        pre.replaceWith(wrapper)
      }
    }

    private handleCodeCopy = async (event: MouseEvent) => {
      if (!(event.target instanceof Element)) return
      const button = event.target.closest<HTMLButtonElement>('[data-copy-code]')
      if (!button || !this.contains(button)) return

      event.preventDefault()
      event.stopPropagation()
      const block = button.closest<HTMLElement>('.reader-code-block')
      const source = block?.dataset.code
      if (source === undefined) return

      try {
        await navigator.clipboard.writeText(source)
      } catch {
        const fallback = document.createElement('textarea')
        fallback.value = source
        fallback.setAttribute('readonly', '')
        fallback.style.position = 'fixed'
        fallback.style.opacity = '0'
        document.body.append(fallback)
        fallback.select()
        document.execCommand('copy')
        fallback.remove()
      }

      const label = button.querySelector<HTMLElement>('[data-copy-label]')
      const feedback = block?.querySelector<HTMLElement>('[data-copy-feedback]')
      const originalLabel = button.dataset.copyLabel || '复制'
      window.clearTimeout(this.copyFeedbackTimers.get(button))
      if (label) label.textContent = '已复制'
      if (feedback) {
        feedback.textContent = '已复制'
        feedback.dataset.visible = 'true'
      }
      button.dataset.copied = 'true'
      const hideTimer = window.setTimeout(() => {
        if (!button.isConnected) return
        if (label) label.textContent = originalLabel
        if (feedback) {
          delete feedback.dataset.visible
        }
        delete button.dataset.copied
      }, 1400)
      this.copyFeedbackTimers.set(button, hideTimer)
    }

    private updateMindMap(content: HTMLElement) {
      const root: MindMapNode = {
        title: this.article.title,
        depth: 1,
        children: [],
      }
      const stack: MindMapNode[] = [root]
      const headings = Array.from(
        content.querySelectorAll<HTMLElement>('h2, h3, h4')
      )

      for (const heading of headings) {
        const depth = Number(heading.tagName.slice(1))
        const node: MindMapNode = {
          title: heading.textContent?.trim() || '未命名章节',
          headingId: heading.id,
          depth,
          children: [],
        }
        while (stack.length > 1 && stack.at(-1)!.depth >= depth) stack.pop()
        ;(stack.at(-1) || root).children.push(node)
        stack.push(node)
      }

      this.mindMapRoot = root
      const title = this.querySelector<HTMLElement>('[data-mindmap-title]')
      if (title) title.textContent = this.article.title
    }

    private wrapMindMapText(value: string, maxUnits: number, maxLines = 3) {
      const normalized = value.replace(/\s+/g, ' ').trim() || '未命名章节'
      const tokens =
        normalized.match(
          /[\u3400-\u9fff\uf900-\ufaff]|[A-Za-z0-9_$@#.+:/-]+|[^\s]/g
        ) || []
      const lines: string[] = []
      let line = ''
      let units = 0

      const measure = (token: string) =>
        /^[\u3400-\u9fff\uf900-\ufaff]$/.test(token)
          ? 2
          : Math.max(1, Math.min(token.length, maxUnits))

      for (const token of tokens) {
        const tokenUnits = measure(token)
        const needsSpace = Boolean(line) && /^[A-Za-z0-9_$@#]/.test(token)
        const nextUnits = units + tokenUnits + (needsSpace ? 1 : 0)
        if (line && nextUnits > maxUnits) {
          lines.push(line)
          line = token
          units = tokenUnits
          if (lines.length === maxLines) break
        } else {
          line += `${needsSpace ? ' ' : ''}${token}`
          units = nextUnits
        }
      }
      if (lines.length < maxLines && line) lines.push(line)

      const visibleText = lines.join('').replace(/\s+/g, '')
      const fullText = normalized.replace(/\s+/g, '')
      if (visibleText.length < fullText.length && lines.length) {
        lines[lines.length - 1] = `${lines.at(-1)!.replace(/[….]+$/, '')}…`
      }
      return lines
    }

    private renderMindMap() {
      const root = this.mindMapRoot
      const canvas = this.querySelector<SVGSVGElement>('[data-mindmap-canvas]')
      if (!root || !canvas) return

      const compact = window.matchMedia('(max-width: 640px)').matches
      const nodeWidth = compact ? 176 : 208
      const rootWidth = compact ? 192 : 226
      const horizontalGap = compact ? 54 : 78
      const verticalGap = compact ? 13 : 16
      const padding = compact ? 22 : 30
      const lineHeight = compact ? 18 : 19
      const nodes: MindMapNode[] = []
      let cursorY = padding

      const prepare = (node: MindMapNode) => {
        node.width = node.depth === 1 ? rootWidth : nodeWidth
        node.lines = this.wrapMindMapText(
          node.title,
          node.depth === 1 ? (compact ? 20 : 24) : compact ? 17 : 21
        )
        node.height = Math.max(44, node.lines.length * lineHeight + 22)
        node.children.forEach(prepare)
      }

      const position = (node: MindMapNode) => {
        node.x =
          padding +
          (node.depth - 1) * (nodeWidth + horizontalGap) +
          (node.depth > 1 ? rootWidth - nodeWidth : 0)
        if (node.children.length === 0) {
          node.y = cursorY
          cursorY += node.height! + verticalGap
        } else {
          node.children.forEach(position)
          const first = node.children[0]
          const last = node.children.at(-1)!
          const firstCenter = first.y! + first.height! / 2
          const lastCenter = last.y! + last.height! / 2
          node.y = Math.max(
            padding,
            (firstCenter + lastCenter) / 2 - node.height! / 2
          )
        }
        nodes.push(node)
      }

      prepare(root)
      position(root)
      this.mindMapWidth = Math.ceil(
        Math.max(...nodes.map((node) => node.x! + node.width!)) + padding
      )
      this.mindMapHeight = Math.ceil(
        Math.max(...nodes.map((node) => node.y! + node.height!)) + padding
      )

      const svgNamespace = 'http://www.w3.org/2000/svg'
      const fragment = document.createDocumentFragment()
      const edges = document.createElementNS(svgNamespace, 'g')
      edges.setAttribute('aria-hidden', 'true')
      for (const parent of nodes) {
        for (const child of parent.children) {
          const startX = parent.x! + parent.width!
          const startY = parent.y! + parent.height! / 2
          const endX = child.x!
          const endY = child.y! + child.height! / 2
          const bend = Math.max(24, (endX - startX) * 0.48)
          const path = document.createElementNS(svgNamespace, 'path')
          path.setAttribute('class', 'reader-mindmap-edge')
          path.setAttribute(
            'd',
            `M ${startX} ${startY} C ${startX + bend} ${startY}, ${endX - bend} ${endY}, ${endX} ${endY}`
          )
          edges.append(path)
        }
      }
      fragment.append(edges)

      for (const node of nodes) {
        const group = document.createElementNS(svgNamespace, 'g')
        group.setAttribute('class', 'reader-mindmap-node')
        group.setAttribute('transform', `translate(${node.x} ${node.y})`)
        group.dataset.root = String(node.depth === 1)
        if (node.headingId) {
          group.dataset.mindmapHeading = node.headingId
          group.setAttribute('role', 'link')
          group.setAttribute('tabindex', '0')
          group.setAttribute('aria-label', `跳转到：${node.title}`)
        } else {
          group.setAttribute('aria-hidden', 'true')
        }

        const rect = document.createElementNS(svgNamespace, 'rect')
        rect.setAttribute('width', String(node.width))
        rect.setAttribute('height', String(node.height))
        rect.setAttribute('rx', '10')

        const text = document.createElementNS(svgNamespace, 'text')
        const textX = node.depth === 1 ? 15 : 13
        const startY =
          (node.height! - node.lines!.length * lineHeight) / 2 +
          lineHeight * 0.76
        node.lines!.forEach((line, index) => {
          const span = document.createElementNS(svgNamespace, 'tspan')
          span.setAttribute('x', String(textX))
          span.setAttribute('y', String(startY + index * lineHeight))
          span.textContent = line
          text.append(span)
        })
        group.append(rect, text)
        fragment.append(group)
      }

      canvas.replaceChildren(fragment)
      canvas.setAttribute(
        'viewBox',
        `0 0 ${this.mindMapWidth} ${this.mindMapHeight}`
      )
      this.applyMindMapScale(1)
    }

    private applyMindMapScale(scale: number, preserveCenter = false) {
      const canvas = this.querySelector<SVGSVGElement>('[data-mindmap-canvas]')
      const viewport = this.querySelector<HTMLElement>(
        '[data-mindmap-viewport]'
      )
      if (!canvas || !viewport || !this.mindMapWidth || !this.mindMapHeight)
        return

      const centerX = preserveCenter
        ? (viewport.scrollLeft + viewport.clientWidth / 2) /
          Math.max(1, viewport.scrollWidth)
        : 0
      const centerY = preserveCenter
        ? (viewport.scrollTop + viewport.clientHeight / 2) /
          Math.max(1, viewport.scrollHeight)
        : 0
      this.mindMapScale = Math.min(1.8, Math.max(0.32, scale))
      canvas.style.width = `${Math.round(this.mindMapWidth * this.mindMapScale)}px`
      canvas.style.height = `${Math.round(this.mindMapHeight * this.mindMapScale)}px`

      if (preserveCenter) {
        requestAnimationFrame(() => {
          viewport.scrollLeft =
            centerX * viewport.scrollWidth - viewport.clientWidth / 2
          viewport.scrollTop =
            centerY * viewport.scrollHeight - viewport.clientHeight / 2
        })
      }
    }

    private fitMindMap() {
      const viewport = this.querySelector<HTMLElement>(
        '[data-mindmap-viewport]'
      )
      if (!viewport || !this.mindMapWidth || !this.mindMapHeight) return
      const availableWidth = Math.max(1, viewport.clientWidth - 32)
      const minimumReadableScale = window.matchMedia('(max-width: 640px)')
        .matches
        ? 0.78
        : 0.68
      const scale = Math.min(
        1,
        Math.max(minimumReadableScale, availableWidth / this.mindMapWidth)
      )
      this.applyMindMapScale(scale)
      viewport.scrollTo({ left: 0, top: 0, behavior: 'auto' })
    }

    private openMindMap() {
      const dialog = this.querySelector<HTMLDialogElement>(
        '[data-mindmap-dialog]'
      )
      if (!dialog || !this.mindMapRoot) return
      this.renderMindMap()
      if (!dialog.open) dialog.showModal()
      requestAnimationFrame(() => this.fitMindMap())
    }

    private closeMindMap() {
      const dialog = this.querySelector<HTMLDialogElement>(
        '[data-mindmap-dialog]'
      )
      if (dialog?.open) dialog.close()
    }

    private jumpToMindMapHeading(headingId: string) {
      const heading = this.querySelector<HTMLElement>(
        `#${CSS.escape(headingId)}`
      )
      if (!heading) return
      this.closeMindMap()
      requestAnimationFrame(() => {
        const headingTop =
          heading.getBoundingClientRect().top + window.scrollY - 88
        window.scrollTo({
          top: Math.max(0, headingTop),
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)')
            .matches
            ? 'auto'
            : 'smooth',
        })
        const anchorUrl = new URL(window.location.href)
        anchorUrl.hash = encodeURIComponent(headingId)
        window.history.pushState(window.history.state, '', anchorUrl)
        this.setActiveToc(headingId)
      })
    }

    private handleMindMapClick = (event: MouseEvent) => {
      if (!(event.target instanceof Element)) return
      const dialog = this.querySelector<HTMLDialogElement>(
        '[data-mindmap-dialog]'
      )
      if (event.target === dialog) {
        this.closeMindMap()
        return
      }

      const trigger = event.target.closest<HTMLElement>(
        '[data-mindmap-trigger]'
      )
      if (trigger && this.contains(trigger)) {
        event.preventDefault()
        this.openMindMap()
        return
      }

      const action = event.target.closest<HTMLButtonElement>(
        '[data-mindmap-action]'
      )
      if (action && this.contains(action)) {
        event.preventDefault()
        if (action.dataset.mindmapAction === 'close') this.closeMindMap()
        if (action.dataset.mindmapAction === 'fit') this.fitMindMap()
        if (action.dataset.mindmapAction === 'zoom-in')
          this.applyMindMapScale(this.mindMapScale + 0.14, true)
        if (action.dataset.mindmapAction === 'zoom-out')
          this.applyMindMapScale(this.mindMapScale - 0.14, true)
        return
      }

      const node = event.target.closest<SVGGElement>('[data-mindmap-heading]')
      if (node?.dataset.mindmapHeading)
        this.jumpToMindMapHeading(node.dataset.mindmapHeading)
    }

    private handleMindMapKeydown = (event: KeyboardEvent) => {
      if (!(event.target instanceof Element)) return
      const node = event.target.closest<SVGGElement>('[data-mindmap-heading]')
      if (
        !node?.dataset.mindmapHeading ||
        (event.key !== 'Enter' && event.key !== ' ')
      )
        return
      event.preventDefault()
      this.jumpToMindMapHeading(node.dataset.mindmapHeading)
    }

    private handleMindMapResize = () => {
      const dialog = this.querySelector<HTMLDialogElement>(
        '[data-mindmap-dialog]'
      )
      if (!dialog?.open) return
      if (this.mindMapResizeFrame)
        window.cancelAnimationFrame(this.mindMapResizeFrame)
      this.mindMapResizeFrame = window.requestAnimationFrame(() => {
        this.renderMindMap()
        this.fitMindMap()
      })
    }

    private handlePanelToggle = (event: MouseEvent) => {
      if (!(event.target instanceof Element)) return
      const button = event.target.closest<HTMLButtonElement>(
        '[data-reader-panel-toggle]'
      )
      if (!button || !this.contains(button)) return

      event.preventDefault()
      event.stopPropagation()
      const type = button.dataset.readerPanelToggle
      if (type !== 'course' && type !== 'toc') return
      const panel = this.querySelector<HTMLElement>(
        type === 'course' ? '[data-course-panel]' : '[data-toc-panel]'
      )
      if (!panel || (panel.hidden && !panel.dataset.readerPanelReady)) return

      const open = panel.hasAttribute('data-reader-panel-open')
      const otherType = type === 'course' ? 'toc' : 'course'
      const otherPanel = this.querySelector<HTMLElement>(
        otherType === 'course' ? '[data-course-panel]' : '[data-toc-panel]'
      )

      otherPanel?.removeAttribute('data-reader-panel-open')
      this.setPanelToggleState(otherType, false)
      if (open) {
        panel.removeAttribute('data-reader-panel-open')
        this.setPanelToggleState(type, false)
      } else {
        document.documentElement.removeAttribute('data-immersive')
        panel.hidden = false
        panel.setAttribute('data-reader-panel-open', '')
        this.setPanelToggleState(type, true)
      }
    }

    private setPanelToggleState(type: string, open: boolean) {
      const panelName = type === 'course' ? '课程目录' : '本页目录'
      for (const toggle of this.querySelectorAll<HTMLButtonElement>(
        `[data-reader-panel-toggle="${type}"]`
      )) {
        toggle.setAttribute('aria-expanded', String(open))
        toggle.setAttribute(
          'aria-label',
          `${open ? '关闭' : '打开'}${panelName}`
        )
      }
    }

    private resolveArticleLocation() {
      const params = new URLSearchParams(window.location.search)
      const currentPath = params.get('path')
      const currentSourceId = params.get('source') || 'geektime'
      const currentCourseId = params.get('course') || undefined
      if (currentPath) {
        this.storeArticleLocation(currentPath, currentSourceId, currentCourseId)
        return {
          path: currentPath,
          sourceId: currentSourceId,
          courseId: currentCourseId,
        }
      }

      try {
        const rememberedPath = sessionStorage.getItem(
          'geektime:last-article-path'
        )
        if (!rememberedPath) return null
        const rememberedSourceId =
          sessionStorage.getItem('geektime:last-source-id') || 'geektime'
        const rememberedCourseId =
          sessionStorage.getItem('geektime:last-course-id') || undefined

        const restoredUrl = new URL(window.location.href)
        restoredUrl.searchParams.set('path', rememberedPath)
        restoredUrl.searchParams.set('source', rememberedSourceId)
        if (rememberedCourseId) {
          restoredUrl.searchParams.set('course', rememberedCourseId)
        }
        window.history.replaceState(
          window.history.state,
          '',
          restoredUrl.toString()
        )
        return {
          path: rememberedPath,
          sourceId: rememberedSourceId,
          courseId: rememberedCourseId,
        }
      } catch {
        return null
      }
    }

    private handleReaderLink = (event: MouseEvent) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return
      if (!(event.target instanceof Element)) return
      const link = event.target.closest<HTMLAnchorElement>('a[href]')
      if (!link || link.target === '_blank' || link.hasAttribute('download'))
        return

      const rawHref = link.getAttribute('href')
      if (rawHref?.startsWith('#')) {
        const headingId = decodeURIComponent(rawHref.slice(1))
        const heading = this.querySelector<HTMLElement>(
          `#${CSS.escape(headingId)}`
        )
        if (!heading) return

        event.preventDefault()
        const headingTop =
          heading.getBoundingClientRect().top + window.scrollY - 88
        window.scrollTo({
          top: Math.max(0, headingTop),
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)')
            .matches
            ? 'auto'
            : 'smooth',
        })
        const anchorUrl = new URL(window.location.href)
        anchorUrl.hash = rawHref.slice(1)
        window.history.pushState(window.history.state, '', anchorUrl)
        this.setActiveToc(headingId)
        return
      }

      const url = new URL(link.href, window.location.href)
      const articlePath = url.searchParams.get('path')
      const sourceId = url.searchParams.get('source') || 'geektime'
      const courseId = url.searchParams.get('course') || undefined
      if (
        !articlePath ||
        url.origin !== window.location.origin ||
        url.pathname !== window.location.pathname
      )
        return

      event.preventDefault()
      if (
        articlePath === this.article?.path &&
        sourceId === this.source?.id &&
        (!courseId || courseId === this.course?.id)
      )
        return
      this.storeArticleLocation(articlePath, sourceId, courseId)
      window.history.pushState({}, '', url)
      this.loadArticle(articlePath, false, sourceId, courseId).catch((error) =>
        this.showError(error)
      )
    }

    private prefetchReaderLink = (event: PointerEvent) => {
      if (!(event.target instanceof Element) || !this.catalog) return
      const link = event.target.closest<HTMLAnchorElement>('a[href]')
      if (!link) return
      const url = new URL(link.href, window.location.href)
      const articlePath = url.searchParams.get('path')
      const sourceId = url.searchParams.get('source')
      const courseId = url.searchParams.get('course') || undefined
      if (!articlePath || !sourceId) return
      const located = this.findArticle(articlePath, sourceId, courseId)
      if (located)
        void this.fetchMarkdown(articlePath, located.source).catch(
          () => undefined
        )
    }

    private handlePopState = () => {
      const params = new URLSearchParams(window.location.search)
      const articlePath = params.get('path')
      const sourceId = params.get('source') || 'geektime'
      const courseId = params.get('course') || undefined
      if (
        !articlePath ||
        (articlePath === this.article?.path &&
          sourceId === this.source?.id &&
          (!courseId || courseId === this.course?.id))
      )
        return
      this.storeArticleLocation(articlePath, sourceId, courseId)
      this.loadArticle(articlePath, false, sourceId, courseId).catch((error) =>
        this.showError(error)
      )
    }

    private handlePageLoad = () => {
      if (!this.isConnected || !this.catalog) return
      const location = this.resolveArticleLocation()
      if (!location) return
      this.loadArticle(
        location.path,
        false,
        location.sourceId,
        location.courseId
      ).catch((error) => this.showError(error))
    }

    private storeArticleLocation(
      articlePath: string,
      sourceId: string,
      courseId?: string
    ) {
      try {
        sessionStorage.setItem('geektime:last-article-path', articlePath)
        sessionStorage.setItem('geektime:last-source-id', sourceId)
        if (courseId) {
          sessionStorage.setItem('geektime:last-course-id', courseId)
        } else {
          sessionStorage.removeItem('geektime:last-course-id')
        }
      } catch {
        // Reading still works when storage is unavailable.
      }
    }

    private async fetchMarkdown(
      path: string,
      source: Source,
      signal?: AbortSignal
    ) {
      const cacheKey = `${source.id}:${path}`
      const cached = this.markdownCache.get(cacheKey)
      if (cached !== undefined) return cached

      let lastStatus: number | undefined
      for (const url of this.getMarkdownUrls(path, source)) {
        for (let attempt = 0; attempt < FETCH_RETRY_DELAYS.length; attempt++) {
          try {
            const response = await fetch(url, { signal })
            lastStatus = response.status
            if (response.ok) {
              const markdown = await response.text()
              if (!markdown.trim()) {
                throw new Error('该章节源文件暂无正文。')
              }
              this.markdownCache.set(cacheKey, markdown)
              return markdown
            }
            if (!shouldRetryStatus(response.status)) break
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') {
              throw error
            }
            if (
              error instanceof Error &&
              error.message === '该章节源文件暂无正文。'
            ) {
              throw error
            }
          }

          if (attempt < FETCH_RETRY_DELAYS.length - 1) {
            await waitForRetry(FETCH_RETRY_DELAYS[attempt], signal)
          }
        }
      }

      const statusMessage = lastStatus ? `（HTTP ${lastStatus}）` : ''
      throw new Error(`正文加载失败${statusMessage}，已自动重试并切换备用源。`)
    }

    private async fetchCatalog(url: string) {
      let lastStatus: number | undefined
      for (let attempt = 0; attempt < FETCH_RETRY_DELAYS.length; attempt++) {
        try {
          const response = await fetch(url)
          lastStatus = response.status
          if (response.ok) return response
          if (!shouldRetryStatus(response.status)) break
        } catch {
          // Retry same-origin catalog requests after transient network failures.
        }

        if (attempt < FETCH_RETRY_DELAYS.length - 1) {
          await waitForRetry(FETCH_RETRY_DELAYS[attempt])
        }
      }

      const statusMessage = lastStatus ? `（HTTP ${lastStatus}）` : ''
      throw new Error(`无法加载文档目录${statusMessage}，请稍后重试。`)
    }

    private findArticle(path: string, sourceId: string, courseId?: string) {
      const source = this.getSources().find((item) => item.id === sourceId)
      if (!source) return null

      for (const category of this.catalog.categories) {
        for (const course of category.courses) {
          if ((course.sourceId || 'geektime') !== sourceId) continue
          if (courseId && course.id !== courseId) continue
          const article = course.articles.find((item) => item.path === path)
          if (article) return { category, course, article, source }
        }
      }
      return null
    }

    private getSources() {
      if (this.catalog.sources?.length) return this.catalog.sources
      if (!this.catalog.source || !this.catalog.commit) return []

      return [
        {
          id: 'geektime',
          name: '极客时间',
          source: this.catalog.source,
          repository: 'uaxe/geektime-docs',
          commit: this.catalog.commit,
        },
      ]
    }

    private updateHeader() {
      const title = this.querySelector<HTMLElement>('[data-title]')
      const courseLink =
        this.querySelector<HTMLAnchorElement>('[data-course-link]')
      const courseSeparator = this.querySelector<HTMLElement>(
        '[data-course-separator]'
      )

      if (title) title.textContent = this.article.title
      if (courseLink) {
        courseLink.textContent = this.course.name
        courseLink.href = `/docs/#${this.category.id}`
      }
      if (courseSeparator) courseSeparator.hidden = false

      document.title = `${this.article.title} - wangshengliang`
      document
        .querySelector('meta[name="description"]')
        ?.setAttribute('content', `${this.course.name}：${this.article.title}`)
    }

    private updateCoursePanel() {
      const panel = this.querySelector<HTMLElement>('[data-course-panel]')
      const list = this.querySelector<HTMLOListElement>('[data-course-list]')
      const link = this.querySelector<HTMLAnchorElement>(
        '[data-course-panel-link]'
      )
      const count = this.querySelector<HTMLElement>('[data-course-count]')
      if (!panel || !list) return

      if (link) {
        link.textContent = this.course.name
        link.href = `/docs/#${this.category.id}`
      }
      if (count) count.textContent = `${this.course.articles.length} 篇`

      const courseKey = `${this.source.id}:${this.course.id}`
      if (list.dataset.courseId !== courseKey) {
        const fragment = document.createDocumentFragment()
        this.course.articles.forEach((article, index) => {
          const item = document.createElement('li')
          item.className = 'reader-course-item'

          const articleLink = document.createElement('a')
          articleLink.className = 'reader-course-link'
          articleLink.href = this.getArticleUrl(article.path)
          articleLink.dataset.articlePath = article.path

          const number = document.createElement('span')
          number.className = 'reader-course-index'
          number.textContent = String(index + 1).padStart(2, '0')

          const name = document.createElement('span')
          name.textContent = article.title.replace(/^\d+\s*[-–—]\s*/, '')
          articleLink.append(number, name)
          item.append(articleLink)
          fragment.append(item)
        })

        list.replaceChildren(fragment)
        list.dataset.courseId = courseKey
      }

      let activeLink: HTMLAnchorElement | undefined
      for (const articleLink of list.querySelectorAll<HTMLAnchorElement>(
        '.reader-course-link'
      )) {
        const isActive = articleLink.dataset.articlePath === this.article.path
        articleLink.toggleAttribute('aria-current', isActive)
        if (isActive) {
          articleLink.setAttribute('aria-current', 'page')
          activeLink = articleLink
        }
      }

      panel.hidden = false
      panel.dataset.readerPanelReady = 'true'
      requestAnimationFrame(() => {
        activeLink?.scrollIntoView({ block: 'nearest' })
      })
    }

    private updatePostActions(markdown: string) {
      const container = this.querySelector<HTMLElement>('[data-reader-actions]')
      const actions = this.querySelector<HTMLElement>('[data-post-actions]')
      if (!container || !actions) return

      actions.dataset.markdown = markdown
      actions.dataset.url = window.location.href
      actions.dataset.title = this.article.title
      container.hidden = false
    }

    private updateToc(content: HTMLElement) {
      const panel = this.querySelector<HTMLElement>('[data-toc-panel]')
      const list = this.querySelector<HTMLElement>('[data-toc-list]')
      if (!panel || !list) return

      const headings = Array.from(
        content.querySelectorAll<HTMLElement>('h2, h3, h4')
      )
      if (headings.length === 0) {
        list.replaceChildren()
        panel.hidden = true
        this.headingObserver?.disconnect()
        return
      }

      const fragment = document.createDocumentFragment()
      for (const heading of headings) {
        const link = document.createElement('a')
        link.className = 'reader-toc-link'
        link.dataset.depth = heading.tagName.slice(1)
        link.href = `#${encodeURIComponent(heading.id)}`
        link.textContent = heading.textContent?.trim() || '未命名章节'
        link.dataset.headingId = heading.id
        fragment.append(link)
      }

      list.replaceChildren(fragment)
      panel.hidden = false
      panel.dataset.readerPanelReady = 'true'
      this.headingObserver?.disconnect()
      this.headingObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries.find((entry) => entry.isIntersecting)
          if (!(visible?.target instanceof HTMLElement)) return
          this.setActiveToc(visible.target.id)
        },
        { rootMargin: '-12% 0px -72% 0px' }
      )
      headings.forEach((heading) => this.headingObserver?.observe(heading))
      this.setActiveToc(headings[0].id)
    }

    private setActiveToc(headingId: string) {
      for (const link of this.querySelectorAll<HTMLAnchorElement>(
        '.reader-toc-link'
      )) {
        if (link.dataset.headingId === headingId) {
          link.setAttribute('aria-current', 'true')
        } else {
          link.removeAttribute('aria-current')
        }
      }
    }

    private rewriteResources(root: DocumentFragment) {
      const knownPaths = new Set(
        this.catalog.categories.flatMap((category) =>
          category.courses.flatMap((course) =>
            (course.sourceId || 'geektime') === this.source.id
              ? course.articles.map((article) => article.path)
              : []
          )
        )
      )

      for (const image of root.querySelectorAll<HTMLImageElement>('img[src]')) {
        const source = image.getAttribute('src')
        if (!source) continue

        // Geekbang's image host rejects requests carrying an external Referer.
        // Apply this before the fragment enters the DOM so the first request
        // is sent without the blog URL as its referrer.
        image.referrerPolicy = 'no-referrer'
        image.loading = 'lazy'
        image.decoding = 'async'

        const fallback = (imageFallbacks as Record<string, string>)[source]
        if (fallback) {
          image.src = fallback
          continue
        }

        if (!this.isAbsoluteUrl(source)) {
          image.src = this.getRawUrl(this.resolvePath(source))
        }
      }

      for (const link of root.querySelectorAll<HTMLAnchorElement>('a[href]')) {
        const href = link.getAttribute('href')
        if (!href || href.startsWith('#')) continue

        if (this.isAbsoluteUrl(href)) {
          link.target = '_blank'
          link.rel = 'noopener noreferrer'
          continue
        }

        const resolved = this.resolvePath(href)
        if (resolved.endsWith('.md') && knownPaths.has(resolved)) {
          const located = this.findArticle(resolved, this.source.id)
          link.href = this.getArticleUrl(
            resolved,
            this.source.id,
            located?.course.id
          )
        } else {
          link.href = this.getRawUrl(resolved)
          link.target = '_blank'
          link.rel = 'noopener noreferrer'
        }
      }
    }

    private addHeadingAnchors(root: DocumentFragment) {
      const used = new Set<string>()
      for (const heading of root.querySelectorAll<HTMLElement>(
        'h2, h3, h4, h5, h6'
      )) {
        const base =
          heading.textContent
            ?.trim()
            .toLocaleLowerCase('zh-CN')
            .replace(/\s+/g, '-')
            .replace(/[^\w\-\u4e00-\u9fff]/g, '') || 'section'
        let id = base
        let suffix = 2
        while (used.has(id)) id = `${base}-${suffix++}`
        used.add(id)
        heading.id = id
      }
    }

    private resolvePath(relativePath: string) {
      const baseDirectory = this.article.path.split('/').slice(0, -1).join('/')
      const resolved = new URL(
        relativePath,
        `https://content.local/${baseDirectory}/`
      )
      return decodeURIComponent(resolved.pathname.replace(/^\//, ''))
    }

    private isAbsoluteUrl(value: string) {
      return /^(?:[a-z]+:)?\/\//i.test(value) || value.startsWith('data:')
    }

    private getRawUrl(path: string, source = this.source) {
      const encodedPath = path
        .split('/')
        .map((segment) => encodeURIComponent(segment))
        .join('/')
      return `https://cdn.jsdelivr.net/gh/${source.repository}@${source.commit}/${encodedPath}`
    }

    private getMarkdownUrls(path: string, source: Source) {
      const encodedPath = path
        .split('/')
        .map((segment) => encodeURIComponent(segment))
        .join('/')
      return [
        this.getRawUrl(path, source),
        `https://gcore.jsdelivr.net/gh/${source.repository}@${source.commit}/${encodedPath}`,
        `https://raw.githubusercontent.com/${source.repository}/${source.commit}/${encodedPath}`,
      ]
    }

    private getArticleUrl(
      path: string,
      sourceId = this.source.id,
      courseId = this.course.id
    ) {
      const params = new URLSearchParams({ source: sourceId, path })
      params.set('course', courseId)
      return `/docs/read/?${params.toString()}`
    }

    private getLocationKey(path: string, sourceId: string, courseId?: string) {
      return `${sourceId}:${courseId || ''}:${path}`
    }

    private canonicalizeLocation() {
      const url = new URL(window.location.href)
      const urlPath = url.searchParams.get('path')
      const urlSourceId = url.searchParams.get('source') || 'geektime'
      // A previous request may finish while Astro is already navigating to a
      // different course on the same pathname. Never let that stale response
      // rewrite the new route back to the old course.
      if (urlPath !== this.article.path || urlSourceId !== this.source.id)
        return
      if (url.searchParams.get('course') === this.course.id) return
      url.searchParams.set('course', this.course.id)
      window.history.replaceState(window.history.state, '', url)
      this.requestedLocationKey = this.getLocationKey(
        this.article.path,
        this.source.id,
        this.course.id
      )
      this.storeArticleLocation(
        this.article.path,
        this.source.id,
        this.course.id
      )
    }

    private updateNavigation() {
      const navigation = this.querySelector<HTMLElement>('.reader-neighbors')
      const previous = this.querySelector<HTMLAnchorElement>('[data-previous]')
      const next = this.querySelector<HTMLAnchorElement>('[data-next]')
      const index = this.course.articles.findIndex(
        (article) => article.path === this.article.path
      )

      this.configureNeighbor(previous, this.course.articles[index - 1])
      this.configureNeighbor(next, this.course.articles[index + 1])
      if (navigation) navigation.hidden = false
    }

    private prefetchNeighbors() {
      const index = this.course.articles.findIndex(
        (article) => article.path === this.article.path
      )
      for (const article of [
        this.course.articles[index - 1],
        this.course.articles[index + 1],
      ]) {
        if (article) {
          void this.fetchMarkdown(article.path, this.source).catch(
            () => undefined
          )
        }
      }
    }

    private configureNeighbor(
      element: HTMLAnchorElement | null,
      article: Article | undefined
    ) {
      if (!element) return
      if (!article) {
        element.hidden = true
        return
      }
      element.hidden = false
      element.href = this.getArticleUrl(article.path)
      element.dataset.articlePath = article.path
      const title = element.querySelector('strong')
      if (title) title.textContent = article.title
    }

    private showError(error: unknown) {
      const state = this.querySelector<HTMLElement>('[data-state]')
      if (!state) return

      this.removeAttribute('data-loading')
      this.removeAttribute('aria-busy')

      const title = this.querySelector<HTMLElement>('[data-title]')
      const course = this.querySelector<HTMLAnchorElement>('[data-course-link]')
      const content = this.querySelector<HTMLElement>('[data-content]')
      if (title) title.textContent = '文档暂时无法打开'
      if (course) {
        course.href = '/docs/'
        course.textContent = '加载失败'
      }

      state.hidden = false
      state.classList.add('is-error')
      state.replaceChildren()
      if (content) content.hidden = true

      const icon = document.createElement('span')
      icon.className = 'i-ri-error-warning-line'
      const message = document.createElement('span')
      message.textContent =
        error instanceof Error ? error.message : '文档加载失败，请稍后重试。'
      const actions = document.createElement('div')
      actions.className = 'reader-error-actions'
      const retryButton = document.createElement('button')
      retryButton.type = 'button'
      retryButton.className = 'reader-error-back reader-error-retry'
      retryButton.textContent = '重新加载'
      retryButton.addEventListener('click', () => window.location.reload(), {
        once: true,
      })
      const backLink = document.createElement('a')
      backLink.className = 'reader-error-back'
      backLink.href = '/docs/'
      backLink.textContent = '返回 Docs'
      actions.append(retryButton, backLink)
      state.append(icon, message, actions)
    }
  }

  if (!customElements.get('geektime-reader')) {
    customElements.define('geektime-reader', GeektimeReader)
  }
</script>
