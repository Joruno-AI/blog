---
import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import PostActions from '~/components/widgets/PostActions.astro'
---

<BaseLayout
  title="课程文档"
  description="技术课程文档阅读页"
  bgType="rose"
  stableNavigation={true}
  hideFooter={true}
>
  <StandardLayout class="reader-shell">
    <geektime-reader
      data-catalog-url="/docs/catalog.json?v=2"
      data-loading
      aria-busy="true"
    >
      <div class="reader-layout">
        <aside
          class="reader-panel-skeleton reader-panel-skeleton-course"
          aria-hidden="true"
        >
          <span class="reader-panel-skeleton-heading"></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </aside>

        <aside
          id="reader-course-panel"
          class="reader-course-panel"
          data-course-panel
          hidden
        >
          <div class="reader-aside-heading">
            <span class="i-ri-book-open-line" aria-hidden="true"></span>
            <a data-course-panel-link href="/docs/">本课程</a>
            <span data-course-count></span>
          </div>
          <ol class="reader-course-list" data-course-list></ol>
        </aside>

        <div class="reader-main">
          <nav class="reader-breadcrumb" aria-label="面包屑">
            <a href="/docs/">Docs</a>
            <span data-course-separator aria-hidden="true" hidden>/</span>
            <a data-course-link href="/docs/">
              <span class="sr-only">课程</span>
            </a>
          </nav>

          <header class="reader-header">
            <div class="reader-header-skeleton" aria-hidden="true">
              <span class="reader-header-skeleton-title"></span>
              <span
                class="reader-header-skeleton-title reader-header-skeleton-title-short"
              ></span>
              <span class="reader-header-skeleton-actions"></span>
            </div>
            <div class="reader-header-content">
              <h1 data-title><span class="sr-only">正在加载文档</span></h1>
              <div class="reader-actions" data-reader-actions hidden>
                <PostActions markdown="" postUrl="" title="课程文档" />
              </div>
            </div>
          </header>

          <div class="reader-state" data-state aria-live="polite">
            <span class="sr-only">正在从内容快照加载正文</span>
            <div class="reader-skeleton" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span class="reader-skeleton-media"></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>

          <article class="prose reader-content" data-content hidden></article>

          <nav class="reader-neighbors" aria-label="章节导航" hidden>
            <a data-previous href="/docs/">
              <span>上一篇</span>
              <strong></strong>
            </a>
            <a data-next href="/docs/">
              <span>下一篇</span>
              <strong></strong>
            </a>
          </nav>
        </div>

        <aside
          id="reader-toc-panel"
          class="reader-toc-panel"
          data-toc-panel
          hidden
        >
          <div class="reader-aside-heading">
            <span class="i-ri-menu-2-line" aria-hidden="true"></span>
            <span>本页目录</span>
          </div>
          <nav class="reader-toc-list" data-toc-list aria-label="本页目录">
          </nav>
        </aside>

        <aside
          class="reader-panel-skeleton reader-panel-skeleton-toc"
          aria-hidden="true"
        >
          <span class="reader-panel-skeleton-heading"></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </aside>
      </div>

      <div class="reader-floating-controls" aria-label="阅读面板">
        <button
          type="button"
          class="reader-panel-toggle reader-course-toggle"
          data-reader-panel-toggle="course"
          aria-label="打开课程目录"
          aria-controls="reader-course-panel"
          aria-expanded="false"
        >
          <span
            class="reader-toggle-icon-collapsed i-lucide-panel-left-open"
            aria-hidden="true"></span>
          <span
            class="reader-toggle-icon-expanded i-lucide-panel-left-close"
            aria-hidden="true"></span>
        </button>
        <button
          type="button"
          class="reader-panel-toggle reader-toc-toggle"
          data-reader-panel-toggle="toc"
          aria-label="打开本页目录"
          aria-controls="reader-toc-panel"
          aria-expanded="false"
        >
          <span
            class="reader-toggle-icon-collapsed i-lucide-panel-right-open"
            aria-hidden="true"></span>
          <span
            class="reader-toggle-icon-expanded i-lucide-panel-right-close"
            aria-hidden="true"></span>
        </button>
      </div>
    </geektime-reader>
  </StandardLayout>
</BaseLayout>

<style>
  geektime-reader {
    --reader-line: var(--c-border-soft);
    --reader-muted: var(--c-text-muted);
    --reader-math-accent: #b05c78;
    --reader-math-ink: color-mix(
      in srgb,
      var(--c-text) 68%,
      var(--reader-math-accent) 32%
    );
    --reader-math-line: color-mix(
      in srgb,
      var(--c-border-soft) 48%,
      var(--reader-math-accent) 52%
    );
    --reader-math-surface: color-mix(
      in srgb,
      var(--c-bg) 95%,
      var(--reader-math-accent) 5%
    );
    display: block;
  }

  .reader-layout {
    width: 100%;
    max-width: 96rem;
    margin-inline: auto;
  }

  .reader-main {
    position: relative;
    width: 100%;
    max-width: 54rem;
    min-width: 0;
    margin-inline: auto;
  }

  .reader-course-panel,
  .reader-toc-panel,
  .reader-panel-skeleton {
    display: none;
  }

  .reader-floating-controls {
    display: none;
  }

  .reader-course-panel[hidden],
  .reader-toc-panel[hidden],
  .reader-actions[hidden] {
    display: none;
  }

  .reader-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.75rem;
    color: var(--c-text-faint);
    font-size: 0.7rem;
  }

  .reader-breadcrumb a {
    border-bottom: 1px solid transparent;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .reader-breadcrumb a:hover,
  .reader-breadcrumb a:focus-visible {
    border-color: var(--c-border-strong);
    color: var(--c-text);
  }

  .reader-header {
    position: relative;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--reader-line);
  }

  .reader-header-skeleton {
    display: none;
  }

  geektime-reader[data-loading] .reader-header-skeleton {
    display: grid;
    gap: 0.7rem;
  }

  geektime-reader[data-loading] .reader-header-content {
    display: none;
  }

  .reader-header-skeleton span {
    display: block;
    border-radius: 0.25rem;
    background: var(--c-surface-soft);
    animation: reader-pulse 1.4s ease-in-out infinite;
  }

  .reader-header-skeleton-title {
    width: min(38rem, 88%);
    height: clamp(2rem, 5vw, 2.8rem);
    margin-top: 0.2rem;
  }

  .reader-header-skeleton-title-short {
    width: min(25rem, 58%);
    margin-top: -0.35rem;
    animation-delay: 100ms !important;
  }

  .reader-header-skeleton-actions {
    width: min(19rem, 72%);
    height: 2rem;
    margin-top: 0.65rem;
    animation-delay: 180ms !important;
  }

  .reader-header h1 {
    max-width: 100%;
    margin: 0;
    color: var(--c-text);
    font-family: var(--font-article-title);
    font-size: clamp(1.85rem, 3.4vw, 2.75rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.15;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
    text-wrap: wrap;
  }

  .reader-actions {
    margin-top: 1.25rem;
  }

  .reader-actions :global(.post-actions) {
    margin-bottom: 0;
  }

  .reader-state {
    min-height: 20rem;
    padding-top: 2.25rem;
  }

  .reader-state.is-error {
    display: flex;
    min-height: 16rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    color: #dc2626;
    font-size: 0.8rem;
    text-align: center;
  }

  :global(.dark) .reader-state.is-error {
    color: #f87171;
  }

  :global(.reader-error-back) {
    margin-top: 0.35rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--reader-line);
    border-radius: 0.375rem;
    color: var(--c-text-muted);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  :global(.reader-error-back:hover),
  :global(.reader-error-back:focus-visible) {
    border-color: var(--c-border-strong);
    background: var(--c-surface-hover);
    color: var(--c-text);
  }

  .reader-state[hidden] {
    display: none;
  }

  .reader-skeleton {
    display: grid;
    gap: 1rem;
  }

  .reader-skeleton span {
    display: block;
    height: 0.82rem;
    border-radius: 0.2rem;
    background: var(--c-surface-soft);
    animation: reader-pulse 1.5s ease-in-out infinite;
  }

  .reader-skeleton span:nth-child(1) {
    width: 94%;
  }

  .reader-skeleton span:nth-child(2) {
    width: 100%;
    animation-delay: 80ms;
  }

  .reader-skeleton span:nth-child(3) {
    width: 86%;
    animation-delay: 160ms;
  }

  .reader-skeleton span:nth-child(4) {
    width: 100%;
    animation-delay: 240ms;
  }

  .reader-skeleton span:nth-child(5) {
    width: 97%;
    animation-delay: 320ms;
  }

  .reader-skeleton span:nth-child(6) {
    width: 88%;
    animation-delay: 400ms;
  }

  .reader-skeleton span:nth-child(7) {
    width: 94%;
    margin-top: 0.9rem;
    animation-delay: 480ms;
  }

  .reader-skeleton span:nth-child(8) {
    width: 72%;
    animation-delay: 560ms;
  }

  .reader-skeleton .reader-skeleton-media {
    height: clamp(10rem, 23vw, 15rem);
    margin-block: 1rem 0.6rem;
    border-radius: 0.5rem;
  }

  .reader-content {
    max-width: none;
    padding-top: 1.75rem;
  }

  .reader-content :global(img) {
    height: auto;
    border-radius: 0.5rem;
  }

  .reader-content :global(.katex) {
    color: var(--reader-math-ink);
  }

  .reader-content :global(.katex-display) {
    max-width: 100%;
    margin: 1.5rem 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding: clamp(0.85rem, 2vw, 1.15rem) clamp(0.9rem, 2.4vw, 1.35rem);
    border: 1px solid var(--reader-math-line);
    border-left-width: 3px;
    border-radius: 0.5rem;
    background: var(--reader-math-surface);
    scrollbar-color: var(--reader-math-line) transparent;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  .reader-content :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid var(--reader-line);
    border-radius: 0.5rem;
    background: var(--c-surface-soft);
  }

  .reader-content :global(pre code) {
    padding: 0;
    background: transparent;
    font-size: 0.82rem;
  }

  .reader-content :global(.reader-code-block) {
    --reader-code-bg: #fff;
    --reader-code-header-bg: #fff;
    --reader-code-border: var(--c-border-soft);
    --reader-code-shadow: rgb(15 23 42 / 0.05);
    position: relative;
    margin: 1em 0;
    overflow: hidden;
    border: 1px solid var(--reader-code-border);
    border-radius: 0.4rem;
    background: var(--reader-code-bg);
    box-shadow: 0 1px 2px var(--reader-code-shadow);
  }

  .reader-content :global(.reader-code-toolbar) {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0.45rem 0.65rem;
    border-bottom: 1px solid var(--reader-code-border);
    background: var(--reader-code-header-bg);
    color: var(--c-text-muted);
    pointer-events: none;
  }

  .reader-content :global(.reader-code-window-controls) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .reader-content :global(.reader-code-window-dot) {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
  }

  .reader-content :global(.reader-code-window-dot.is-close) {
    background: #ff5f57;
  }

  .reader-content :global(.reader-code-window-dot.is-minimize) {
    background: #ffbd2e;
  }

  .reader-content :global(.reader-code-window-dot.is-maximize) {
    background: #28c840;
  }

  .reader-content :global(.reader-code-language) {
    position: absolute;
    right: 0.5rem;
    bottom: 0.35rem;
    padding: 0.1rem 0.45rem;
    border-radius: 0.25rem;
    color: var(--c-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    opacity: 0.78;
    text-transform: uppercase;
  }

  .reader-content
    :global(.reader-code-block[data-terminal='true'] .reader-code-language) {
    display: none;
  }

  .reader-content :global(.reader-code-copy) {
    position: absolute;
    top: 0.175rem;
    right: 0.25rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 0.3rem;
    color: var(--c-text-muted);
    background: transparent;
    font-size: 0.95rem;
    opacity: 0.68;
    pointer-events: auto;
    transition:
      opacity 160ms ease,
      background-color 160ms ease,
      color 160ms ease,
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .reader-content :global(.reader-code-block:hover .reader-code-copy),
  .reader-content :global(.reader-code-block:focus-within .reader-code-copy),
  .reader-content :global(.reader-code-copy:hover),
  .reader-content :global(.reader-code-copy:focus-visible),
  .reader-content :global(.reader-code-copy[data-copied='true']) {
    background: var(--c-surface-hover);
    color: var(--c-text);
    opacity: 1;
  }

  .reader-content :global(.reader-code-copy:active) {
    transform: scale(0.96);
  }

  .reader-content :global(.reader-code-copy:focus-visible) {
    outline: 2px solid var(--c-border-strong);
    outline-offset: 1px;
  }

  .reader-content :global(.reader-code-copy-label) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .reader-content :global(.reader-code-copy-feedback) {
    position: absolute;
    top: 50%;
    right: 2.55rem;
    z-index: 2;
    padding: 0.25rem 0.55rem;
    border-radius: 0.35rem;
    background: var(--c-text);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.12);
    color: var(--c-bg);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(0.25rem, -50%) scale(0.97);
    transform-origin: right center;
    transition:
      opacity 160ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      visibility 0s linear 160ms;
  }

  .reader-content :global(.reader-code-copy-feedback::after) {
    content: '';
    position: absolute;
    top: 50%;
    right: -0.38rem;
    width: 0;
    height: 0;
    border-top: 0.38rem solid transparent;
    border-bottom: 0.38rem solid transparent;
    border-left: 0.42rem solid var(--c-text);
    transform: translateY(-50%);
  }

  .reader-content :global(.reader-code-copy-feedback[data-visible='true']) {
    opacity: 1;
    visibility: visible;
    transform: translate(0, -50%) scale(1);
    transition-delay: 0s;
  }

  .reader-content :global(.reader-code-block > pre) {
    margin: 0;
    padding: 0.85rem 1rem;
    border: 0;
    border-radius: 0;
    background: var(--reader-code-bg);
  }

  :global(.dark) .reader-content :global(.reader-code-block) {
    --reader-code-bg: #121212;
    --reader-code-header-bg: #121212;
    --reader-code-border: var(--c-border-soft);
    --reader-code-shadow: rgb(0 0 0 / 0.16);
  }

  .reader-content :global(.reader-code-block .shiki) {
    color: var(--shiki-light);
  }

  .reader-content :global(.reader-code-block .shiki span) {
    color: var(--shiki-light);
  }

  :global(.dark) .reader-content :global(.reader-code-block .shiki),
  :global(.dark) .reader-content :global(.reader-code-block .shiki span) {
    color: var(--shiki-dark);
  }

  .reader-content :global(.reader-code-block .line) {
    display: inline-block;
    width: 100%;
    min-height: 1.35em;
  }

  .reader-content :global(.reader-code-block code) {
    background: transparent !important;
    border-radius: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    user-select: text;
  }

  .reader-content :global(h2),
  .reader-content :global(h3),
  .reader-content :global(h4) {
    scroll-margin-top: 5rem;
    text-wrap: pretty;
  }

  .reader-neighbors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 3.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--reader-line);
  }

  .reader-neighbors[hidden] {
    display: none;
  }

  .reader-neighbors a {
    display: flex;
    min-width: 0;
    min-height: 5rem;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--reader-line);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--c-text-soft);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .reader-neighbors a:hover,
  .reader-neighbors a:focus-visible {
    border-color: var(--c-border-strong);
    background: var(--c-surface-hover);
    color: var(--c-text);
    transform: translateY(-1px);
  }

  .reader-neighbors a:last-child {
    text-align: right;
  }

  .reader-neighbors a[hidden] {
    visibility: hidden;
  }

  .reader-neighbors span {
    color: var(--c-text-faint);
    font-size: 0.7rem;
  }

  .reader-neighbors strong {
    overflow: hidden;
    font-size: 0.78rem;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @keyframes reader-pulse {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reader-header-skeleton span,
    .reader-skeleton span,
    .reader-panel-skeleton span {
      animation: none;
    }

    .reader-content :global(.reader-code-copy-feedback) {
      transition: none;
    }
  }

  /* Keep the course directory and table of contents visible on normal
     desktop monitors as well as wide screens. At smaller widths the reader
     intentionally falls back to a single column so the content stays usable. */
  @media (min-width: 1128px) {
    .reader-layout {
      display: grid;
      grid-template-columns:
        minmax(11rem, 15rem) minmax(0, 1fr)
        minmax(10rem, 13rem);
      gap: clamp(1rem, 1.8vw, 2rem);
      align-items: start;
    }

    .reader-main {
      grid-column: 2;
      grid-row: 1;
      max-width: none;
      margin: 0;
    }

    .reader-course-panel,
    .reader-panel-skeleton-course {
      grid-column: 1;
      grid-row: 1;
    }

    .reader-toc-panel,
    .reader-panel-skeleton-toc {
      grid-column: 3;
      grid-row: 1;
    }

    geektime-reader[data-loading] .reader-panel-skeleton {
      display: grid;
      gap: 0.78rem;
      align-content: start;
      padding: 0.2rem 0.35rem;
    }

    .reader-panel-skeleton span {
      display: block;
      width: 86%;
      height: 0.62rem;
      border-radius: 0.2rem;
      background: var(--c-surface-soft);
      animation: reader-pulse 1.5s ease-in-out infinite;
    }

    .reader-panel-skeleton span:nth-child(3n) {
      width: 68%;
      animation-delay: 120ms;
    }

    .reader-panel-skeleton span:nth-child(3n + 2) {
      width: 96%;
      animation-delay: 220ms;
    }

    .reader-panel-skeleton .reader-panel-skeleton-heading {
      width: 100%;
      height: 1.55rem;
      margin-bottom: 0.35rem;
      border-radius: 0.3rem;
    }

    .reader-course-panel,
    .reader-toc-panel {
      position: sticky;
      top: 5.5rem;
      display: flex;
      max-height: calc(100vh - 7rem);
      flex-direction: column;
      overflow: hidden;
      color: var(--c-text-muted);
    }

    .reader-aside-heading {
      display: flex;
      flex: none;
      align-items: center;
      gap: 0.45rem;
      min-height: 2.25rem;
      padding: 0.2rem 0.35rem 0.65rem;
      border-bottom: 1px solid var(--reader-line);
      color: var(--c-text);
      font-size: 0.78rem;
      font-weight: 600;
    }

    .reader-aside-heading a {
      min-width: 0;
      overflow: hidden;
      border: 0;
      color: inherit;
      text-decoration: none;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .reader-aside-heading [data-course-count] {
      margin-left: auto;
      color: var(--c-text-faint);
      font-family: var(--font-mono);
