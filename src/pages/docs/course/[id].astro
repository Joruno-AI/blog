---
import { getGeektimeArticleUrl, getGeektimeCourses } from '~/utils/geektime'

export function getStaticPaths() {
  return getGeektimeCourses().map(({ course }) => ({
    params: { id: course.id },
    props: { course },
  }))
}

const { course } = Astro.props
const firstArticle = course.articles[0]
const target = firstArticle
  ? getGeektimeArticleUrl(firstArticle.path)
  : '/docs/'

Astro.response.headers.set('Location', target)
return Astro.redirect(target)
---
