---
import { getCollection } from 'astro:content'

import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import SkillsNav from '~/components/views/SkillsNav.astro'
import SkillMiniCard from '~/components/views/SkillMiniCard.astro'

import type { FullIndexItem } from '~/utils/skills'

const skills = (await getCollection('skills')).map((s) => s.data)

const toIndexItem = (s: (typeof skills)[number]): FullIndexItem => ({
  f: s.id,
  n: s.name,
  a: s.author,
  s: s.stars,
  d: s.desc,
  c: s.category,
  q: s.qualityScore,
  g: s.securityGrade,
})

const daysAgo = (iso: string) => {
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86400e3)
  if (days <= 0) return '今天'
  if (days < 30) return `${days} 天前`
  if (days < 365) return `${Math.floor(days / 30)} 个月前`
  return `${Math.floor(days / 365)} 年前`
}

const hasGithubMeta = skills.some((s) => s.pushedAt)

const recentlyPushed = skills
  .filter((s) => s.pushedAt)
  .sort((a, b) => (b.pushedAt! > a.pushedAt! ? 1 : -1))
  .slice(0, 18)

const recentlyCreated = skills
  .filter((s) => s.createdAt)
  .sort((a, b) => (b.createdAt! > a.createdAt! ? 1 : -1))
  .slice(0, 18)

const risingStars = skills
  .filter((s) => (s.starsDelta ?? 0) > 0)
  .sort((a, b) => (b.starsDelta ?? 0) - (a.starsDelta ?? 0))
  .slice(0, 18)

const languages = Object.entries(
  skills.reduce((acc: Record<string, number>, s) => {
    if (s.language) acc[s.language] = (acc[s.language] ?? 0) + 1
    return acc
  }, {})
)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12)
const maxLangCount = languages[0]?.[1] ?? 0

const sections = [
  {
    title: '最近更新',
    hint: '按仓库最近提交时间排序',
    items: recentlyPushed,
    meta: (s: (typeof skills)[number]) => daysAgo(s.pushedAt!),
  },
  {
    title: '新面孔',
    hint: '按仓库创建时间排序',
    items: recentlyCreated,
    meta: (s: (typeof skills)[number]) => `创建于 ${daysAgo(s.createdAt!)}`,
  },
  {
    title: 'Star 增速',
    hint: '与上一次数据快照对比',
    items: risingStars,
    meta: (s: (typeof skills)[number]) => `+${s.starsDelta} stars`,
  },
]
---

<BaseLayout
  title="趋势 - Skills"
  description="Agent Skills 与 MCP 工具趋势：最近更新、新收录与 Star 增速"
  bgType={false}
>
  <StandardLayout
    class="max-w-300"
    title="趋势"
    subtitle="最近更新、新面孔与 Star 增速"
    isCentered={true}
  >
    <SkillsNav active="trending" slot="head" />
    {
      !hasGithubMeta && (
        <p class="trend-empty slide-enter">
          仓库动态数据尚未同步，运行一次 pnpm sync:skills 后即可展示。
        </p>
      )
    }
    {
      sections.map((section, idx) =>
        section.items.length > 0 ? (
          <section
            class="trend-section slide-enter"
            style={`--enter-stage: ${idx}`}
          >
            <div class="trend-section-head">
              <h2 class="trend-section-title">{section.title}</h2>
              <span class="trend-section-hint">{section.hint}</span>
            </div>
            <div class="trend-grid">
              {section.items.map((s) => (
                <SkillMiniCard
                  item={toIndexItem(s)}
                  descZh={s.descZh}
                  installs={s.installs}
                  hasDetail={true}
                  metaText={section.meta(s)}
                />
              ))}
            </div>
          </section>
        ) : section.title === 'Star 增速' && hasGithubMeta ? (
          <section class="trend-section slide-enter">
            <div class="trend-section-head">
              <h2 class="trend-section-title">{section.title}</h2>
            </div>
            <p class="trend-empty">
              增速数据需要至少两次数据快照对比，随每次数据同步逐步积累。
            </p>
          </section>
        ) : null
      )
    }
    {
      languages.length > 0 && (
        <section class="trend-section slide-enter" style="--enter-stage: 3">
          <div class="trend-section-head">
            <h2 class="trend-section-title">语言分布</h2>
            <span class="trend-section-hint">精选项目的主要实现语言</span>
          </div>
          <div class="trend-langs">
            {languages.map(([lang, count]) => (
              <div class="trend-lang-row">
                <span class="trend-lang-name">{lang}</span>
                <span class="trend-lang-bar">
                  <i style={`width: ${(count / maxLangCount) * 100}%`} />
                </span>
                <span class="trend-lang-count">{count}</span>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </StandardLayout>
</BaseLayout>

<script>
  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLElement>(
      '[data-copy]'
    )
    if (!btn) return
    navigator.clipboard.writeText(btn.dataset.copy!).then(() => {
      btn.classList.add('is-copied')
      setTimeout(() => btn.classList.remove('is-copied'), 1200)
    })
  })
</script>

<style is:global>
  .trend-section {
    margin-top: 2rem;
  }

  .trend-section-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .trend-section-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--c-text);
  }

  .trend-section-hint {
    font-size: 0.75rem;
    color: var(--c-text-faint);
  }

  .trend-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 0.8rem;
    margin-top: 0.9rem;
  }

  .trend-empty {
    text-align: center;
    color: var(--c-text-faint);
    font-size: 0.85rem;
    padding: 1.6rem 0;
  }

  .trend-langs {
    margin-top: 0.9rem;
    border: 1px solid var(--c-border-soft);
    border-radius: 0.7rem;
    background: var(--c-surface-soft);
    padding: 0.9rem 1.1rem;
    margin-bottom: 2.4rem;
  }

  .trend-lang-row {
    display: grid;
    grid-template-columns: 7rem 1fr 2.6rem;
    align-items: center;
    gap: 0.7rem;
    padding: 0.32rem 0;
    font-size: 0.82rem;
  }

  .trend-lang-name {
    color: var(--c-text-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .trend-lang-bar {
    height: 0.4rem;
    border-radius: 999px;
    background: var(--c-surface-active);
    overflow: hidden;
  }

  .trend-lang-bar i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--c-text-muted);
  }

  .trend-lang-count {
    text-align: right;
    color: var(--c-text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
