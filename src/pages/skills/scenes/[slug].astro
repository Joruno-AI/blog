---
import { getCollection } from 'astro:content'

import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import SkillsNav from '~/components/views/SkillsNav.astro'
import SkillMiniCard from '~/components/views/SkillMiniCard.astro'
import Link from '~/components/base/Link.astro'
import scenesData from '~/data/skill-scenes.json'
import { withBasePath } from '~/utils/path'
import { matchScene } from '~/utils/skills'
import { loadFullIndex } from '~/utils/skills-data'

export function getStaticPaths() {
  return scenesData.scenes.map((scene) => ({
    params: { slug: scene.slug },
    props: { scene },
  }))
}

const { scene } = Astro.props as {
  scene: (typeof scenesData.scenes)[number]
}

const fullIndex = loadFullIndex()
const matches = fullIndex
  .filter((item) => matchScene(item, scene.keywords))
  .slice(0, 30)

const featured = await getCollection('skills')
const enrichMap = new Map(
  featured.map((s) => [
    s.data.id,
    { descZh: s.data.descZh, installs: s.data.installs },
  ])
)

const groupLabel =
  scenesData.groups.find((g) => g.key === scene.group)?.label ?? ''
---

<BaseLayout
  title={`${scene.title} - Skills 场景`}
  description={`${scene.title}: ${scene.desc}`}
  bgType={false}
>
  <StandardLayout
    class="max-w-300"
    title={scene.title}
    subtitle={scene.desc}
    isCentered={true}
  >
    <SkillsNav active="scenes" slot="head" />
    <p class="scene-detail-meta slide-enter" style="--enter-stage: 0">
      <Link href={withBasePath('/skills/scenes/')}>
        <span class="i-ri-arrow-left-line" aria-hidden="true"></span>
        全部场景
      </Link>
      <span>·</span>
      <span>{groupLabel}</span>
      <span>·</span>
      <span>按 Star 数展示前 {matches.length} 个匹配项目</span>
    </p>
    <div class="scene-detail-grid slide-enter" style="--enter-stage: 1">
      {
        matches.map((item) => {
          const enrich = enrichMap.get(item.f)
          return (
            <SkillMiniCard
              item={item}
              descZh={enrich?.descZh}
              installs={enrich?.installs}
              hasDetail={Boolean(enrich)}
            />
          )
        })
      }
    </div>
    {
      matches.length === 0 && (
        <p class="scene-detail-empty">该场景暂无匹配项目。</p>
      )
    }
  </StandardLayout>
</BaseLayout>

<script>
  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLElement>(
      '[data-copy]'
    )
    if (!btn) return
    navigator.clipboard.writeText(btn.dataset.copy!).then(() => {
      btn.classList.add('is-copied')
      setTimeout(() => btn.classList.remove('is-copied'), 1200)
    })
  })
</script>

<style is:global>
  .scene-detail-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.2rem 0 0;
    font-size: 0.8rem;
    color: var(--c-text-faint);
  }

  .scene-detail-meta a {
    display: inline-flex !important;
    align-items: center;
    gap: 0.25rem;
    color: var(--c-text-muted);
    opacity: 1 !important;
  }

  .scene-detail-meta a:hover {
    color: var(--c-text);
  }

  .scene-detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 0.8rem;
    margin-top: 1.2rem;
    padding-bottom: 2.4rem;
  }

  .scene-detail-empty {
    text-align: center;
    color: var(--c-text-faint);
    padding: 2.5rem 0;
  }
</style>
