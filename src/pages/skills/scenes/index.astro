---
import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import SkillsNav from '~/components/views/SkillsNav.astro'
import Link from '~/components/base/Link.astro'
import scenesData from '~/data/skill-scenes.json'
import { withBasePath } from '~/utils/path'
import { matchScene } from '~/utils/skills'
import { loadFullIndex } from '~/utils/skills-data'

const fullIndex = loadFullIndex()

const groups = scenesData.groups.map((group) => ({
  ...group,
  scenes: scenesData.scenes
    .filter((scene) => scene.group === group.key)
    .map((scene) => ({
      ...scene,
      count: fullIndex.filter((item) => matchScene(item, scene.keywords))
        .length,
    })),
}))
---

<BaseLayout
  title="场景导航 - Agent 能力目录"
  description="按使用场景浏览 Agent Skills 与 MCP 工具：数据库、浏览器自动化、内容创作等"
  bgType="dot"
>
  <StandardLayout
    class="max-w-300"
    title="场景导航"
    subtitle={`${scenesData.scenes.length} 个场景，按需找到合适的工具`}
    isCentered={true}
  >
    <SkillsNav active="scenes" slot="head" />
    {
      groups.map((group, idx) => (
        <section
          class="scene-group slide-enter"
          style={`--enter-stage: ${idx}`}
        >
          <div class="scene-group-head">
            <div>
              <span>
                {String(idx + 1).padStart(2, '0')} /{' '}
                {String(groups.length).padStart(2, '0')}
              </span>
              <h2 class="scene-group-title">{group.label}</h2>
            </div>
            <small>{group.scenes.length} 个场景</small>
          </div>
          <div class="scene-grid">
            {group.scenes.map((scene, sceneIndex) => (
              <Link
                class="scene-card"
                href={withBasePath(`/agent/scenes/${scene.slug}/`)}
              >
                <span class="scene-card-index">
                  {String(sceneIndex + 1).padStart(2, '0')}
                </span>
                <span class="scene-card-title">{scene.title}</span>
                <span class="scene-card-desc">{scene.desc}</span>
                <span class="scene-card-count">
                  {scene.count.toLocaleString('zh-CN')} 个项目
                  <i class="i-ri-arrow-right-up-line" aria-hidden="true" />
                </span>
              </Link>
            ))}
          </div>
        </section>
      ))
    }
  </StandardLayout>
</BaseLayout>

<style is:global>
  .scene-group {
    margin-top: 3rem;
  }

  .scene-group-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .scene-group-head > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .scene-group-head > div > span {
    color: var(--c-text-faint);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  .scene-group-head small {
    color: var(--c-text-faint);
    font-size: 0.68rem;
  }

  .scene-group-title {
    margin: 0.18rem 0 0;
    font-size: 1.5rem;
    font-weight: 680;
    letter-spacing: -0.035em;
    color: var(--c-text);
  }

  .scene-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .scene-card {
    display: grid !important;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.3rem 0.7rem;
    min-height: 9.5rem;
    padding: 1rem;
    border: 1px solid var(--skills-border);
    border-radius: var(--skills-radius-lg);
    background: var(--c-bg);
    opacity: 1 !important;
    transition:
      background 160ms ease,
      border-color 160ms ease;
  }

  .scene-card:hover {
    border-color: var(--skills-border);
    background: var(--c-surface-soft);
  }

  .scene-card-index {
    color: var(--c-text-faint);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.62rem;
  }

  .scene-card-title {
    font-size: 0.88rem;
    font-weight: 660;
    color: var(--c-text);
    text-align: left;
  }

  .scene-card-desc {
    grid-column: 2;
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--c-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .scene-card-count {
    grid-column: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.7rem;
    border-top: 1px solid var(--skills-border);
    font-size: 0.65rem;
    color: var(--c-text-faint);
  }

  @media (max-width: 900px) {
    .scene-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .scene-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
