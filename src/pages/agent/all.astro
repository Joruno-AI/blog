---
import { getCollection } from 'astro:content'

import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import SkillCatalogCard from '~/components/views/SkillCatalogCard.astro'
import SkillCategoryIcon from '~/components/views/SkillCategoryIcon.astro'
import SkillSelect from '~/components/views/SkillSelect.astro'
import SkillsNav from '~/components/views/SkillsNav.astro'
import '~/styles/skills-catalog.css'
import { withBasePath } from '~/utils/path'
import { CATEGORY_LABELS, SKILL_CATEGORIES } from '~/utils/skills'
import { loadFullIndex } from '~/utils/skills-data'

const featured = await getCollection('skills')
const fullIndex = loadFullIndex()
const enrichMap = Object.fromEntries(
  featured.map((entry) => [
    entry.data.id,
    { z: entry.data.descZh, i: entry.data.installs ?? 0 },
  ])
)
const categoryCounts = Object.fromEntries(
  SKILL_CATEGORIES.map((category) => [
    category,
    fullIndex.filter((item) => item.c === category).length,
  ])
)
const qualityCounts = {
  S: fullIndex.filter((item) => item.q >= 80).length,
  A: fullIndex.filter((item) => item.q >= 65 && item.q < 80).length,
  B: fullIndex.filter((item) => item.q >= 50 && item.q < 65).length,
  C: fullIndex.filter((item) => item.q < 50).length,
}
const PAGE_SIZE = 48
const catalogScore = (item: (typeof fullIndex)[number]) =>
  item.q * 0.72 + Math.min(Math.log10(item.s + 1) * 8, 28)
const initialItems = [...fullIndex]
  .sort((a, b) => catalogScore(b) - catalogScore(a))
  .slice(0, PAGE_SIZE)
const totalPages = Math.ceil(fullIndex.length / PAGE_SIZE)
const indexUrl = withBasePath('/agent/full-index.json')
const detailBase = withBasePath('/agent/')
const sortOptions = [
  { value: 'score', label: '综合推荐', icon: 'i-ri-sparkling-line' },
  { value: 's', label: 'Stars', icon: 'i-ri-star-line' },
  { value: 'q', label: '质量分', icon: 'i-ri-medal-line' },
  { value: 'n', label: '名称', icon: 'i-ri-sort-alphabet-asc' },
]
---

<BaseLayout
  title="Agent 项目库"
  description="浏览全部收录的 Agent Skills、MCP Servers 与工具，支持搜索、筛选、比较和站内阅读"
  bgType="dot"
>
  <StandardLayout
    class="max-w-300"
    title="Agent 项目库"
    subtitle={`${fullIndex.length.toLocaleString('zh-CN')} 个开源项目，可搜索、筛选与站内比较`}
    isCentered={true}
  >
    <SkillsNav active="all" slot="head" />

    <div class="ska-shell">
      <aside class="ska-filters" aria-label="技能筛选器">
        <div class="ska-filter-head">
          <div>
            <span>FILTERS</span>
            <strong>缩小范围</strong>
          </div>
          <button type="button" data-reset>重置</button>
        </div>

        <section class="ska-filter-group">
          <h2>工具类型</h2>
          <div class="ska-filter-list" role="group" aria-label="工具类型">
            <button type="button" class="is-active" data-cat="all">
              <span>全部项目</span>
              <small>{fullIndex.length.toLocaleString('zh-CN')}</small>
            </button>
            {
              SKILL_CATEGORIES.map((category) => (
                <button type="button" data-cat={category}>
                  <SkillCategoryIcon category={category} size="sm" />
                  <span>{CATEGORY_LABELS[category]}</span>
                  <small>
                    {categoryCounts[category].toLocaleString('zh-CN')}
                  </small>
                </button>
              ))
            }
          </div>
        </section>

        <section class="ska-filter-group">
          <h2>质量等级</h2>
          <div class="ska-quality-list" role="group" aria-label="质量等级">
            {
              (['S', 'A', 'B', 'C'] as const).map((grade) => (
                <button type="button" data-quality={grade}>
                  <b>{grade}</b>
                  <span>
                    {grade === 'S'
                      ? '80+'
                      : grade === 'A'
                        ? '65–79'
                        : grade === 'B'
                          ? '50–64'
                          : '<50'}
                  </span>
                  <small>{qualityCounts[grade].toLocaleString('zh-CN')}</small>
                </button>
              ))
            }
          </div>
        </section>

        <label class="ska-safe">
          <span>
            <i class="i-ri-shield-check-line" aria-hidden="true"></i>
            仅看安全评级通过
          </span>
          <input type="checkbox" data-safe />
        </label>

        <p class="ska-filter-note">
          所有项目详情、README 与源码浏览均优先在本站完成。
        </p>
      </aside>

      <section class="ska-results" aria-label="技能搜索结果">
        <div class="ska-toolbar">
          <label class="ska-search">
            <span class="i-ri-search-line" aria-hidden="true"></span>
            <input
              type="search"
              placeholder="搜索名称、作者或用途"
              aria-label="搜索全部项目"
              autocomplete="off"
            />
            <kbd>/</kbd>
          </label>
          <div class="ska-sort-select">
            <span>排序</span>
            <SkillSelect
              class="ska-sort-control"
              options={sortOptions}
              value="score"
              ariaLabel="排序方式"
              dataAttribute="data-sort"
            />
          </div>
          <div class="ska-view" role="group" aria-label="显示方式">
            <button
              class="is-active"
              type="button"
              data-view="card"
              aria-label="卡片视图"
            >
              <span class="i-ri-layout-grid-line" aria-hidden="true"></span>
            </button>
            <button type="button" data-view="table" aria-label="列表视图">
              <span class="i-ri-list-check-2" aria-hidden="true"></span>
            </button>
          </div>
        </div>

        <div class="ska-results-head">
          <p class="ska-summary" data-summary aria-live="polite">
            找到 {fullIndex.length.toLocaleString('zh-CN')} 个项目 · 第 1/{
              totalPages
            } 页
          </p>
          <p class="ska-selection-note" data-selection-note>
            最多选择 3 个项目进行比较
          </p>
        </div>

        <div class="ska-grid" data-grid>
          {
            initialItems.map((item) => {
              const enrich = enrichMap[item.f]
              return (
                <SkillCatalogCard
                  item={item}
                  descZh={enrich?.z}
                  installs={enrich?.i}
                />
              )
            })
          }
        </div>

        <nav class="ska-pager" data-pager aria-label="分页"></nav>
      </section>
    </div>

    <div class="ska-compare-tray" data-compare-tray hidden>
      <div>
        <span>COMPARE</span>
        <strong data-compare-count>已选择 0/3</strong>
      </div>
      <div class="ska-compare-items" data-compare-items></div>
      <button type="button" class="ska-compare-clear" data-compare-clear
        >清空</button
      >
      <button type="button" class="ska-compare-open" data-compare-open
        >开始比较</button
      >
    </div>

    <dialog class="ska-compare-dialog" data-compare-dialog>
      <div class="ska-compare-dialog-head">
        <div>
          <span>PROJECT COMPARISON</span>
          <h2>项目对比</h2>
        </div>
        <button type="button" data-compare-close aria-label="关闭对比">
          <span class="i-ri-close-line" aria-hidden="true"></span>
        </button>
      </div>
      <div class="ska-compare-content" data-compare-content></div>
    </dialog>
  </StandardLayout>
</BaseLayout>

<script
  is:inline
  data-astro-rerun
  define:vars={{
    enrichMap,
    indexUrl,
    detailBase,
    initialItems,
    totalCount: fullIndex.length,
  }}
>
  window.__SKILLS_ALL__ = {
    enrichMap,
    indexUrl,
    detailBase,
    initialItems,
    totalCount,
  }
</script>

<script>
  interface Item {
    f: string
    n: string
    a: string
    s: number
    d: string
    c: string
    q: number
    g: string
  }

  interface SkillsWindow extends Window {
    __SKILLS_ALL__: {
      enrichMap: Record<string, { z: string; i: number }>
      indexUrl: string
      detailBase: string
      initialItems: Item[]
      totalCount: number
    }
    __SKILLS_INDEX__?: Item[]
    __SKILLS_INDEX_PROMISE__?: Promise<Item[]>
    __mountSkillAvatars?: () => void
  }

  const skillsWindow = window as unknown as SkillsWindow
  const PAGE_SIZE = 48

  const gradeLabel: Record<string, string> = {
    safe: '安全',
    caution: '谨慎',
    unknown: '未评级',
  }
  const categoryLabel: Record<string, string> = {
    'claude-skill': 'Claude Skills',
    'codex-skill': 'Codex Skills',
    'mcp-server': 'MCP Servers',
    'agent-tool': 'Agent Tools',
    'ai-skill': 'AI Skills',
    'llm-plugin': 'Prompt / LLM Plugins',
    'uncategorized': '其他工具',
  }
  const installable = new Set(['claude-skill', 'codex-skill'])
  const format = (value: number) =>
    new Intl.NumberFormat('zh-CN', {
      notation: 'compact',
      maximumFractionDigits: 1,
    }).format(value)
  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (character) =>
        ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        })[character] as string
    )
  const qualityBand = (score: number) =>
    score >= 80 ? 'S' : score >= 65 ? 'A' : score >= 50 ? 'B' : 'C'
  const score = (item: Item) =>
    item.q * 0.72 + Math.min(Math.log10(item.s + 1) * 8, 28)
  const avatarHtml = (author: string, size: number, className: string) =>
    `<span class="skill-avatar-lazy ${className}" data-avatar-src="https://github.com/${encodeURIComponent(author)}.png?size=${size}" role="img" aria-label="${escapeHtml(author)} 的 GitHub 头像"><span class="skill-avatar-fallback" aria-hidden="true">${escapeHtml(author.trim().charAt(0).toUpperCase() || '?')}</span><img class="skill-avatar-image" src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="" decoding="async"></span>`

  async function boot() {
    const grid = document.querySelector<HTMLElement>('[data-grid]')
    const pager = document.querySelector<HTMLElement>('[data-pager]')
    const summary = document.querySelector<HTMLElement>('[data-summary]')
    if (!grid || !pager || !summary) return
    if (grid.dataset.catalogBound === 'true') return
    grid.dataset.catalogBound = 'true'

    const cfg = skillsWindow.__SKILLS_ALL__
    const selected = new Set<string>()
    const selectionNote = document.querySelector<HTMLElement>(
      '[data-selection-note]'
    )
    const searchInput =
      document.querySelector<HTMLInputElement>('.ska-search input')
    const safeCheck = document.querySelector<HTMLInputElement>('[data-safe]')
    const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort]')
    const categoryButtons = [
      ...document.querySelectorAll<HTMLButtonElement>('[data-cat]'),
    ]
    const qualityButtons = [
      ...document.querySelectorAll<HTMLButtonElement>('[data-quality]'),
    ]
    const viewButtons = [
      ...document.querySelectorAll<HTMLButtonElement>('[data-view]'),
    ]
    const resetButton =
      document.querySelector<HTMLButtonElement>('[data-reset]')
    const compareTray = document.querySelector<HTMLElement>(
      '[data-compare-tray]'
    )
    const compareCount = document.querySelector<HTMLElement>(
      '[data-compare-count]'
    )
    const compareItems = document.querySelector<HTMLElement>(
      '[data-compare-items]'
    )
    const compareDialog = document.querySelector<HTMLDialogElement>(
      '[data-compare-dialog]'
    )
    const compareContent = document.querySelector<HTMLElement>(
      '[data-compare-content]'
    )
    const pageController = new AbortController()
    document.addEventListener(
      'astro:before-swap',
      () => pageController.abort(),
      { once: true }
    )

    let items = skillsWindow.__SKILLS_INDEX__ ?? cfg.initialItems
    let itemMap = new Map(items.map((item) => [item.f, item]))
    let indexReady = Boolean(skillsWindow.__SKILLS_INDEX__)
    const params = new URLSearchParams(location.search)
    const storedView = localStorage.getItem('skills-catalog-view')
    const state = {
      category: params.get('cat') || 'all',
      quality: params.get('quality') || 'all',
      sort: params.get('sort') || 'score',
      query: params.get('q') || '',
      safe: params.get('safe') === '1',
      page: Math.max(1, Number(params.get('page')) || 1),
      view: params.get('view') || storedView || 'card',
    }

    const needsFullIndex = () =>
      state.category !== 'all' ||
      state.quality !== 'all' ||
      state.sort !== 'score' ||
      Boolean(state.query.trim()) ||
      state.safe ||
      state.page !== 1 ||
      state.view !== 'card'

    const ensureFullIndex = async () => {
      if (indexReady) return true
      grid.setAttribute('aria-busy', 'true')
      summary.textContent = '正在应用筛选，本页内容仍可浏览…'

      try {
        skillsWindow.__SKILLS_INDEX_PROMISE__ ??= fetch(cfg.indexUrl).then(
          async (response) => {
            if (!response.ok) throw new Error('index request failed')
            return ((await response.json()) as { items: Item[] }).items
          }
        )
        items = await skillsWindow.__SKILLS_INDEX_PROMISE__
        skillsWindow.__SKILLS_INDEX__ = items
        itemMap = new Map(items.map((item) => [item.f, item]))
        indexReady = true
        return true
      } catch {
        skillsWindow.__SKILLS_INDEX_PROMISE__ = undefined
        summary.textContent = '筛选索引暂时读取失败，已保留当前推荐项目'
        return false
      } finally {
        grid.removeAttribute('aria-busy')
      }
    }

    const syncControls = () => {
      if (searchInput) searchInput.value = state.query
      if (safeCheck) safeCheck.checked = state.safe
      if (sortSelect) {
        sortSelect.value = state.sort
        sortSelect.dispatchEvent(new Event('skill-select-sync'))
      }
      categoryButtons.forEach((button) =>
        button.classList.toggle(
          'is-active',
          button.dataset.cat === state.category
        )
      )
      qualityButtons.forEach((button) =>
        button.classList.toggle(
          'is-active',
          button.dataset.quality === state.quality
        )
      )
      viewButtons.forEach((button) =>
        button.classList.toggle('is-active', button.dataset.view === state.view)
      )
    }

    const filtered = () => {
      const query = state.query.trim().toLowerCase()
      let list = items.filter(
        (item) => state.category === 'all' || item.c === state.category
      )
      if (state.quality !== 'all')
        list = list.filter((item) => qualityBand(item.q) === state.quality)
      if (state.safe) list = list.filter((item) => item.g === 'safe')
      if (query)
        list = list.filter((item) =>
          `${item.n} ${item.a} ${item.d}`.toLowerCase().includes(query)
        )

      return [...list].sort((a, b) => {
        if (state.sort === 'q') return b.q - a.q || b.s - a.s
        if (state.sort === 's') return b.s - a.s
        if (state.sort === 'n') return a.n.localeCompare(b.n)
        return score(b) - score(a)
      })
    }

    const compareButton = (item: Item) =>
      `<button type="button" class="ska-card-compare${selected.has(item.f) ? ' is-active' : ''}" data-compare="${escapeHtml(item.f)}" aria-pressed="${selected.has(item.f)}">
        <span class="i-ri-scales-3-line"></span>${selected.has(item.f) ? '已选择' : '对比'}
      </button>`

    const cardHtml = (item: Item) => {
      const enrich = cfg.enrichMap[item.f]
      const description = enrich?.z || item.d || '暂无描述'
      const detail = escapeHtml(`${cfg.detailBase}${item.f}/`)
      const install = installable.has(item.c) ? `npx skills add ${item.f}` : ''
      return `<article class="ska-card">
        <div class="ska-card-topline">
          <span class="ska-quality"><b>${qualityBand(item.q)}</b><small>${item.q}</small></span>
          <span class="ska-grade is-${item.g}"><i></i>${gradeLabel[item.g] || gradeLabel.unknown}</span>
        </div>
        <div class="ska-card-head">
          ${avatarHtml(item.a, 80, 'ska-card-avatar')}
          <div class="ska-card-titles">
            <a class="ska-card-name" href="${detail}">${escapeHtml(item.n)}</a>
            <span class="ska-card-author">${escapeHtml(item.a)}</span>
          </div>
        </div>
        <p class="ska-card-desc">${escapeHtml(description)}</p>
        <div class="ska-card-meta">
          <span><span class="i-ri-star-line"></span>${format(item.s)}</span>
          ${enrich?.i ? `<span><span class="i-ri-download-2-line"></span>${format(enrich.i)}</span>` : ''}
          <span class="ska-card-cat">${categoryLabel[item.c] || escapeHtml(item.c)}</span>
        </div>
        <div class="ska-card-foot">
          ${compareButton(item)}
          ${
            install
              ? `<button type="button" class="ska-card-install" data-copy="${escapeHtml(install)}"><span class="i-ri-terminal-box-line"></span><span>复制安装命令</span></button>`
              : `<a class="ska-card-read" href="${detail}"><span class="i-ri-book-open-line"></span>站内阅读</a>`
          }
          <a class="ska-card-more" href="${detail}" aria-label="查看 ${escapeHtml(item.n)}"><span class="i-ri-arrow-right-line"></span></a>
        </div>
      </article>`
    }

    const tableHtml = (
      list: Item[]
    ) => `<div class="ska-table-wrap"><table class="ska-table">
      <thead><tr><th>项目</th><th>类型</th><th>Stars</th><th>质量</th><th>安全</th><th>操作</th></tr></thead>
      <tbody>${list
        .map((item) => {
          const detail = escapeHtml(`${cfg.detailBase}${item.f}/`)
          return `<tr>
            <td><a href="${detail}">${avatarHtml(item.a, 48, 'ska-table-avatar')}<span><strong>${escapeHtml(item.n)}</strong><small>${escapeHtml(item.a)}</small></span></a></td>
            <td>${categoryLabel[item.c] || escapeHtml(item.c)}</td>
            <td>${format(item.s)}</td>
            <td><span class="ska-table-quality"><b>${qualityBand(item.q)}</b>${item.q}</span></td>
            <td><span class="ska-grade is-${item.g}"><i></i>${gradeLabel[item.g] || gradeLabel.unknown}</span></td>
            <td>${compareButton(item)}<a class="ska-table-open" href="${detail}">打开</a></td>
          </tr>`
        })
        .join('')}</tbody>
    </table></div>`

    const updateUrl = () => {
      const url = new URL(location.href)
      const setParam = (key: string, value: string, fallback: string) =>
        value === fallback
          ? url.searchParams.delete(key)
          : url.searchParams.set(key, value)
      setParam('cat', state.category, 'all')
      setParam('quality', state.quality, 'all')
      setParam('sort', state.sort, 'score')
      setParam('q', state.query.trim(), '')
      setParam('safe', state.safe ? '1' : '0', '0')
      setParam('page', String(state.page), '1')
      setParam('view', state.view, 'card')
      history.replaceState(null, '', url)
    }

    const pageButton = (
      page: number,
      label: string,
      disabled = false,
      current = false
    ) =>
      `<button class="ska-page-btn${current ? ' is-current' : ''}" data-page="${page}"${disabled ? ' disabled' : ''}>${label}</button>`

    const renderPager = (totalItems: number) => {
      const pages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE))
      state.page = Math.min(state.page, pages)
      const pageWindow: number[] = []
      for (
        let page = Math.max(1, state.page - 2);
        page <= Math.min(pages, state.page + 2);
        page++
      )
        pageWindow.push(page)
      pager.innerHTML = [
        pageButton(state.page - 1, '上一页', state.page <= 1),
        ...(pageWindow[0] > 1
          ? [pageButton(1, '1'), '<span class="ska-ellipsis">…</span>']
          : []),
        ...pageWindow.map((page) =>
          pageButton(page, String(page), false, page === state.page)
        ),
        ...(pageWindow[pageWindow.length - 1] < pages
          ? [
              '<span class="ska-ellipsis">…</span>',
              pageButton(pages, String(pages)),
            ]
          : []),
        pageButton(state.page + 1, '下一页', state.page >= pages),
      ].join('')
    }

    const render = () => {
      const list = filtered()
      const pages = Math.max(1, Math.ceil(list.length / PAGE_SIZE))
      state.page = Math.min(state.page, pages)
      const start = (state.page - 1) * PAGE_SIZE
      const visible = list.slice(start, start + PAGE_SIZE)
      grid.classList.toggle('is-table', state.view === 'table')
      grid.innerHTML = visible.length
        ? state.view === 'table'
          ? tableHtml(visible)
          : visible.map(cardHtml).join('')
        : '<div class="ska-empty"><strong>没有找到匹配项目</strong><span>换个关键词或重置筛选条件。</span></div>'
      summary.textContent = `找到 ${list.length.toLocaleString('zh-CN')} 个项目 · 第 ${state.page}/${pages} 页`
      renderPager(list.length)
      syncControls()
      updateUrl()
      skillsWindow.__mountSkillAvatars?.()
    }

    let lastGoodState = { ...state }
    const applyState = async () => {
      if (!indexReady && !needsFullIndex()) {
        summary.textContent = `找到 ${cfg.totalCount.toLocaleString('zh-CN')} 个项目 · 第 1/${Math.ceil(cfg.totalCount / PAGE_SIZE)} 页`
        renderPager(cfg.totalCount)
        syncControls()
        updateUrl()
        lastGoodState = { ...state }
        return true
      }
      if (!(await ensureFullIndex())) {
        // 索引读取失败: 回滚 state, 保持 UI(仍显示推荐项)与状态一致
        Object.assign(state, lastGoodState)
        syncControls()
        return false
      }
      render()
      lastGoodState = { ...state }
      return true
    }

    const renderCompareTray = () => {
      if (!compareTray || !compareCount || !compareItems) return
      compareTray.hidden = selected.size === 0
      compareCount.textContent = `已选择 ${selected.size}/3`
      compareItems.innerHTML = [...selected]
        .map((id) => {
          const item = itemMap.get(id)
          return item
            ? `<span><img src="https://github.com/${encodeURIComponent(item.a)}.png?size=40" alt=""><b>${escapeHtml(item.n)}</b><button type="button" data-compare-remove="${escapeHtml(id)}" aria-label="移除 ${escapeHtml(item.n)}"><span class="i-ri-close-line"></span></button></span>`
            : ''
        })
        .join('')
      if (selectionNote)
        selectionNote.textContent =
          selected.size >= 3
            ? '已选满 3 个项目，可以开始比较'
            : '最多选择 3 个项目进行比较'
    }

    const refreshCompareButtons = () => {
      document
        .querySelectorAll<HTMLButtonElement>('[data-compare]')
        .forEach((button) => {
          const active = selected.has(button.dataset.compare ?? '')
          button.classList.toggle('is-active', active)
          button.setAttribute('aria-pressed', String(active))
          const label = button.lastChild
          if (label?.nodeType === Node.TEXT_NODE)
            label.textContent = active ? '已选择' : '对比'
        })
    }

    const toggleCompare = (id: string) => {
      if (selected.has(id)) selected.delete(id)
      else if (selected.size < 3) selected.add(id)
      else {
        if (selectionNote) selectionNote.textContent = '最多同时比较 3 个项目'
        return
      }
      refreshCompareButtons()
      renderCompareTray()
    }

    const openCompare = () => {
      if (!compareDialog || !compareContent || selected.size < 2) {
        if (selectionNote)
          selectionNote.textContent = '至少选择 2 个项目才能比较'
        return
      }
      const compare = [...selected]
        .map((id) => itemMap.get(id))
        .filter((item): item is Item => Boolean(item))
      const rows = [
        ['作者', (item: Item) => escapeHtml(item.a)],
        ['类型', (item: Item) => categoryLabel[item.c] || escapeHtml(item.c)],
        ['Stars', (item: Item) => item.s.toLocaleString('zh-CN')],
        ['质量分', (item: Item) => `${qualityBand(item.q)} · ${item.q}`],
        ['安全评级', (item: Item) => gradeLabel[item.g] || gradeLabel.unknown],
        [
          '项目描述',
          (item: Item) =>
            escapeHtml(cfg.enrichMap[item.f]?.z || item.d || '暂无描述'),
        ],
      ] as const
      compareContent.innerHTML = `<div class="ska-compare-grid" style="--compare-count:${compare.length}">
        <div class="ska-compare-label"></div>
        ${compare.map((item) => `<a class="ska-compare-project" href="${escapeHtml(`${cfg.detailBase}${item.f}/`)}"><img src="https://github.com/${encodeURIComponent(item.a)}.png?size=72" alt=""><strong>${escapeHtml(item.n)}</strong><span>打开详情 →</span></a>`).join('')}
        ${rows
          .map(
            ([label, value]) =>
              `<div class="ska-compare-label">${label}</div>${compare.map((item) => `<div class="ska-compare-cell">${value(item)}</div>`).join('')}`
          )
          .join('')}
      </div>
      <p class="ska-compare-handoff"><a href="/agent/compare/?repos=${encodeURIComponent(compare.map((item) => item.f).join(','))}">在对比页查看实时 GitHub 数据 →</a></p>`
      compareDialog.showModal()
    }

    categoryButtons.forEach((button) =>
      button.addEventListener('click', () => {
        state.category = button.dataset.cat ?? 'all'
        state.page = 1
        void applyState()
      })
    )
    qualityButtons.forEach((button) =>
      button.addEventListener('click', () => {
        state.quality =
          state.quality === button.dataset.quality
            ? 'all'
            : (button.dataset.quality ?? 'all')
        state.page = 1
        void applyState()
      })
    )
    safeCheck?.addEventListener('change', () => {
      state.safe = safeCheck.checked
      state.page = 1
      void applyState()
    })
    sortSelect?.addEventListener('change', () => {
      state.sort = sortSelect.value
      state.page = 1
      void applyState()
    })
    viewButtons.forEach((button) =>
      button.addEventListener('click', () => {
        state.view = button.dataset.view ?? 'card'
        localStorage.setItem('skills-catalog-view', state.view)
        void applyState()
      })
    )
    resetButton?.addEventListener('click', () => {
      Object.assign(state, {
        category: 'all',
        quality: 'all',
        sort: 'score',
        query: '',
        safe: false,
        page: 1,
      })
      void applyState()
    })
    let searchTimer = 0
    searchInput?.addEventListener('input', () => {
      window.clearTimeout(searchTimer)
      searchTimer = window.setTimeout(() => {
        state.query = searchInput.value
        state.page = 1
        void applyState()
      }, 160)
    })
    pager.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-page]'
      )
      if (!button || button.disabled) return
      state.page = Number(button.dataset.page)
      if (await applyState())
        grid.scrollIntoView({ behavior: 'smooth', block: 'start' })
    })
    grid.addEventListener('click', (event) => {
      const target = event.target as HTMLElement
      const copy = target.closest<HTMLElement>('[data-copy]')
      if (copy) {
        navigator.clipboard
          .writeText(copy.dataset.copy ?? '')
          .then(() => {
            copy.classList.add('is-copied')
            const label = copy.querySelector('span:last-child')
            if (label) label.textContent = '已复制'
            window.setTimeout(() => {
              copy.classList.remove('is-copied')
              if (label) label.textContent = '复制安装命令'
            }, 1200)
          })
          .catch(() => {
            console.warn('[agent] 复制安装命令失败: 剪贴板不可用')
          })
        return
      }
      const compare = target.closest<HTMLElement>('[data-compare]')
      if (compare) toggleCompare(compare.dataset.compare ?? '')
    })
    compareTray?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement
      const remove = target.closest<HTMLElement>('[data-compare-remove]')
      if (remove) {
        toggleCompare(remove.dataset.compareRemove ?? '')
        return
      }
      if (target.closest('[data-compare-clear]')) {
        selected.clear()
        refreshCompareButtons()
        renderCompareTray()
      }
      if (target.closest('[data-compare-open]')) openCompare()
    })
    document
      .querySelector('[data-compare-close]')
      ?.addEventListener('click', () => compareDialog?.close())
    compareDialog?.addEventListener('click', (event) => {
      if (event.target === compareDialog) compareDialog.close()
    })
    document.addEventListener(
      'keydown',
      (event) => {
        if (
          event.key === '/' &&
          !['INPUT', 'TEXTAREA', 'SELECT'].includes(
            (event.target as HTMLElement)?.tagName ?? ''
          )
        ) {
          event.preventDefault()
          searchInput?.focus()
        }
      },
      { signal: pageController.signal }
    )

    syncControls()
    renderPager(cfg.totalCount)
    updateUrl()
    skillsWindow.__mountSkillAvatars?.()
    if (needsFullIndex()) void applyState()
  }

  void boot()
  document.addEventListener('astro:page-load', boot)
</script>
