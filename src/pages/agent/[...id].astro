---
import { getCollection } from 'astro:content'

import AgentKnowledgeReader from '~/components/views/AgentKnowledgeReader.astro'

import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const skills = await getCollection('skills')
  return skills.map((skill) => ({
    params: { id: skill.data.id },
    props: { skill: skill.data },
  }))
}

const { skill } = Astro.props as {
  skill: CollectionEntry<'skills'>['data']
}
---

<AgentKnowledgeReader {skill} />
