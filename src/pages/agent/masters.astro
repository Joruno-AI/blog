---
import { getCollection } from 'astro:content'

import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import SkillsNav from '~/components/views/SkillsNav.astro'
import Link from '~/components/base/Link.astro'
import { withBasePath } from '~/utils/path'
import { formatCount, githubAvatar } from '~/utils/skills'

const skills = (await getCollection('skills')).map((s) => s.data)

interface MasterRow {
  author: string
  repoCount: number
  totalStars: number
  totalInstalls: number
  avgQuality: number
  topRepos: { id: string; name: string }[]
}

const masters: MasterRow[] = Object.values(
  skills.reduce((acc: Record<string, (typeof skills)[number][]>, s) => {
    ;(acc[s.author] ??= []).push(s)
    return acc
  }, {})
)
  .map((repos) => {
    const sorted = [...repos].sort((a, b) => b.stars - a.stars)
    return {
      author: sorted[0].author,
      repoCount: repos.length,
      totalStars: repos.reduce((sum, r) => sum + r.stars, 0),
      totalInstalls: repos.reduce((sum, r) => sum + (r.installs ?? 0), 0),
      avgQuality:
        Math.round(
          (repos.reduce((sum, r) => sum + r.qualityScore, 0) / repos.length) *
            10
        ) / 10,
      topRepos: sorted.slice(0, 3).map((r) => ({ id: r.id, name: r.name })),
    }
  })
  .sort((a, b) => b.totalStars - a.totalStars)
  .slice(0, 50)
---

<BaseLayout
  title="创作者 - Agent 能力目录"
  description="按作者聚合的 Agent Skills 创作者排行榜"
  bgType="dot"
>
  <StandardLayout
    class="max-w-300"
    title="创作者"
    subtitle="按作者聚合的创作者排行榜 (Top 50)"
    isCentered={true}
  >
    <SkillsNav active="masters" slot="head" />
    <section class="masters-podium slide-enter" aria-label="前三名创作者">
      {
        masters.slice(0, 3).map((master, index) => (
          <article class={`masters-podium-card is-${index + 1}`}>
            <span class="masters-podium-rank">
              {String(index + 1).padStart(2, '0')}
            </span>
            <img
              src={githubAvatar(master.author, 144)}
              alt={master.author}
              loading="lazy"
              decoding="async"
            />
            <Link
              href={withBasePath(
                `/agent/all/?q=${encodeURIComponent(master.author)}`
              )}
            >
              {master.author}
            </Link>
            <p>
              {master.repoCount} 个项目 · 平均质量 {master.avgQuality}
            </p>
            <div>
              <span>累计 Stars</span>
              <strong>{formatCount(master.totalStars)}</strong>
            </div>
          </article>
        ))
      }
    </section>
    <ol class="masters-list slide-enter" style="--enter-stage: 0">
      {
        masters.slice(3).map((master, index) => (
          <li class="masters-row">
            <span class="masters-rank">{index + 4}</span>
            <img
              class="masters-avatar"
              src={githubAvatar(master.author, 96)}
              alt={master.author}
              loading="lazy"
              decoding="async"
            />
            <div class="masters-info">
              <Link
                class="masters-name"
                href={withBasePath(
                  `/agent/all/?q=${encodeURIComponent(master.author)}`
                )}
              >
                {master.author}
              </Link>
              <span class="masters-repos">
                {master.topRepos.map((repo, repoIdx) => (
                  <>
                    {repoIdx > 0 && ' · '}
                    <Link href={withBasePath(`/agent/${repo.id}/`)}>
                      {repo.name}
                    </Link>
                  </>
                ))}
              </span>
            </div>
            <div class="masters-metrics">
              <span title="收录作品数">
                <span class="i-ri-archive-line" aria-hidden="true" />
                {master.repoCount}
              </span>
              <span title="总 Star 数">
                <span class="i-ri-star-line" aria-hidden="true" />
                {formatCount(master.totalStars)}
              </span>
              {master.totalInstalls > 0 && (
                <span title="总安装量">
                  <span class="i-ri-download-2-line" aria-hidden="true" />
                  {formatCount(master.totalInstalls)}
                </span>
              )}
              <span title="平均质量分">
                <span class="i-ri-medal-line" aria-hidden="true" />
                {master.avgQuality}
              </span>
            </div>
          </li>
        ))
      }
    </ol>
  </StandardLayout>
</BaseLayout>

<style is:global>
  .masters-list {
    list-style: none;
    margin: 0.9rem 0 3rem;
    padding: 0;
    border: 1px solid var(--skills-border);
    border-radius: var(--skills-radius-lg);
    background: var(--c-bg);
    overflow: hidden;
  }

  .masters-row {
    display: grid;
    grid-template-columns: 2.2rem 2.6rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.78rem 1rem;
    border-top: 1px solid var(--skills-border);
    transition: background 0.2s ease;
  }

  .masters-row:first-child {
    border-top: none;
  }

  .masters-row:hover {
    background: var(--c-surface-soft);
  }

  .masters-rank {
    text-align: center;
    font-weight: 700;
    color: var(--c-text-faint);
    font-variant-numeric: tabular-nums;
  }

  .masters-rank.is-top {
    color: var(--c-text);
  }

  .masters-podium {
    display: grid;
    grid-template-columns: 1.16fr 1fr 1fr;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  .masters-podium-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 14rem;
    padding: 1.15rem;
    overflow: hidden;
    border: 1px solid var(--skills-border);
    border-radius: var(--skills-radius-lg);
    background: var(--c-bg);
  }

  .masters-podium-card.is-1 {
    background: var(--c-text);
    color: var(--c-bg);
  }

  .masters-podium-rank {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.64rem;
    opacity: 0.55;
  }

  .masters-podium-card img {
    width: 3.4rem;
    height: 3.4rem;
    border: 1px solid var(--c-border-soft);
    border-radius: var(--skills-radius-sm);
  }

  .masters-podium-card > a {
    max-width: 100%;
    margin-top: 1rem;
    overflow: hidden;
    color: inherit;
    font-size: 1rem;
    font-weight: 680;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 1 !important;
  }

  .masters-podium-card > p {
    margin: 0.22rem 0 0;
    color: inherit;
    font-size: 0.68rem;
    opacity: 0.6;
  }

  .masters-podium-card > div {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    width: 100%;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 14%, transparent);
  }

  .masters-podium-card > div span {
    font-size: 0.64rem;
    opacity: 0.58;
  }

  .masters-podium-card > div strong {
    font-size: 1.5rem;
    letter-spacing: -0.045em;
  }

  .masters-avatar {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--skills-radius-sm);
    background: var(--c-surface-soft);
  }

  .masters-info {
    min-width: 0;
  }

  .masters-name {
    display: block !important;
    font-weight: 600;
    color: var(--c-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 1 !important;
  }

  .masters-name:hover {
    text-decoration: underline;
  }

  .masters-repos {
    display: block;
    font-size: 0.74rem;
    color: var(--c-text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .masters-repos a {
    color: var(--c-text-muted);
    opacity: 1 !important;
  }

  .masters-repos a:hover {
    color: var(--c-text);
    text-decoration: underline;
  }

  .masters-metrics {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.78rem;
    color: var(--c-text-soft);
    font-variant-numeric: tabular-nums;
  }

  .masters-metrics > span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  @media (max-width: 640px) {
    .masters-podium {
      grid-template-columns: 1fr;
    }

    .masters-row {
      grid-template-columns: 1.6rem 2.2rem minmax(0, 1fr);
    }

    .masters-metrics {
      grid-column: 2 / -1;
      padding-left: 0;
    }
  }
</style>
